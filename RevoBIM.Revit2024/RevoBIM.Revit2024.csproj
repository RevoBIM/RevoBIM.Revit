<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RevoBIM</RootNamespace>
    <AssemblyName>RevoBIM.Revit2024</AssemblyName>
    <Platforms>AnyCPU</Platforms>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <UseWPF>true</UseWPF>
    <Version>0.1.0</Version>
    <RevitInstall>C:\Program Files\Autodesk\Revit 2024</RevitInstall>
    <DeployDir>$(APPDATA)\RevoBIM\2024</DeployDir>
    <AddinDir>$(APPDATA)\Autodesk\Revit\Addins\2024</AddinDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstall)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstall)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Framework assemblies: Screen (window drawer) and UI Automation (Project Browser reveal) -->
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
  </ItemGroup>

  <!-- Ribbon icons, embedded as RevoBIM.Resources.<Tool>.<file> -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.png" />
  </ItemGroup>

  <!-- Pro Sheets Exporter layouts: loose XAML loaded at runtime by PsUi.LoadXaml,
       exactly as the pyRevit tool did. Embedded as RevoBIM.UI.ProSheets.Layouts.<file>. -->
  <ItemGroup>
    <Page Remove="UI\ProSheets\Layouts\**" />
    <None Remove="UI\ProSheets\Layouts\**" />
    <EmbeddedResource Include="UI\ProSheets\Layouts\*.xaml" LogicalName="RevoBIM.UI.ProSheets.Layouts.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Per-user deploy: no admin rights needed. Copies the DLL and writes the .addin manifest. -->
  <Target Name="DeployAddin" AfterTargets="Build">
    <MakeDir Directories="$(DeployDir);$(AddinDir)" />
    <ItemGroup>
      <BuiltFiles Include="$(OutDir)RevoBIM.Revit2024.dll;$(OutDir)RevoBIM.Revit2024.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltFiles)" DestinationFolder="$(DeployDir)" ContinueOnError="true" />
    <WriteLinesToFile File="$(AddinDir)\RevoBIM.addin" Overwrite="true" Lines="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;;&lt;RevitAddIns&gt;;  &lt;AddIn Type=&quot;Application&quot;&gt;;    &lt;Name&gt;RevoBIM Tools&lt;/Name&gt;;    &lt;Assembly&gt;$(DeployDir)\RevoBIM.Revit2024.dll&lt;/Assembly&gt;;    &lt;AddInId&gt;4C8B2E71-5A93-4F0D-B6E2-9D1A7C3E8F54&lt;/AddInId&gt;;    &lt;FullClassName&gt;RevoBIM.App&lt;/FullClassName&gt;;    &lt;VendorId&gt;A2SV&lt;/VendorId&gt;;    &lt;VendorDescription&gt;A2 Services LTD&lt;/VendorDescription&gt;;  &lt;/AddIn&gt;;&lt;/RevitAddIns&gt;" />
  </Target>

</Project>

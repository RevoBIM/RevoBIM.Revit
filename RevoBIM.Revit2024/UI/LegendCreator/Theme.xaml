<!-- Legend Creator - the shared theme.

     Merged into every window's Window.Resources at compile time, so the
     windows share one copy of every brush and style, and keyed styles can
     be StaticResource. The brushes here are the dark palette's defaults;
     LgcTheme.ApplyPalette repaints them for the live theme by writing the
     window's own Resources, which sit in front of this merged dictionary. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <!-- RevoBIM house palette -->
    <SolidColorBrush x:Key="Base"   Color="#FF3C4454"/>
    <SolidColorBrush x:Key="Card"   Color="#FF353D4B"/>
    <SolidColorBrush x:Key="Field"  Color="#FF2D3441"/>
    <SolidColorBrush x:Key="Bar"    Color="#FF212932"/>
    <SolidColorBrush x:Key="Line"   Color="#FF4B5566"/>
    <SolidColorBrush x:Key="Edge"   Color="#FF586376"/>
    <SolidColorBrush x:Key="Ink"    Color="#FFF0F0F8"/>
    <SolidColorBrush x:Key="Muted"  Color="#FFAEB4BB"/>
    <SolidColorBrush x:Key="Blue"   Color="#FF4FA3E3"/>
    <SolidColorBrush x:Key="Orange" Color="#FFE8912D"/>
    <SolidColorBrush x:Key="Green"  Color="#FF3FA75A"/>
    <SolidColorBrush x:Key="Red"    Color="#FFD9534F"/>
    <SolidColorBrush x:Key="Sel"    Color="#FF2B5473"/>
    <SolidColorBrush x:Key="RowEvenBrush" Color="#FF353D4B"/>
    <SolidColorBrush x:Key="RowOddBrush" Color="#FF2D3441"/>
    <SolidColorBrush x:Key="RowHover" Color="#FF2B5473"/>
    <SolidColorBrush x:Key="PillBrush" Color="#FF4B5566"/>
    <SolidColorBrush x:Key="CtrlBorder" Color="#FF66728A"/>
    <SolidColorBrush x:Key="CtrlFill" Color="#FF465061"/>
    <SolidColorBrush x:Key="TickGlyph" Color="#FF1B1F24"/>
    <SolidColorBrush x:Key="Thumb" Color="#FF66728A"/>
    <SolidColorBrush x:Key="GreenHover" Color="#FF4EC06D"/>
    <SolidColorBrush x:Key="OnGreen" Color="#FF0E2214"/>
    <SolidColorBrush x:Key="BlueHover" Color="#FF8FBEFC"/>

    <!-- close button -->
    <!-- shrink to the taskbar: an arrow down onto a bar; while the window
         is parked the Tag trigger swaps it for the green up arrow -->
    <Style x:Key="ShrinkBtn" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="sb" CornerRadius="3"
                    Background="{TemplateBinding Background}">
              <Grid Width="12" Height="12" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Path x:Name="pthShrink"
                      Data="M 6,1 L 6,8 M 3,5 L 6,8 L 9,5 M 2,11 L 10,11"
                      Stroke="{DynamicResource Muted}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"/>
                <Path x:Name="pthExpand"
                      Data="M 6,11 L 6,2 M 2.5,5.5 L 6,2 L 9.5,5.5"
                      Stroke="{DynamicResource Green}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="sb" Property="Background"
                        Value="{DynamicResource Line}"/>
                <Setter TargetName="pthShrink" Property="Stroke"
                        Value="{DynamicResource Ink}"/>
              </Trigger>
              <Trigger Property="Tag" Value="shrunk">
                <Setter TargetName="pthShrink" Property="Visibility"
                        Value="Collapsed"/>
                <Setter TargetName="pthExpand" Property="Visibility"
                        Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="cb" CornerRadius="3"
                    Background="{TemplateBinding Background}">
              <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{DynamicResource Muted}"
                    x:Name="glyph" StrokeThickness="1.3"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="cb" Property="Background" Value="{DynamicResource Red}"/>
                <Setter TargetName="glyph" Property="Stroke" Value="{DynamicResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="pchrome" CornerRadius="9" Padding="9,2"
                    Background="{DynamicResource CtrlFill}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <!-- drawn from a Path, never a symbol font, so it cannot
                     render as an empty box on a machine without that font -->
                <Path Width="10" Height="10" Stretch="Uniform"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource Orange}"
                      Data="M 6,0 A 6,6 0 1 0 12,6 A 4.6,4.6 0 0 1 6,0 Z"/>
                <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="pchrome" Property="BorderBrush"
                        Value="{DynamicResource Blue}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Grip" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <!-- transparent, not empty: a null Background is not hit
                 testable and the grip would never fire -->
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- rows -->
    <Style x:Key="RowBase" TargetType="Border">
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Padding" Value="11,6,11,6"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource Sel}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowEven" TargetType="Border" BasedOn="{StaticResource RowBase}">
      <Setter Property="Background" Value="{DynamicResource RowEvenBrush}"/>
    </Style>
    <Style x:Key="RowOdd" TargetType="Border" BasedOn="{StaticResource RowBase}">
      <Setter Property="Background" Value="{DynamicResource RowOddBrush}"/>
    </Style>

    <Thickness x:Key="HairThickness" Left="1" Top="1" Right="1" Bottom="1"/>
    <Thickness x:Key="LabelMargin" Left="12" Top="0" Right="0" Bottom="0"/>

    <!-- tabs -->
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="tchrome" Background="Transparent"
                    BorderBrush="Transparent" BorderThickness="0,0,0,2"
                    Padding="16,9">
              <ContentPresenter ContentSource="Header"
                                HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="tchrome" Property="BorderBrush"
                        Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Background="{DynamicResource Bar}"
                      BorderBrush="{DynamicResource Line}"
                      BorderThickness="0,0,0,1">
                <TabPanel IsItemsHost="True" Margin="12,0,0,0"/>
              </Border>
              <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="9,2,9,2"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- section heading tick -->
    <Style x:Key="TickBlue" TargetType="Border">
      <Setter Property="Width" Value="4"/>
      <Setter Property="Height" Value="13"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Blue}"/>
    </Style>
    <Style x:Key="TickOrange" TargetType="Border" BasedOn="{StaticResource TickBlue}">
      <Setter Property="Background" Value="{DynamicResource Orange}"/>
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- tick box -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="15" Height="15" CornerRadius="2"
                      Background="{DynamicResource Field}" BorderBrush="{DynamicResource CtrlBorder}"
                      BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M 2.5,6.5 L 5.5,9.5 L 10.5,3.5"
                      Stroke="{DynamicResource TickGlyph}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource Blue}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- radio -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="ring" Width="14" Height="14" CornerRadius="7"
                      Background="{DynamicResource Field}" BorderBrush="{DynamicResource CtrlBorder}"
                      BorderThickness="1" VerticalAlignment="Center">
                <Ellipse x:Name="dot" Width="6" Height="6"
                         Fill="{DynamicResource TickGlyph}" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Background" Value="{DynamicResource Blue}"/>
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- buttons -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource PillBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chrome" CornerRadius="3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chrome" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="chrome" Property="Opacity" Value="0.62"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Padding" Value="9,5"/>
    </Style>

    <Style x:Key="Create" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{DynamicResource Green}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Green}"/>
      <Setter Property="Foreground" Value="{DynamicResource OnGreen}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource GreenHover}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource GreenHover}"/>
        </Trigger>
        <!-- greyed out while the footer says why nothing can be made -->
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.4"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- text fields -->
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Field}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6,9,6"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="fchrome" CornerRadius="3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"
                            VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="fchrome" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- search field, with a magnifier -->
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Padding" Value="0,6,9,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="schrome" CornerRadius="3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Path Margin="10,0,8,0" VerticalAlignment="Center"
                      Stroke="{DynamicResource Muted}" StrokeThickness="1.4"
                      Data="M 5,5 A 4,4 0 1 1 5,5.01 M 8.2,8.2 L 11.5,11.5"/>
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="schrome" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border CornerRadius="3" Background="{DynamicResource Thumb}" Margin="2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand"
                                Opacity="0" Focusable="False" IsTabStop="False"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand"
                                Opacity="0" Focusable="False" IsTabStop="False"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="10"/>
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="10"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ComboBox. WPF's stock one ignores Background and falls back to the
         system theme, so every part of it is retemplated. -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="tchrome" CornerRadius="3"
                    Background="{DynamicResource Field}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,10,0" Fill="{DynamicResource Muted}"
                    Data="M 0,0 L 8,0 L 4,5 Z"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tchrome" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="ichrome" Background="Transparent"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ichrome" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ichrome" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"/>
              <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True"
                     Placement="Bottom" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="Fade">
                <Border Background="{DynamicResource Card}"
                        BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                        CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="260">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{DynamicResource Card}" BorderThickness="1"
                    BorderBrush="{DynamicResource Edge}" CornerRadius="3"
                    Padding="9,6" MaxWidth="320">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Report" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Field}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border CornerRadius="4" BorderThickness="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="8,6"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

</ResourceDictionary>

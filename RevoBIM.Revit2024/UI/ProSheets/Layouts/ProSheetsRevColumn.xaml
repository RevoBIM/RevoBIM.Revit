<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Revision column"
        Width="560" Height="560" MinWidth="460" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SnapsToDevicePixels="True">

  <Grid>
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0"
                Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoHost" Grid.Column="0" Width="28" Height="28"
                    CornerRadius="4" Margin="0,0,11,0"
                    Background="{DynamicResource ChipBg}" Cursor="Hand">
              <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="17" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock x:Name="SubtitleText" Text="New revision column"
                         FontSize="13" Margin="0,-3,0,0"
                         Foreground="{DynamicResource OrangeBrush}"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" Grid.Column="2"
                       Style="{DynamicResource MutedText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" Text="v0.0.0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen"/>
              <Button x:Name="CloseButton"
                      Style="{DynamicResource CloseButton}"
                      Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,4">
            <TextBlock Text="Name" Style="{DynamicResource SectionLabel}"
                       Margin="0,0,0,5"/>
            <TextBox x:Name="ColumnNameBox" Margin="0,0,0,12" Height="30"/>

            <!-- Issued To / Method: Yes/No columns the Document Register's
                 Excel plots as its "Issued to:" rows. -->
            <TextBlock Text="Column" Style="{DynamicResource SectionLabel}"
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="ColumnGroupCombo" Margin="0,0,0,4" Height="28"/>
            <TextBlock x:Name="ColumnGroupNote" Style="{DynamicResource MutedText}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Custom: any type of data, kept with each revision. Issued To and Issued Method: Yes/No - tick where each issue went and how; the Document Register's Excel plots them as its Issued to rows."/>

            <TextBlock Text="Type of data" Style="{DynamicResource SectionLabel}"
                       Margin="0,0,0,5"/>
            <ComboBox x:Name="ColumnKindCombo" Margin="0,0,0,4" Height="28"/>
            <TextBlock x:Name="ColumnKindNote" Style="{DynamicResource MutedText}"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="The type is fixed once the column exists."/>

            <StackPanel x:Name="ChoicesPanel" Visibility="Collapsed">
              <TextBlock Text="Choices, one per line"
                         Style="{DynamicResource SectionLabel}"
                         Margin="0,0,0,5"/>
              <TextBox x:Name="ColumnChoicesBox" Margin="0,0,0,12"
                       Height="86" AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalContentAlignment="Top"
                       VerticalScrollBarVisibility="Auto"/>
            </StackPanel>

            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12,10">
              <StackPanel>
                <TextBlock Text="Push into a parameter"
                           Style="{DynamicResource SectionLabel}"
                           Margin="0,0,0,5"/>
                <TextBlock Style="{DynamicResource MutedText}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Revit takes no parameters on revisions, so the values are kept in the model by this tool. To show them on a title block or tag, push them into a project or shared parameter you have added to sheets or revision clouds. They are pushed on every Apply."/>
                <ComboBox x:Name="ColumnTargetCombo" Margin="0,0,0,8"
                          Height="28"/>
                <TextBlock Text="Parameter" Style="{DynamicResource FieldLabel}"
                           Margin="0,0,0,4"/>
                <ComboBox x:Name="ColumnParameterCombo" Margin="0,0,0,4"
                          Height="28" IsEditable="True"/>
                <TextBlock x:Name="ColumnParameterNote"
                           Style="{DynamicResource MutedText}"
                           TextWrapping="Wrap" Text=""/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="{DynamicResource BarBg}"
                CornerRadius="0,0,5,5" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RemoveColumnButton" Grid.Column="0" Width="130"
                    Visibility="Collapsed"
                    ToolTip="Remove this column and its values from the model on Apply">
              <StackPanel Orientation="Horizontal">
                <Path Width="11" Height="12" Stretch="Uniform"
                      Margin="0,0,8,0" VerticalAlignment="Center"
                      Fill="{DynamicResource RedBrush}"
                      Data="M 4,0 L 8,0 L 9,2 L 12,2 L 12,3.5 L 0,3.5 L 0,2 L 3,2 Z M 1.5,5 L 10.5,5 L 9.8,13 L 2.2,13 Z"/>
                <TextBlock Text="Remove column" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Grid.Column="1"
                       Style="{DynamicResource MutedText}" Margin="12,0"
                       VerticalAlignment="Center" TextWrapping="Wrap" Text=""/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
              <Button x:Name="CancelButton" Content="Cancel" Width="100"
                      Margin="0,0,9,0"/>
              <Button x:Name="OkButton" Content="Ok" Width="100"
                      Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==================== palette defaults (Revit dark) ==================== -->
  <!-- cm_theme writes the live palette onto window.Resources, which WPF       -->
  <!-- searches first; these are what shows for the instant before it lands.   -->
  <SolidColorBrush x:Key="TitleBg" Color="#222933"/>
  <SolidColorBrush x:Key="BodyBg" Color="#3C4454"/>
  <SolidColorBrush x:Key="FieldBg" Color="#2D3441"/>
  <SolidColorBrush x:Key="ToolbarBg" Color="#1B1F24"/>
  <SolidColorBrush x:Key="HeadingBg" Color="#323C48"/>
  <SolidColorBrush x:Key="CardBg" Color="#343C4A"/>
  <SolidColorBrush x:Key="HoverBg" Color="#444E5E"/>
  <SolidColorBrush x:Key="PressBg" Color="#323C48"/>
  <SolidColorBrush x:Key="SelBg" Color="#3A7392"/>
  <SolidColorBrush x:Key="RowHlBg" Color="#36485A"/>
  <SolidColorBrush x:Key="Edge" Color="#515C6B"/>
  <SolidColorBrush x:Key="FrameEdge" Color="#5A6372"/>
  <SolidColorBrush x:Key="Text" Color="#EEF0F4"/>
  <SolidColorBrush x:Key="Muted" Color="#A4AAB1"/>
  <SolidColorBrush x:Key="Hint" Color="#7B8290"/>
  <SolidColorBrush x:Key="Blue" Color="#5AAEEB"/>
  <SolidColorBrush x:Key="Orange" Color="#E8912D"/>
  <SolidColorBrush x:Key="Green" Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHover" Color="#4EC06D"/>
  <SolidColorBrush x:Key="Red" Color="#D9534F"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ButtonBg" Color="#46505F"/>
  <SolidColorBrush x:Key="ButtonHover" Color="#55606F"/>
  <SolidColorBrush x:Key="StagedBg" Color="#2F5E3B"/>
  <SolidColorBrush x:Key="StagedText" Color="#D8F5DF"/>
  <SolidColorBrush x:Key="BadBg" Color="#8E2A27"/>
  <SolidColorBrush x:Key="BadText" Color="#FFE3E1"/>
  <SolidColorBrush x:Key="CopyBg" Color="#6B5420"/>
  <SolidColorBrush x:Key="ReadOnlyBg" Color="#4A3E45"/>

  <!-- ==================== buttons ==================== -->
  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource ButtonHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource PressBg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>

  <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Green}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource GreenHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Orange}"/>
  </Style>

  <!-- header chip (theme toggle) - the same shape on every RevoBIM tool -->
  <Style x:Key="ChipBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Background" Value="{DynamicResource HeadingBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- window controls: shrink, full screen -->
  <Style x:Key="ChromeBtn" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            </Trigger>
            <Trigger Property="Tag" Value="shrunk">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HeadingBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Red}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== text, ticks, tips ==================== -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Blue}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="4,2"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
            <Grid>
              <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Hint}"
                         Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                         FontStyle="Italic" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="3" BorderThickness="1"
                    BorderBrush="{DynamicResource Edge}" Background="{DynamicResource FieldBg}" VerticalAlignment="Center">
              <Path x:Name="tick" Data="M 3,7.5 L 6,10.5 L 11.5,4" Stroke="{DynamicResource OnAccent}" StrokeThickness="2"
                    Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="Background" Value="{DynamicResource Blue}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <!-- ==================== scrollbars ==================== -->
  <Style x:Key="ThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border CornerRadius="4" Background="{DynamicResource ButtonHover}" Margin="2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="MinWidth" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{DynamicResource BodyBg}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ThumbStyle}"/>
              </Track.Thumb>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="MinHeight" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Border Background="{DynamicResource BodyBg}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ThumbStyle}"/>
                  </Track.Thumb>
                </Track>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== menus ==================== -->
  <Style TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="3">
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="8,5">
            <DockPanel>
              <Path x:Name="chk" DockPanel.Dock="Left" Width="16" Data="M 2,7 L 5,10 L 11,3"
                    Stroke="{DynamicResource Blue}" StrokeThickness="2" Visibility="Hidden" VerticalAlignment="Center"/>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center" Margin="4,0,12,0"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource Hint}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== lists ==================== -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="6,3">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== the circuit table ==================== -->
  <Style x:Key="CmGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="RowBackground" Value="{DynamicResource FieldBg}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="GridLinesVisibility" Value="All"/>
    <Setter Property="RowHeight" Value="24"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="CmHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource HeadingBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Edge}"
                    BorderThickness="0,0,1,1" Padding="5,4">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CmRowHeader" TargetType="DataGridRowHeader">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRowHeader">
          <Border x:Name="bd" Background="{DynamicResource HeadingBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,1,1"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Blue}"/>
            </Trigger>
            <Trigger Property="IsRowSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- whole row lit while any of its cells is selected ([hl] = '1') -->
  <Style x:Key="CmRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding hl}" Value="1">
        <Setter Property="Background" Value="{DynamicResource RowHlBg}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CmCell" TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="4,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelBg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ==================== the text box a cell edits in ==================== -->
  <Style x:Key="CmEditBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Blue}"/>
    <Setter Property="Padding" Value="1,0"/>
    <Setter Property="Margin" Value="-4,0"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>

  <!-- ==================== resize grips (borderless window) ==================== -->
  <Style x:Key="Grip" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

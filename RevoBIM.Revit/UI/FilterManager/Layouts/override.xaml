<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Override graphics"
        Width="700" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource EdgeWindow}" BorderThickness="1"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- RevoBIM theme -->
        <!-- palette: swapped at run time, so DynamicResource only -->
        <SolidColorBrush x:Key="ChangedBg" Color="#FF4A3A20"/>
        <SolidColorBrush x:Key="ChangedEdge" Color="#FFE8862D"/>
        <SolidColorBrush x:Key="ArrowBg" Color="#FF1B1F24"/>
        <SolidColorBrush x:Key="ArrowHover" Color="#FF12151A"/>
        <SolidColorBrush x:Key="ArrowPress" Color="#FF2D3441"/>
        <SolidColorBrush x:Key="Blue" Color="#FF3D9BE9"/>
        <SolidColorBrush x:Key="BoxEdge" Color="#FF6A7384"/>
        <SolidColorBrush x:Key="Btn" Color="#FF2D3441"/>
        <SolidColorBrush x:Key="BtnHover" Color="#FF39424F"/>
        <SolidColorBrush x:Key="BtnPress" Color="#FF222931"/>
        <SolidColorBrush x:Key="CloseHover" Color="#FFC0392B"/>
        <SolidColorBrush x:Key="Dim" Color="#FFACB4C2"/>
        <SolidColorBrush x:Key="Disabled" Color="#FF6E7584"/>
        <SolidColorBrush x:Key="Edge" Color="#FF4A5364"/>
        <SolidColorBrush x:Key="EdgeFaint" Color="#FF3A4352"/>
        <SolidColorBrush x:Key="EdgeHover" Color="#FF7B8290"/>
        <SolidColorBrush x:Key="EdgeSoft" Color="#FF434C5B"/>
        <SolidColorBrush x:Key="EdgeStrong" Color="#FF5A6372"/>
        <SolidColorBrush x:Key="EdgeWindow" Color="#FF1B1F24"/>
        <SolidColorBrush x:Key="Field" Color="#FF2D3441"/>
        <SolidColorBrush x:Key="FieldDeep" Color="#FF262C37"/>
        <SolidColorBrush x:Key="Glyph" Color="#FFACB2B9"/>
        <SolidColorBrush x:Key="GlyphHover" Color="#FF2D3441"/>
        <SolidColorBrush x:Key="Green" Color="#FF3FA75A"/>
        <SolidColorBrush x:Key="GreenEdge" Color="#FF2E8546"/>
        <SolidColorBrush x:Key="GreenHover" Color="#FF4EC06D"/>
        <SolidColorBrush x:Key="Head" Color="#FF222931"/>
        <SolidColorBrush x:Key="HeaderRow" Color="#FF323C48"/>
        <SolidColorBrush x:Key="Hover" Color="#FF39414F"/>
        <SolidColorBrush x:Key="Label" Color="#FFBAC0C8"/>
        <SolidColorBrush x:Key="OnAccent" Color="#FFF2F2F2"/>
        <SolidColorBrush x:Key="OnOrange" Color="#FF1B1F24"/>
        <SolidColorBrush x:Key="Orange" Color="#FFE8862D"/>
        <SolidColorBrush x:Key="OrangeEdge" Color="#FFC96F1E"/>
        <SolidColorBrush x:Key="OrangeHover" Color="#FFF39A45"/>
        <SolidColorBrush x:Key="Panel" Color="#FF3C4454"/>
        <SolidColorBrush x:Key="PanelAlt" Color="#FF363E4C"/>
        <SolidColorBrush x:Key="Red" Color="#FFF07A75"/>
        <SolidColorBrush x:Key="RedDeep" Color="#FFB03A36"/>
        <SolidColorBrush x:Key="RedEdge" Color="#FF8E2C29"/>
        <SolidColorBrush x:Key="Sel" Color="#FF4B5669"/>
        <SolidColorBrush x:Key="TabActiveTxt" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TabIdle" Color="#FFACB2B9"/>
        <SolidColorBrush x:Key="Thumb" Color="#FF5A6372"/>
        <SolidColorBrush x:Key="ThumbHover" Color="#FF7B8290"/>
        <SolidColorBrush x:Key="Txt" Color="#FFE6EEF7"/>
        <SolidColorBrush x:Key="WindowBg" Color="#FF323A47"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- scroll bars -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="tb" Background="{DynamicResource Thumb}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="{DynamicResource ThumbHover}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="tb" Property="Background" Value="{DynamicResource Orange}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="Width" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource EdgeFaint}" BorderThickness="1,0,0,0">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource EdgeFaint}" BorderThickness="0,1,0,0">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkScroll" TargetType="ScrollViewer">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                                       Orientation="Vertical"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                                       Orientation="Horizontal"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                            <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Field}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- text box -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Txt}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Blue}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <!-- the padding belongs on the border, the way WPF's
                             own template does it. Putting it on the content
                             host as a margin takes the space twice and the
                             text loses its top and bottom. -->
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <TextBlock x:Name="hint"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontStyle="Italic"
                                           Foreground="{DynamicResource Dim}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Background="Transparent"
                                              VerticalAlignment="Center"
                                              VerticalScrollBarVisibility="Hidden"
                                              HorizontalScrollBarVisibility="Hidden"
                                              Focusable="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}"
                                         Value="">
                                <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- lists -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer Style="{StaticResource DarkScroll}" Focusable="False" Padding="0">
                                <ItemsPresenter SnapsToDevicePixels="True"/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Sel}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- check box -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="6,3,6,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="14" Height="14" Margin="0,0,7,0"
                                    VerticalAlignment="Center" CornerRadius="2"
                                    Background="{DynamicResource FieldDeep}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1">
                                <Path x:Name="tick" Margin="1" Stretch="Uniform"
                                      Stroke="{DynamicResource Orange}" StrokeThickness="2"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Data="M 0,5 L 4,9 L 11,1" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Orange}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- combo box -->
        <Style x:Key="ComboToggle" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="ClickMode" Value="Press"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Edge}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M 0,0 L 9,0 L 4.5,5.5 Z" Fill="{DynamicResource Label}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Orange}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{DynamicResource Txt}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Sel}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
            <Setter Property="Background" Value="{DynamicResource Field}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Style="{StaticResource ComboToggle}"
                                          Background="{TemplateBinding Background}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{DynamicResource Txt}"
                                              Margin="8,0,24,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource EdgeStrong}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                                    <ScrollViewer Style="{StaticResource DarkScroll}">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ContentSite" Property="TextElement.Foreground"
                                        Value="{DynamicResource Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- buttons -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Btn}"/>
            <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Orange}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource BtnPress}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Dim}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderThickness="0">
                            <TextBlock Text="X" FontSize="12" FontWeight="Bold"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource CloseHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="{DynamicResource Orange}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnOrange}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource OrangeEdge}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource OrangeHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource OrangeEdge}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource EdgeFaint}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Edge}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- tab strip buttons -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource WindowBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TabIdle}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Edge}" BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="tick" Height="3" VerticalAlignment="Top"
                                        Background="Transparent"
                                        Margin="-18,-7,-18,0"/>
                                <ContentPresenter x:Name="cp"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Panel}"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground"
                                        Value="{DynamicResource Txt}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Panel}"/>
                                <Setter TargetName="tick" Property="Background" Value="{DynamicResource Orange}"/>
                                <Setter TargetName="cp" Property="TextElement.Foreground"
                                        Value="{DynamicResource TabActiveTxt}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabBtn" TargetType="Button" BasedOn="{StaticResource TabBtn}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Background" Value="{DynamicResource PanelAlt}"/>
        </Style>

        <Style x:Key="Create" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Background" Value="{DynamicResource Green}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GreenEdge}"/>
            <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource EdgeFaint}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Edge}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Create}">
            <Setter Property="Background" Value="{DynamicResource RedDeep}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RedEdge}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Red}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource EdgeFaint}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Edge}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Disabled}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowKill" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="{DynamicResource Red}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="ArrowBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ArrowBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource EdgeSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ArrowHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EdgeHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ArrowPress}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlyphBtn" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource GlyphHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- context menu -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Field}"
                                BorderBrush="{DynamicResource EdgeStrong}"
                                BorderThickness="1" Padding="2">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bd" Background="Transparent" Padding="14,6">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{DynamicResource Txt}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource Sel}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,3"
                                Background="{DynamicResource EdgeFaint}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>







        <Style x:Key="VThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="bd" Background="Transparent">
                            <Border Width="2" Background="{DynamicResource EdgeSoft}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Stretch" Margin="0,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource Orange}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VSplit" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border x:Name="bd" Background="Transparent">
                            <Border Width="2" Background="{DynamicResource EdgeSoft}"
                                    HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                    Margin="0,4"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Blue}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Orange}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- end theme -->

    </Window.Resources>

    <Grid Background="{DynamicResource WindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="pnlHeader" Grid.Row="0" Background="{DynamicResource Head}"
                BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="on_drag">
            <Grid Margin="12,8,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Blue}"/>
                    <TextBlock x:Name="txtTitle" Text="  Override" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource Orange}"
                               Margin="0,3,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="txtVersion" Text="v3.25.0"
                           Foreground="{DynamicResource Dim}" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnShrink" Style="{StaticResource GlyphBtn}"
                        Width="28" Height="24" Margin="0,0,2,0" Click="on_shrink"
                        ToolTip="Shrink to the taskbar - slide the window down to its title bar so the model can be seen">
                    <Grid Width="12" Height="13">
                        <Path x:Name="pthShrink" Stretch="Uniform" Fill="{DynamicResource Glyph}"
                              Data="M 3,0 L 9,0 L 9,5 L 12,5 L 6,10 L 0,5 L 3,5 Z M 0,12 L 12,12 L 12,14 L 0,14 Z"/>
                        <Path x:Name="pthExpand" Stretch="Uniform" Fill="{DynamicResource Green}"
                              Visibility="Collapsed"
                              Data="M 6,0 L 13,7 L 9,7 L 9,14 L 3,14 L 3,7 L -1,7 Z"/>
                    </Grid>
                </Button>
                <Button Style="{StaticResource CloseBtn}" Width="28" Height="24"
                        Click="on_cancel"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="16,14,16,10">

            <TextBlock x:Name="txtSubject" Text="" Foreground="{DynamicResource Dim}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock x:Name="txtScope" Text="" Foreground="{DynamicResource Orange}"
                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <!-- LINES -->
            <StackPanel x:Name="pnlLines">
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Colour" VerticalAlignment="Center"
                               Foreground="{DynamicResource Label}"/>
                    <Button Grid.Column="1" x:Name="btnLineColour" Height="30"
                            Style="{StaticResource Ghost}" HorizontalAlignment="Stretch"
                            Click="on_pick_line_colour"/>
                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Line weight" VerticalAlignment="Center"
                               Foreground="{DynamicResource Label}"/>
                    <ComboBox Grid.Column="1" x:Name="cboWeight" Height="30"/>
                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search patterns" VerticalAlignment="Center"
                               Foreground="{DynamicResource Label}"/>
                    <TextBox Grid.Column="1" x:Name="txtLinePatSearch" Height="34"
                             Tag="type to narrow the list"
                             TextChanged="on_line_pattern_search"/>
                </Grid>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Line pattern" VerticalAlignment="Center"
                               Foreground="{DynamicResource Label}"/>
                    <ComboBox Grid.Column="1" x:Name="cboLinePattern" Height="30"
                              SelectionChanged="on_line_pattern_changed"/>
                    <Border Grid.Column="2" x:Name="pnlLinePreview" Margin="8,0,0,0"
                            BorderBrush="{DynamicResource EdgeStrong}" BorderThickness="1"
                            VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- PATTERNS -->
            <StackPanel x:Name="pnlPatterns" Visibility="Collapsed">
                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Search patterns" VerticalAlignment="Center"
                               Foreground="{DynamicResource Label}"/>
                    <TextBox Grid.Column="1" x:Name="txtFillPatSearch" Height="34"
                             Tag="type to narrow both lists"
                             TextChanged="on_fill_pattern_search"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                    <Border Width="4" Height="15" Background="{DynamicResource Blue}"
                            Margin="0,0,7,0"/>
                    <TextBlock Text="FOREGROUND" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource Txt}"/>
                </StackPanel>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern"
                               VerticalAlignment="Center" Foreground="{DynamicResource Label}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboFgPattern" Height="30"
                              SelectionChanged="on_fg_pattern_changed"/>
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" x:Name="pnlFgPreview"
                            Margin="8,0,0,0" BorderBrush="{DynamicResource EdgeStrong}" BorderThickness="1"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Colour"
                               VerticalAlignment="Center" Foreground="{DynamicResource Label}"
                               Margin="0,7,0,0"/>
                    <Button Grid.Row="1" Grid.Column="1" x:Name="btnFgColour" Height="30"
                            Style="{StaticResource Ghost}" HorizontalAlignment="Stretch"
                            Margin="0,7,0,0" Click="on_pick_fg_colour"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                    <Border Width="4" Height="15" Background="{DynamicResource Orange}"
                            Margin="0,0,7,0"/>
                    <TextBlock Text="BACKGROUND" FontWeight="Bold" FontSize="11"
                               Foreground="{DynamicResource Txt}"/>
                </StackPanel>

                <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Pattern"
                               VerticalAlignment="Center" Foreground="{DynamicResource Label}"/>
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cboBgPattern" Height="30"
                              SelectionChanged="on_bg_pattern_changed"/>
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" x:Name="pnlBgPreview"
                            Margin="8,0,0,0" BorderBrush="{DynamicResource EdgeStrong}" BorderThickness="1"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Colour"
                               VerticalAlignment="Center" Foreground="{DynamicResource Label}"
                               Margin="0,7,0,0"/>
                    <Button Grid.Row="1" Grid.Column="1" x:Name="btnBgColour" Height="30"
                            Style="{StaticResource Ghost}" HorizontalAlignment="Stretch"
                            Margin="0,7,0,0" Click="on_pick_bg_colour"/>
                </Grid>
            </StackPanel>

            <TextBlock Text="Blank or &lt;no override&gt; leaves that property to the target template."
                       Foreground="{DynamicResource Dim}" FontSize="10" TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Head}"
                BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Clear overrides"
                        Style="{StaticResource Ghost}" Height="32" FontSize="12"
                        Padding="14,4" VerticalAlignment="Center" Click="on_clear"/>
                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource Ghost}"
                        Height="32" Width="84" FontSize="12" VerticalAlignment="Center"
                        Click="on_cancel"/>
                <Button Grid.Column="3" Content="OK" Style="{StaticResource Primary}"
                        Height="32" Width="96" VerticalAlignment="Center" Click="on_ok"/>
            </Grid>
        </Border>
    </Grid>
</Window>

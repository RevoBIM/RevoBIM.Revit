<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Subfolder parameters"
        Width="720" Height="640" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SnapsToDevicePixels="True">

  <Grid>
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0"
                Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoHost" Grid.Column="0"
                    Width="28" Height="28" CornerRadius="4"
                    Margin="0,0,11,0"
                    Background="{DynamicResource ChipBg}">
              <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="17" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Subfolder parameters" FontSize="13"
                         Margin="0,-3,0,0"
                         Foreground="{DynamicResource OrangeBrush}"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" Grid.Column="2"
                       Style="{DynamicResource MutedText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" Text="v0.0.0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen"/>
              <Button x:Name="CloseButton"
                      Style="{DynamicResource CloseButton}"
                      Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14,14,14,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="TokenGroupCombo" Grid.Column="0" Width="170"
                    Margin="0,0,8,0"/>
          <TextBox x:Name="TokenSearchBox" Grid.Column="1"
                   Tag="Search sheet and project parameters"/>
        </Grid>

        <Border Grid.Row="2" Margin="14,10,14,0"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="1" CornerRadius="4">
          <DataGrid x:Name="TokenGrid" Margin="1" IsReadOnly="True"
                    SelectionMode="Extended"
                    BorderThickness="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Parameter" Binding="{Binding pname}"
                                  Width="2*" MinWidth="180"/>
              <DataGridTextColumn Header="Group" Binding="{Binding pgroup}"
                                  Width="1*" MinWidth="110"/>
              <DataGridTextColumn Header="On this sheet"
                                  Binding="{Binding sample}"
                                  Width="1.4*" MinWidth="130"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>

        <Border Grid.Row="3" Margin="14,12,14,0" Padding="12,10"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Subfolders"
                         Style="{DynamicResource FieldLabel}"
                         Margin="0,0,10,0"/>
              <TextBox x:Name="TokenStringBox" Grid.Column="1"
                       Tag="Nothing yet"/>
            </Grid>
            <Grid Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Becomes"
                         Style="{DynamicResource FieldLabel}"
                         Margin="0,0,10,0"/>
              <TextBlock x:Name="TokenPreview" Grid.Column="1"
                         FontFamily="Consolas" FontSize="12.5"
                         Foreground="{DynamicResource BlueBrush}"
                         TextTrimming="CharacterEllipsis" Text=""/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="AddLevelButton" Content="Add as a folder level"
                      Style="{DynamicResource AccentButton}"
                      Margin="0,0,8,0"/>
              <Button x:Name="AppendButton" Content="Add to this level"
                      Style="{DynamicResource ChipButton}" Margin="0,0,8,0"/>
              <Button x:Name="ClearTokensButton" Content="Clear"
                      Style="{DynamicResource ChipButton}"/>
              <TextBlock x:Name="TokenHint" Style="{DynamicResource MutedText}"
                         VerticalAlignment="Center" Margin="14,0,0,0"
                         TextTrimming="CharacterEllipsis"
                         Text="Double click a row to add it as a folder level."/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="4" Margin="0,14,0,0"
                Background="{DynamicResource BarBg}"
                CornerRadius="0,0,5,5" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{DynamicResource MutedText}"
                       VerticalAlignment="Center" Text=""/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CancelButton" Content="Cancel" Width="100"
                      Margin="0,0,9,0"/>
              <Button x:Name="OkButton" Content="Ok" Width="100"
                      Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="GripLayer">
      <Grid.RowDefinitions>
        <RowDefinition Height="5"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="5"/>
      </Grid.ColumnDefinitions>
      <Thumb x:Name="GripNW" Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripN"  Grid.Row="0" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripNE" Grid.Row="0" Grid.Column="2" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripW"  Grid.Row="1" Grid.Column="0" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripE"  Grid.Row="1" Grid.Column="2" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSW" Grid.Row="2" Grid.Column="0" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripS"  Grid.Row="2" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSE" Grid.Row="2" Grid.Column="2" Cursor="SizeNWSE"
             Style="{DynamicResource GripThumb}"/>
    </Grid>
  </Grid>
</Window>

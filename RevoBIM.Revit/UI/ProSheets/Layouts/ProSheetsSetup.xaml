<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Set up this machine"
        Width="720" Height="720" MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SnapsToDevicePixels="True">

  <Grid>
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0"
                Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoHost" Grid.Column="0" Width="28" Height="28"
                    CornerRadius="4" Margin="0,0,11,0"
                    Background="{DynamicResource ChipBg}">
              <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="17" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock x:Name="SubtitleText" Text="Set up this machine"
                         FontSize="13" Margin="0,-3,0,0"
                         Foreground="{DynamicResource OrangeBrush}"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" Grid.Column="2"
                       Style="{DynamicResource MutedText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" Text="v0.0.0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen"/>
              <Button x:Name="CloseButton"
                      Style="{DynamicResource CloseButton}"
                      Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="14,14,14,4">

            <TextBlock x:Name="IntroText" TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Style="{DynamicResource MutedText}"
                       Text="Settings kept on this computer, not in the model. This only appears the first time; Set up is in the header afterwards."/>

            <!-- how PDFs get written -->
            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14"
                    Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Width="4" Height="14"
                          Background="{DynamicResource OrangeBrush}"
                          Margin="0,0,7,0"/>
                  <TextBlock Text="How PDFs get written"
                             Style="{DynamicResource SectionLabel}"/>
                </StackPanel>

                <RadioButton x:Name="NativeRadio" Margin="0,0,0,4"
                             Content="Revit's own PDF exporter"/>
                <TextBlock x:Name="NativeNote" Margin="20,0,0,10"
                           TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}"
                           Text="Nothing to set up. Writes the exact file name asked for, keeps each sheet at its own size, and is the faster of the two."/>

                <RadioButton x:Name="DriverRadio" Margin="0,0,0,6"
                             Content="A print driver"/>
                <CheckBox x:Name="SetupPreferNative" Margin="20,0,0,8"
                          Content="Ignore what a template asks for and always use Revit's own exporter"
                          ToolTip="On by default. A template remembers the printer it was saved with, and a shared template would otherwise put everybody on that driver."/>
                <TextBlock x:Name="DriverNote" Margin="20,0,0,8"
                           TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}"
                           Text="Only needed where the house PDF settings - compression, fonts, stamps - live in the driver rather than in Revit."/>

                <ComboBox x:Name="SetupPrinterCombo" Margin="20,0,0,8"/>

                <TextBlock Text="Driver saves to"
                           Margin="20,0,0,2"
                           Style="{DynamicResource FieldLabel}"/>
                <TextBlock Margin="20,0,0,6" TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}"
                           Text="The folder the DRIVER already saves into - not where you want the PDFs. This box tells the tool where to look; it cannot tell the driver where to put things. Getting these the wrong way round is the single most common reason nothing is written."/>
                <Border Margin="20,0,0,7" Padding="10,8" CornerRadius="3"
                        Background="{DynamicResource FieldBg}"
                        BorderBrush="{DynamicResource EdgeBrush}"
                        BorderThickness="1">
                  <StackPanel>
                    <TextBlock Style="{DynamicResource FieldLabel}"
                               Margin="0,0,0,4"
                               Text="How to find it, in order"/>
                    <TextBlock Style="{DynamicResource MutedText}"
                               TextWrapping="Wrap"
                               Text="1.  In the driver's own settings, turn ON automatic saving and give it an output folder of its own - C:\PDF24_Staging, not Documents and not your export folder."/>
                    <TextBlock Style="{DynamicResource MutedText}"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="2.  Print anything at all to that printer once - a Notepad page will do - so it writes a file."/>
                    <TextBlock Style="{DynamicResource MutedText}"
                               TextWrapping="Wrap" Margin="0,3,0,0"
                               Text="3.  Press Find it below. It looks for PDFs written in the last few minutes and fills the box in for you. Browse only if you already know the folder."/>
                  </StackPanel>
                </Border>
                <Grid Margin="20,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="SetupStagingBox" Grid.Column="0"/>
                  <Button x:Name="SetupStagingFind" Grid.Column="1"
                          Content="Find it" Width="76" Margin="7,0,0,0"
                          ToolTip="Look for PDFs this machine has written in the last few minutes, and use the folder they went to"/>
                  <Button x:Name="SetupStagingBrowse" Grid.Column="2"
                          Content="Browse" Width="76" Margin="6,0,0,0"/>
                </Grid>
                <TextBlock x:Name="SetupStagingNote" Margin="20,0,0,0"
                           TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}" Text=""/>
              </StackPanel>
            </Border>

            <!-- where exports land -->
            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14"
                    Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Width="4" Height="14"
                          Background="{DynamicResource BlueBrush}"
                          Margin="0,0,7,0"/>
                  <TextBlock Text="Where exports land"
                             Style="{DynamicResource SectionLabel}"/>
                </StackPanel>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="SetupRootBox" Grid.Column="0"/>
                  <Button x:Name="SetupRootBrowse" Grid.Column="1"
                          Content="Browse" Width="86" Margin="7,0,0,0"/>
                </Grid>
                <TextBlock Style="{DynamicResource MutedText}"
                           TextWrapping="Wrap"
                           Text="The starting folder for a new template. Every template can point somewhere else."/>
              </StackPanel>
            </Border>

            <!-- the two parameters this office sorts and files by -->
            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14"
                    Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Width="4" Height="14"
                          Background="{DynamicResource OrangeBrush}"
                          Margin="0,0,7,0"/>
                  <TextBlock Text="Sheet series and discipline"
                             Style="{DynamicResource SectionLabel}"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource MutedText}"
                           TextWrapping="Wrap" Margin="0,0,0,9"
                           Text="Which parameters this project uses for them. The Selection list shows both as columns and sorts by the series; the series is also the last folder level exports land in. Picked up automatically where the usual names are in the model."/>
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Sheet series" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <ComboBox x:Name="SetupSeriesCombo" Grid.Column="1"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Discipline" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <ComboBox x:Name="SetupDisciplineCombo" Grid.Column="1"/>
                </Grid>
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Sheet status" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <ComboBox x:Name="SetupStatusCombo" Grid.Column="1"
                            ToolTip="Fills each revision's Issue Status in the Revision Manager - the most common value among the sheets carrying it - and so the Issue Status row of the register's Excel file."/>
                </Grid>
                <TextBlock x:Name="SetupParamNote" TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}" Text=""/>
              </StackPanel>
            </Border>

            <!-- the Document Register's Excel form -->
            <Border x:Name="RegisterSection"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14"
                    Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Width="4" Height="14"
                          Background="{DynamicResource BlueBrush}"
                          Margin="0,0,7,0"/>
                  <TextBlock Text="Document Register"
                             Style="{DynamicResource SectionLabel}"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource MutedText}"
                           TextWrapping="Wrap" Margin="0,0,0,9"
                           Text="How the register's Excel file looks: the TIDP issue sheet, one worksheet per discipline. The tabs and the blank rows between series come from the parameters above."/>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Title" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <TextBox x:Name="SetupRegTitle" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Company logo" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <TextBox x:Name="SetupRegLogoBox" Grid.Column="1"
                           IsReadOnly="True"/>
                  <Button x:Name="SetupRegLogoBrowse" Grid.Column="2"
                          Content="Browse" Width="76" Margin="7,0,0,0"/>
                  <Button x:Name="SetupRegLogoClear" Grid.Column="3"
                          Content="Clear" Width="64" Margin="6,0,0,0"/>
                </Grid>
                <Border Margin="110,0,0,8" Padding="6" CornerRadius="3"
                        HorizontalAlignment="Left" MinWidth="120" Height="64"
                        Background="{DynamicResource FieldBg}"
                        BorderBrush="{DynamicResource EdgeBrush}"
                        BorderThickness="1">
                  <Grid>
                    <Image x:Name="SetupRegLogoPreview" Stretch="Uniform"
                           MaxWidth="220"/>
                    <TextBlock x:Name="SetupRegLogoNote"
                               Style="{DynamicResource MutedText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Text="No logo"/>
                  </Grid>
                </Border>
                <TextBlock Margin="110,0,0,10" TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}"
                           Text="PNG or JPG. Copied into this computer's RevoBIM folder when chosen, so the register keeps it if the original moves. It sits in the title band straight after the title, scaled to fit."/>

                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Client logo" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <TextBox x:Name="SetupRegClientLogoBox" Grid.Column="1"
                           IsReadOnly="True"/>
                  <Button x:Name="SetupRegClientLogoBrowse" Grid.Column="2"
                          Content="Browse" Width="76" Margin="7,0,0,0"/>
                  <Button x:Name="SetupRegClientLogoClear" Grid.Column="3"
                          Content="Clear" Width="64" Margin="6,0,0,0"/>
                </Grid>
                <Border Margin="110,0,0,8" Padding="6" CornerRadius="3"
                        HorizontalAlignment="Left" MinWidth="120" Height="64"
                        Background="{DynamicResource FieldBg}"
                        BorderBrush="{DynamicResource EdgeBrush}"
                        BorderThickness="1">
                  <Grid>
                    <Image x:Name="SetupRegClientLogoPreview"
                           Stretch="Uniform" MaxWidth="220"/>
                    <TextBlock x:Name="SetupRegClientLogoNote"
                               Style="{DynamicResource MutedText}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Text="No logo"/>
                  </Grid>
                </Border>
                <TextBlock Margin="110,0,0,10" TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}"
                           Text="Per machine, like the company logo. It sits in the title band to the right of the company logo, the same size."/>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Current revision" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <TextBox x:Name="SetupRegSnapshot" Grid.Column="1"
                           ToolTip="The heading of the orange column before the issues, which carries every drawing's current revision. Blank leaves the column off."/>
                </Grid>

                <!-- Where the Scale column comes from. -->
                <Grid Margin="0,0,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Scale" Width="110"
                             VerticalAlignment="Top" Margin="0,4,0,0"
                             Style="{DynamicResource FieldLabel}"/>
                  <StackPanel Grid.Column="1">
                    <RadioButton x:Name="SetupScaleParamRadio" GroupName="RegScale"
                                 Margin="0,2,0,4"
                                 Content="From a parameter - the text on the sheet, or on its title block"/>
                    <ComboBox x:Name="SetupScaleCombo" Margin="20,0,0,6"/>
                    <RadioButton x:Name="SetupScaleRevitRadio" GroupName="RegScale"
                                 Margin="0,0,0,2"
                                 Content="Revit's own - the scales of the views placed on the sheet"/>
                  </StackPanel>
                </Grid>
                <TextBlock Margin="110,0,0,10" TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}"
                           Text="A sheet with nothing in the parameter falls back to Revit's own scale, so the column is never left blank by a title block that has not been filled in."/>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Status legend" Width="110"
                             VerticalAlignment="Top" Margin="0,4,0,0"
                             Style="{DynamicResource FieldLabel}"/>
                  <TextBox x:Name="SetupRegLegend" Grid.Column="1"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalContentAlignment="Top" Height="96"
                           VerticalScrollBarVisibility="Auto"
                           ToolTip="One per line, e.g. P = Preliminary"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Issued to" Width="110"
                             VerticalAlignment="Top"
                             Style="{DynamicResource FieldLabel}"/>
                  <TextBlock Grid.Column="1" TextWrapping="Wrap"
                             Style="{DynamicResource MutedText}"
                             Text="From the Revision Manager: its Issued To and Issued Method columns are the Issued to rows, an x wherever a revision is ticked. A column nothing on a worksheet is ticked in is left off it."/>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Footer" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <TextBox x:Name="SetupRegFooter" Grid.Column="1"
                           Tag="Blank: says which model it came from, and when"/>
                </Grid>

                <Grid Margin="0,0,0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="Paper" Width="110"
                             Style="{DynamicResource FieldLabel}"/>
                  <ComboBox x:Name="SetupRegPaper" Grid.Column="1"
                            MinWidth="120"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- the Revision Manager -->
            <Border x:Name="RevisionSection"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14"
                    Margin="0,0,0,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Width="4" Height="14"
                          Background="{DynamicResource BlueBrush}"
                          Margin="0,0,7,0"/>
                  <TextBlock Text="Revision Manager"
                             Style="{DynamicResource SectionLabel}"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource MutedText}"
                           TextWrapping="Wrap" Margin="0,0,0,9"
                           Text="The Sheet series column uses the series parameter above. Columns of your own, and the parameters they push into, belong to each model: set them with the Settings button at the top right of the Revision Manager."/>
                <CheckBox x:Name="SetupRevReopen" Margin="0,0,0,2"
                          Content="Keep the Revision Manager open after Apply (its own ribbon button)"
                          ToolTip="From its own ribbon button the manager is modeless - Revit stays usable while it is open. Apply writes the changes and the window stays, refreshed from the model. Untick to close it after Apply instead."/>
              </StackPanel>
            </Border>

            <!-- what this machine has -->
            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Width="4" Height="14"
                          Background="{DynamicResource GreenBrush}"
                          Margin="0,0,7,0"/>
                  <TextBlock Text="What this machine has"
                             Style="{DynamicResource SectionLabel}"/>
                </StackPanel>
                <TextBlock x:Name="FoundText" TextWrapping="Wrap"
                           Style="{DynamicResource MutedText}" Text=""/>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,10,0,0"
                Background="{DynamicResource BarBg}"
                CornerRadius="0,0,5,5" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{DynamicResource MutedText}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text=""/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="TestButton" Content="Test it" Width="100"
                      Margin="0,0,9,0"/>
              <Button x:Name="SkipButton" Content="Later" Width="90"
                      Margin="0,0,9,0"/>
              <Button x:Name="OkButton" Content="Save" Width="100"
                      Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Pro Sheets Exporter"
        Width="1240" Height="820" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="True" SnapsToDevicePixels="True">

  <!-- ==========================================================
       Every resource reference in this file is a DynamicResource.
       Theme.xaml is merged in AFTER XamlReader has parsed this
       layout, so a StaticResource would fail at load and show up
       as a blank white pyRevit window.
       ========================================================== -->

  <Grid>

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= header ======================= -->
        <Border x:Name="HeaderBar" Grid.Row="0"
                Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoHost" Grid.Column="0" Width="34" Height="34"
                    CornerRadius="4" Margin="0,0,11,0"
                    Background="{DynamicResource ChipBg}"
                    Cursor="Hand">
              <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Pro Sheets Exporter" FontSize="15"
                         Margin="0,-3,0,0"
                         Foreground="{DynamicResource OrangeBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,10,0">
              <TextBlock Text="Template" Style="{DynamicResource FieldLabel}"
                         Margin="0,0,8,0"/>
              <ComboBox x:Name="ProfileCombo" Width="190" Tag="No template"
                        ToolTip="Saved export templates for this project"/>
              <Button x:Name="ProfileNewButton" Style="{DynamicResource IconButton}"
                      Margin="5,0,0,0" ToolTip="Save the current settings as a new template">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource GreenBrush}"
                      Data="M 5,0 L 7,0 L 7,5 L 12,5 L 12,7 L 7,7 L 7,12 L 5,12 L 5,7 L 0,7 L 0,5 L 5,5 Z"/>
              </Button>
              <Button x:Name="ProfileSaveButton" Style="{DynamicResource IconButton}"
                      ToolTip="Overwrite the selected template with the current settings">
                <Path Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource BlueBrush}"
                      Data="M 0,0 L 11,0 L 14,3 L 14,14 L 0,14 Z
                            M 2.6,0.9 L 9,0.9 L 9,4.6 L 2.6,4.6 Z
                            M 7.1,1.6 L 8.3,1.6 L 8.3,3.9 L 7.1,3.9 Z
                            M 2.6,7.6 L 11.4,7.6 L 11.4,13.1 L 2.6,13.1 Z
                            M 4,9 L 10,9 L 10,9.9 L 4,9.9 Z
                            M 4,10.8 L 10,10.8 L 10,11.7 L 4,11.7 Z"/>
              </Button>
              <Button x:Name="ProfileImportButton" Style="{DynamicResource IconButton}"
                      ToolTip="Load templates from a file">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource MutedBrush}"
                      Data="M 5,0 L 7,0 L 7,6 L 10,6 L 6,11 L 2,6 L 5,6 Z M 0,12 L 12,12 L 12,14 L 0,14 Z"/>
              </Button>
              <Button x:Name="ProfileExportButton" Style="{DynamicResource IconButton}"
                      ToolTip="Save every template for this project to a file">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource MutedBrush}"
                      Data="M 6,0 L 10,5 L 7,5 L 7,11 L 5,11 L 5,5 L 2,5 Z M 0,12 L 12,12 L 12,14 L 0,14 Z"/>
              </Button>
              <Button x:Name="ProfileDeleteButton" Style="{DynamicResource IconButton}"
                      ToolTip="Delete the selected template">
                <Path Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource RedBrush}"
                      Data="M 4,0 L 8,0 L 9,2 L 12,2 L 12,3.5 L 0,3.5 L 0,2 L 3,2 Z M 1.5,5 L 10.5,5 L 9.8,13 L 2.2,13 Z"/>
              </Button>

              <Border Width="1" Margin="11,3,11,3"
                      Background="{DynamicResource EdgeBrush}"/>

              <!-- The size of the whole tool: smaller fits more on a small
                   screen. Ctrl+minus, Ctrl+plus and Ctrl+0 do the same. -->
              <Button x:Name="ZoomOutButton" Style="{DynamicResource IconButton}"
                      Width="24" ToolTip="Make the tool smaller, to see more (Ctrl+minus)">
                <Path Width="11" Height="11" Stretch="Uniform"
                      Fill="{DynamicResource TextBrush}"
                      Data="M 0,5 L 11,5 L 11,7 L 0,7 Z"/>
              </Button>
              <Button x:Name="ZoomResetButton" Style="{DynamicResource ChipButton}"
                      Content="100%" MinWidth="50" Margin="2,0,2,0"
                      ToolTip="The tool's size. Click to go back to 100% (Ctrl+0)"/>
              <Button x:Name="ZoomInButton" Style="{DynamicResource IconButton}"
                      Width="24" Margin="0,0,9,0"
                      ToolTip="Make the tool bigger (Ctrl+plus)">
                <Path Width="11" Height="11" Stretch="Uniform"
                      Fill="{DynamicResource TextBrush}"
                      Data="M 4.5,0 L 6.5,0 L 6.5,4.5 L 11,4.5 L 11,6.5 L 6.5,6.5 L 6.5,11 L 4.5,11 L 4.5,6.5 L 0,6.5 L 0,4.5 L 4.5,4.5 Z"/>
              </Button>

              <Button x:Name="SetupButton" Style="{DynamicResource ChipButton}"
                      Content="Set up" Margin="0,0,7,0"
                      ToolTip="The settings that belong to this computer rather than to the model: how PDFs get written, and where exports land"/>
              <Button x:Name="ThemeChip" Style="{DynamicResource ChipButton}"
                      Content="Dark" ToolTip="Switch between the dark and light palette"/>
              <TextBlock x:Name="VersionText" Style="{DynamicResource MutedText}"
                         Margin="12,0,0,0" VerticalAlignment="Center"
                         Text="v0.0.0"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen"/>
              <Button x:Name="FullScreenButton" Style="{DynamicResource IconButton}"
                      ToolTip="Full screen (F11)">
                <Border Width="12" Height="11" BorderThickness="1.6"
                        BorderBrush="{DynamicResource MutedBrush}"/>
              </Button>
              <Button x:Name="CloseButton" Style="{DynamicResource CloseButton}"
                      Content="&#x2715;" ToolTip="Close"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ======================= tabs ======================= -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,2,0,0">

          <!-- ===================================================
               1. SELECTION
               =================================================== -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <Path Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      Fill="{Binding Foreground,
                             RelativeSource={RelativeSource AncestorType=TabItem}}"
                      Data="M 0,1 L 3,1 L 3,3 L 0,3 Z M 5,1 L 14,1 L 14,3 L 5,3 Z M 0,6 L 3,6 L 3,8 L 0,8 Z M 5,6 L 14,6 L 14,8 L 5,8 Z M 0.4,11.6 L 1.8,10.2 L 3,11.4 L 5.6,8.8 L 7,10.2 L 3,14.2 Z M 9,11 L 14,11 L 14,13 L 9,13 Z"/>
                <TextBlock Text="Selection" VerticalAlignment="Center"
                           Foreground="{Binding Foreground,
                                        RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Both toolbar rows are WrapPanels, not StackPanels in
                   fixed columns. A horizontal StackPanel in an Auto column
                   reports the sum of its children as a hard minimum, so
                   every control added here raised the width the window
                   could no longer shrink below - and the resize grips then
                   looked broken because dragging narrower did nothing.
                   A WrapPanel reflows instead. -->
              <WrapPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
                <RadioButton x:Name="SheetsRadio" Content="Sheets"
                             GroupName="ScopeMode" IsChecked="True"
                             VerticalAlignment="Center" Margin="0,0,14,6"/>
                <RadioButton x:Name="ViewsRadio" Content="Views"
                             GroupName="ScopeMode"
                             VerticalAlignment="Center" Margin="0,0,20,6"/>

                <TextBlock Text="View/Sheet Set"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,0,8,6"/>
                <ComboBox x:Name="SheetSetCombo" MinWidth="170"
                          Margin="0,0,7,6" Tag="Filter by V/S Sets"
                          ToolTip="Show only the sheets in a saved View/Sheet Set"/>
                <Button x:Name="SaveSetButton" Content="Save V/S Set"
                        Margin="0,0,20,6"
                        ToolTip="Save the ticked sheets as a Revit View/Sheet Set"/>

                <TextBox x:Name="SearchBox" MinWidth="200" Margin="0,0,0,6"
                         Tag="Search every column"/>
              </WrapPanel>

              <WrapPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
                <Button x:Name="SelectAllButton" Content="Tick all"
                        Style="{DynamicResource ChipButton}" Margin="0,0,6,6"/>
                <Button x:Name="SelectNoneButton" Content="Tick none"
                        Style="{DynamicResource ChipButton}" Margin="0,0,6,6"/>
                <Button x:Name="InvertButton" Content="Invert"
                        Style="{DynamicResource ChipButton}" Margin="0,0,14,6"/>
                <CheckBox x:Name="GroupCheck" Margin="0,0,8,6"
                          VerticalAlignment="Center" IsChecked="True"
                          Content="Group matching values"
                          ToolTip="Colour each run of matching values in the sorted column and let it collapse. A value that appears once is left alone."/>
                <Button x:Name="CollapseAllButton" Content="Collapse all"
                        Style="{DynamicResource ChipButton}"
                        Margin="0,0,14,6" Visibility="Collapsed"/>
                <!-- Heading colours, as on the Document Register (1.54.0). -->
                <Button x:Name="SelectionHeadingModeButton"
                        Style="{DynamicResource HeadingModeButton}" Margin="0,0,14,6"
                        Visibility="Collapsed"
                        ToolTip="Heading colours: the trade colours, plain greys, or your own. Click to move on to the next; right-click a heading to pick its colour.">
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Path Fill="#A9DFA6" Data="M 0,0 L 6,0 L 6,6 L 0,6 Z"/>
                      <Path Fill="#A9D0F4" Data="M 7,0 L 13,0 L 13,6 L 7,6 Z"/>
                      <Path Fill="#D9B892" Data="M 0,7 L 6,7 L 6,13 L 0,13 Z"/>
                      <Path Fill="#CDB2EA" Data="M 7,7 L 13,7 L 13,13 L 7,13 Z"/>
                    </Grid>
                    <TextBlock x:Name="SelectionHeadingModeText" Text="Grey headers"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
                <CheckBox x:Name="ShowAllCheck" Visibility="Collapsed"
                          VerticalAlignment="Center" Margin="0,0,10,6"
                          Content="Show all sheets"
                          ToolTip="Show every sheet in the model again. What is already ticked stays ticked."/>
                <TextBlock x:Name="IsolationNote"
                           Style="{DynamicResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,14,6"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource OrangeBrush}"
                           Text=""/>
                <CheckBox x:Name="OnSheetListCheck" Margin="0,0,16,6"
                          VerticalAlignment="Center"
                          Content="Only sheets on the sheet list"/>
                <Button x:Name="CustomNameButton" Content="Custom File Name"
                        Style="{DynamicResource AccentButton}" Margin="0,0,0,6"
                        ToolTip="Choose which parameters make up the exported file name"/>
              </WrapPanel>

              <!-- the table -->
              <!-- No columns here: every column on this grid is built
                   in code from one ordered list, so that a parameter
                   column can be inserted beside the heading it was added
                   from and the order can be remembered in a template. -->
              <DataGrid x:Name="SheetGrid" Grid.Row="2"
                        IsReadOnly="False"
                        SelectionMode="Extended"
                        CanUserSortColumns="True"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"/>

              <TextBlock x:Name="SelectionHint" Grid.Row="3" Margin="2,8,0,0"
                         Style="{DynamicResource MutedText}"
                         Text="Click the Custom File Name heading to change how the files are named. Right click any heading to add a parameter column."/>
            </Grid>
          </TabItem>

          <!-- ===================================================
               2. DOCUMENT REGISTER

               Every sheet down the page, every revision across, in
               the Drawing Register's layout, one tab per discipline
               along the bottom. A tick here means "in the register
               export", not "print" - that is the Selection tab's job.
               Which sheets are ticked is driven by a Revit View/Sheet
               Set, and Apply writes the ticks back into it. Every
               column is built in code: the revision columns do not
               exist until the model has been read.
               =================================================== -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <Path Width="15" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      Fill="{Binding Foreground,
                             RelativeSource={RelativeSource AncestorType=TabItem}}"
                      Data="M 0,0 L 15,0 L 15,3 L 0,3 Z M 0,5 L 6,5 L 6,7 L 0,7 Z M 8,5 L 10,5 L 10,7 L 8,7 Z M 12,5 L 15,5 L 15,7 L 12,7 Z M 0,9 L 6,9 L 6,11 L 0,11 Z M 8,9 L 10,9 L 10,11 L 8,11 Z M 0,13 L 6,13 L 6,15 L 0,15 Z M 12,13 L 15,13 L 15,15 L 12,15 Z"/>
                <TextBlock Text="Document Register" VerticalAlignment="Center"
                           Foreground="{Binding Foreground,
                                        RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </StackPanel>
            </TabItem.Header>
            <Grid x:Name="RegisterRoot" Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <!-- Top right: the register's settings, then the Revision
                   Manager - a row high, not two (1.53.0). -->
              <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                          Orientation="Horizontal" VerticalAlignment="Top"
                          Margin="14,0,0,8">
                <!-- Search, then Settings, then the Revision Manager (1.54.0).
                     The source line is kept (code still writes it)
                     but is not shown: the tabs say what they are. -->
                <TextBox x:Name="RegisterSearch" Width="220" Margin="0,0,12,0"
                         VerticalAlignment="Top"
                         Tag="Search drawing number or title"/>
                <StackPanel VerticalAlignment="Top" Margin="0,0,12,0">
                  <Button x:Name="RegisterSetupButton" Content="Settings"
                          Style="{DynamicResource ChipButton}"
                          HorizontalAlignment="Right"
                          ToolTip="The discipline and series parameters, the logo and the rest of the register's form, in Set up"/>
                  <TextBlock x:Name="RegisterSource" Style="{DynamicResource MutedText}"
                             Visibility="Collapsed" Text=""/>
                </StackPanel>
                <Button x:Name="RevisionManagerButton"
                        Style="{DynamicResource BigActionButton}"
                        Height="56" Padding="16,0" VerticalAlignment="Top"
                      ToolTip="Add, edit, reorder, merge and delete the project's revisions, with how many sheets use each one. Nothing is written until Apply.">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="26" Height="24" Margin="0,0,10,0"
                        VerticalAlignment="Center">
                    <Path Stretch="Uniform"
                          Stroke="{DynamicResource BlueBrush}"
                          StrokeThickness="2.2" StrokeLineJoin="Round"
                          Data="M 13,1 L 25,23 L 1,23 Z"/>
                  </Grid>
                  <TextBlock Text="Revision Manager" VerticalAlignment="Center"
                             Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
                </Button>
              </StackPanel>

              <!-- Row one: what the register is for. The export, and the
                   View/Sheet Set that decides which drawings are in it. -->
              <WrapPanel Grid.Row="0" Margin="0,0,0,6" Orientation="Horizontal">
                <!-- Revision changes made here wait for Apply revisions
                     (bottom right): Undo / Redo step through them
                     (Ctrl+Z / Ctrl+Y). -->
                <Border Style="{DynamicResource SwitchBox}" Margin="0,0,18,6">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="RegisterUndoButton"
                            Style="{DynamicResource IconButton}"
                            IsEnabled="False" Opacity="0.4" Margin="0,0,2,0"
                            ToolTip="Undo the last revision change (Ctrl+Z). Nothing has been written to Revit yet.">
                      <Path Width="15" Height="13" Stretch="Uniform"
                            Fill="{DynamicResource TextBrush}"
                            Data="M 5,0 L 0,5 L 5,10 L 5,6.6 L 9,6.6 C 11.6,6.6 13.2,8.2 13.2,10.4 C 13.2,11.6 12.7,12.6 12,13.3 C 14.4,12.6 16,10.6 16,8.4 C 16,5.4 13.6,3.4 10,3.4 L 5,3.4 Z"/>
                    </Button>
                    <Button x:Name="RegisterRedoButton"
                            Style="{DynamicResource IconButton}"
                            IsEnabled="False" Opacity="0.4" Margin="0,0,2,0"
                            ToolTip="Redo the change just undone (Ctrl+Y)">
                      <Path Width="15" Height="13" Stretch="Uniform"
                            Fill="{DynamicResource TextBrush}"
                            Data="M 11,0 L 16,5 L 11,10 L 11,6.6 L 7,6.6 C 4.4,6.6 2.8,8.2 2.8,10.4 C 2.8,11.6 3.3,12.6 4,13.3 C 1.6,12.6 0,10.6 0,8.4 C 0,5.4 2.4,3.4 6,3.4 L 11,3.4 Z"/>
                    </Button>
                  </StackPanel>
                </Border>
                <CheckBox x:Name="RegisterAddToExport" Margin="0,0,14,6"
                          VerticalAlignment="Center"
                          Content="Add to export?"
                          ToolTip="When ticked, every Export run also writes this Document Register as an Excel file, into the folder the run's drawings went to"/>
                <Button x:Name="RegisterExportButton"
                        Style="{DynamicResource ExcelButton}" Margin="0,0,20,6"
                        ToolTip="Write the Document Register now, in the RD9 layout: one worksheet per discipline, only the included drawings">
                  <StackPanel Orientation="Horizontal">
                    <!-- A spreadsheet tile: green sheet, white cross, the
                         edge of a grid behind it. -->
                    <Grid Width="16" Height="16" Margin="0,0,7,0"
                          VerticalAlignment="Center">
                      <Border Background="{DynamicResource GreenBrush}"
                              CornerRadius="2"/>
                      <Path Stroke="White" StrokeThickness="0.8" Opacity="0.45"
                            Data="M 10.5,1 L 10.5,15 M 10.5,5.5 L 16,5.5 M 10.5,10.5 L 16,10.5"/>
                      <Path Fill="White"
                            Data="M 2.2,3.6 L 4.4,3.6 L 5.9,6.3 L 7.4,3.6 L 9.6,3.6 L 7.0,8 L 9.6,12.4 L 7.4,12.4 L 5.9,9.7 L 4.4,12.4 L 2.2,12.4 L 4.8,8 Z"/>
                    </Grid>
                    <TextBlock Text="Export to Excel" VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>

                <TextBlock Text="View/Sheet Set"
                           Style="{DynamicResource FieldLabel}"
                           Margin="0,0,8,6"/>
                <ComboBox x:Name="RegisterSetCombo" MinWidth="230"
                          Margin="0,0,6,6"
                          ToolTip="Revit's own View/Sheet Sets. Choosing one ticks exactly the sheets in it; that is what the register exports."/>
                <Button x:Name="RegisterApplyButton" Content="Apply"
                        Style="{DynamicResource ChipButton}" Margin="0,0,6,6"
                        ToolTip="Write the ticked sheets back into the chosen View/Sheet Set"/>
                <Button x:Name="RegisterNewSetButton" Content="+"
                        Style="{DynamicResource ChipButton}" Margin="0,0,20,6"
                        FontWeight="Bold" MinWidth="30"
                        ToolTip="Start a new View/Sheet Set: name it, tick its sheets, then Save new set"/>

                <Button x:Name="RegisterRefreshButton"
                        Style="{DynamicResource ChipButton}" Margin="0,0,0,6"
                        ToolTip="Read the sheets, revisions and sets from the model again (F5)">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 7,0 C 3.1,0 0,3.1 0,7 C 0,10.9 3.1,14 7,14 C 10.2,14 12.9,11.9 13.7,9 L 11.6,9 C 10.9,10.8 9.1,12 7,12 C 4.2,12 2,9.8 2,7 C 2,4.2 4.2,2 7,2 C 8.4,2 9.6,2.6 10.5,3.5 L 8,6 L 14,6 L 14,0 L 11.9,2.1 C 10.6,0.8 8.9,0 7,0 Z"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
              </WrapPanel>

              <!-- Row two: what is on screen. -->
              <WrapPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
                <!-- One switch, in a box of its own so it reads as a
                     choice between two views rather than two more chips.
                     The icons and text take the button's colour, so the
                     lit side and the quiet side swap together. -->
                <Border Style="{DynamicResource SwitchBox}" Margin="0,0,16,6">
                  <StackPanel Orientation="Horizontal">
                    <Button x:Name="RegisterShowAllButton"
                            Style="{DynamicResource SwitchButtonOn}" Margin="0,0,3,0"
                            ToolTip="Show every sheet, included or not. The ones left out are in the lighter colour.">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 3,0 L 13,0 L 13,11 L 3,11 Z M 0,3 L 1.6,3 L 1.6,13.4 L 10,13.4 L 10,15 L 0,15 Z"/>
                        <TextBlock Text="All sheets" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="RegisterShowIncludedButton"
                            Style="{DynamicResource ChipButton}"
                            ToolTip="Show only the sheets in the register. Disciplines with nothing in it drop off the tabs along the bottom.">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="13" Stretch="Uniform"
                              Margin="0,0,6,0" VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 0,0 L 11,0 L 11,4 L 9.4,4 L 9.4,1.6 L 1.6,1.6 L 1.6,13.4 L 6,13.4 L 6,15 L 0,15 Z M 7,10 L 8.4,8.6 L 10.2,10.4 L 14,6.6 L 15.4,8 L 10.2,13.2 Z"/>
                        <TextBlock Text="Included only" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <Button x:Name="RegisterCollapseButton"
                        Style="{DynamicResource ChipButton}" Margin="0,0,14,6"
                        ToolTip="Collapse or expand every heading on this tab. Click a heading to collapse just that one.">
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="12" Height="12" Margin="0,0,6,0"
                          VerticalAlignment="Center">
                      <Path x:Name="RegisterCollapseIcon" Stretch="Uniform"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M 2.2,0.6 L 7.5,4.3 L 12.8,0.6 L 14,2 L 7.5,6.5 L 1,2 Z M 2.2,14.4 L 7.5,10.7 L 12.8,14.4 L 14,13 L 7.5,8.5 L 1,13 Z"/>
                      <Path x:Name="RegisterExpandIcon" Stretch="Uniform"
                            Visibility="Collapsed" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M 1,6 L 7.5,1.5 L 14,6 L 12.8,7.4 L 7.5,3.7 L 2.2,7.4 Z M 1,9 L 7.5,13.5 L 14,9 L 12.8,7.6 L 7.5,11.3 L 2.2,7.6 Z"/>
                    </Grid>
                    <TextBlock x:Name="RegisterCollapseText" Text="Collapse all"
                               VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
                <Button x:Name="RegisterResetFiltersButton"
                        Style="{DynamicResource ChipButton}" Margin="0,0,14,6"
                        IsEnabled="False"
                        ToolTip="Clear every column filter on the register. The search box and Included only are left as they are.">
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="12" Height="12" Margin="0,0,6,0"
                          VerticalAlignment="Center">
                      <Path Stretch="Uniform"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            Data="M 0,0 L 12,0 L 7.4,5.6 L 7.4,9.4 L 4.6,11 L 4.6,5.6 Z M 9.2,8.2 L 10.2,7.2 L 12,9 L 13.8,7.2 L 14.8,8.2 L 13,10 L 14.8,11.8 L 13.8,12.8 L 12,11 L 10.2,12.8 L 9.2,11.8 L 11,10 Z"/>
                    </Grid>
                    <TextBlock x:Name="RegisterResetFiltersText" Text="Reset filters"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
                <!-- Lit (solid orange) once a revision is picked by its
                     sequence number at the top of its column. -->
                <Button x:Name="RegisterIsolateButton"
                        Style="{DynamicResource ChipButton}" Margin="0,0,8,6"
                        IsEnabled="False" Opacity="0.5"
                        ToolTip="Pick a revision by the sequence number at the top of its column (Ctrl+click for several, Shift+click for a run), then show only the sheets carrying it. Click again to show every sheet.">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 0,0 L 14,0 L 14,2 L 0,2 Z M 0,12 L 14,12 L 14,14 L 0,14 Z M 3,4.5 L 11,4.5 L 11,9.5 L 3,9.5 Z"/>
                    <TextBlock x:Name="RegisterIsolateText"
                               Text="Isolate sheets with this revision"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
                <!-- The sheet toolset: only there while drawing rows are
                     highlighted. Blue, where the revision one is orange. -->
                <Border x:Name="RegisterSheetTools" Visibility="Collapsed"
                        Margin="0,0,10,6" Padding="8,2"
                        Background="{DynamicResource ChipBg}"
                        BorderBrush="{DynamicResource BlueBrush}"
                        BorderThickness="1" CornerRadius="13">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RegisterSheetToolsText"
                               VerticalAlignment="Center" Margin="2,0,10,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource BlueBrush}"
                               Text="0 sheets"/>
                    <Button x:Name="RegisterAssignRevButton"
                            Style="{DynamicResource ChipButtonOn}"
                            ToolTip="Put a revision on the highlighted sheets, as Revit's Revisions on Sheet does. A sheet already carrying it is left as it is.">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource BlueBrush}"
                              Data="M 0,0 L 8,0 L 11,3 L 11,7 L 9.5,7 L 9.5,4 L 7,4 L 7,1.5 L 1.5,1.5 L 1.5,12.5 L 6,12.5 L 6,14 L 0,14 Z M 10,8 L 11.5,8 L 11.5,10.5 L 14,10.5 L 14,12 L 11.5,12 L 11.5,14.5 L 10,14.5 L 10,12 L 7.5,12 L 7.5,10.5 L 10,10.5 Z"/>
                        <TextBlock Text="Assign revision to selected..." VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <!-- The picked-cell toolset: only there while revision cells
                     are picked, so what it acts on is never in doubt. -->
                <Border x:Name="RegisterCellTools" Visibility="Collapsed"
                        Margin="0,0,14,6" Padding="8,2"
                        Background="{DynamicResource PickWashBrush}"
                        BorderBrush="{DynamicResource OrangeBrush}"
                        BorderThickness="1" CornerRadius="13">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="RegisterCellToolsText"
                               VerticalAlignment="Center" Margin="2,0,10,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OrangeBrush}"
                               Text="0 picked"/>
                    <Button x:Name="RegisterCreateRevButton"
                            Style="{DynamicResource ChipButtonOn}" Margin="0,0,6,0"
                            ToolTip="Make a new revision - sequence first, just after the one picked - and put it on the picked cells in place of what they carry: on the sheets, and in their clouds.">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource GreenBrush}"
                              Data="M 5,0 L 7,0 L 7,5 L 12,5 L 12,7 L 7,7 L 7,12 L 5,12 L 5,7 L 0,7 L 0,5 L 5,5 Z"/>
                        <TextBlock Text="Create new revision..." VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="RegisterEditRevButton"
                            Style="{DynamicResource ChipButtonOn}" Margin="0,0,6,0"
                            ToolTip="Open the Revision Manager on the picked revisions, ready to edit.">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="11" Height="11" Margin="0,0,6,0" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource BlueBrush}"
                              Data="M 8,0 L 11,3 L 3.5,10.5 L 0,11 L 0.5,7.5 Z"/>
                        <TextBlock Text="Edit revision..." VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="RegisterChangeRevButton"
                            Style="{DynamicResource SwitchButtonOn}" Margin="0,0,6,0"
                            ToolTip="Change the picked cells to another revision. Revisions added by hand are swapped on the sheet; revision clouds marking the old revision move to the new one.">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="13" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M 0,3 L 10,3 L 10,0 L 15,4.5 L 10,9 L 10,6 L 0,6 Z M 15,11 L 5,11 L 5,14 L 0,9.5 L 5,5 L 5,8 L 15,8 Z"/>
                        <TextBlock x:Name="RegisterChangeRevText"
                                   Text="Change revision..."
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                    <Button x:Name="RegisterRemoveRevButton"
                            Style="{DynamicResource ChipButton}"
                            ToolTip="Take the picked revisions off their sheets. Deletes the rev clouds from all associated views on the sheet, and takes off any added by hand. Asks first.">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource RedBrush}"
                              Data="M 4,0 L 8,0 L 9,2 L 12,2 L 12,3.5 L 0,3.5 L 0,2 L 3,2 Z M 1.5,5 L 10.5,5 L 9.8,13 L 2.2,13 Z"/>
                        <TextBlock Text="Remove revision..."
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource RedBrush}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
                <!-- Solid orange while every revision is showing. -->
                <Button x:Name="RegisterAllRevsButton"
                        Style="{DynamicResource ChipButton}" Margin="0,0,14,6"
                        ToolTip="Show every revision in the project, or only the ones the drawings on screen carry. A new revision is on no sheet yet, so it only shows with this on. The Excel export follows it.">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="14" Height="11" Margin="0,0,6,0" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 0,0 L 2,0 L 2,11 L 0,11 Z M 4,0 L 6,0 L 6,11 L 4,11 Z M 8,0 L 10,0 L 10,11 L 8,11 Z M 12,0 L 14,0 L 14,11 L 12,11 Z"/>
                    <TextBlock x:Name="RegisterAllRevsText" Text="Show all revisions"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
                <!-- Heading colours: its own colours, so it reads as what it
                     does (1.53.0). -->
                <Button x:Name="RegisterHeadingModeButton"
                        Style="{DynamicResource HeadingModeButton}" Margin="0,0,14,6"
                        ToolTip="Heading colours: the trade colours, plain greys, or your own. Click to move on to the next; right-click a heading to pick its colour.">
                  <StackPanel Orientation="Horizontal">
                    <Grid Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                      <Path Fill="#A9DFA6" Data="M 0,0 L 6,0 L 6,6 L 0,6 Z"/>
                      <Path Fill="#A9D0F4" Data="M 7,0 L 13,0 L 13,6 L 7,6 Z"/>
                      <Path Fill="#D9B892" Data="M 0,7 L 6,7 L 6,13 L 0,13 Z"/>
                      <Path Fill="#CDB2EA" Data="M 7,7 L 13,7 L 13,13 L 7,13 Z"/>
                    </Grid>
                    <TextBlock x:Name="RegisterHeadingModeText" Text="Coloured headers"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
                <!-- The issue rows: frozen in the heading (the default), or
                     scrolling with the drawings (1.53.0). -->
                <Button x:Name="RegisterFreezeButton"
                        Style="{DynamicResource SwitchButtonOn}" Margin="0,0,14,6"
                        ToolTip="Issue Status, Issued To and Method: frozen in the heading so they stay in view, or as rows at the top of the drawings that scroll away with them.">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="13" Margin="0,0,6,0" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 0,6 L 12,6 L 12,13 L 0,13 Z M 2.5,6 L 2.5,3.5 C 2.5,0.5 9.5,0.5 9.5,3.5 L 9.5,6 L 8,6 L 8,3.8 C 8,2 4,2 4,3.8 L 4,6 Z"/>
                    <TextBlock x:Name="RegisterFreezeText" Text="Issue rows frozen"
                               VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </StackPanel>
                </Button>
                <TextBlock x:Name="RegisterNote" Style="{DynamicResource MutedText}"
                           Foreground="{DynamicResource OrangeBrush}"
                           VerticalAlignment="Center" Margin="0,0,0,6"
                           TextWrapping="Wrap" Visibility="Collapsed" Text=""/>
              </WrapPanel>

              <DataGrid x:Name="RegisterGrid" Grid.Row="2" Grid.ColumnSpan="2"
                        IsReadOnly="False"
                        SelectionMode="Extended"
                        CanUserSortColumns="True"
                        CanUserReorderColumns="False"
                        EnableColumnVirtualization="True"
                        RowStyle="{DynamicResource RegisterRow}"
                        CellStyle="{DynamicResource RegisterCell}"
                        ColumnHeaderStyle="{DynamicResource RegisterHeader}"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto"/>
              <!-- The issue data's row names, laid over the drawing headings'
                   free space and right-aligned against the revisions: one
                   block spanning Rev, Seq No and Rev Date, which no single
                   column heading could hold. Placed in code (RegisterView.
                   _place_issue_labels); no Background, so clicks anywhere
                   else go straight through to the grid. -->
              <Canvas x:Name="RegisterIssueLabels" Grid.Row="2" Grid.ColumnSpan="2"
                      ClipToBounds="True"/>

              <Grid Grid.Row="3" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="RegisterTabs" Orientation="Horizontal"/>
                </ScrollViewer>
                <TextBlock x:Name="RegisterSummary" Grid.Column="1"
                           Style="{DynamicResource MutedText}"
                           VerticalAlignment="Center" Margin="12,6,12,0" Text=""/>
                <!-- Staged revision changes: thrown away (red) or written
                     (green, lit only once something is staged). -->
                <Button x:Name="RegisterDiscardRevsButton" Grid.Column="2"
                        Style="{DynamicResource DangerButton}"
                        IsEnabled="False" Margin="0,6,8,0"
                        ToolTip="Throw away every staged revision change. Revit is not touched.">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="10" Height="10" Margin="0,0,7,0" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 1.4,0 L 5,3.6 L 8.6,0 L 10,1.4 L 6.4,5 L 10,8.6 L 8.6,10 L 5,6.4 L 1.4,10 L 0,8.6 L 3.6,5 L 0,1.4 Z"/>
                    <TextBlock Text="Discard changes" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="RegisterApplyRevsButton" Grid.Column="3"
                        Style="{DynamicResource PrimaryButton}"
                        IsEnabled="False" Margin="0,6,2,0"
                        ToolTip="Write the staged revision changes to the sheets and their clouds, in the order they were made">
                  <StackPanel Orientation="Horizontal">
                    <Path Width="12" Height="12" Margin="0,0,7,0" Stretch="Uniform"
                          VerticalAlignment="Center"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 0,6.4 L 1.8,4.6 L 4.6,7.4 L 10.2,1.8 L 12,3.6 L 4.6,11 Z"/>
                    <TextBlock x:Name="RegisterApplyRevsText"
                               Text="Apply revisions" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Grid>
          </TabItem>

          <!-- ===================================================
               3. FORMAT
               =================================================== -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <Path Width="13" Height="15" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      Fill="{Binding Foreground,
                             RelativeSource={RelativeSource AncestorType=TabItem}}"
                      Data="M 1,0 L 8,0 L 12,4 L 12,15 L 1,15 Z M 8,0 L 8,4 L 12,4 Z M 3,7 L 10,7 L 10,8.4 L 3,8.4 Z M 3,10 L 10,10 L 10,11.4 L 3,11.4 Z"/>
                <TextBlock Text="Format" VerticalAlignment="Center"
                           Foreground="{Binding Foreground,
                                        RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <!-- format tiles

                   One page per format, each with a mark of its own. The
                   marks are drawn here rather than taken from anybody's
                   brand: what carries the meaning is the colour language
                   and the shape - a page of text for PDF, a wireframe in
                   yellow on blue for DWG, two overlapping models for NWC,
                   a structure with its nodes for IFC.
              -->
              <Border Grid.Row="0" Padding="6,10,6,12"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="0,0,0,1">
                <WrapPanel x:Name="FormatTiles" Orientation="Horizontal">
                  <StackPanel x:Name="PdfGroup" Orientation="Horizontal"
                              Margin="0,0,14,0">
                    <CheckBox x:Name="PdfCheck" VerticalAlignment="Center"
                              Margin="0,0,3,0"/>
                    <Button x:Name="PdfTile" Style="{DynamicResource IconButton}"
                            Width="58" Height="74" Padding="0"
                            ToolTip="Show the PDF settings">
                      <StackPanel>
                        <Canvas Width="32" Height="42"
                                HorizontalAlignment="Center">
                          <Path Data="M 4,0 L 21,0 L 32,11 L 32,38 A 4,4 0 0 1 28,42 L 4,42 A 4,4 0 0 1 0,38 L 0,4 A 4,4 0 0 1 4,0 Z"
                                Fill="{DynamicResource FmtPdf}"/>
                          <Path Data="M 21,0 L 32,11 L 25,11 A 4,4 0 0 1 21,7 Z" Fill="#FFFFFF" Opacity="0.9"/>
        <Rectangle Canvas.Left="7" Canvas.Top="16" Width="18" Height="3"
                   RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF"/>
        <Rectangle Canvas.Left="7" Canvas.Top="22" Width="18" Height="3"
                   RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF"/>
        <Rectangle Canvas.Left="7" Canvas.Top="28" Width="12" Height="3"
                   RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF"/>
                        </Canvas>
                        <TextBlock Text="PDF" FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource FmtPdf}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel x:Name="DwgGroup" Orientation="Horizontal"
                              Margin="0,0,14,0">
                    <CheckBox x:Name="DwgCheck" VerticalAlignment="Center"
                              Margin="0,0,3,0"/>
                    <Button x:Name="DwgTile" Style="{DynamicResource IconButton}"
                            Width="58" Height="74" Padding="0"
                            ToolTip="Show the DWG settings">
                      <StackPanel>
                        <Canvas Width="32" Height="42"
                                HorizontalAlignment="Center">
                          <Path Data="M 4,0 L 21,0 L 32,11 L 32,38 A 4,4 0 0 1 28,42 L 4,42 A 4,4 0 0 1 0,38 L 0,4 A 4,4 0 0 1 4,0 Z"
                                Fill="{DynamicResource FmtDwg}"/>
                          <Path Data="M 21,0 L 32,11 L 25,11 A 4,4 0 0 1 21,7 Z" Fill="#FFFFFF" Opacity="0.9"/>
        <Path Stroke="{DynamicResource FmtDwgInk}" StrokeThickness="1.7"
              StrokeLineJoin="Round"
              Data="M 16,12.5 L 25.5,18 L 25.5,29 L 16,34.5 L 6.5,29 L 6.5,18 Z M 16,12.5 L 16,23.5 M 16,23.5 L 25.5,29 M 16,23.5 L 6.5,29"/>
                        </Canvas>
                        <TextBlock Text="DWG" FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource FmtDwg}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel x:Name="DwfGroup" Orientation="Horizontal"
                              Margin="0,0,14,0" Opacity="0.5">
                    <CheckBox x:Name="DwfCheck" VerticalAlignment="Center"
                              Margin="0,0,3,0" IsEnabled="False"/>
                    <Button x:Name="DwfTile" Style="{DynamicResource IconButton}"
                            Width="58" Height="74" Padding="0" IsEnabled="False"
                            ToolTip="DWF is reserved for a later version">
                      <StackPanel>
                        <Canvas Width="32" Height="42"
                                HorizontalAlignment="Center">
                          <Path Data="M 4,0 L 21,0 L 32,11 L 32,38 A 4,4 0 0 1 28,42 L 4,42 A 4,4 0 0 1 0,38 L 0,4 A 4,4 0 0 1 4,0 Z"
                                Fill="{DynamicResource FmtDwf}"/>
                          <Path Data="M 21,0 L 32,11 L 25,11 A 4,4 0 0 1 21,7 Z" Fill="#FFFFFF" Opacity="0.9"/>
        <Rectangle Canvas.Left="7" Canvas.Top="18" Width="18" Height="3"
                   RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF"/>
        <Rectangle Canvas.Left="7" Canvas.Top="25" Width="14" Height="3"
                   RadiusX="1.5" RadiusY="1.5" Fill="#FFFFFF"/>
                        </Canvas>
                        <TextBlock Text="DWF" FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource FmtDwf}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel x:Name="NwcGroup" Orientation="Horizontal"
                              Margin="0,0,14,0">
                    <CheckBox x:Name="NwcCheck" VerticalAlignment="Center"
                              Margin="0,0,3,0"/>
                    <Button x:Name="NwcTile" Style="{DynamicResource IconButton}"
                            Width="58" Height="74" Padding="0"
                            ToolTip="Show the Navisworks (NWC) settings">
                      <StackPanel>
                        <Canvas Width="32" Height="42"
                                HorizontalAlignment="Center">
                          <Path Data="M 4,0 L 21,0 L 32,11 L 32,38 A 4,4 0 0 1 28,42 L 4,42 A 4,4 0 0 1 0,38 L 0,4 A 4,4 0 0 1 4,0 Z"
                                Fill="{DynamicResource FmtNwc}"/>
                          <Path Data="M 21,0 L 32,11 L 25,11 A 4,4 0 0 1 21,7 Z" Fill="#FFFFFF" Opacity="0.9"/>
        <Rectangle Canvas.Left="6" Canvas.Top="15" Width="11" Height="11"
                   Stroke="#FFFFFF" StrokeThickness="1.5"/>
        <Rectangle Canvas.Left="13" Canvas.Top="21" Width="13" Height="12"
                   Fill="{DynamicResource FmtNwcInk}"
                   Stroke="#FFFFFF" StrokeThickness="1.5"/>
                        </Canvas>
                        <TextBlock Text="NWC" FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource FmtNwc}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                  <StackPanel x:Name="IfcGroup" Orientation="Horizontal"
                              Margin="0,0,14,0">
                    <CheckBox x:Name="IfcCheck" VerticalAlignment="Center"
                              Margin="0,0,3,0"/>
                    <Button x:Name="IfcTile" Style="{DynamicResource IconButton}"
                            Width="58" Height="74" Padding="0"
                            ToolTip="Show the IFC settings">
                      <StackPanel>
                        <Canvas Width="32" Height="42"
                                HorizontalAlignment="Center">
                          <Path Data="M 4,0 L 21,0 L 32,11 L 32,38 A 4,4 0 0 1 28,42 L 4,42 A 4,4 0 0 1 0,38 L 0,4 A 4,4 0 0 1 4,0 Z"
                                Fill="{DynamicResource FmtIfc}"/>
                          <Path Data="M 21,0 L 32,11 L 25,11 A 4,4 0 0 1 21,7 Z" Fill="#FFFFFF" Opacity="0.9"/>
        <Path Stroke="#FFFFFF" StrokeThickness="1.6"
              StrokeLineJoin="Round"
              Data="M 6,24 L 16,15 L 26,24 M 9,22 L 9,33 L 23,33 L 23,22"/>
        <Ellipse Canvas.Left="3.9" Canvas.Top="21.9" Width="4.2" Height="4.2"
                 Fill="{DynamicResource FmtIfcInk}" Stroke="#FFFFFF"
                 StrokeThickness="0.9"/>
        <Ellipse Canvas.Left="13.9" Canvas.Top="12.9" Width="4.2" Height="4.2"
                 Fill="{DynamicResource FmtIfcInk}" Stroke="#FFFFFF"
                 StrokeThickness="0.9"/>
        <Ellipse Canvas.Left="23.9" Canvas.Top="21.9" Width="4.2" Height="4.2"
                 Fill="{DynamicResource FmtIfcInk}" Stroke="#FFFFFF"
                 StrokeThickness="0.9"/>
        <Ellipse Canvas.Left="6.9" Canvas.Top="30.9" Width="4.2" Height="4.2"
                 Fill="{DynamicResource FmtIfcInk}" Stroke="#FFFFFF"
                 StrokeThickness="0.9"/>
        <Ellipse Canvas.Left="20.9" Canvas.Top="30.9" Width="4.2" Height="4.2"
                 Fill="{DynamicResource FmtIfcInk}" Stroke="#FFFFFF"
                 StrokeThickness="0.9"/>
                        </Canvas>
                        <TextBlock Text="IFC" FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource FmtIfc}"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>

                  <TextBlock x:Name="FormatNote" Style="{DynamicResource MutedText}"
                             VerticalAlignment="Center" Margin="10,0,0,0"
                             TextWrapping="Wrap" MaxWidth="260"
                             Text=""/>
                </WrapPanel>
              </Border>

              <!-- panels -->
              <Grid Grid.Row="1" Margin="0,14,0,0">

                <!-- PDF -->
                <Grid x:Name="PdfPanel">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>

                  <!-- column 1 -->
                  <StackPanel Grid.Column="0" Margin="0,0,9,0">
                    <Border Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource EdgeBrush}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="14" Margin="0,0,0,12">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                          <Border Width="4" Height="14"
                                  Background="{DynamicResource BlueBrush}"
                                  Margin="0,0,7,0"/>
                          <TextBlock Text="Paper Placement"
                                     Style="{DynamicResource SectionLabel}"/>
                        </StackPanel>
                        <RadioButton x:Name="PlaceCenterRadio" Content="Center"
                                     GroupName="Placement" IsChecked="True"
                                     Margin="0,0,0,7"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                          <RadioButton x:Name="PlaceOffsetRadio"
                                       Content="Offset from corner"
                                       GroupName="Placement"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                          <ComboBox x:Name="MarginCombo" Width="140"
                                    IsEnabled="False"/>
                        </StackPanel>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBox x:Name="IfcUserPsetsBox" Grid.Column="0"/>
                              <Button x:Name="IfcUserPsetsBrowse" Grid.Column="1" Content="Browse"
                                      Width="76" Margin="7,0,0,0"/>
                            </Grid>
                            <CheckBox x:Name="IfcParamMapCheck" Margin="0,0,0,7"
                                      Content="Export parameter mapping table"/>
                            <Grid Margin="18,0,0,9">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBox x:Name="IfcParamMapBox" Grid.Column="0"/>
                              <Button x:Name="IfcParamMapBrowse" Grid.Column="1" Content="Browse"
                                      Width="76" Margin="7,0,0,0"/>
                            </Grid>
                            <Button x:Name="IfcClassificationButton"
                                    Content="Classification Settings ..."
                                    HorizontalAlignment="Left" Width="190"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <Border Grid.Column="2" Margin="9,0,0,10" VerticalAlignment="Top"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource EdgeBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                              <Border Width="4" Height="14"
                                      Background="{DynamicResource GreenBrush}"
                                      Margin="0,0,7,0"/>
                              <TextBlock Text="Advanced"
                                         Style="{DynamicResource SectionLabel}"/>
                            </StackPanel>
                            <CheckBox x:Name="IfcPartsAsElementsCheck" Margin="0,0,0,7"
                                      Content="Export parts as building elements"/>
                            <CheckBox x:Name="IfcSolidModelCheck" Margin="0,0,0,7"
                                      Content="Allow use of mixed Solid Model representation"/>
                            <CheckBox x:Name="IfcActiveViewGeomCheck" Margin="0,0,0,7"
                                      Content="Use active view when creating geometry"/>
                            <CheckBox x:Name="IfcFamilyTypeRefCheck" Margin="0,0,0,7"
                                      Content="Use family and type name for reference"/>
                            <CheckBox x:Name="Ifc2dRoomBoundaryCheck" Margin="0,0,0,7"
                                      Content="Use 2D room boundaries for room volume"/>
                            <CheckBox x:Name="IfcSiteElevationCheck" Margin="18,0,0,7"
                                      Content="Include IFCSITE elevation in the site local placement origin"/>
                            <CheckBox x:Name="IfcStoreGuidCheck" Margin="0,0,0,7"
                                      Content="Store the IFC GUID in an element parameter after export"/>
                            <CheckBox x:Name="IfcBoundingBoxCheck" Margin="0,0,0,7"
                                      Content="Export bounding box"/>
                            <CheckBox x:Name="IfcTriangulationCheck" Margin="0,0,0,7"
                                      Content="Keep tessellated geometry as triangulation"/>
                            <CheckBox x:Name="IfcTypeNameOnlyCheck" Margin="0,0,0,7"
                                      Content="Use Type name only for IFCType name"/>
                            <CheckBox x:Name="IfcVisibleNameCheck" Margin="0,0,0,0"
                                      Content="Use visible Revit name as IFCEntity name"/>
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Margin="9,0,0,0" VerticalAlignment="Top"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource EdgeBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="14">
                          <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                              <Border Width="4" Height="14"
                                      Background="{DynamicResource BlueBrush}"
                                      Margin="0,0,7,0"/>
                              <TextBlock Text="Import / Export Settings"
                                         Style="{DynamicResource SectionLabel}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Button x:Name="IfcImportSettingsButton" Grid.Column="0"
                                      Margin="0,0,4,0" Content="Import"/>
                              <Button x:Name="IfcExportSettingsButton" Grid.Column="1"
                                      Margin="4,0,0,0" Content="Export"/>
                            </Grid>
                            <Button x:Name="IfcCustomNameButton" Content="Custom File Name"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,9"/>
                            <TextBlock x:Name="IfcAvailableNote"
                                       Style="{DynamicResource MutedText}"
                                       TextWrapping="Wrap" Text=""/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </Grid>
                  </ScrollViewer>
                </Grid>
              </Grid>
            </Grid>
          </TabItem>

          <!-- ===================================================
               4. CREATE
               =================================================== -->
          <TabItem>
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <Path Width="16" Height="16" Stretch="Uniform"
                      VerticalAlignment="Center" Margin="0,0,8,0"
                      Fill="{Binding Foreground,
                             RelativeSource={RelativeSource AncestorType=TabItem}}"
                      Data="M 0,0 L 7,0 L 10,3 L 10,6.5 L 5.5,6.5 L 5.5,12 L 0,12 Z M 7,0 L 7,3 L 10,3 Z M 11.5,9.5 L 15.5,12.5 L 11.5,15.5 L 11.5,13.3 L 7.5,13.3 L 7.5,11.7 L 11.5,11.7 Z"/>
                <TextBlock Text="Create" VerticalAlignment="Center"
                           Foreground="{Binding Foreground,
                                        RelativeSource={RelativeSource AncestorType=TabItem}}"/>
              </StackPanel>
            </TabItem.Header>
            <Grid Margin="12">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Margin="0,0,0,10"
                      Background="{DynamicResource CardBg}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="1" CornerRadius="4" Padding="14">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                    <Border Width="4" Height="14"
                            Background="{DynamicResource BlueBrush}"
                            Margin="0,0,7,0"/>
                    <TextBlock Text="Where the files go"
                               Style="{DynamicResource SectionLabel}"/>
                  </StackPanel>

                  <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Root folder"
                               Style="{DynamicResource FieldLabel}" Width="94"/>
                    <TextBox x:Name="RootFolderBox" Grid.Column="1"
                             Tag="Browse to the folder the export lives under"/>
                    <Button x:Name="BrowseButton" Grid.Column="2"
                            Content="Browse" Margin="7,0,0,0"/>
                  </Grid>

                  <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Subfolders"
                               Style="{DynamicResource FieldLabel}" Width="94"/>
                    <!-- The leading {} escapes the brace: without it XAML
                         reads "{Project Number}" as a markup extension and
                         the whole layout fails to parse. -->
                    <TextBox x:Name="TokenBox" Grid.Column="1"
                             Tag="{}{Project Number}\{BGL_Sheet Discipline}"/>
                    <Button x:Name="AddTokenButton" Grid.Column="2"
                            Content="Add parameter" Margin="7,0,0,0"
                            ToolTip="Insert a project or sheet parameter as a folder level"/>
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Example"
                               Style="{DynamicResource FieldLabel}" Width="94"/>
                    <TextBlock x:Name="PathPreview" Grid.Column="1"
                               Style="{DynamicResource MutedText}"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource BlueBrush}"
                               Text="Choose a root folder to see where the first sheet lands."/>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="94,11,0,0">
                    <CheckBox x:Name="FolderPerFormatCheck" Margin="0,0,20,0"
                              Content="A subfolder per format"/>
                    <CheckBox x:Name="OverwriteCheck" Margin="0,0,20,0"
                              Content="Overwrite files that are already there"/>
                    <CheckBox x:Name="OpenFolderCheck" Margin="0,0,20,0"
                              Content="Offer to open the folder afterwards"/>
                    <CheckBox x:Name="DebugCheck" Margin="0,0,20,0"
                              Content="Debug log"
                              ToolTip="Write a blow-by-blow log of the run to %APPDATA%\RevoBIM\logs. Worth turning on when a printer is not behaving."/>
                    <CheckBox x:Name="SuppressCheck"
                              Content="Suppress dialogs while exporting"
                              ToolTip="Answers Revit's own dialogs and warnings for you, and skips this tool's confirmation, so a run goes straight through. It cannot close a print driver's own Save As window, which is not Revit's. The debug log still opens."/>
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Grid.Row="1" Orientation="Horizontal"
                          Margin="2,0,0,8">
                <TextBlock x:Name="CreateSummary"
                           Style="{DynamicResource SectionLabel}"
                           Text="Nothing ticked yet."/>
                <TextBlock x:Name="ClashWarning" Margin="14,0,0,0"
                           Foreground="{DynamicResource OrangeBrush}"
                           FontSize="12" Text=""/>
              </StackPanel>

              <DataGrid x:Name="CreateGrid" Grid.Row="2" IsReadOnly="True"
                        RowStyle="{DynamicResource PlanRow}"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Sheet" Binding="{Binding num}"
                                      Width="1*" MinWidth="110"/>
                  <DataGridTextColumn Header="Name" Binding="{Binding name}"
                                      Width="1.4*" MinWidth="150"/>
                  <DataGridTextColumn Header="Size" Binding="{Binding size}"
                                      Width="0.8*" MinWidth="110"/>
                  <DataGridTextColumn Header="Formats" Binding="{Binding fmt}"
                                      Width="0.6*" MinWidth="80"/>
                  <DataGridTextColumn Header="File name" Binding="{Binding fname}"
                                      Width="2*" MinWidth="190"/>
                  <DataGridTextColumn Header="Folder" Binding="{Binding folder}"
                                      Width="2.2*" MinWidth="200"/>
                </DataGrid.Columns>
              </DataGrid>

              <TextBlock x:Name="CreateHint" Grid.Row="3" Margin="2,8,0,0"
                         Style="{DynamicResource MutedText}" Text=""/>
            </Grid>
          </TabItem>
        </TabControl>

        <!-- ======================= footer ======================= -->
        <Border Grid.Row="2" Background="{DynamicResource BarBg}"
                CornerRadius="0,0,5,5" Padding="14,9,8,9">
          <!-- A DockPanel, not a star/Auto Grid: the buttons are docked
               right and always measured first at their full size, and the
               status line takes what is left, trimmed. The Grid it replaces
               could open with the buttons squeezed off the end until the
               window was resized (1.56.1). -->
          <DockPanel x:Name="FooterDock" LastChildFill="True">

            <!-- Purely a signpost. The dragging is done by the GripSE thumb
                 in the overlay above, which sits right on top of this. -->
            <Path DockPanel.Dock="Right" Width="13" Height="13"
                  VerticalAlignment="Bottom" HorizontalAlignment="Right"
                  Margin="0,0,0,-3" IsHitTestVisible="False"
                  Fill="{DynamicResource MutedBrush}" Opacity="0.7"
                  Data="M 11,0 L 13,0 L 13,2 L 11,2 Z
                        M 7,4 L 9,4 L 9,6 L 7,6 Z
                        M 11,4 L 13,4 L 13,6 L 11,6 Z
                        M 3,8 L 5,8 L 5,10 L 3,10 Z
                        M 7,8 L 9,8 L 9,10 L 7,10 Z
                        M 11,8 L 13,8 L 13,10 L 11,10 Z"/>
            <StackPanel x:Name="FooterButtons" DockPanel.Dock="Right"
                        Orientation="Horizontal" Margin="12,0,10,0"
                        VerticalAlignment="Center">
              <Button x:Name="CancelExportButton" Content="Stop"
                      Style="{DynamicResource AccentButton}"
                      Visibility="Collapsed" Margin="0,0,9,0"/>
              <!-- Express Export: the ticked sheets straight out with the
                   template's settings, no pages, no prompts. Selection
                   tab only. -->
              <Button x:Name="ExpressExportButton"
                      Style="{DynamicResource PrimaryButton}"
                      Padding="14,6" Margin="0,0,9,0"
                      ToolTip="Export the ticked sheets now with this template's settings - skips Format and Create, asks nothing">
                <StackPanel Orientation="Horizontal">
                  <Path Width="16" Height="16" Stretch="None"
                        VerticalAlignment="Center" Margin="0,0,7,0"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        Data="M4,1 L12,1 L12,5 L4,5 Z M1,6 L15,6 L15,12 L13,12 L13,9 L3,9 L3,12 L1,12 Z M4,10 L12,10 L12,15 L4,15 Z M12.5,7.2 L14,7.2 L14,8.2 L12.5,8.2 Z"/>
                  <TextBlock Text="Express Export" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BackButton" Content="Back" Width="92"
                      Margin="0,0,9,0" IsEnabled="False"/>
              <Button x:Name="NextButton" Content="Next" Width="92"/>
              <Button x:Name="ExportButton" Content="Export"
                      Style="{DynamicResource PrimaryButton}"
                      Width="128" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel x:Name="FooterStatus" VerticalAlignment="Center">
              <TextBlock x:Name="StatusText" Style="{DynamicResource MutedText}"
                         TextTrimming="CharacterEllipsis"
                         ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                         Text="Ready."/>
              <Grid x:Name="ProgressRow" Margin="0,6,20,0"
                    Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar x:Name="Progress" Grid.Column="0"
                             VerticalAlignment="Center"
                             Minimum="0" Maximum="100"/>
                <TextBlock x:Name="ProgressText" Grid.Column="1"
                           Style="{DynamicResource MutedText}"
                           Margin="12,0,0,0" VerticalAlignment="Center"
                           FontFamily="Consolas" Text=""/>
              </Grid>
            </StackPanel>

          </DockPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ==========================================================
         Resize grips. No Background on this Grid, so everything
         underneath stays clickable.
         ========================================================== -->
    <Grid x:Name="GripLayer">
      <Grid.RowDefinitions>
        <RowDefinition Height="7"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="7"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="7"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="7"/>
      </Grid.ColumnDefinitions>
      <Thumb x:Name="GripNW" Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripN"  Grid.Row="0" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripNE" Grid.Row="0" Grid.Column="2" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripW"  Grid.Row="1" Grid.Column="0" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripE"  Grid.Row="1" Grid.Column="2" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSW" Grid.Row="2" Grid.Column="0" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripS"  Grid.Row="2" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSE" Grid.Row="2" Grid.Column="2" Cursor="SizeNWSE"
             Width="18" Height="18" Margin="0,-11,0,0"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"
             Style="{DynamicResource GripThumb}"/>
    </Grid>
  </Grid>
</Window>

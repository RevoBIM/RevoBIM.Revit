<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ==========================================================
       RevoBIM PY : Pro Sheets Exporter : Theme.xaml
       Every brush and every control template lives here. The layout
       files reference these with DynamicResource ONLY, because this
       dictionary is merged in after XamlReader has parsed the layout.
       The brushes below are the dark palette as a starting point;
       theme.apply writes the chosen palette over them onto the
       window's own resources, which sit in front of a merged
       dictionary in WPF's lookup order.
       Banners are drawn with = because XML forbids two hyphens
       inside a comment and a XAML that will not parse shows up as a
       blank white pyRevit window with no traceback.
       ========================================================== -->

  <SolidColorBrush x:Key="WindowBg"        Color="#3C4454"/>
  <SolidColorBrush x:Key="CardBg"          Color="#353D4B"/>
  <SolidColorBrush x:Key="FieldBg"         Color="#2D3441"/>
  <SolidColorBrush x:Key="BarBg"           Color="#222933"/>
  <SolidColorBrush x:Key="HeaderBg"        Color="#323C48"/>
  <SolidColorBrush x:Key="TabActiveBg"     Color="#353D4B"/>
  <SolidColorBrush x:Key="TabInactiveBg"   Color="#2B313C"/>
  <SolidColorBrush x:Key="EdgeBrush"       Color="#4A5464"/>
  <SolidColorBrush x:Key="WindowEdgeBrush" Color="#515C6B"/>
  <SolidColorBrush x:Key="GridLineBrush"   Color="#46505F"/>
  <SolidColorBrush x:Key="HoverBrush"      Color="#444E5E"/>
  <SolidColorBrush x:Key="TextBrush"       Color="#EEF0F4"/>
  <SolidColorBrush x:Key="MutedBrush"      Color="#A4AAB1"/>
  <SolidColorBrush x:Key="DisabledBrush"   Color="#6E7684"/>
  <SolidColorBrush x:Key="BlueBrush"       Color="#5AAEEB"/>
  <SolidColorBrush x:Key="OrangeBrush"     Color="#E8912D"/>
  <SolidColorBrush x:Key="GreenBrush"      Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHoverBrush" Color="#4EC06D"/>
  <SolidColorBrush x:Key="OnOrangeBrush"   Color="#1E1E20"/>
  <SolidColorBrush x:Key="GreenWashBrush"  Color="#3D5855"/>
  <SolidColorBrush x:Key="PickWashBrush"   Color="#5E534C"/>
  <SolidColorBrush x:Key="RedBrush"        Color="#D9534F"/>
  <SolidColorBrush x:Key="SelectionBrush"  Color="#3A7392"/>
  <SolidColorBrush x:Key="RowAltBrush"     Color="#394151"/>
  <SolidColorBrush x:Key="ChipBg"          Color="#323C48"/>
  <SolidColorBrush x:Key="SortL1"          Color="#E8912D"/>
  <SolidColorBrush x:Key="SortL2"          Color="#4FA3E3"/>
  <SolidColorBrush x:Key="SortL3"          Color="#3FA75A"/>
  <SolidColorBrush x:Key="SortL4"          Color="#A98BE8"/>
  <SolidColorBrush x:Key="SortL5"          Color="#46BFBF"/>
  <SolidColorBrush x:Key="SortL6"          Color="#D9B23C"/>

  <!-- One colour per export format, swapped live by theme.apply. The
       Ink pair is the mark drawn on top of the page: yellow on blue for
       DWG because that is the colour language people read as CAD, and a
       lighter tint of its own colour for the other two. -->
  <SolidColorBrush x:Key="DoneRowBrush"    Color="#3D5D56"/>
  <SolidColorBrush x:Key="FailedRowBrush"  Color="#634853"/>

  <SolidColorBrush x:Key="FmtPdf"          Color="#D0443A"/>
  <SolidColorBrush x:Key="FmtDwg"          Color="#2C6FC4"/>
  <SolidColorBrush x:Key="FmtDwf"          Color="#6E7684"/>
  <SolidColorBrush x:Key="FmtNwc"          Color="#1F9C9C"/>
  <SolidColorBrush x:Key="FmtIfc"          Color="#5A6BD6"/>
  <SolidColorBrush x:Key="FmtDwgInk"       Color="#F2B417"/>
  <SolidColorBrush x:Key="FmtNwcInk"       Color="#6FD8D8"/>
  <SolidColorBrush x:Key="FmtIfcInk"       Color="#C3CBF5"/>

  <sys:Double x:Key="RowHeight">26</sys:Double>

  <!-- ==========================================================
       TextBlock
       ========================================================== -->

  <Style TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="MutedText" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style x:Key="SectionLabel" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <!-- ==========================================================
       Buttons
       A bare WPF Button has no implicit style of its own, so it
       falls back to the OS chrome : a light grey lozenge sitting in
       a dark header. Anything that can render a surface gets a
       template, including buttons built in code.
       ========================================================== -->

  <Style TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource ChipBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="3"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource CardBg}"/>
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="20,6"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource GreenBrush}"
                  BorderBrush="{DynamicResource GreenBrush}"
                  BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource GreenHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource CardBg}"/>
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The red twin of PrimaryButton: throws work away. Grey while there
       is nothing to throw. -->
  <Style x:Key="DangerButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,6"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource RedBrush}"
                  BorderBrush="{DynamicResource RedBrush}"
                  BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource CardBg}"/>
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AccentButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="Transparent"
                  BorderBrush="{DynamicResource OrangeBrush}"
                  BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The lit version of a chip, for a control whose state is worth
       seeing from across the room: Collapse all wears it while grouping
       is on. Same geometry as ChipButton so nothing shifts when the
       style is swapped. -->
  <Style x:Key="ChipButtonOn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource ChipBg}"
                  BorderBrush="{DynamicResource BlueBrush}"
                  BorderThickness="1" CornerRadius="11">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The register's heading colour button (1.53.0): filled with the four
       trade ramps' dark ends, so it looks like what it changes. The same
       on both themes, like the headings it cycles. -->
  <LinearGradientBrush x:Key="HeadingModeFill" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#17572B" Offset="0"/>
    <GradientStop Color="#173F78" Offset="0.35"/>
    <GradientStop Color="#4F3220" Offset="0.7"/>
    <GradientStop Color="#4B2A6E" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="HeadingModeButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource HeadingModeFill}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="11">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="shell" Property="Opacity" Value="0.85"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The chosen half of a two-way switch (All sheets / Included only):
       solid orange, so which one is on reads at a glance. Same geometry
       as ChipButton, so nothing moves when the two swap. -->
  <Style x:Key="SwitchButtonOn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource OnOrangeBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource OrangeBrush}"
                  BorderBrush="{DynamicResource OrangeBrush}"
                  BorderThickness="1" CornerRadius="11">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Opacity" Value="0.88"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Export to Excel: green and bold, the colour people look for when the
       output is a spreadsheet. -->
  <Style x:Key="ExcelButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <!-- Raised on a soft shadow all round, which tightens when
               pressed - the same feel as the Revision Manager button. -->
          <Border x:Name="shell" Background="{DynamicResource GreenWashBrush}"
                  BorderBrush="{DynamicResource GreenBrush}"
                  BorderThickness="1.5" CornerRadius="3" Margin="3">
            <Border.Effect>
              <DropShadowEffect BlurRadius="8" ShadowDepth="1.5"
                                Direction="300" Opacity="0.45"
                                Color="#000000"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource GreenHoverBrush}"/>
              <Setter Property="Foreground"
                      Value="{DynamicResource GreenHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="shell" Property="Margin" Value="4,4,2,2"/>
              <Setter TargetName="shell" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="0.5"
                                    Direction="300" Opacity="0.35"
                                    Color="#000000"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A big, pressable button: raised on a drop shadow, sinking into it
       when pressed. The Revision Manager wears it on the register tab. The
       shadow is replaced whole when pressed, because a Setter cannot reach
       into an Effect by name. -->
  <Style x:Key="BigActionButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="20,10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Margin="0,0,4,4"
                  Background="{DynamicResource CardBg}"
                  BorderBrush="{DynamicResource BlueBrush}"
                  BorderThickness="2" CornerRadius="7">
            <Border.Effect>
              <DropShadowEffect BlurRadius="9" ShadowDepth="4" Direction="315"
                                Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource OrangeBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="shell" Property="Margin" Value="3,3,1,1"/>
              <Setter TargetName="shell" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="1"
                                    Direction="315" Opacity="0.35"
                                    Color="#000000"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The Revision Manager's choice lists. Placeholders: the window puts
       the real lists on its own resources, which sit in front of these. -->
  <x:Array x:Key="RevShowChoices" Type="{x:Type sys:String}">
    <sys:String>None</sys:String>
    <sys:String>Tag</sys:String>
    <sys:String>Cloud and Tag</sys:String>
  </x:Array>
  <x:Array x:Key="RevNumberingChoices" Type="{x:Type sys:String}"/>

  <!-- The sequence number at the top of a register revision column. A
       button so its click is its own: a click anywhere else on the heading
       includes the drawings carrying the revision. Quiet until picked;
       solid orange once it is, like every other "on" in the tool. -->
  <Style x:Key="SeqChip" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="5,0"/>
    <Setter Property="MinWidth" Value="20"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="Transparent"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource OrangeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SeqChipOn" TargetType="{x:Type Button}"
         BasedOn="{StaticResource SeqChip}">
    <Setter Property="Foreground" Value="{DynamicResource OnOrangeBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource OrangeBrush}"
                  BorderBrush="{DynamicResource OrangeBrush}"
                  BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Opacity" Value="0.88"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChipButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="9,3"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource ChipBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="11">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Top right of every window, before full screen and close: shrink the
       window down to its title bar at the bottom of the screen, so Revit
       can be seen (ps_ui.Chrome.shrink). Shrunk, Chrome sets Tag to
       "shrunk" and the glyph turns into a green up arrow that brings the
       window back. The glyphs are a ContentTemplate, not Content, so one
       style serves every window without sharing an element between them. -->
  <Style x:Key="ShrinkButton" TargetType="{x:Type Button}"
         BasedOn="{StaticResource IconButton}">
    <Setter Property="Content" Value="shrink"/>
    <Setter Property="ToolTip" Value="Shrink to the bottom of the screen"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Path Width="13" Height="13" Stretch="Uniform"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                Data="M 5,0 L 9,0 L 9,5 L 12,5 L 7,10 L 2,5 L 5,5 Z M 1,12 L 13,12 L 13,14 L 1,14 Z"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Tag" Value="shrunk">
        <Setter Property="ContentTemplate">
          <Setter.Value>
            <DataTemplate>
              <Path Width="14" Height="14" Stretch="Uniform"
                    Fill="{DynamicResource GreenBrush}"
                    Data="M 7,0 L 14,7 L 9.5,7 L 9.5,14 L 4.5,14 L 4.5,7 L 0,7 Z"/>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CloseButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource RedBrush}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       TextBox, with a placeholder driven by Tag so a bare search
       box says what it searches
       ========================================================== -->

  <Style TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="shell" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="3">
            <Grid>
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}"
                         Foreground="{DynamicResource DisabledBrush}"
                         Margin="8,0,6,0" VerticalAlignment="Center"
                         IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource CardBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       CheckBox : the tick is a Path, not a symbol font, so it
       cannot come out as an empty box on a machine without it
       ========================================================== -->

  <Style TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1">
              <Path x:Name="tick" Visibility="Collapsed"
                    Stretch="Uniform" Margin="2.5"
                    Stroke="{DynamicResource BlueBrush}"
                    StrokeThickness="1.9"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Data="M 0,4 L 3.2,7.2 L 9,0.6"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
              <Setter TargetName="tick" Property="Stroke"
                      Value="{DynamicResource DisabledBrush}"/>
              <Setter TargetName="box" Property="BorderBrush"
                      Value="{DynamicResource EdgeBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A grid cell's CheckBox needs its own keyed style: DataGrid applies an
       element style of its own to the checkbox it builds, which wins over
       the implicit style above and puts an unthemed system tick in the
       middle of a dark table. -->
  <Style x:Key="GridCheckBox" TargetType="{x:Type CheckBox}">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Border Background="Transparent" Padding="4">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="2"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1">
              <Path x:Name="tick" Visibility="Collapsed"
                    Stretch="Uniform" Margin="2.5"
                    Stroke="{DynamicResource BlueBrush}"
                    StrokeThickness="1.9"
                    StrokeEndLineCap="Round"
                    StrokeStartLineCap="Round"
                    Data="M 0,4 L 3.2,7.2 L 9,0.6"/>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       RadioButton
       ========================================================== -->

  <Style TargetType="{x:Type RadioButton}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Grid Width="15" Height="15" VerticalAlignment="Center">
              <Ellipse x:Name="ring"
                       Fill="{DynamicResource FieldBg}"
                       Stroke="{DynamicResource EdgeBrush}"
                       StrokeThickness="1"/>
              <Ellipse x:Name="dot" Width="7" Height="7"
                       Fill="{DynamicResource BlueBrush}"
                       Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"
                              RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ring" Property="Stroke"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ring" Property="Stroke"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
              <Setter TargetName="dot" Property="Fill"
                      Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       ScrollBar
       ========================================================== -->

  <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border x:Name="grip" CornerRadius="4" Margin="3"
                  Background="{DynamicResource EdgeBrush}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="grip" Property="Background"
                      Value="{DynamicResource MutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollLineButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent" Height="0" Width="0"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="11"/>
    <Setter Property="MinWidth" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand"
                              Style="{DynamicResource ScrollPageButton}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{DynamicResource ScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand"
                              Style="{DynamicResource ScrollPageButton}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="11"/>
              <Setter Property="MinHeight" Value="11"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter Property="MinWidth" Value="0"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed"
                      Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       ComboBox : its editable text box, its popup and its items all
       ignore Background and fall back to the system theme, which is
       what shows through as unreadable white boxes in dark mode
       ========================================================== -->

  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBoxItem}">
          <Border x:Name="shell" Background="Transparent"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboToggle" TargetType="{x:Type ToggleButton}">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border x:Name="shell" Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="3">
            <Path x:Name="caret" HorizontalAlignment="Right"
                  VerticalAlignment="Center" Margin="0,0,9,0"
                  Fill="{DynamicResource MutedBrush}"
                  Data="M 0,0 L 8,0 L 4,5 Z"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
              <Setter TargetName="caret" Property="Fill"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource CardBg}"/>
              <Setter TargetName="caret" Property="Fill"
                      Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="8,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton x:Name="PART_Toggle"
                          Style="{DynamicResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                      RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="shown"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="8,0,24,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              IsHitTestVisible="False"/>
            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}"
                       Foreground="{DynamicResource DisabledBrush}"
                       Margin="9,0,24,0" VerticalAlignment="Center"
                       Visibility="Collapsed" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" Placement="Bottom"
                   AllowsTransparency="True" Focusable="False"
                   PopupAnimation="None"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{DynamicResource CardBg}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="1" CornerRadius="3"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      SnapsToDevicePixels="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                  <StackPanel IsItemsHost="True" Margin="1"
                              KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="-1">
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       ListBox
       ========================================================== -->

  <Style TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="7,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border x:Name="shell" Background="Transparent"
                  Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <!-- ==========================================================
       ToolTip
       ========================================================== -->

  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{DynamicResource CardBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="8,5"
                  MaxWidth="360">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       Context menu. Like every other control that renders a
       surface, it falls back to the OS chrome without a template :
       a white menu hanging off a dark table.
       ========================================================== -->

  <Style TargetType="{x:Type Separator}">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="6,4"/>
    <Setter Property="Background" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Height="1" Background="{TemplateBinding Background}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type MenuItem}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Border x:Name="shell" Background="Transparent"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground"
                      Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type ContextMenu}">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4"
                  Padding="2" SnapsToDevicePixels="True">
            <StackPanel IsItemsHost="True"
                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Keyed copies, for menus built in code. An implicit style reaches a
       ContextMenu through its PlacementTarget, which usually works and is
       not worth relying on for something that renders a whole surface. -->
  <Style x:Key="ThemedContextMenu" TargetType="{x:Type ContextMenu}"
         BasedOn="{StaticResource {x:Type ContextMenu}}"/>
  <Style x:Key="ThemedMenuItem" TargetType="{x:Type MenuItem}"
         BasedOn="{StaticResource {x:Type MenuItem}}"/>

  <!-- ==========================================================
       Tabs
       ========================================================== -->

  <Style TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Border x:Name="shell" Margin="0,0,3,0"
                  Background="{DynamicResource TabInactiveBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1,1,1,0"
                  CornerRadius="4,4,0,0">
            <Grid>
              <Border x:Name="tick" Height="2" VerticalAlignment="Top"
                      Background="{DynamicResource BlueBrush}"
                      Visibility="Collapsed"/>
              <ContentPresenter ContentSource="Header"
                                Margin="18,7,18,7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource TabActiveBg}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="False"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="10,8,10,0"
                      Panel.ZIndex="1"/>
            <Border Grid.Row="1" Margin="10,0,10,0"
                    Background="{DynamicResource TabActiveBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="0,4,4,4">
              <ContentPresenter ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       DataGrid
       ========================================================== -->

  <Style TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
          <Grid>
            <Border x:Name="edge" Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource GridLineBrush}"
                    BorderThickness="0,0,1,1" Padding="5,4">
              <ContentPresenter VerticalAlignment="Top"
                                HorizontalAlignment="Stretch"/>
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" Width="6"
                   HorizontalAlignment="Right" Cursor="SizeWE"
                   Opacity="0" Background="Transparent"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="edge" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The search box that sits under every column heading. Smaller and
       quieter than a normal field, because there is one per column and a
       row of full sized boxes would shout louder than the data. -->
  <Style x:Key="ColumnSearchBox" TargetType="{x:Type TextBox}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="0,4,0,0"/>
    <Setter Property="Padding" Value="5,1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border x:Name="shell" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="2">
            <Grid>
              <TextBlock x:Name="hint" Text="{TemplateBinding Tag}"
                         Foreground="{DynamicResource DisabledBrush}"
                         FontSize="11" Margin="6,0,4,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False" Visibility="Collapsed"/>
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value=""/>
                <Condition Property="IsFocused" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <!-- A column with something typed in it is filtered, and a
                 filter you cannot see is a filter you forget. -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Text" Value="">
        <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Keyed as well as implicit, so a column that wants a cell background
       of its own can be BasedOn it instead of replacing it. A code built
       Style assigned to DataGridColumn.CellStyle beats the implicit one
       outright, and a cell with no template renders as OS chrome - the
       same trap as assigning a null Style to a Button. -->
  <Style x:Key="GridCell" TargetType="{x:Type DataGridCell}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DataGridCell}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="0,0,1,0"
                  Padding="8,0" SnapsToDevicePixels="True">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- A group heading. The row carries the colour; the text has to
           be set on the cell, because this style sets Foreground and
           FontSize explicitly and an explicit setter beats anything the
           row tries to hand down by inheritance. Black or white by
           contrast with the heading's colour (gink, from ps_ramp), and no
           grid lines across the pill. -->
      <DataTrigger Binding="{Binding ishead}" Value="1">
        <Setter Property="Foreground" Value="{Binding gink}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </DataTrigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type DataGridCell}"
         BasedOn="{StaticResource GridCell}"/>

  <!-- The sorted column's cells, coloured per run of matching values. The
       brush is carried in the row's own "gbrush" column rather than
       computed here: a run's colour depends on where it sits among the
       other runs, which no trigger can know. Rows outside a run hold
       Transparent, never null - a Setter handed DBNull cannot convert to
       a Brush and the cell loses its background entirely. -->
  <Style x:Key="GroupedCell" TargetType="{x:Type DataGridCell}"
         BasedOn="{StaticResource GridCell}">
    <Setter Property="Background" Value="{Binding gbrush}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A group heading as Project Browser Pro draws one: a solid rounded
       pill in the heading's colour (the row's Background, set in code),
       with the shadow on its own Border behind the cells - an Effect on
       the row would shadow the text too. Only heading rows wear it; the
       grids have no row headers, so nothing else in a row is lost. -->
  <ControlTemplate x:Key="HeadingRowTemplate" TargetType="{x:Type DataGridRow}">
    <Grid>
      <Border Margin="2,2,4,2" CornerRadius="4"
              Background="{TemplateBinding Background}"
              SnapsToDevicePixels="True">
        <Border.Effect>
          <DropShadowEffect BlurRadius="5" ShadowDepth="1.5" Direction="290"
                            Opacity="0.4" Color="#000000"/>
        </Border.Effect>
      </Border>
      <DataGridCellsPresenter Margin="2,2,4,2"
                              ItemsPanel="{TemplateBinding ItemsPanel}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
    </Grid>
  </ControlTemplate>
  <Style x:Key="GridRow" TargetType="{x:Type DataGridRow}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="MinHeight" Value="27"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding ishead}" Value="1">
        <Setter Property="Template" Value="{StaticResource HeadingRowTemplate}"/>
        <Setter Property="MinHeight" Value="31"/>
      </DataTrigger>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="{DynamicResource RowAltBrush}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="{x:Type DataGridRow}"
         BasedOn="{StaticResource GridRow}"/>

  <!-- The Create list during a run. Written rows go green and failed
       ones red as each file lands, so a long issue can be watched
       rather than guessed at. Data triggers rather than painting in
       LoadingRow: the grid recycles row containers, and a colour set
       on a container follows it onto whatever row it is handed to
       next. -->
  <Style x:Key="PlanRow" TargetType="{x:Type DataGridRow}"
         BasedOn="{StaticResource GridRow}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding state}" Value="done">
        <Setter Property="Background" Value="{DynamicResource DoneRowBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="failed">
        <Setter Property="Background" Value="{DynamicResource FailedRowBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- ==========================================================
       Document Register
       ========================================================== -->

  <!-- The register's rows. A series or discipline heading sits on the
       header colour so it reads as a break in the list rather than one
       more drawing; the text colour comes from the cell style's own
       ishead trigger, which is shared with the Selection grid. -->
  <Style x:Key="RegisterRow" TargetType="{x:Type DataGridRow}"
         BasedOn="{StaticResource GridRow}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding ishead}" Value="1">
        <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- The register's cells. A drawing left out of the export is shown in
       the muted colour, so what is in and what is out reads at a glance
       down a long list. On the cell rather than the row: GridCell sets
       Foreground explicitly, and an explicit setter beats anything the
       row hands down. Headings are never muted - they are the way to
       include their whole series back in. -->
  <Style x:Key="RegisterCell" TargetType="{x:Type DataGridCell}"
         BasedOn="{StaticResource GridCell}">
    <Style.Triggers>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding sel}" Value="False"/>
          <Condition Binding="{Binding ishead}" Value="0"/>
        </MultiDataTrigger.Conditions>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Register headings sit on the bottom edge. The revision dates are
       rotated, and rotated labels of different lengths only line up if
       they share a baseline; hung from the top, a short date floats
       halfway up the header and looks misplaced. -->
  <Style x:Key="RegisterHeader" TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
          <Grid>
            <Border x:Name="edge" Background="{DynamicResource HeaderBg}"
                    BorderBrush="{DynamicResource GridLineBrush}"
                    BorderThickness="0,0,1,1" Padding="5,6,5,5">
              <ContentPresenter VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"/>
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" Width="6"
                   HorizontalAlignment="Right" Cursor="SizeWE"
                   Opacity="0" Background="Transparent"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="edge" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The discipline tabs along the bottom of the register, the way a
       workbook's sheet tabs hang under the grid: flush at the top,
       rounded underneath, the live one lifted onto the card colour with
       a blue bar along its foot. The mirror of the main TabItem, which
       hangs the other way. -->
  <!-- Background is a TemplateBinding so each discipline's tab can wear
       its own colour - the same colour as its heading on the All tab.
       A tab with no colour of its own falls back to the setter. -->
  <!-- Bold, a little larger, and raised on a soft shadow so each tab reads
       as something to press; the shadow tightens when pressed, the same
       feel as the Revision Manager button. The live tab sits flatter, with
       the blue bar along its foot. -->
  <Style x:Key="SheetTab" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="Background" Value="{DynamicResource TabInactiveBg}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="13,6,15,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Margin="1,0,6,6"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1,0,1,1" CornerRadius="0,0,5,5">
            <Border.Effect>
              <DropShadowEffect BlurRadius="7" ShadowDepth="2.5"
                                Direction="290" Opacity="0.45"
                                Color="#000000"/>
            </Border.Effect>
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource HoverBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="shell" Property="Margin" Value="2,1,5,5"/>
              <Setter TargetName="shell" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="3" ShadowDepth="0.5"
                                    Direction="290" Opacity="0.35"
                                    Color="#000000"/>
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SheetTabOn" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource TabActiveBg}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="13,6,15,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Margin="1,0,6,6"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource BlueBrush}"
                  BorderThickness="1,0,1,1" CornerRadius="0,0,5,5">
            <Border.Effect>
              <DropShadowEffect BlurRadius="4" ShadowDepth="1"
                                Direction="290" Opacity="0.35"
                                Color="#000000"/>
            </Border.Effect>
            <Grid>
              <Border Height="3" VerticalAlignment="Bottom"
                      CornerRadius="0,0,4,4"
                      Background="{DynamicResource BlueBrush}"/>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The filter button under each register heading, opening an Excel
       style list. Quiet when the column is not filtered; orange when it
       is, because a filter you cannot see is a filter you forget. -->
  <Style x:Key="FilterButton" TargetType="{x:Type Button}">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Height" Value="19"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border x:Name="shell" Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="5,0">
            <ContentPresenter HorizontalAlignment="Left"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="FilterButtonOn" TargetType="{x:Type Button}"
         BasedOn="{StaticResource FilterButton}">
    <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource OrangeBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="5,0">
            <ContentPresenter HorizontalAlignment="Left"
                              VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The box holding All sheets / Included only, so the two read as one
       switch rather than two more chips in a row of them. -->
  <Style x:Key="SwitchBox" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="3"/>
  </Style>

  <Style TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="AlternationCount" Value="2"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="ClipboardCopyMode" Value="ExcludeHeader"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>

  <!-- ==========================================================
       GridSplitter
       ========================================================== -->

  <Style TargetType="{x:Type GridSplitter}">
    <Setter Property="Background" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="ShowsPreview" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type GridSplitter}">
          <Border x:Name="shell" Background="{TemplateBinding Background}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background"
                      Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       Resize grips. A borderless AllowsTransparency window cannot
       be resized by WPF : there is nothing hit testable in its
       transparent frame, so the resize border never fires however
       ResizeMode is set. The window carries its own grips instead.
       ========================================================== -->

  <Style x:Key="GripThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       Progress bar
       ========================================================== -->

  <Style TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Border Background="{TemplateBinding Background}" CornerRadius="2">
            <Grid>
              <Rectangle x:Name="PART_Track"/>
              <Rectangle x:Name="PART_Indicator"
                         HorizontalAlignment="Left"
                         Fill="{TemplateBinding Foreground}"
                         RadiusX="2" RadiusY="2"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Unhide in View"
        Width="1320" Height="800" MinWidth="980" MinHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display">

  <!-- ==================== RevoBIM PY - Unhide in View ==================== -->
  <!-- Layout only. Every brush and style comes from Theme.xaml by DynamicResource. -->

  <Grid x:Name="RootGrid">

    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource WinEdge}" Background="{DynamicResource Bg}">
      <DockPanel LastChildFill="True">

        <!-- ==================== header ==================== -->
        <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource Bar}"
                CornerRadius="6,6,0,0" Padding="12,8,8,8">
          <DockPanel LastChildFill="True">
            <Image x:Name="Logo" DockPanel.Dock="Left" Width="36" Height="36"
                   Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand"
                   ToolTip="RevoBIM Unhide in View"/>
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource Blue}"/>
              <TextBlock x:Name="ToolTitle" Text="Unhide in View" FontSize="15"
                         Foreground="{DynamicResource Orange}" Margin="0,-4,0,0"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ThemeChip" Style="{DynamicResource RbChip}" Margin="0,0,10,0"
                      ToolTip="Theme: Auto follows the Revit canvas, then Dark, then Light">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="12" Height="12" VerticalAlignment="Center">
                    <Ellipse Width="12" Height="12" StrokeThickness="1.4"
                             Stroke="{DynamicResource Text}"/>
                    <Path Data="M6,0 A6,6 0 0 0 6,12 Z" Fill="{DynamicResource Text}"/>
                  </Grid>
                  <TextBlock x:Name="ThemeText" Text="Auto" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="11"
                         Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                         Margin="0,0,10,0"/>
              <Button x:Name="ShrinkBtn" Style="{DynamicResource RbShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen (Ctrl+Shift+H)"/>
              <Button x:Name="FullScreenBtn" Style="{DynamicResource RbWinButton}"
                      ToolTip="Full screen (F11)">
                <Border Width="11" Height="11" BorderThickness="1.5" CornerRadius="1"
                        BorderBrush="{DynamicResource Text}"/>
              </Button>
              <Button x:Name="CloseBtn" Style="{DynamicResource RbCloseButton}" ToolTip="Close">
                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
            </StackPanel>
            <Border/>
          </DockPanel>
        </Border>

        <!-- ==================== footer ==================== -->
        <Border x:Name="FooterBar" DockPanel.Dock="Bottom" Background="{DynamicResource Bar}"
                CornerRadius="0,0,6,6" Padding="12,8,12,8">
          <DockPanel LastChildFill="True">
            <CheckBox x:Name="DebugChk" DockPanel.Dock="Left" Content="Debug"
                      Style="{DynamicResource RbCheck}" VerticalAlignment="Center"
                      ToolTip="Log every step to %APPDATA%\RevoBIM\unhide_in_view_debug.txt"/>
            <Button x:Name="CopyDebugBtn" DockPanel.Dock="Left" Style="{DynamicResource RbButton}"
                    Margin="10,0,0,0" Content="Copy debug"
                    ToolTip="Copy the debug log and settings to the clipboard"/>
            <Button x:Name="UnhideBtn" DockPanel.Dock="Right" Style="{DynamicResource RbGreen}"
                    ToolTip="Unhide the ticked elements in their views, and the ticked categories in the target views">
              <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="10" VerticalAlignment="Center" Margin="0,0,8,0">
                  <Path Data="M0,5 C3,-0.5 13,-0.5 16,5 C13,10.5 3,10.5 0,5 Z" StrokeThickness="1.4"
                        Stroke="{DynamicResource OnAccent}"/>
                  <Ellipse Width="5" Height="5" Fill="{DynamicResource OnAccent}"/>
                </Grid>
                <TextBlock x:Name="UnhideText" Text="Unhide" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Margin="14,0,14,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
        </Border>

        <!-- ==================== body ==================== -->
        <Grid x:Name="BodyGrid" Margin="10,10,10,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="56*" MinWidth="440"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition x:Name="RightCol" Width="44*" MinWidth="340"/>
          </Grid.ColumnDefinitions>

          <!-- ==================== left: hidden elements + categories ==================== -->
          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition x:Name="ElemRow" Height="66*" MinHeight="150"/>
              <RowDefinition Height="8"/>
              <RowDefinition x:Name="CatRow" Height="34*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
              <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="1"
                      Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
              <TextBlock DockPanel.Dock="Left" Text="Hidden elements in" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="ElemCountText" Foreground="{DynamicResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button x:Name="CurrentViewBtn" Style="{DynamicResource RbChip}"
                        Content="Current view"
                        ToolTip="Show the view open in Revit"/>
              </StackPanel>
              <TextBlock x:Name="FocusViewText" Foreground="{DynamicResource Orange}"
                         FontWeight="SemiBold" Margin="6,0,10,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Grid Grid.Row="1">
              <DataGrid x:Name="ElemGrid"/>
              <TextBlock x:Name="ElemEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="0,40,0,0" Foreground="{DynamicResource Muted}"
                         TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <GridSplitter Grid.Row="2" Style="{DynamicResource RbSplitter}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Row="3" LastChildFill="True">
              <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" LastChildFill="True">
                <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="1"
                        Background="{DynamicResource Orange}" Margin="0,0,8,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Hidden categories" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <CheckBox x:Name="ChangeTemplatesChk" Style="{DynamicResource RbCheck}"
                            Content="Also change view templates" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Where a view template controls visibility, unhide the category on the template - every view using it changes"/>
                  <TextBox x:Name="CatSearch" Style="{DynamicResource RbSearch}" Width="170"
                           Tag="Search categories"/>
                </StackPanel>
                <TextBlock x:Name="CatTargetText" Foreground="{DynamicResource Muted}"
                           Margin="8,0,10,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <Grid>
                <DataGrid x:Name="CatGrid"/>
                <TextBlock x:Name="CatEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,30,0,0" Foreground="{DynamicResource Muted}"
                           TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
            </DockPanel>
          </Grid>

          <GridSplitter Grid.Column="1" Style="{DynamicResource RbSplitter}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

          <!-- ==================== right: views ==================== -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
              <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="1"
                      Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
              <TextBlock DockPanel.Dock="Left" Text="Views" FontWeight="SemiBold"
                         Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
              <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Style="{DynamicResource RbChip}"
                      Content="Refresh" ToolTip="Read the model again (F5)"/>
              <TextBlock x:Name="ViewCountText" Foreground="{DynamicResource Muted}"
                         Margin="8,0,10,0" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="ViewSearch" Grid.Column="0" Style="{DynamicResource RbSearch}"
                       Tag="Search views - name or type (Ctrl+F)"/>
              <ToggleButton x:Name="OnlyHiddenToggle" Grid.Column="1" Margin="8,0,0,0"
                            Style="{DynamicResource RbToggle}"
                            ToolTip="List only the views that have elements hidden in them">
                <TextBlock x:Name="OnlyHiddenText" Text="Show views with hidden elements"/>
              </ToggleButton>
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,6">
              <ProgressBar x:Name="ScanBar" Style="{DynamicResource RbProgress}"
                           Minimum="0" Maximum="100" Value="0"/>
              <TextBlock x:Name="ScanText" FontSize="11" Foreground="{DynamicResource Muted}"
                         Margin="0,3,0,0"/>
            </StackPanel>

            <Grid Grid.Row="3">
              <DataGrid x:Name="ViewGrid"/>
              <TextBlock x:Name="ViewEmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Margin="0,30,0,0" Foreground="{DynamicResource Muted}"
                         TextWrapping="Wrap" TextAlignment="Center" IsHitTestVisible="False"/>
            </Grid>

            <DockPanel Grid.Row="4" Margin="0,8,0,0" LastChildFill="True">
              <Button x:Name="UnhideViewsBtn" DockPanel.Dock="Right" Style="{DynamicResource RbOrange}"
                      ToolTip="Unhide every hidden element in each ticked view">
                <TextBlock x:Name="UnhideViewsText" Text="Unhide all in ticked views"/>
              </Button>
              <TextBlock x:Name="TickedText" Foreground="{DynamicResource Muted}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Margin="0,0,10,0"/>
            </DockPanel>
          </Grid>
        </Grid>
      </DockPanel>
    </Border>

    <!-- ==================== confirm overlay ==================== -->
    <Grid x:Name="ConfirmOverlay" Visibility="Collapsed" Background="#99000000">
      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
              BorderThickness="1" CornerRadius="6" Padding="18" MaxWidth="480"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="ConfirmTitle" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource Orange}"/>
          <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" Margin="0,8,0,16"
                     Foreground="{DynamicResource Text}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ConfirmNoBtn" Style="{DynamicResource RbButton}" Content="Cancel"/>
            <Button x:Name="ConfirmYesBtn" Style="{DynamicResource RbOrange}" Margin="8,0,0,0">
              <TextBlock x:Name="ConfirmYesText" Text="OK"/>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ==================== resize grips (no Background: the rest stays clickable) ==================== -->
    <Grid x:Name="GripLayer"/>
  </Grid>
</Window>

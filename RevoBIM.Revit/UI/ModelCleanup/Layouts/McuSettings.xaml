<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Cleanup Export Settings"
        Width="1280" Height="900" MinWidth="1080" MinHeight="780"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="12.5">

    <Grid>
        <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
                Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource WindowEdgeBrush}">
            <Grid x:Name="RootGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ==================== header ==================== -->
                <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBrush}"
                        CornerRadius="6,6,0,0" Padding="12,8,8,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Image x:Name="HeaderIcon" Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <StackPanel x:Name="LogoHost" Grid.Column="1" VerticalAlignment="Center" Background="Transparent">
                            <TextBlock x:Name="LogoText" Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource BlueBrush}" Cursor="Hand"/>
                            <TextBlock Text="Model Cleanup Export Settings" FontSize="15" Margin="1,-3,0,0"
                                       Foreground="{DynamicResource OrangeBrush}"/>
                        </StackPanel>
                        <Button x:Name="ThemeChip" Grid.Column="3" Style="{DynamicResource ChipButton}"
                                Margin="0,0,12,0" VerticalAlignment="Center"
                                ToolTip="Dark or light. Auto follows the Revit canvas.">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="{DynamicResource TextBrush}" StrokeThickness="1.2"/>
                                    <Path Data="M 6,0 A 6,6 0 0 0 6,12 Z" Fill="{DynamicResource TextBrush}"/>
                                </Grid>
                                <TextBlock x:Name="ThemeChipText" Text="Auto Dark" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="VersionText" Grid.Column="4" Text="v0.0.0" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="ShrinkButton" Grid.Column="5" Style="{DynamicResource ShrinkButton}"
                                ToolTip="Shrink to a bar so Revit can be seen (Ctrl+Shift+H)"/>
                        <Button x:Name="FullScreenButton" Grid.Column="6" Style="{DynamicResource WindowButton}"
                                ToolTip="Full screen (F11)">
                            <Border Width="11" Height="11" BorderThickness="1.5" BorderBrush="{DynamicResource MutedBrush}"/>
                        </Button>
                        <Button x:Name="CloseButton" Grid.Column="7" Style="{DynamicResource CloseButton}" ToolTip="Close without saving">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" StrokeThickness="1.6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== body ==================== -->
                <Grid x:Name="BodyGrid" Grid.Row="2" Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{DynamicResource Card}" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="320"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
                                <TextBlock Text="Settings template" Style="{DynamicResource SectionLabel}"/>
                            </StackPanel>
                            <ComboBox x:Name="SettingsTemplateCombo" Grid.Column="1"/>
                            <Button x:Name="ImportTemplateButton" Grid.Column="3" Style="{DynamicResource BaseButton}"
                                    Content="Load from file" Margin="0,0,8,0"
                                    ToolTip="Load a settings template someone sent you"/>
                            <Button x:Name="ExportTemplateButton" Grid.Column="4" Style="{DynamicResource BaseButton}"
                                    Content="Save to file" Margin="0,0,8,0"
                                    ToolTip="Save this template to a file you can keep or send on"/>
                            <Button x:Name="SaveAsNewButton" Grid.Column="5" Style="{DynamicResource BaseButton}"
                                    Content="Save as new template" Margin="0,0,8,0"/>
                            <Button x:Name="DeleteTemplateButton" Grid.Column="6" Style="{DynamicResource RedGhostButton}"
                                    Content="Delete template"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- detach and save, publish -->
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{DynamicResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Detach and save" Style="{DynamicResource SectionLabel}"/>
                                </StackPanel>
                                <RadioButton x:Name="PreserveRadio" GroupName="Detach" Content="Detach, preserve worksets"/>
                                <RadioButton x:Name="DiscardRadio" GroupName="Detach" Content="Detach, discard worksets"/>
                                <CheckBox x:Name="AuditCheck" Content="Audit when opening the copy" Margin="0,8,0,3"/>
                                <CheckBox x:Name="CompactCheck" Content="Compact when saving"/>
                                <CheckBox x:Name="RelinquishDefaultCheck" Content="Relinquish everything on sync"/>
                                <CheckBox x:Name="OpenWhenDoneCheck" Content="Open the cleaned copy on close"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AddSuffixCheck" Content="Suffix" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              ToolTip="Add this to the end of the file name. Untick to keep the model's own name."/>
                                    <TextBox x:Name="FileSuffixBox" Grid.Column="1" Tag="_Issue"/>
                                </Grid>
                                <CheckBox x:Name="AddDateCheck" Content="Add today's date to the name" Margin="0,6,0,3"/>
                                <TextBlock Text="Sync comment" Style="{DynamicResource Muted}" Margin="0,6,0,3"/>
                                <TextBox x:Name="SyncCommentDefaultBox" Tag="Comment written with the sync"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="2" Style="{DynamicResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Publish to ACC" Style="{DynamicResource SectionLabel}"/>
                                </StackPanel>
                                <CheckBox x:Name="OfferPublishCheck" Content="Offer to publish after the sync"/>
                                <TextBlock Text="Links when publishing" Style="{DynamicResource Muted}" Margin="0,6,0,3"/>
                                <ComboBox x:Name="PublishLinksCombo"/>
                                <TextBlock Text="APS app Client ID (all templates)" Style="{DynamicResource Muted}" Margin="0,8,0,3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="64"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ApsClientIdBox" Tag="Client ID" Margin="0,0,6,0"/>
                                    <TextBox x:Name="ApsPortBox" Grid.Column="1" Tag="8765" ToolTip="Sign-in port"/>
                                </Grid>
                                <TextBlock x:Name="ApsCallbackText" Style="{DynamicResource Muted}" Margin="0,6,0,0" Text="-"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ApsHelpButton" Style="{DynamicResource BaseButton}" Content="How to set up"/>
                                    <Button x:Name="SignOutButton" Grid.Column="2" Style="{DynamicResource RedGhostButton}" Content="Sign out"/>
                                </Grid>
                                <TextBlock x:Name="ApsSignedInText" Style="{DynamicResource Muted}" Margin="0,6,0,0" Text="-"/>
                            </StackPanel>
                        </Border>
                        </Grid>

                        <!-- clean up -->
                        <Border Grid.Column="2" Style="{DynamicResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Clean up" Style="{DynamicResource SectionLabel}"/>
                                </StackPanel>
                                <CheckBox x:Name="DeleteSheetsCheck" Content="Delete sheets not retained"
                                          ToolTip="Runs first. Pick the sheets to keep on the Sheets to retain tab."/>
                                <CheckBox x:Name="RemoveLinksCheck" Content="Remove Revit links"/>
                                <CheckBox x:Name="RemoveCadCheck" Content="Remove CAD links and imports"/>
                                <CheckBox x:Name="RemovePointCloudsCheck" Content="Remove point clouds"/>
                                <CheckBox x:Name="DeleteViewsCheck" Content="Delete views not retained or placed"/>
                                <CheckBox x:Name="DeleteSchedulesCheck" Content="Delete schedules not retained or placed"/>
                                <CheckBox x:Name="DeleteLegendsCheck" Content="Delete legends not retained or placed"/>
                                <CheckBox x:Name="DeleteUnplacedImagesCheck" Content="Delete raster images that are not placed"
                                          ToolTip="Runs after the sheets and views, so images only placed on those go too. An image picked in an element's Image parameter stays."/>
                                <CheckBox x:Name="DeleteTemplatesCheck" Content="Delete unused view templates"/>
                                <CheckBox x:Name="DeleteFiltersCheck" Content="Delete unused view filters"/>
                                <TextBlock Text="Keep views whose name contains (; between words)" Style="{DynamicResource Muted}" Margin="0,8,0,3"/>
                                <TextBox x:Name="KeepWordsBox" Tag="KEEP;Starting"/>
                                <CheckBox x:Name="PurgeCheck" Content="Purge unused elements" Margin="0,10,0,3"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Purge passes, after sheets and views (1 to 10)" Style="{DynamicResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBox x:Name="PurgePassesBox" Grid.Column="1" Tag="3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- purge categories, views and sheets to retain -->
                        <Border Grid.Column="4" Style="{DynamicResource Card}">
                            <TabControl x:Name="RightTabs">
                                <TabItem Header="Categories to purge">
                            <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,0,8"
                                                       Text="Unused elements in these categories go in every purge pass."/>
                                            <Button x:Name="RescanButton" Grid.Column="1" Style="{DynamicResource BaseButton}"
                                                    Content="Rescan model" MinHeight="26" Padding="10,2" VerticalAlignment="Top"/>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CategorySearchBox" Tag="Search categories" Margin="0,0,8,0"/>
                                            <Button x:Name="SelectAllButton" Grid.Column="1" Style="{DynamicResource BaseButton}" Content="All" Margin="0,0,6,0"/>
                                            <Button x:Name="SelectNoneButton" Grid.Column="2" Style="{DynamicResource BaseButton}" Content="None" Margin="0,0,12,0"/>
                                            <CheckBox x:Name="ShowUsedCheck" Grid.Column="3" Content="Show used / unused elements"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" MinWidth="220"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="3*" MinWidth="260"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource EdgeBrush}"
                                                        BorderThickness="1,1,1,0" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="56"/>
                                                            <ColumnDefinition x:Name="UsedHeaderColumn" Width="56"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Category" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="Unused" FontWeight="SemiBold" TextAlignment="Right"
                                                                   Foreground="{DynamicResource OrangeBrush}"/>
                                                        <TextBlock x:Name="UsedHeaderText" Grid.Column="2" Text="Used" FontWeight="SemiBold"
                                                                   TextAlignment="Right" Foreground="{DynamicResource GreenBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <ListBox x:Name="CategoryList" Grid.Row="1" SelectionMode="Single"/>
                                            </Grid>
                                            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBox x:Name="ElementSearchBox" Tag="Search elements in the picked category" Margin="0,0,0,6"/>
                                                <DataGrid x:Name="ElementGrid" Grid.Row="1">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Element" Binding="{Binding name}" Width="3*" MinWidth="140"/>
                                                        <DataGridTextColumn Header="Category" Binding="{Binding grp}" Width="2*" MinWidth="90"/>
                                                        <DataGridTextColumn Header="Status" Binding="{Binding status}" Width="*" MinWidth="64"/>
                                                        <DataGridTextColumn Header="Id" Binding="{Binding eid}" Width="*" MinWidth="64"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="CategorySummaryText" Grid.Row="3" Style="{DynamicResource Muted}"
                                                   Margin="0,8,0,0" Text="-"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Views to retain">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="ViewHintText" Style="{DynamicResource Muted}" Margin="0,0,0,8" Text="Ticked views are kept. Views placed on a sheet that stays are always kept. Grouped as the project browser shows them now."/>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBox x:Name="ViewSearchBox" Tag="Search views and folders" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="ViewAllButton" Style="{DynamicResource BaseButton}" Content="Retain shown" Margin="0,0,6,0"/>
                                                <Button x:Name="ViewNoneButton" Style="{DynamicResource BaseButton}" Content="Clear shown" Margin="0,0,6,0"/>
                                                <Button x:Name="ViewCollapseButton" Style="{DynamicResource BaseButton}" Content="Collapse all" Margin="0,0,6,0"/>
                                                <Button x:Name="ViewIsolateButton" Style="{DynamicResource BaseButton}" Content="Retained only" Margin="0" ToolTip="Show only what is ticked to retain"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ListBox x:Name="ViewList" Grid.Row="2" SelectionMode="Single"
                                                 VirtualizingPanel.IsVirtualizing="True"/>
                                        <TextBlock x:Name="ViewSummaryText" Grid.Row="3" Style="{DynamicResource Muted}"
                                                   Margin="0,8,0,0" Text="-"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="Sheets to retain">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="SheetHintText" Style="{DynamicResource Muted}" Margin="0,0,0,8" Text="Ticked sheets are kept when Delete sheets not retained is on. Grouped as the project browser shows them now."/>
                                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBox x:Name="SheetSearchBox" Tag="Search sheets and folders" Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="SheetAllButton" Style="{DynamicResource BaseButton}" Content="Retain shown" Margin="0,0,6,0"/>
                                                <Button x:Name="SheetNoneButton" Style="{DynamicResource BaseButton}" Content="Clear shown" Margin="0,0,6,0"/>
                                                <Button x:Name="SheetCollapseButton" Style="{DynamicResource BaseButton}" Content="Collapse all" Margin="0,0,6,0"/>
                                                <Button x:Name="SheetIsolateButton" Style="{DynamicResource BaseButton}" Content="Retained only" Margin="0" ToolTip="Show only what is ticked to retain"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <ListBox x:Name="SheetList" Grid.Row="2" SelectionMode="Single"
                                                 VirtualizingPanel.IsVirtualizing="True"/>
                                        <TextBlock x:Name="SheetSummaryText" Grid.Row="3" Style="{DynamicResource Muted}"
                                                   Margin="0,8,0,0" Text="-"/>
                                    </Grid>
                                </TabItem>
                                <TabItem Header="NWC export">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ExportNwcCheck" FontWeight="SemiBold"
                                                      Content="Export NWC first, into the folder the detached copy is saved in"/>
                                            <TextBlock x:Name="NwcAvailableText" Grid.Column="1" Style="{DynamicResource Muted}"
                                                       VerticalAlignment="Center" Text="-"/>
                                        </Grid>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="250"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel x:Name="NwcSettingsPanel">
                                                <TextBlock Text="Navisworks export settings" Style="{DynamicResource SectionLabel}" Margin="0,0,0,4"/>
                                                <RadioButton x:Name="NwcDefaultsRadio" GroupName="NwcSource" Content="Navisworks exporter defaults"
                                                             ToolTip="Revit's default NWC options. The settings saved in Revit's own Navisworks dialog cannot be read by an add-in."/>
                                                <RadioButton x:Name="NwcCustomRadio" GroupName="NwcSource" Content="These settings"/>
                                                <StackPanel x:Name="NwcCustomPanel" Margin="0,4,0,0">
                                                    <Grid Margin="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Coordinates" Style="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <ComboBox x:Name="NwcCoordinatesCombo" Grid.Column="1"/>
                                                    </Grid>
                                                    <Grid Margin="0,2,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Parameters" Style="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <ComboBox x:Name="NwcParametersCombo" Grid.Column="1"/>
                                                    </Grid>
                                                <CheckBox x:Name="NwcOpt_nwc_links" Content="Export Revit links"/>
                                                <CheckBox x:Name="NwcOpt_nwc_properties" Content="Convert element properties"/>
                                                <CheckBox x:Name="NwcOpt_nwc_levels" Content="Divide file into levels"/>
                                                <CheckBox x:Name="NwcOpt_nwc_ids" Content="Export element IDs"/>
                                                <CheckBox x:Name="NwcOpt_nwc_parts" Content="Export parts"/>
                                                <CheckBox x:Name="NwcOpt_nwc_room_attr" Content="Export room as attribute"/>
                                                <CheckBox x:Name="NwcOpt_nwc_room_geo" Content="Export room geometry"/>
                                                <CheckBox x:Name="NwcOpt_nwc_urls" Content="Export URLs"/>
                                                <CheckBox x:Name="NwcOpt_nwc_materials" Content="Try to find missing materials"/>
                                                <CheckBox x:Name="NwcOpt_nwc_lights" Content="Convert lights"/>
                                                <CheckBox x:Name="NwcOpt_nwc_linked_cad" Content="Convert linked CAD files"/>
                                                    <Grid Margin="0,4,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Faceting factor (0.1 to 10)" Style="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                                        <TextBox x:Name="NwcFacetingBox" Grid.Column="1" Tag="1"/>
                                                    </Grid>
                                                </StackPanel>
                                            </StackPanel>
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Style="{DynamicResource Muted}" Margin="0,0,0,6"
                                                           Text="Tick the 3D views to export. The primary is named after the model; the others get _view name added."/>
                                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                                    <TextBox x:Name="NwcSearchBox" Tag="Search 3D views" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="NwcAllButton" Style="{DynamicResource BaseButton}" Content="Tick shown" Margin="0,0,6,0"/>
                                                        <Button x:Name="NwcNoneButton" Style="{DynamicResource BaseButton}" Content="Clear shown" Margin="0,0,6,0"/>
                                                        <Button x:Name="NwcIsolateButton" Style="{DynamicResource BaseButton}" Content="Ticked only" Margin="0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <ListBox x:Name="NwcViewList" Grid.Row="2" SelectionMode="Single"
                                                         VirtualizingPanel.IsVirtualizing="True"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="NwcSummaryText" Grid.Row="2" Style="{DynamicResource Muted}"
                                                   Margin="0,8,0,0" Text="-"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ==================== progress ==================== -->
                <Border x:Name="ProgressPanel" Grid.Row="3" Background="{DynamicResource BarBrush}"
                        BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0"
                        Padding="14,10,14,6" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="ProgressTrack" Height="24">
                            <Border CornerRadius="12" Background="{DynamicResource FieldBrush}"
                                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"/>
                            <Border x:Name="ProgressFill" CornerRadius="12" HorizontalAlignment="Left"
                                    Width="0" Background="{DynamicResource BlueBrush}"/>
                            <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="4,6,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ProgressStage" Text="" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="ProgressEta" Grid.Column="1" Text="" Margin="16,0,0,0"
                                       Foreground="{DynamicResource MutedBrush}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ==================== footer ==================== -->
                <Border x:Name="FooterBar" Grid.Row="4" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" Text="Ready"/>
                        <Button x:Name="CancelButton" Grid.Column="1" Style="{DynamicResource BaseButton}"
                                Content="Cancel" Margin="0,0,8,0"/>
                        <Button x:Name="SaveButton" Grid.Column="2" Style="{DynamicResource GreenButton}" Content="Save Settings"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="GripLayer">
            <Thumb x:Name="GripN" Style="{DynamicResource GripThumb}" Height="5" VerticalAlignment="Top" Margin="8,0" Cursor="SizeNS"/>
            <Thumb x:Name="GripS" Style="{DynamicResource GripThumb}" Height="5" VerticalAlignment="Bottom" Margin="8,0" Cursor="SizeNS"/>
            <Thumb x:Name="GripW" Style="{DynamicResource GripThumb}" Width="5" HorizontalAlignment="Left" Margin="0,8" Cursor="SizeWE"/>
            <Thumb x:Name="GripE" Style="{DynamicResource GripThumb}" Width="5" HorizontalAlignment="Right" Margin="0,8" Cursor="SizeWE"/>
            <Thumb x:Name="GripNW" Style="{DynamicResource GripThumb}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
            <Thumb x:Name="GripNE" Style="{DynamicResource GripThumb}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
            <Thumb x:Name="GripSW" Style="{DynamicResource GripThumb}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
            <Thumb x:Name="GripSE" Style="{DynamicResource GripThumb}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
        </Grid>
    </Grid>
</Window>

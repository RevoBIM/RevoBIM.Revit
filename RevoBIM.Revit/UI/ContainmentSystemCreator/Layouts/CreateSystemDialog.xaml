<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Create Containment System"
        Height="712" Width="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

  <Window.Resources>

    <SolidColorBrush x:Key="WinBg"    Color="#FF3C4454"/>
    <SolidColorBrush x:Key="PanelBg"  Color="#FF343C4A"/>
    <SolidColorBrush x:Key="FieldBg"  Color="#FF2D3441"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="#FF4E5665"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8F0F8"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF9DA4B2"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#FF4FA3E3"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FFE8912D"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#FF3FA75A"/>
    <SolidColorBrush x:Key="GreenHover" Color="#FF4EC06D"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FFD9534F"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="#FF46505F" BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF55606F"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF323C48"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{StaticResource GreenBrush}" BorderBrush="#FF2E8446"
                    BorderThickness="1" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource GreenHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF2E8446"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#FF33443A"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#FF33443A"/>
                <Setter Property="Foreground" Value="#FF7C8A80"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Shrink to taskbar: grey hover, never takes focus so Enter cannot press it -->
    <Style x:Key="ShrinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF46505F"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FFC0392B"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource FieldBg}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource BlueBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ComboBox : dark -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
      <Border x:Name="bd" Background="{StaticResource FieldBg}"
              BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="3">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
          </Grid.ColumnDefinitions>
          <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 0,0 L 9,0 L 4.5,5.5 Z" Fill="#FF9DA4B2"/>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF404853"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="MaxDropDownHeight" Value="320"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                            Template="{StaticResource ComboToggleTemplate}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                Margin="9,0,28,0" VerticalAlignment="Center"
                                HorizontalAlignment="Left"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                     AllowsTransparency="True"
                     IsOpen="{TemplateBinding IsDropDownOpen}">
                <Grid MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border Background="#FF2D3441" BorderBrush="#FF4E5665"
                          BorderThickness="1" CornerRadius="3"/>
                  <ScrollViewer Margin="3" SnapsToDevicePixels="True">
                    <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FF7B8290"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="box" Width="15" Height="15" CornerRadius="2"
                      Background="{StaticResource FieldBg}"
                      BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="tick" Visibility="Collapsed" Stretch="Uniform" Margin="2.5"
                      Data="M 0,4 L 3.5,7.5 L 9,0.5" Stroke="#FF4EC06D" StrokeThickness="2"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#FF4EC06D"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border Background="{StaticResource WinBg}" BorderBrush="#FF5A6372"
          BorderThickness="1" CornerRadius="6">
    <Grid Margin="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- HEADER -->
      <Border x:Name="header_bar" Grid.Row="0" Background="#FF212932" CornerRadius="5,5,0,0"
              MouseLeftButtonDown="drag_window">
        <Grid Margin="14,10,10,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="app_icon" Grid.Column="0" Width="26" Height="26"
                 VerticalAlignment="Center" Margin="0,0,10,0"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="dialog_title" Text="New System" FontSize="14" Margin="10,0,0,0"
                       Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Bottom"
                       Padding="0,0,0,2"/>
          </StackPanel>
          <TextBlock x:Name="version_text" Grid.Column="3" Text="v1.4.1" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <Button x:Name="shrink_btn" Grid.Column="4" Style="{StaticResource ShrinkButton}"
                  Margin="0,0,2,0">
            <Grid Width="14" Height="14">
              <Path x:Name="shrink_glyph"
                    Data="M 7,1.5 L 7,9 M 3.5,5.5 L 7,9 L 10.5,5.5 M 2,12.5 L 12,12.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
              <Path x:Name="expand_glyph" Visibility="Collapsed"
                    Data="M 7,12.5 L 7,2.5 M 2.5,7 L 7,2.5 L 11.5,7"
                    Stroke="{StaticResource GreenHover}"
                    StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
            </Grid>
          </Button>
          <Button Grid.Column="5" Style="{StaticResource ChromeButton}"
                  Content="&#x2715;" Click="cancel_clicked"/>
        </Grid>
      </Border>

      <!-- BODY -->
      <Grid Grid.Row="1" Margin="18,14,18,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="176"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1 kind -->
        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="Containment kind"/>
        <ComboBox x:Name="cmb_kind" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                  SelectionChanged="kind_changed"/>

        <!-- 2 source -->
        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="Source type to duplicate"/>
        <ComboBox x:Name="cmb_source" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                  SelectionChanged="source_changed"/>

        <!-- 3 name -->
        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="New service type name"/>
        <TextBox x:Name="txt_name" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                 TextChanged="name_changed"/>

        <!-- 4 full new type name (auto, editable) -->
        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="Full new type name"/>
        <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="txt_fullname" Grid.Column="0"
                   TextChanged="fullname_edited"/>
          <Button Grid.Column="1" Style="{StaticResource FlatButton}"
                  Content="Auto" Padding="10,4" Margin="8,0,0,0"
                  ToolTip="Rebuild the name from the kind and service name"
                  Click="reset_fullname"/>
        </Grid>

        <!-- 5 function -->
        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="BGL_Function value"/>
        <TextBox x:Name="txt_function" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"
                 TextChanged="mirror_edited"/>

        <!-- 6 type mark -->
        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="BGL_Type Mark value"/>
        <TextBox x:Name="txt_mark" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"
                 TextChanged="mirror_edited"/>

        <!-- 7 fitting naming -->
        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FieldLabel}"
                   Text="Fitting type naming"/>
        <ComboBox x:Name="cmb_fitname" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"
                  SelectionChanged="source_changed"/>

        <!-- 8 options -->
        <CheckBox x:Name="chk_params_on_fittings" Grid.Row="7" Grid.Column="1"
                  Margin="0,2,0,6" IsChecked="True" Click="source_changed_evt"
                  Content="Write BGL_Function and Type Mark onto the fitting types too"/>
        <CheckBox x:Name="chk_select_after" Grid.Row="8" Grid.Column="1"
                  Margin="0,0,0,12" IsChecked="True"
                  Content="Show a summary of everything created when finished"/>

        <!-- 9 preview -->
        <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{StaticResource PanelBg}" BorderBrush="{StaticResource EdgeBrush}"
                BorderThickness="1" CornerRadius="4" Padding="14,12">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="4" Height="14" CornerRadius="2"
                      Background="{StaticResource OrangeBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="13"
                         VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="preview_head" Grid.Row="1" Margin="0,0,0,8" TextWrapping="Wrap"
                       Foreground="{StaticResource BlueBrush}" FontFamily="Consolas"
                       FontSize="13" Text=""/>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="preview_body" TextWrapping="NoWrap"
                         Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"
                         FontSize="11" Text=""/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- FOOTER -->
      <Border Grid.Row="2" Background="#FF212932" CornerRadius="0,0,5,5">
        <Grid Margin="18,10,18,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="warn_text" Grid.Column="0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{StaticResource RedBrush}" Text=""/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource FlatButton}" Content="Cancel"
                    Padding="16,7" Margin="0,0,10,0" Click="cancel_clicked"/>
            <Button x:Name="btn_create" Style="{StaticResource GreenButton}"
                    Content="Create System" Padding="22,7" Click="create_clicked"/>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

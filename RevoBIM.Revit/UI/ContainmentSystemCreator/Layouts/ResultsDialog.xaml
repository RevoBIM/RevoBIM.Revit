<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Result"
        Height="520" Width="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

  <Window.Resources>
    <SolidColorBrush x:Key="WinBg"    Color="#FF3C4454"/>
    <SolidColorBrush x:Key="FieldBg"  Color="#FF2D3441"/>
    <SolidColorBrush x:Key="EdgeBrush" Color="#FF4E5665"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFE8F0F8"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#FF9DA4B2"/>
    <SolidColorBrush x:Key="BlueBrush" Color="#FF4FA3E3"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FFE8912D"/>
    <SolidColorBrush x:Key="GreenBrush" Color="#FF3FA75A"/>
    <SolidColorBrush x:Key="GreenHover" Color="#FF4EC06D"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <Style x:Key="FlatButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="20,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="#FF46505F" BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF55606F"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource OrangeBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Shrink to taskbar: grey hover, never takes focus so Enter cannot press it -->
    <Style x:Key="ShrinkButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF46505F"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource WinBg}" BorderBrush="#FF5A6372"
          BorderThickness="1" CornerRadius="6">
    <Grid Margin="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="header_bar" Grid.Row="0" Background="#FF212932" CornerRadius="5,5,0,0"
              MouseLeftButtonDown="drag_window">
        <Grid Margin="14,10,10,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="app_icon" Grid.Column="0" Width="26" Height="26"
                 VerticalAlignment="Center" Margin="0,0,10,0"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="dialog_title" Text="System Created" FontSize="14" Margin="10,0,0,0"
                       Foreground="{StaticResource OrangeBrush}" VerticalAlignment="Bottom"
                       Padding="0,0,0,2"/>
          </StackPanel>
          <TextBlock x:Name="version_text" Grid.Column="3" Text="v1.4.1" FontSize="11"
                     Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <Button x:Name="shrink_btn" Grid.Column="4" Style="{StaticResource ShrinkButton}">
            <Grid Width="14" Height="14">
              <Path x:Name="shrink_glyph"
                    Data="M 7,1.5 L 7,9 M 3.5,5.5 L 7,9 L 10.5,5.5 M 2,12.5 L 12,12.5"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
              <Path x:Name="expand_glyph" Visibility="Collapsed"
                    Data="M 7,12.5 L 7,2.5 M 2.5,7 L 7,2.5 L 11.5,7"
                    Stroke="{StaticResource GreenHover}"
                    StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
            </Grid>
          </Button>
        </Grid>
      </Border>

      <TextBlock x:Name="headline" Grid.Row="1" Margin="18,14,18,10" TextWrapping="Wrap"
                 FontSize="14" FontWeight="SemiBold"
                 Foreground="{StaticResource GreenBrush}" Text=""/>

      <Border Grid.Row="2" Margin="18,0,18,12" Background="{StaticResource FieldBg}"
              BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1" CornerRadius="4">
        <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <TextBlock x:Name="body" FontFamily="Consolas" FontSize="12"
                     Foreground="{StaticResource TextBrush}" Text=""/>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="3" Background="#FF212932" CornerRadius="0,0,5,5">
        <Grid Margin="18,10,18,12">
          <Button HorizontalAlignment="Right" Style="{StaticResource FlatButton}"
                  Content="OK" Click="ok_clicked" IsDefault="True"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

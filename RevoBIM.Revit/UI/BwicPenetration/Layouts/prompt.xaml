<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM BWIC Penetration - next step"
        Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Focusable="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI" Foreground="#FFEEF1F5">

    <!-- The step prompt. It never takes focus and lets every click through
         to Revit underneath. It only says what to pick next, so it must not
         be the thing that stops Return finishing a selection. -->
    <Window.Resources>
        <!-- Revit dark theme palette, as the tool window -->
        <SolidColorBrush x:Key="BgShell"  Color="#FF3C4454"/>
        <SolidColorBrush x:Key="BgField"  Color="#FF2D3441"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFEEF1F5"/>
        <SolidColorBrush x:Key="TextDim"  Color="#FF9DA4B2"/>
        <SolidColorBrush x:Key="Blue"     Color="#FF4A9EDB"/>
        <SolidColorBrush x:Key="Green"    Color="#FF3FA75A"/>
        <SolidColorBrush x:Key="Orange"   Color="#FFE8862A"/>
    </Window.Resources>

    <!-- a little margin so the drop shadow is not clipped -->
    <Border Margin="10" Background="{StaticResource BgShell}"
            BorderBrush="{StaticResource Blue}" BorderThickness="1.5" CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45"
                              Color="#FF000000"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- blue for a step, green when placed, orange when not -->
            <Border x:Name="accent_bd" Grid.Column="0" CornerRadius="6,0,0,6"
                    Background="{StaticResource Blue}"/>

            <StackPanel Grid.Column="1" Margin="14,11,16,12">
                <Grid>
                    <TextBlock x:Name="eyebrow_tb" Text="STEP 1 OF 2"
                               FontSize="10.5" FontWeight="Bold"
                               Foreground="{StaticResource Blue}"/>
                    <TextBlock x:Name="dots_tb" Text="" FontSize="10"
                               HorizontalAlignment="Right"
                               Foreground="{StaticResource TextDim}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="icon_tb" Text="" FontSize="17"
                               FontWeight="Bold" Margin="0,0,7,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Green}"/>
                    <TextBlock x:Name="title_tb" Text="Select the services"
                               FontSize="16" FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource TextMain}"/>
                </StackPanel>
                <TextBlock x:Name="detail_tb" TextWrapping="Wrap" FontSize="12"
                           Margin="0,4,0,0" Foreground="{StaticResource TextDim}"
                           Text=""/>
                <Border x:Name="hint_bd" Background="{StaticResource BgField}"
                        CornerRadius="3" Padding="8,4" Margin="0,9,0,0"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="hint_tb" FontSize="11"
                               Foreground="{StaticResource TextMain}" Text=""/>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM BWIC Penetration - Global Placement results"
        Height="430" Width="470"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#FFEEF1F5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Revit dark theme palette, sampled from Revit 2024's own
             Project Browser: blue-grey, not neutral grey -->
        <SolidColorBrush x:Key="BgShell"  Color="#FF3C4454"/>
        <SolidColorBrush x:Key="BgPanel"  Color="#FF323C48"/>
        <SolidColorBrush x:Key="BgField"  Color="#FF2D3441"/>
        <SolidColorBrush x:Key="BgCanvas" Color="#FF2D3441"/>
        <SolidColorBrush x:Key="Line"     Color="#FF505968"/>
        <SolidColorBrush x:Key="LineSoft" Color="#FF404353"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFEEF1F5"/>
        <SolidColorBrush x:Key="TextDim"  Color="#FF9DA4B2"/>
        <SolidColorBrush x:Key="Blue"     Color="#FF4A9EDB"/>
        <SolidColorBrush x:Key="Orange"   Color="#FFE8862A"/>
        <SolidColorBrush x:Key="Green"    Color="#FF3FA75A"/>
        <SolidColorBrush x:Key="BlueHover" Color="#FF5FAEE6"/>
        <SolidColorBrush x:Key="BlueDown"  Color="#FF3A7FB0"/>
        <SolidColorBrush x:Key="RedSoft"   Color="#FFB0655C"/>
        <SolidColorBrush x:Key="RedSoftLine" Color="#FF7A4842"/>
        <SolidColorBrush x:Key="Red"      Color="#FFC0392B"/>
        <SolidColorBrush x:Key="RedHover" Color="#FFD9483A"/>
        <SolidColorBrush x:Key="RedDown"  Color="#FF992D22"/>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Blue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Blue}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource BlueHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource BlueDown}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background"
                                        Value="#FF465062"/>
                                <Setter Property="Foreground" Value="#FF7B8290"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FF4A5366"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- window chrome close button -->
        <Style x:Key="ChromeClose" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Red}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shrink to the taskbar: the glyph is a template, swapped to a
             green up arrow by Tag="shrunk" -->
        <Style x:Key="ChromeShrink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Tag" Value=""/>
            <Setter Property="ToolTip" Value="Shrink to the taskbar  (Ctrl+Shift+H)"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="&#x2913;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Line}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="shrunk">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="&#x2912;" FontWeight="Bold"
                                           Foreground="{StaticResource Green}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tbd"
                                                Background="{StaticResource BgField}"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Data="M 0 0 L 9 0 L 4.5 5 Z"
                                                  Fill="{StaticResource TextDim}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tbd" Property="BorderBrush"
                                                        Value="{StaticResource Blue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource BgPanel}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DimCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource BgShell}"
            BorderBrush="#FF212932" BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- heading, doubles as the drag bar -->
            <StackPanel x:Name="header_pnl" Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="drag_window">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource Blue}"
                                   TextWrapping="NoWrap" Margin="0,0,0,-2"/>
                        <TextBlock Text="Global placement complete" FontSize="15"
                                   Foreground="{StaticResource Orange}"
                                   TextWrapping="NoWrap"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0">
                        <TextBlock x:Name="version_tb" Text="v0.0.0" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextDim}"/>
                        <Button x:Name="shrink_btn" Style="{StaticResource ChromeShrink}"
                                Click="shrink_click"/>
                        <Button Style="{StaticResource ChromeClose}" Content="&#x2715;"
                                Click="close_click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource Orange}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- the numbers -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="2" Padding="10,12">
                    <StackPanel>
                        <TextBlock x:Name="placed_val" Text="0" FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Blue}"/>
                        <TextBlock x:Name="placed_cap" Text="BWIC placed"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource Red}" BorderThickness="1"
                        CornerRadius="2" Padding="10,12">
                    <StackPanel>
                        <TextBlock x:Name="review_val" Text="0" FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Red}"/>
                        <TextBlock Text="overlapping - to review"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{StaticResource BgPanel}"
                        BorderBrush="{StaticResource RedSoftLine}"
                        BorderThickness="1"
                        CornerRadius="2" Padding="10,12">
                    <StackPanel>
                        <TextBlock x:Name="failed_val" Text="0" FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource RedSoft}"/>
                        <TextBlock Text="failed to place"
                                   FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextDim}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- the rest of the numbers -->
            <TextBlock Grid.Row="2" x:Name="detail_tb" Text="" FontSize="12"
                       TextWrapping="Wrap" Margin="2,12,0,0"
                       Foreground="{StaticResource TextDim}"/>

            <!-- what to do about it -->
            <Border Grid.Row="3" Background="{StaticResource BgCanvas}"
                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                    CornerRadius="2" Padding="10,8" Margin="0,12,0,0"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2139;" FontSize="14" Margin="0,0,8,0"
                               VerticalAlignment="Top"
                               Foreground="{StaticResource Blue}"/>
                    <StackPanel Width="375">
                        <TextBlock x:Name="note_tb" TextWrapping="Wrap"
                                   FontSize="11.5" Text=""
                                   Foreground="{StaticResource TextDim}"/>
                        <TextBlock x:Name="warn_tb" TextWrapping="Wrap"
                                   FontSize="11" Text="" Margin="0,6,0,0"
                                   Foreground="{StaticResource RedSoft}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- actions -->
            <Grid Grid.Row="4" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="select_btn" Grid.Column="0"
                        Style="{StaticResource FlatButton}"
                        Content="Select the overlapping BWICs" Click="select_click"
                        ToolTip="Select and zoom to the BWICs that need reviewing"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                        Content="Close" Width="80" Click="close_click"/>
            </Grid>

        </Grid>
    </Border>
</Window>


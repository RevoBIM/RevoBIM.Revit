<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM BWIC Penetration Settings"
        Height="620" Width="470"
        WindowStyle="None"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Transparent"
        Foreground="#FFEEF1F5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Revit dark theme palette, sampled from Revit 2024's own
             Project Browser: blue-grey, not neutral grey -->
        <SolidColorBrush x:Key="BgShell"  Color="#FF3C4454"/>
        <SolidColorBrush x:Key="BgPanel"  Color="#FF323C48"/>
        <SolidColorBrush x:Key="BgField"  Color="#FF2D3441"/>
        <SolidColorBrush x:Key="BgCanvas" Color="#FF2D3441"/>
        <SolidColorBrush x:Key="Line"     Color="#FF505968"/>
        <SolidColorBrush x:Key="LineSoft" Color="#FF404353"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFEEF1F5"/>
        <SolidColorBrush x:Key="TextDim"  Color="#FF9DA4B2"/>
        <SolidColorBrush x:Key="Blue"     Color="#FF4A9EDB"/>
        <SolidColorBrush x:Key="Orange"   Color="#FFE8862A"/>
        <SolidColorBrush x:Key="Green"    Color="#FF3FA75A"/>
        <SolidColorBrush x:Key="Red"      Color="#FFC0392B"/>
        <SolidColorBrush x:Key="RedHover" Color="#FFD9483A"/>
        <SolidColorBrush x:Key="RedDown"  Color="#FF992D22"/>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Blue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Red}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource RedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource RedDown}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background"
                                        Value="#FF465062"/>
                                <Setter Property="Foreground" Value="#FF7B8290"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource Orange}"/>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FF4A5366"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- window chrome close button -->
        <Style x:Key="ChromeClose" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Red}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shrink to the taskbar: the glyph is a template, swapped to a
             green up arrow by Tag="shrunk" -->
        <Style x:Key="ChromeShrink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Tag" Value=""/>
            <Setter Property="ToolTip" Value="Shrink to the taskbar  (Ctrl+Shift+H)"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="&#x2913;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Line}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="shrunk">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="&#x2912;" FontWeight="Bold"
                                           Foreground="{StaticResource Green}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tbd"
                                                Background="{StaticResource BgField}"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Data="M 0 0 L 9 0 L 4.5 5 Z"
                                                  Fill="{StaticResource TextDim}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tbd" Property="BorderBrush"
                                                        Value="{StaticResource Blue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource BgPanel}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DimCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- tabs -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tab" Background="{StaticResource BgField}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="2,2,0,0" Margin="0,0,3,0"
                                Padding="16,7">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tab" Property="Background"
                                        Value="{StaticResource BgPanel}"/>
                                <Setter TargetName="tab" Property="BorderBrush"
                                        Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMain}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMain}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True"
                                      Panel.ZIndex="1"/>
                            <Border Grid.Row="1"
                                    Background="{StaticResource BgPanel}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="0,2,2,2">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small header glyph button, e.g. the settings gear -->
        <Style x:Key="ChromeGlyph" TargetType="Button" BasedOn="{StaticResource ChromeClose}">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <Border Background="{StaticResource BgShell}"
            BorderBrush="#FF212932" BorderThickness="1"
            CornerRadius="6">
        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="header_pnl" Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="drag_window">
                <Grid>
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="RevoBIM" FontSize="20" FontWeight="Bold"
                             Foreground="{StaticResource Blue}"/>
                        <Run Text=" BWIC Settings" FontSize="15"
                             Foreground="{StaticResource TextMain}"/>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0">
                        <Button x:Name="shrink_btn" Style="{StaticResource ChromeShrink}"
                                Click="shrink_click"/>
                        <Button Style="{StaticResource ChromeClose}" Content="&#x2715;"
                                Click="cancel_click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource Orange}" Margin="0,10,0,0"/>
            </StackPanel>

            <TabControl x:Name="settings_tabs" Grid.Row="1" Margin="0,14,0,0"
                        Style="{StaticResource DarkTabControl}"
                        ItemContainerStyle="{StaticResource DarkTabItem}">

                <TabItem Header="Wall">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">

                            <TextBlock Text="Round width and height up to, mm"
                                       Style="{StaticResource SectionHead}"/>
                            <TextBox x:Name="w_round_tb" Style="{StaticResource FieldBox}"
                                     Width="100" HorizontalAlignment="Left" Margin="0,0,0,12"/>

                            <TextBlock Text="Family types by wall kind"
                                       Style="{StaticResource SectionHead}"/>
                            <TextBlock Text="Blockwork - Type Name contains BLK"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                            <TextBox x:Name="w_blk_tb" Style="{StaticResource FieldBox}"
                                     Margin="0,0,0,8"/>
                            <TextBlock Text="Fire rated - Type Name contains FR or a fire rating"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,4"
                                       TextWrapping="Wrap"/>
                            <TextBox x:Name="w_fr_tb" Style="{StaticResource FieldBox}"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Slab">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12">



                            <TextBlock Text="Placement rule"
                                       Style="{StaticResource SectionHead}"/>
                            <TextBlock Text="Two levels: the family carries Base Level, Top Level and offsets. Single level: it sits on the nearest level and carries its own height."
                                       FontSize="11" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ComboBox x:Name="s_rule_cb" Style="{StaticResource DarkCombo}"
                                      Margin="0,0,0,14"/>

                            <TextBlock Text="Opening in plan"
                                       Style="{StaticResource SectionHead}"/>
                            <TextBlock Text="Sized around the services the same way the wall tool works"
                                       FontSize="11" Foreground="{StaticResource TextDim}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Border Background="{StaticResource BgCanvas}"
                                    BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="2"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Round up to, mm"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="s_round_tb" Style="{StaticResource FieldBox}" Margin="0,0,0,0"/>
                                        </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCanvas}"
                                    BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="2"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Circular openings"
                                               Style="{StaticResource SectionHead}"/>
                                    <TextBlock Text="One opening per pipe or conduit on its own. The rounding is on the Slab tab as well - either place changes the same setting. The gap around the pipe is the family's clearance, in its Family settings. Whether the family takes a diameter or a radius is in its Family settings."
                                               FontSize="11" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Round up to, mm"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="s_diaround_tb" Style="{StaticResource FieldBox}" Margin="0,0,0,0"/>
                                        </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource BgCanvas}"
                                    BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="2"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Grouping"
                                               Style="{StaticResource SectionHead}"/>
                                    <TextBlock Text="Trays and ducts closer than the first figure share one opening, sized to encompass them all. A pipe within the second figure of such a group joins it instead of getting its own round hole."
                                               FontSize="11" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Trays group within, mm"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="s_group_tb" Style="{StaticResource FieldBox}" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="and pointing within, deg"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="s_groupangle_tb" Style="{StaticResource FieldBox}" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Pipe joins within, mm"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="s_pipegap_tb" Style="{StaticResource FieldBox}" Margin="0,0,0,0"/>
                                        </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="s_single_panel"
                                    Background="{StaticResource BgCanvas}"
                                    BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="2"
                                    Padding="10" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Single level family"
                                               Style="{StaticResource SectionHead}"/>
                                    <TextBlock Text="Placed on the nearest level. The vertical height is set to the floor thickness. Which parameters take the height, top and offset is in Family settings."
                                               FontSize="11" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Height = floor +, mm"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,10,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="s_heightextra_tb" Style="{StaticResource FieldBox}" Margin="0,0,0,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Top = floor top +, mm"
                                                       Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="s_topheightextra_tb" Style="{StaticResource FieldBox}" Margin="0,0,0,0"/>
                                        </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="s_two_panel"
                                    Background="{StaticResource BgCanvas}"
                                    BorderBrush="{StaticResource LineSoft}"
                                    BorderThickness="1" CornerRadius="2"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="Two levels based family"
                                               Style="{StaticResource SectionHead}"/>
                                    <TextBlock Text="The family carries Base Level, Top Level and their offsets. Which parameters those are is set per family in Family settings - leave them blank there to use Revit's own."
                                               FontSize="11" Foreground="{StaticResource TextDim}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="2" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Workset"
                               Style="{StaticResource SectionHead}"/>
                    <TextBlock Text="Every penetration this tool places goes on this workset, wall and slab alike"
                               FontSize="11" Foreground="{StaticResource TextDim}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ComboBox x:Name="s_workset_cb" Style="{StaticResource DarkCombo}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                        Content="Cancel" Width="90" Click="cancel_click"/>
                <Button Grid.Column="3" Style="{StaticResource FlatButton}"
                        Content="Apply" Width="90" Click="apply_click"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find in View"
        Width="1040" Height="860" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12.5">

  <Border x:Name="RootBorder" CornerRadius="6" Margin="6"
          Background="{DynamicResource WindowBg}"
          BorderBrush="{DynamicResource ChromeEdge}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
    </Border.Effect>

    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ===================== header ===================== -->

      <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="5,5,0,0"
              Background="{DynamicResource BarBg}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
              Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="HeaderIcon" Grid.Column="0" Width="30" Height="30"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource BlueBrush}"/>
            <TextBlock x:Name="TitleTool" Text="Find in View" FontSize="15"
                       Margin="1,-3,0,0"
                       Foreground="{DynamicResource OrangeBrush}"/>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="3" Content="Light"
                  Style="{DynamicResource ChipButton}" VerticalAlignment="Center"
                  Margin="0,0,12,0" ToolTip="Switch between the dark and light palette"/>

          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v1.0.0" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,10,0"
                     Foreground="{DynamicResource MutedBrush}"/>

<Button x:Name="ShrinkBtn" Grid.Column="5"
                  Style="{DynamicResource ChromeButton}"
                  ToolTip="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)">
            <Grid Width="12" Height="12">
              <Path x:Name="PathShrink" StrokeThickness="1.4"
                    Stroke="{DynamicResource MutedBrush}"
                    Data="M 6,0.5 L 6,7 M 3,4.2 L 6,7.4 L 9,4.2 M 1.5,10.5 L 10.5,10.5"/>
              <Path x:Name="PathExpand" StrokeThickness="1.6" Visibility="Collapsed"
                    Stroke="{DynamicResource GreenBrush}"
                    Data="M 6,11 L 6,4.5 M 3,7.3 L 6,4.1 L 9,7.3 M 1.5,1 L 10.5,1"/>
            </Grid>
          </Button>

          <Button x:Name="FullScreenBtn" Grid.Column="6"
                  Style="{DynamicResource ChromeButton}" ToolTip="Full screen (F11)">
            <Grid Width="12" Height="12">
              <Border BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1.4"
                      CornerRadius="1"/>
            </Grid>
          </Button>

          <Button x:Name="CloseBtn" Grid.Column="7" Content="&#x2715;"
                  Style="{DynamicResource CloseButton}" ToolTip="Close (Esc)"/>
        </Grid>
      </Border>

      <!-- ===================== body ===================== -->

      <Grid Grid.Row="1" Margin="12,10,12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="PanelColumn" Width="300*" MinWidth="250"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition x:Name="ListColumn" Width="700*" MinWidth="380"/>
        </Grid.ColumnDefinitions>

        <!-- ============ left: what is selected, and the filters ============ -->

        <Border Grid.Column="0" CornerRadius="5" Padding="12,10"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
          <ScrollViewer x:Name="LeftScroll" Focusable="False"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="0,0,2,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                      Background="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Selection" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,12">
              <TextBlock x:Name="SelectionText" TextWrapping="Wrap"
                         FontSize="12" Margin="0,0,0,8"
                         Foreground="{DynamicResource MutedBrush}"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="IdBox" Grid.Column="0"
                         Tag="Element id, or several"
                         Style="{DynamicResource ThemedTextBox}"
                         ToolTip="Type an element id and press Find to select it in Revit and work on it here"/>
                <Button x:Name="FindIdBtn" Grid.Column="1" Content="Find"
                        Style="{DynamicResource ThemedButton}" Margin="8,0,0,0"
                        IsEnabled="False"/>
              </Grid>

              <TextBlock x:Name="IdStatus" TextWrapping="Wrap" FontSize="11"
                         Margin="2,6,0,0"
                         Foreground="{DynamicResource MutedBrush}"/>

              <Border x:Name="PropsCard" CornerRadius="4" Margin="0,8,0,0"
                      Padding="10,8" Visibility="Collapsed"
                      Background="{DynamicResource FieldBg}"
                      BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
                <StackPanel x:Name="PropsPanel"/>
              </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                      Background="{DynamicResource OrangeBrush}"/>
              <TextBlock Text="View types" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBlock x:Name="TypeCountText" FontSize="11" Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TypeSearch" Grid.Column="0" Tag="Search view types"
                       Style="{DynamicResource ThemedTextBox}"/>
              <Button x:Name="TypeAll" Grid.Column="1" Content="All"
                      Style="{DynamicResource LinkButton}" Margin="8,0,0,0"/>
              <Button x:Name="TypeNone" Grid.Column="2" Content="None"
                      Style="{DynamicResource LinkButton}" Margin="6,0,0,0"/>
            </Grid>

            <ListBox x:Name="ViewTypeList" Grid.Row="4" MinHeight="110"
                     VirtualizingStackPanel.IsVirtualizing="False"
                     Style="{DynamicResource ThemedListBox}"/>

            <StackPanel Grid.Row="5" Margin="0,12,0,0">
              <Button x:Name="WhereHeader" Style="{DynamicResource DropHeaderButton}"
                      ToolTip="Show or hide the options for where the view opens">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="4" Height="15" CornerRadius="2"
                          Margin="0,0,8,0" VerticalAlignment="Center"
                          Background="{DynamicResource OrangeBrush}"/>
                  <TextBlock Grid.Column="1" Text="Where it opens" FontSize="13"
                             FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock x:Name="WhereSummary" Grid.Column="2" FontSize="11"
                             Margin="8,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource MutedBrush}"/>
                  <Grid Grid.Column="3" Width="10" Height="10" Margin="8,0,2,0"
                        VerticalAlignment="Center">
                    <Path x:Name="PathWhereClosed" StrokeThickness="1.5"
                          Stroke="{DynamicResource MutedBrush}"
                          Data="M 2.5,1 L 7,5 L 2.5,9"/>
                    <Path x:Name="PathWhereOpen" StrokeThickness="1.5"
                          Visibility="Collapsed"
                          Stroke="{DynamicResource MutedBrush}"
                          Data="M 1,2.5 L 5,7 L 9,2.5"/>
                  </Grid>
                </Grid>
              </Button>

              <StackPanel x:Name="WherePanel" Visibility="Collapsed" Margin="0,8,0,0">

              <CheckBox x:Name="ChkOpenTiled"
                        Style="{DynamicResource ThemedCheckBox}"
                        ToolTip="Keep the view you came from open and tile the two side by side">
                <TextBlock TextWrapping="Wrap"
                           Text="Open beside the view I came from"/>
              </CheckBox>

              <TextBlock x:Name="TileHint" TextWrapping="Wrap" FontSize="11"
                         Margin="22,4,0,8"
                         Foreground="{DynamicResource MutedBrush}"/>

              <CheckBox x:Name="ChkZoomHere"
                        Style="{DynamicResource ThemedCheckBox}" Margin="0,0,0,7"
                        ToolTip="Where the selection is already drawn in the view you are in, zoom to it there instead of opening this window">
                <TextBlock TextWrapping="Wrap"
                           Text="If it is already in the view I am in, just zoom to it"/>
              </CheckBox>

              <CheckBox x:Name="ChkUnhide"
                        Style="{DynamicResource ThemedCheckBox}"
                        ToolTip="Where the view has the selection's category switched off, switch it back on so the elements can be seen">
                <TextBlock TextWrapping="Wrap"
                           Text="Switch the category on if the view has it off"/>
              </CheckBox>

              <TextBlock x:Name="UnhideHint" TextWrapping="Wrap" FontSize="11"
                         Margin="22,4,0,0"
                         Foreground="{DynamicResource MutedBrush}"
                         Text="Temporary view properties where the view has a template, otherwise a change to the view that one undo puts back."/>
              </StackPanel>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" Style="{DynamicResource ThemedSplitter}"
                      Margin="5,0,5,0"/>

        <!-- ============ right: the views ============ -->

        <Border Grid.Column="2" CornerRadius="5" Padding="12,10"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                      Background="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Views" FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBlock x:Name="CountText" FontSize="11" Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>

            <TextBox x:Name="SearchBox" Grid.Row="1" Margin="0,0,0,8"
                     Tag="Search view names"
                     Style="{DynamicResource ThemedTextBox}"/>

            <Grid x:Name="LevelBar" Grid.Row="2" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="LevelNote" Grid.Column="0" FontSize="12"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource OrangeBrush}"/>
              <CheckBox x:Name="ChkShowAll" Grid.Column="1" Margin="12,0,0,0"
                        Style="{DynamicResource ThemedCheckBox}"
                        ToolTip="Show every view, not just the plans on the selection's level">
                <TextBlock Text="Show all views"/>
              </CheckBox>
            </Grid>

            <DataGrid x:Name="ViewGrid" Grid.Row="3"
                      AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserResizeRows="False"
                      CanUserSortColumns="True" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"/>

            <TextBlock x:Name="HintText" Grid.Row="4" FontSize="11" Margin="2,7,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"
                       Text="Double click a view to go straight to it."/>
          </Grid>
        </Border>
      </Grid>

      <!-- ===================== footer ===================== -->

      <Border Grid.Row="2" CornerRadius="0,0,5,5"
              Background="{DynamicResource BarBg}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0"
              Padding="14,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" FontSize="12"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Button x:Name="CancelBtn" Grid.Column="1" Content="Close"
                  Style="{DynamicResource ThemedButton}" Margin="0,0,10,0"/>

          <Button x:Name="ShowMeBtn" Grid.Column="2" Content="Show Me"
                  Style="{DynamicResource GreenButton}" IsEnabled="False"/>
        </Grid>
      </Border>

      <!-- ===================== resize grips ===================== -->
      <!-- a borderless AllowsTransparency window has nothing hit testable in -->
      <!-- its frame, so it carries its own. No Background on this Grid, or   -->
      <!-- everything underneath stops being clickable.                       -->

      <Grid x:Name="GripLayer" Grid.Row="0" Grid.RowSpan="3">
        <Thumb x:Name="GripN" Height="5" VerticalAlignment="Top"
               HorizontalAlignment="Stretch" Margin="5,0,5,0" Cursor="SizeNS" Opacity="0"/>
        <Thumb x:Name="GripS" Height="5" VerticalAlignment="Bottom"
               HorizontalAlignment="Stretch" Margin="5,0,5,0" Cursor="SizeNS" Opacity="0"/>
        <Thumb x:Name="GripW" Width="5" HorizontalAlignment="Left"
               VerticalAlignment="Stretch" Margin="0,5,0,5" Cursor="SizeWE" Opacity="0"/>
        <Thumb x:Name="GripE" Width="5" HorizontalAlignment="Right"
               VerticalAlignment="Stretch" Margin="0,5,0,5" Cursor="SizeWE" Opacity="0"/>
        <Thumb x:Name="GripNW" Width="7" Height="7" HorizontalAlignment="Left"
               VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0"/>
        <Thumb x:Name="GripNE" Width="7" Height="7" HorizontalAlignment="Right"
               VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0"/>
        <Thumb x:Name="GripSW" Width="7" Height="7" HorizontalAlignment="Left"
               VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0"/>
        <Thumb x:Name="GripSE" Width="7" Height="7" HorizontalAlignment="Right"
               VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0"/>
      </Grid>

    </Grid>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel for Revit"
        Height="880" Width="1520" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" FontFamily="Segoe UI" FontSize="12"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

  <Window.Resources>

    <SolidColorBrush x:Key="BgWindow" Color="#3C4454"/>
    <SolidColorBrush x:Key="BgCard"   Color="#1B1F24"/>
    <SolidColorBrush x:Key="BgField"  Color="#2D3441"/>
    <SolidColorBrush x:Key="BgBar"    Color="#222933"/>
    <SolidColorBrush x:Key="Edge"     Color="#4A5364"/>
    <SolidColorBrush x:Key="EdgeSoft" Color="#515C6B"/>
    <SolidColorBrush x:Key="TextBody" Color="#EEF0F4"/>
    <SolidColorBrush x:Key="TextMute" Color="#A4AAB1"/>
    <SolidColorBrush x:Key="Blue"     Color="#5AAEEB"/>
    <SolidColorBrush x:Key="Orange"   Color="#E8912D"/>
    <SolidColorBrush x:Key="Green"    Color="#3FA75A"/>
    <SolidColorBrush x:Key="GreenHi"  Color="#4EC06D"/>
    <SolidColorBrush x:Key="Red"      Color="#FA8880"/>
    <SolidColorBrush x:Key="Sel"      Color="#3A7392"/>
    <SolidColorBrush x:Key="SelFg"    Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#323C48"/>
    <SolidColorBrush x:Key="BtnBg"    Color="#2D3441"/>
    <SolidColorBrush x:Key="BtnEdge"  Color="#4A5364"/>
    <SolidColorBrush x:Key="BtnHover" Color="#444E5E"/>
    <SolidColorBrush x:Key="BtnOff"   Color="#262D37"/>
    <SolidColorBrush x:Key="TextOff"  Color="#6E7785"/>
    <SolidColorBrush x:Key="ScrollBg" Color="#2D3441"/>
    <SolidColorBrush x:Key="ScrollTh" Color="#56606F"/>
    <SolidColorBrush x:Key="GridLine" Color="#3C4454"/>
    <SolidColorBrush x:Key="OrangeSoft" Color="#3A2E1C"/>
    <SolidColorBrush x:Key="OrangeSoftHi" Color="#4C3A20"/>
    <SolidColorBrush x:Key="GreenOff" Color="#2F4736"/>
    <SolidColorBrush x:Key="GreenOffFg" Color="#7E8F84"/>
    <SolidColorBrush x:Key="RowHover" Color="#444E5E"/>

    <!-- Scrollbars -->
    <!-- Invisible resize grips. Background must be set (Transparent still hit
         tests) or the thumb has nothing to catch the mouse with; the parent
         Grid must have NO background so the window stays clickable. -->
    <Style x:Key="Grip" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border Background="#01000000"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SbThumb" TargetType="Thumb">
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="MinWidth" Value="26"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="T" Background="{DynamicResource ScrollTh}" CornerRadius="4" Margin="2"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="T" Property="Background" Value="{DynamicResource TextMute}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="T" Property="Background" Value="{DynamicResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SbLine" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{DynamicResource ScrollBg}"/>
      <Setter Property="Width" Value="14"/>
      <Setter Property="MinWidth" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{DynamicResource ScrollBg}">
              <Track x:Name="PART_Track" IsDirectionReversed="True"
                     ViewportSize="{TemplateBinding ViewportSize}"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{DynamicResource SbLine}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{DynamicResource SbThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{DynamicResource SbLine}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="MinHeight" Value="14"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- The filter caret in each column heading. A bare Button falls back to
         the OS chrome, which is a light grey lozenge sitting in a dark
         header, so it needs a template like everything else. -->
    <Style x:Key="CaretBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextMute}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource BgField}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                    CornerRadius="2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource BtnHover}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Orange}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Window controls, Windows style: flat rectangles with the glyph
         always showing, a grey hover, and a close that is red at rest and
         fills red under the pointer. -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource BtnHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinCloseBtn" TargetType="Button">
      <Setter Property="Width" Value="44"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Foreground" Value="#E8524E"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="Transparent" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="#E8524E"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="#C0392B"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Small header chip, for the theme name -->
    <Style x:Key="ChipBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextMute}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource BgCard}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                    CornerRadius="9" Padding="10,2,10,3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Orange}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The green + that adds a scratch column, and the x that drops one -->
    <Style x:Key="AddColBtn" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource Green}" CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource GreenHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="ToolBtn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource BtnBg}" BorderBrush="{DynamicResource BtnEdge}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource BtnHover}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource BtnOff}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource BtnBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOff}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="OrangeBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource OrangeSoft}" BorderBrush="{DynamicResource Orange}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource OrangeSoftHi}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource BtnOff}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Edge}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextOff}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="{DynamicResource Orange}"/>
    </Style>

    <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
      <Setter Property="Padding" Value="22,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{DynamicResource Green}" BorderBrush="{DynamicResource Green}" BorderThickness="1"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource GreenHi}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource GreenHi}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource GreenOff}"/>
                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource GreenOff}"/>
                <Setter Property="Foreground" Value="{DynamicResource GreenOffFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- Text box -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource BgField}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Orange}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Sel}"/>
    </Style>

    <!-- DataGrid -->
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource HeaderBg}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Grid>
              <Border x:Name="B" Background="{TemplateBinding Background}"
                      BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,1,1"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6"
                     Cursor="SizeWE" Opacity="0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource RowHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="Height" Value="24"/>
    </Style>

    <Style TargetType="DataGridCell">
      <Setter Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border x:Name="B" Background="{TemplateBinding Background}" Padding="6,2"
                    BorderBrush="{DynamicResource Blue}" BorderThickness="0">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Right-click menu -->
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource BgCard}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Edge}"
                    BorderThickness="1" CornerRadius="4" Padding="4">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="B" Background="Transparent" CornerRadius="3" Padding="10,5">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter Grid.Column="0" ContentSource="Header" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource TextMute}" FontSize="11"
                           Margin="24,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="B" Property="Background" Value="{DynamicResource Sel}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextOff}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Separator">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Margin" Value="6,4"/>
      <Setter Property="Background" Value="{DynamicResource Edge}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Background="{DynamicResource Edge}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{DynamicResource BgField}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBody}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLine}"/>
      <Setter Property="RowBackground" Value="Transparent"/>
    </Style>

  </Window.Resources>

  <Border x:Name="Shell" Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource EdgeSoft}"
          BorderThickness="1" CornerRadius="6">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- HEADER -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BgBar}"
              CornerRadius="6,6,0,0" Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="IconImage" Grid.Column="0" Width="30" Height="30"
                 VerticalAlignment="Center" Margin="0,0,10,0"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="LogoText" Text="RevoBIM" Foreground="{DynamicResource Blue}" FontSize="20"
                       FontWeight="Bold" LineHeight="22"/>
            <TextBlock Text="Excel for Revit" Foreground="{DynamicResource Orange}" FontSize="15"
                       Margin="1,-2,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="18,0,18,0">
            <Border Width="1" Background="{DynamicResource Edge}" Margin="0,2,16,2"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="ScheduleTitle" Text="Schedule" Foreground="{DynamicResource TextBody}"
                         FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="ScheduleSub" Text="" Foreground="{DynamicResource TextMute}"
                         FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="VersionText" Grid.Column="3" Text="v1.0.0" Foreground="{DynamicResource TextMute}"
                     FontSize="11" VerticalAlignment="Top" Margin="0,2,10,0"/>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top"
                      Margin="0,-2,-8,0">
            <Button x:Name="BtnTheme" Style="{DynamicResource ChipBtn}" Content="Dark"/>
            <Button x:Name="ShrinkBtn" Style="{DynamicResource WinBtn}" Content="&#x2913;"
                    FontSize="14"
                    ToolTip="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)"/>
            <Button x:Name="MaxBtn" Style="{DynamicResource WinBtn}" Content="&#x2750;"
                    ToolTip="Full screen / restore (F11, or double-click the header)"/>
            <Button x:Name="CloseBtn" Style="{DynamicResource WinCloseBtn}"
                    Content="&#x2715;" ToolTip="Close"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- TOOLBAR -->
      <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Edge}"
              BorderThickness="0,1,0,1" Padding="10,6">
        <Grid x:Name="ToolGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="ToolStrip" Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="BtnFillDown"   Style="{DynamicResource ToolBtn}"/>
            <Border Width="1" Background="{DynamicResource Edge}" Margin="6,4"/>
            <Button x:Name="BtnFormula"    Style="{DynamicResource ToolBtn}"/>
            <Button x:Name="BtnSequence"   Style="{DynamicResource ToolBtn}"/>
            <Button x:Name="BtnAffix"      Style="{DynamicResource ToolBtn}"/>
            <Button x:Name="BtnFindView"   Style="{DynamicResource ToolBtn}"/>
            <Button x:Name="BtnSetLevel"   Style="{DynamicResource ToolBtn}"/>
            <Button x:Name="BtnHighlight"  Style="{DynamicResource ToolBtn}"/>
            <Button x:Name="BtnFind"       Style="{DynamicResource ToolBtn}"/>
            <Border Width="1" Background="{DynamicResource Edge}" Margin="6,4"/>
            <Button x:Name="BtnRevertAll"  Style="{DynamicResource ToolBtn}"/>
            <Border Width="1" Background="{DynamicResource Edge}" Margin="6,4"/>
            <Button x:Name="BtnReload"     Style="{DynamicResource ToolBtn}"/>
          </StackPanel>

          <Border x:Name="GroupBar" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                  HorizontalAlignment="Right" Background="{DynamicResource BgCard}"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                  CornerRadius="4" Padding="12,4,6,4" Margin="10,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Sort Headings" Foreground="{DynamicResource TextMute}"
                         FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                         Margin="0,0,12,0"/>
              <Button x:Name="BtnGroup"  Style="{DynamicResource ToolBtn}"/>
              <Button x:Name="BtnExpand" Style="{DynamicResource ToolBtn}"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <!-- FORMULA BAR — sits between the toolbar and the table, so opening it
           pushes the table down rather than covering it -->
      <Border x:Name="FormulaBar" Grid.Row="2" Visibility="Collapsed"
              Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Edge}"
              BorderThickness="0,0,0,1" Padding="12,8,12,9">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="fx" FontStyle="Italic"
                     FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                     Foreground="{DynamicResource Blue}" Margin="2,0,12,0"/>

          <!-- the coloured text sits behind a transparent editor, so the caret
               and selection are a real TextBox and the colouring is free -->
          <Grid Grid.Row="0" Grid.Column="1">
            <Border Background="{DynamicResource BgField}" BorderBrush="{DynamicResource Edge}"
                    BorderThickness="1" CornerRadius="3"/>
            <TextBlock x:Name="FormulaInk" FontFamily="Consolas" FontSize="13"
                       Margin="7,0,7,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBody}" TextWrapping="NoWrap"/>
            <TextBox x:Name="FormulaBox" FontFamily="Consolas" FontSize="13"
                     Background="Transparent" BorderThickness="0" Padding="6,0,6,0"
                     Foreground="Transparent" CaretBrush="{DynamicResource Orange}"
                     VerticalContentAlignment="Center" MinHeight="28"/>
          </Grid>

          <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="10,0,0,0">
            <Button x:Name="BtnFormulaPick" Style="{DynamicResource ToolBtn}"
                    Content="Pick refs" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="BtnFormulaCancel" Style="{DynamicResource ToolBtn}"
                    Content="Cancel" Padding="12,6"/>
            <Button x:Name="BtnFormulaApply" Style="{DynamicResource GreenBtn}"
                    Content="Write" Padding="16,6" Margin="8,0,0,0"/>
          </StackPanel>

          <TextBlock x:Name="FormulaHint" Grid.Row="1" Grid.Column="1"
                     Foreground="{DynamicResource TextMute}" FontSize="11"
                     Margin="2,5,0,0" TextWrapping="Wrap"/>
        </Grid>
      </Border>

      <Grid x:Name="GridHost" Grid.Row="3" Margin="12,0,12,10">
        <DataGrid x:Name="DataGridMain"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserResizeRows="False" HeadersVisibility="Column" ColumnHeaderHeight="56"
                  SelectionMode="Extended" SelectionUnit="Cell"
                  GridLinesVisibility="All" ClipboardCopyMode="ExcludeHeader"
                  EnableRowVirtualization="True" EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  FrozenColumnCount="2" RowHeaderWidth="0"/>
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="True">
          <Border x:Name="FillPreview" Background="#333A7392" BorderBrush="{DynamicResource Orange}"
                  BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
          <Border x:Name="FillHandle" Width="9" Height="9" Background="{DynamicResource Orange}"
                  BorderBrush="{DynamicResource BgWindow}" BorderThickness="1" Cursor="Cross"
                  Visibility="Collapsed" ToolTip="Drag to fill or sequence — double-click to fill to the end of the group"/>
        </Canvas>
      </Grid>

      <!-- RESIZE GRIPS
           A borderless AllowsTransparency window has nothing hit testable in
           its frame, so WPF's own resize border never fires whatever
           ResizeMode says. These eight thumbs are the frame. The overlay Grid
           carries no Background so everything under it stays clickable. -->

      <!-- FOOTER -->
      <Border Grid.Row="4" Background="{DynamicResource BgBar}" BorderBrush="{DynamicResource Edge}"
              BorderThickness="0,1,0,0" CornerRadius="0,0,6,6" Padding="12,8,12,10">
        <StackPanel>

          <!-- CELL COLOUR LEGEND — filled in by build_legend() -->
          <WrapPanel x:Name="LegendHost" Orientation="Horizontal" Margin="0,0,0,8"/>

          <Border Height="1" Background="{DynamicResource Edge}" Margin="0,0,0,9"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnRevertSelected" Grid.Column="0" Style="{DynamicResource OrangeBtn}"
                    Content="Revert Selected Cells" IsEnabled="False" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="StatusText" Text="Ready." Foreground="{DynamicResource TextMute}" FontSize="11"/>
              <TextBlock x:Name="PendingText" Text="No pending edits" Foreground="{DynamicResource TextMute}" FontSize="11"/>
            </StackPanel>
            <Button x:Name="BtnClose" Grid.Column="2" Style="{DynamicResource ToolBtn}"
                    Content="Close" Padding="18,8" Margin="0,0,10,0"/>
            <Button x:Name="BtnIsolate" Grid.Column="3" Style="{DynamicResource ToolBtn}"
                    Padding="14,6" Margin="0,0,10,0"
                    ToolTip="Open the default 3D view and temporarily isolate the selected elements"/>
            <Button x:Name="BtnExcel" Grid.Column="4" Style="{DynamicResource ToolBtn}"
                    Padding="14,6" Margin="0,0,10,0"
                    ToolTip="Export to Excel, or import an edited workbook back"/>
            <Button x:Name="BtnApply" Grid.Column="5" Style="{DynamicResource GreenBtn}" Content="APPLY"/>
          </Grid>

        </StackPanel>
      </Border>

      <!-- resize frame, on top of everything -->
      <Grid Grid.Row="0" Grid.RowSpan="5" x:Name="GripHost">
        <Thumb x:Name="GripN"  Style="{DynamicResource Grip}" Height="5"
               VerticalAlignment="Top"    HorizontalAlignment="Stretch" Margin="6,0" Cursor="SizeNS"/>
        <Thumb x:Name="GripS"  Style="{DynamicResource Grip}" Height="5"
               VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="6,0" Cursor="SizeNS"/>
        <Thumb x:Name="GripW"  Style="{DynamicResource Grip}" Width="5"
               HorizontalAlignment="Left"  VerticalAlignment="Stretch" Margin="0,6" Cursor="SizeWE"/>
        <Thumb x:Name="GripE"  Style="{DynamicResource Grip}" Width="5"
               HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,6" Cursor="SizeWE"/>
        <Thumb x:Name="GripNW" Style="{DynamicResource Grip}" Width="8" Height="8"
               HorizontalAlignment="Left"  VerticalAlignment="Top"    Cursor="SizeNWSE"/>
        <Thumb x:Name="GripNE" Style="{DynamicResource Grip}" Width="8" Height="8"
               HorizontalAlignment="Right" VerticalAlignment="Top"    Cursor="SizeNESW"/>
        <Thumb x:Name="GripSW" Style="{DynamicResource Grip}" Width="8" Height="8"
               HorizontalAlignment="Left"  VerticalAlignment="Bottom" Cursor="SizeNESW"/>
        <Thumb x:Name="GripSE" Style="{DynamicResource Grip}" Width="14" Height="14"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
      </Grid>

    </Grid>
  </Border>
</Window>

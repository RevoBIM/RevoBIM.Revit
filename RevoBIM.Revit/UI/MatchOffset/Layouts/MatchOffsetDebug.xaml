<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Match Offset debug report"
        Width="820" Height="620" MinWidth="520" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="False">
  <Border Background="{DynamicResource WindowBrush}"
          BorderBrush="{DynamicResource EdgeBrush}"
          BorderThickness="1" CornerRadius="6">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ================= header ================= -->
      <Border x:Name="HeaderBar" Grid.Row="0"
              Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="12,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel x:Name="LogoArea" Grid.Column="0"
                      Orientation="Horizontal" Background="Transparent">
            <Image x:Name="LogoImage" Width="28" Height="28"
                   VerticalAlignment="Center" />
            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}" />
              <TextBlock Text="Debug report" FontSize="12"
                         Foreground="{DynamicResource OrangeBrush}" />
            </StackPanel>
          </StackPanel>
          <Button x:Name="ThemeChip" Grid.Column="2" Content="Auto"
                  Style="{DynamicResource ChipButton}"
                  VerticalAlignment="Center" Margin="0,0,10,0"
                  ToolTip="Auto follows Revit&apos;s own canvas theme" />
          <TextBlock x:Name="VersionLabel" Grid.Column="3" Text="v1.3.0"
                     Style="{DynamicResource MutedText}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button x:Name="CloseButton" Grid.Column="4" Content="&#x2715;"
                  Style="{DynamicResource CloseButton}"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <TextBlock x:Name="DebugLead" Grid.Row="1" Margin="16,12,16,8"
                 TextWrapping="Wrap"
                 Text="Press Copy, then paste the lot into the chat." />

      <TextBox x:Name="DebugText" Grid.Row="2" Margin="16,0,16,10"
               IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
               FontFamily="Consolas" FontSize="11.5"
               VerticalContentAlignment="Stretch"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto" />

      <!-- ================= footer ================= -->
      <Border Grid.Row="3" Background="{DynamicResource BarBrush}"
              CornerRadius="0,0,6,6" Padding="16,10,16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text=""
                     Style="{DynamicResource MutedText}"
                     VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button x:Name="SaveButton" Grid.Column="1" Content="Show the file"
                  Margin="0,0,8,0" />
          <Button x:Name="DoneButton" Grid.Column="2" Content="Close"
                  Margin="0,0,8,0" />
          <Button x:Name="CopyButton" Grid.Column="3" Content="Copy"
                  Style="{DynamicResource PrimaryButton}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

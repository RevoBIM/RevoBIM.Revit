<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================================================================
       RevoBIM PY - Workset Management : house theme.
       Brushes carry the Revit dark values as defaults; wsm_ui writes the active
       palette onto window.Resources, which sits in front of this merged
       dictionary, so every DynamicResource re-resolves on a swap.
       StaticResource is used only inside this file, for things defined
       above the point of use.
       ================================================================ -->

  <SolidColorBrush x:Key="WindowBrush" Color="#3C4454"/>
  <SolidColorBrush x:Key="CardBrush" Color="#353D4B"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#2D3441"/>
  <SolidColorBrush x:Key="BarBrush" Color="#222933"/>
  <SolidColorBrush x:Key="EdgeBrush" Color="#4A5464"/>
  <SolidColorBrush x:Key="ChromeBrush" Color="#515C6B"/>
  <SolidColorBrush x:Key="TextBrush" Color="#EEF0F4"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#ACB2B9"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="#6E7684"/>
  <SolidColorBrush x:Key="BlueBrush" Color="#5AAEEB"/>
  <SolidColorBrush x:Key="BlueTextBrush" Color="#7CC0F2"/>
  <SolidColorBrush x:Key="OrangeBrush" Color="#E8912D"/>
  <SolidColorBrush x:Key="OrangeTextBrush" Color="#F2A452"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHoverBrush" Color="#4EC06D"/>
  <SolidColorBrush x:Key="GreenTextBrush" Color="#5CC97A"/>
  <SolidColorBrush x:Key="RedBrush" Color="#F79A96"/>
  <SolidColorBrush x:Key="RedFillBrush" Color="#D9534F"/>
  <SolidColorBrush x:Key="RedSoftBrush" Color="#4E3842"/>
  <SolidColorBrush x:Key="OrangeSoftBrush" Color="#4E4434"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#3A7392"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#444E5E"/>
  <SolidColorBrush x:Key="RowAltBrush" Color="#39414F"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#101216"/>
  <SolidColorBrush x:Key="TickBrush" Color="#101216"/>
  <SolidColorBrush x:Key="ShadowBrush" Color="#66000000"/>

  <!-- ================================================================ buttons -->

  <ControlTemplate x:Key="WsFlatTemplate" TargetType="Button">
    <Border x:Name="Chrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="3" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="{TemplateBinding Padding}"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.85"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.65"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Chrome" Property="Opacity" Value="0.35"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="WsButton" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource WsFlatTemplate}"/>
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="11,5,11,5"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="WsGreenButton" TargetType="Button" BasedOn="{StaticResource WsButton}">
    <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>

  <Style x:Key="WsBlueButton" TargetType="Button" BasedOn="{StaticResource WsButton}">
    <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>

  <Style x:Key="WsOrangeButton" TargetType="Button" BasedOn="{StaticResource WsButton}">
    <Setter Property="Background" Value="{DynamicResource OrangeBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OrangeBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>

  <Style x:Key="WsRedButton" TargetType="Button" BasedOn="{StaticResource WsButton}">
    <Setter Property="Background" Value="{DynamicResource RedFillBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RedFillBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  </Style>

  <!-- header chips: the theme toggle, full screen -->
  <Style x:Key="WsChip" TargetType="Button" BasedOn="{StaticResource WsButton}">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Padding" Value="9,3,10,3"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style x:Key="WsCloseButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RedFillBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- shrink to taskbar: a down arrow onto a bar; parked (Tag="shrunk") it
       becomes a green up arrow.  Both glyphs live in the template, so every
       window gets its own copies - one Path cannot sit in two windows -->
  <Style x:Key="WsShrinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ToolTip" Value="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
            <Grid Width="14" Height="14">
              <Path x:Name="ShrinkGlyph" Data="M 7,0.5 V 9 M 3.5,5.5 L 7,9 L 10.5,5.5 M 1.5,12.5 H 12.5"
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path x:Name="ExpandGlyph" Data="M 7,13.5 V 4.5 M 3,8.5 L 7,4.5 L 11,8.5 M 1.5,1.5 H 12.5"
                    Stroke="{DynamicResource GreenTextBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="shrunk">
              <Setter TargetName="ShrinkGlyph" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="ExpandGlyph" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- tab strip -->
  <Style x:Key="WsTab" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="14,7,16,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent"
                  BorderBrush="Transparent" BorderThickness="0,0,0,3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WsTabActive" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="14,7,16,7"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource OrangeBrush}" BorderThickness="0,0,0,3"
                  CornerRadius="3,3,0,0" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- segmented case choice in the rename panel -->
  <Style x:Key="WsSegment" TargetType="Button" BasedOn="{StaticResource WsButton}">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="Padding" Value="8,3,8,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style x:Key="WsSegmentOn" TargetType="Button" BasedOn="{StaticResource WsButton}">
    <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
    <Setter Property="Padding" Value="8,3,8,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <!-- ================================================================ text box -->

  <Style x:Key="WsTextBox" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,1,6,1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
            <Grid>
              <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                         Foreground="{DynamicResource MutedBrush}" Opacity="0.75"
                         Margin="7,0,6,0" VerticalAlignment="Center"
                         IsHitTestVisible="False" Visibility="Collapsed"
                         TextTrimming="CharacterEllipsis"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ check box -->

  <Style x:Key="WsCheck" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border Background="Transparent" Padding="1,2,1,2">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="Box" Width="15" Height="15" CornerRadius="2"
                      Background="{DynamicResource FieldBrush}"
                      BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Path x:Name="Tick" Data="M 2.5,7 L 6,10.5 L 12,3.5"
                      Stroke="{DynamicResource TickBrush}" StrokeThickness="2"
                      Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BlueBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ drop-down toggle -->

  <Style x:Key="WsDropToggle" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{DynamicResource FieldBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="3" SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0" Margin="8,0,4,0"
                                VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Margin="4,0,9,0"
                    Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                    VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the small caret on a column heading that opens its tick list -->
  <Style x:Key="WsCaret" TargetType="ToggleButton">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="2"
                  BorderBrush="Transparent" BorderThickness="1">
            <Path x:Name="Glyph" Data="M 0,0 L 4,4 L 8,0 Z" Fill="{DynamicResource MutedBrush}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="on">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource OrangeBrush}"/>
              <Setter TargetName="Glyph" Property="Fill" Value="{DynamicResource OnAccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ lists -->

  <Style x:Key="WsListBox" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <Style x:Key="WsListItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="8,4,8,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ right-click menus -->

  <Style x:Key="WsMenu" TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource ChromeBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="3">
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WsMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="2" Padding="10,5,16,5">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ scroll bars -->

  <Style x:Key="WsScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{DynamicResource ChromeBrush}" CornerRadius="4" Margin="2"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WsScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="11"/>
    <Setter Property="MinWidth" Value="11"/>
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource WsScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource WsScrollPage}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource WsScrollPage}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{TemplateBinding Background}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb>
                    <Thumb Style="{StaticResource WsScrollThumb}"/>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource WsScrollPage}" Command="ScrollBar.PageRightCommand"/>
                  </Track.IncreaseRepeatButton>
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource WsScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                  </Track.DecreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource ChromeBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="8,5,8,5">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- resize grips round the window edge: transparent, so hit testable -->
  <Style x:Key="WsGrip" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ table -->

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,1,1"
                    Padding="4,4,4,4">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="5"
                   Style="{StaticResource WsGrip}" Cursor="SizeWE"/>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="5"
                   Style="{StaticResource WsGrip}" Cursor="SizeWE"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WsGridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding state}" Value="rename">
        <Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="new">
        <Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="delete">
        <Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="merge">
        <Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="error">
        <Setter Property="Background" Value="{DynamicResource RedSoftBrush}"/>
      </DataTrigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WsGridCell" TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                  BorderBrush="Transparent" BorderThickness="1" Padding="6,2,6,2">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WsGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="AlternatingRowBackground" Value="Transparent"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="RowHeaderWidth" Value="0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="RowStyle" Value="{StaticResource WsGridRow}"/>
    <Setter Property="CellStyle" Value="{StaticResource WsGridCell}"/>
  </Style>

  <!-- column text: the workset name goes red when anything is staged on it -->
  <Style x:Key="WsNameText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding state}" Value="rename">
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="new">
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="delete">
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        <Setter Property="TextDecorations" Value="Strikethrough"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="merge">
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        <Setter Property="TextDecorations" Value="Strikethrough"/>
        <Setter Property="FontStyle" Value="Italic"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="error">
        <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
      </DataTrigger>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WsCountText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OrangeTextBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Style.Triggers>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WsEditableText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding editable}" Value="Yes">
        <Setter Property="Foreground" Value="{DynamicResource GreenTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </DataTrigger>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Visible in all views: a workset that is off stands out in orange -->
  <Style x:Key="WsVisibleText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ToolTip" Value="Revit's 'Visible in all views' for this workset"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding visible}" Value="No">
        <Setter Property="Foreground" Value="{DynamicResource OrangeTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="ToolTip" Value="Off in all views - new views will not show this workset"/>
      </DataTrigger>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WsPlainText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="WsChangeText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource RedBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding state}" Value="error">
        <Setter Property="FontWeight" Value="Bold"/>
      </DataTrigger>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- the expander glyph in the first column, and the category summary -->
  <Style x:Key="WsExpText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BlueTextBrush}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Show the categories on this workset"/>
    <Style.Triggers>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- the workset's colour in the 3D view; the string binds straight to a brush -->
  <DataTemplate x:Key="WsSwatchTemplate">
    <Border Width="13" Height="13" CornerRadius="3" Background="{Binding colour}"
            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            ToolTip="This workset's colour in the Workset Management 3D view"/>
  </DataTemplate>

  <!-- Used by on the scope box table: the full list rides on the tooltip -->
  <Style x:Key="WsUsedByText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ToolTip" Value="{Binding tip_usedby}"/>
    <Style.Triggers>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WsCatsText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers>
      <!-- on a selected row every cell reads in body text: red, orange, green and
           muted all fall under 3:1 on Revit's selection blue -->
      <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WsNameEdit" TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2,0,2,0"/>
  </Style>

  <!-- ================================================================ panels -->

  <Style x:Key="WsCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="12,10,12,12"/>
  </Style>

  <Style x:Key="WsLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,8,0,3"/>
  </Style>

  <Style x:Key="WsIcon" TargetType="Path">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="StrokeThickness" Value="1.6"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

</ResourceDictionary>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bulk Rename" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5"
        SizeToContent="Height" Width="500" MaxHeight="620" MinWidth="420">
    <Border x:Name="Root" Background="{DynamicResource Window}" BorderBrush="{DynamicResource Edge}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- ======== header ======== -->
            <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource Title}"
                    CornerRadius="5,5,0,0" Padding="10,6,6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Logo" Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Blue}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PromptTitle" Text="Bulk Rename" FontSize="15" Margin="8,2,16,0"
                                   Foreground="{DynamicResource Orange}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="ThemeChip" Grid.Column="3" Style="{DynamicResource ChipButton}"
                            ToolTip="Theme: Auto follows the Revit canvas" Margin="0,0,8,0">
                        <TextBlock x:Name="ThemeLabel" Text="Auto" Foreground="{DynamicResource Text}"/>
                    </Button>
                    <TextBlock x:Name="VersionText" Grid.Column="4" Text="v" FontSize="11" Margin="0,0,8,0"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <Button x:Name="ShrinkBtn" Grid.Column="5" Style="{DynamicResource WinButton}"
                            ToolTip="Shrink to taskbar (Ctrl+Shift+H)">
                        <Grid Width="14" Height="14">
                            <Path x:Name="ShrinkGlyph" Data="M7,1 L7,9 M3,6 L7,10 L11,6 M2,13 L12,13"
                                  StrokeThickness="1.5" Stroke="{DynamicResource Text}"/>
                            <Path x:Name="ExpandGlyph" Data="M7,13 L7,3 M2.5,7.5 L7,2 L11.5,7.5"
                                  StrokeThickness="2.2" Stroke="{DynamicResource Green}" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <Button x:Name="FullBtn" Grid.Column="6" Style="{DynamicResource WinButton}"
                            ToolTip="Full screen (F11)">
                        <Border Width="11" Height="11" BorderThickness="1.4" BorderBrush="{DynamicResource Text}"/>
                    </Button>
                    <Button x:Name="CloseBtn" Grid.Column="7" Style="{DynamicResource CloseButton}" ToolTip="Close (Esc)">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.6" Stroke="{DynamicResource Text}"/>
                    </Button>
                </Grid>
            </Border>
            <!-- ======== message ======== -->
            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="13"/>
                <Border x:Name="DetailBox" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0" MaxHeight="320"
                        Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                        BorderThickness="1" CornerRadius="4" Padding="8,6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="Detail" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
            <!-- ======== footer ======== -->
            <Border Grid.Row="2" Background="{DynamicResource Title}" CornerRadius="0,0,5,5" Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoBtn" Style="{DynamicResource BaseButton}" Margin="0,0,8,0">
                        <TextBlock x:Name="NoText" Text="No"/>
                    </Button>
                    <Button x:Name="YesBtn" IsDefault="True" Style="{DynamicResource GreenButton}">
                        <TextBlock x:Name="YesText" Text="OK" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}"/>
                    </Button>
                </StackPanel>
            </Border>
            <!-- ======== resize grips ======== -->
            <Grid x:Name="Grips" Grid.RowSpan="3">
                <Thumb x:Name="GripL" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Cursor="SizeWE"/>
                <Thumb x:Name="GripR" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Cursor="SizeWE"/>
                <Thumb x:Name="GripT" Style="{DynamicResource Grip}" Height="4" VerticalAlignment="Top" Cursor="SizeNS"/>
                <Thumb x:Name="GripB" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS"/>
                <Thumb x:Name="GripTL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
                <Thumb x:Name="GripTR" Style="{DynamicResource Grip}" Width="8" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
                <Thumb x:Name="GripBL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
                <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Align settings" Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5">
  <Border x:Name="Frame" CornerRadius="6" BorderThickness="1"
          BorderBrush="{DynamicResource EdgeWindow}" Background="{DynamicResource BgWindow}">
    <DockPanel>

      <!-- ==== header ==== -->
      <Border x:Name="Header" DockPanel.Dock="Top" Background="{DynamicResource BgBar}"
              CornerRadius="6,6,0,0" Padding="12,8,8,8">
        <DockPanel LastChildFill="False">
          <Image x:Name="Logo" DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,10,0"
                 VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blue}"/>
            <TextBlock x:Name="ToolName" Text="3D Align - settings" FontSize="15"
                       Foreground="{DynamicResource Orange}" Margin="0,-3,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ThemeChip" Style="{DynamicResource ChipButton}">
              <StackPanel Orientation="Horizontal">
                <Grid Width="14" Height="14">
                  <Path Data="M7,1 A6,6 0 1 1 7,13 A6,6 0 1 1 7,1 Z" StrokeThickness="1.4"
                        Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <Path Data="M7,1 A6,6 0 0 1 7,13 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Grid>
                <TextBlock x:Name="ThemeLabel" Text="Auto" Margin="6,0,0,0"/>
              </StackPanel>
            </Button>
            <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="11" Margin="2,0,8,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
            <Button x:Name="CloseBtn" Style="{DynamicResource CloseButton}" ToolTip="Close without saving (Esc)">
              <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.6"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ==== footer ==== -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBar}" CornerRadius="0,0,6,6" Padding="12,8">
        <DockPanel>
          <Button x:Name="ApplyBtn" DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Content="Apply"/>
          <Button x:Name="CancelBtn" DockPanel.Dock="Right" Style="{DynamicResource SecondaryButton}" Content="Cancel"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}"
                     Text="Saved to %APPDATA%\RevoBIM\3d_align.txt"/>
        </DockPanel>
      </Border>

      <!-- ==== body ==== -->
      <StackPanel Margin="16,12,16,6">

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
          <TextBlock Text="After each alignment" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
        </StackPanel>
        <WrapPanel Margin="12,0,0,8">
          <RadioButton x:Name="KeepOn" GroupName="keep" Style="{DynamicResource Segment}" Content="Keep going until Escape"/>
          <RadioButton x:Name="KeepOff" GroupName="keep" Style="{DynamicResource Segment}" Content="Stop after one"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
          <TextBlock Text="Show the results window" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
        </StackPanel>
        <WrapPanel Margin="12,0,0,8">
          <RadioButton x:Name="ShowLook" GroupName="show" Style="{DynamicResource Segment}" Content="Only if something needs a look"/>
          <RadioButton x:Name="ShowAlways" GroupName="show" Style="{DynamicResource Segment}" Content="Always"/>
          <RadioButton x:Name="ShowNever" GroupName="show" Style="{DynamicResource Segment}" Content="Never"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
          <TextBlock Text="If Revit will not move it with its connections" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
        </StackPanel>
        <WrapPanel Margin="12,0,0,8">
          <RadioButton x:Name="RefDetach" GroupName="refusal" Style="{DynamicResource Segment}" Content="Release them, move it, and say so"/>
          <RadioButton x:Name="RefLeave" GroupName="refusal" Style="{DynamicResource Segment}" Content="Leave it where it is, and say so"/>
        </WrapPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource Orange}" Margin="0,0,8,0"/>
          <TextBlock Text="Largest move allowed" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
        </StackPanel>
        <DockPanel Margin="12,0,0,10">
          <TextBox x:Name="MaxMove" Style="{DynamicResource Field}" Width="90" DockPanel.Dock="Left"/>
          <TextBlock Text="mm. Guards against a mis-click on something across the floor; 0 for no limit."
                     Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextMuted}"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource Orange}" Margin="0,0,8,0"/>
          <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
        </StackPanel>
        <WrapPanel Margin="12,0,0,8">
          <RadioButton x:Name="ThemeFollow" GroupName="theme" Style="{DynamicResource Segment}" Content="Follow Revit's canvas"/>
          <RadioButton x:Name="ThemeDark" GroupName="theme" Style="{DynamicResource Segment}" Content="Dark"/>
          <RadioButton x:Name="ThemeLight" GroupName="theme" Style="{DynamicResource Segment}" Content="Light"/>
        </WrapPanel>

        <CheckBox x:Name="DebugTick" Style="{DynamicResource Tick}" Margin="12,4,0,8"
                  Content="Write a debug log to %APPDATA%\RevoBIM\3d_align_debug.txt"/>
      </StackPanel>

    </DockPanel>
  </Border>
</Window>

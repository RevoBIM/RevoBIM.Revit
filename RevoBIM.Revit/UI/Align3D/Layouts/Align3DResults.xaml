<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Align" Width="900" Height="440" MinWidth="620" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5">
  <Grid>
    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource EdgeWindow}" Background="{DynamicResource BgWindow}">
      <DockPanel>

        <!-- ==== header ==== -->
        <Border x:Name="Header" DockPanel.Dock="Top" Background="{DynamicResource BgBar}"
                CornerRadius="6,6,0,0" Padding="12,8,8,8">
          <DockPanel LastChildFill="False">
            <Image x:Name="Logo" DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,10,0"
                   VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blue}"/>
              <TextBlock x:Name="ToolName" Text="3D Align - results" FontSize="15"
                         Foreground="{DynamicResource Orange}" Margin="0,-3,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="SettingsChip" Style="{DynamicResource ChipButton}"
                      ToolTip="Open the 3D Align settings (also Shift+Click on the ribbon button)">
                <TextBlock Text="Settings"/>
              </Button>
              <Button x:Name="ThemeChip" Style="{DynamicResource ChipButton}">
                <StackPanel Orientation="Horizontal">
                  <Grid Width="14" Height="14">
                    <Path Data="M7,1 A6,6 0 1 1 7,13 A6,6 0 1 1 7,1 Z" StrokeThickness="1.4"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <Path Data="M7,1 A6,6 0 0 1 7,13 Z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </Grid>
                  <TextBlock x:Name="ThemeLabel" Text="Auto" Margin="6,0,0,0"/>
                </StackPanel>
              </Button>
              <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="11" Margin="2,0,8,0"
                         VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
              <Button x:Name="FullBtn" Style="{DynamicResource HeaderButton}" ToolTip="Full screen (F11)">
                <Border Width="12" Height="10" BorderThickness="1.5" CornerRadius="1"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
              <Button x:Name="CloseBtn" Style="{DynamicResource CloseButton}" ToolTip="Close (Esc)">
                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- ==== footer ==== -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBar}" CornerRadius="0,0,6,6"
                Padding="12,8">
          <DockPanel>
            <Button x:Name="OkBtn" DockPanel.Dock="Right" Style="{DynamicResource PrimaryButton}" Content="OK"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextMuted}"/>
          </DockPanel>
        </Border>

        <!-- ==== body ==== -->
        <Grid Margin="12,10,12,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
            <TextBlock Text="Alignments this run" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
          </StackPanel>
          <Border Grid.Row="1" x:Name="HeadingRow" Padding="8,4" Background="{DynamicResource BgCard}"
                  CornerRadius="4,4,0,0"/>
          <Border Grid.Row="2" BorderThickness="1,0,1,1" BorderBrush="{DynamicResource Edge}"
                  CornerRadius="0,0,4,4">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="Rows"/>
            </ScrollViewer>
          </Border>
        </Grid>

      </DockPanel>
    </Border>

    <!-- ==== resize grips: no Background on this Grid, so the window stays clickable ==== -->
    <Grid x:Name="Grips">
      <Thumb x:Name="GripL" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Margin="0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripR" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Margin="0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripT" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Margin="8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripB" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Margin="8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripTL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
      <Thumb x:Name="GripTR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

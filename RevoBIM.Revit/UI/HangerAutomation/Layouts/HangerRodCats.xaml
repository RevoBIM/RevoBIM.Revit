<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Rod target categories"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="6">
    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource EdgeStrongBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================ header ================ -->
        <Border x:Name="RodCatsHeader" Grid.Row="0" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Rod target categories" FontSize="13" Foreground="{DynamicResource OrangeBrush}" Margin="0,-2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="RodCatsVerTxt" Text="v1.1.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="RodCatsShrinkBtn" Style="{DynamicResource WinBtn}" ToolTip="Shrink to the taskbar - see Revit (Ctrl+Shift+H)">
                <Grid Width="12" Height="12">
                  <Path x:Name="RodCatsShrinkIcon" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,3 L6,7 L10,3 M1,11 L11,11"/>
                  <Path x:Name="RodCatsExpandIcon" Visibility="Collapsed" Stroke="{DynamicResource GreenBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,1.5 L11,1.5 M6,11 L6,4.5 M2.5,8 L6,4.5 L9.5,8"/>
                </Grid>
              </Button>
              <Button x:Name="RodCatsCloseBtn" Style="{DynamicResource CloseBtn}" Content="&#x2715;" ToolTip="Close without saving"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================ body ================ -->
        <StackPanel Grid.Row="1" Margin="14,12,14,8">
          <TextBlock Text="Where drop rods can run up to" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="Drop rods can also run up to these categories when Extend drop rod up to soffit is ticked. Defaults: Casework, MEP Ancillary Framing." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8"/>
          <TextBox x:Name="RodCatsSearch" Tag="Search categories" Margin="0,0,0,6"/>
          <ListBox x:Name="RodCatsList" Height="280" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
          <TextBlock x:Name="RodCatsCount" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ================ footer ================ -->
        <Border Grid.Row="2" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="12,8">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RodCatsCancel" Content="Cancel" Margin="0,0,8,0"/>
            <Button x:Name="RodCatsOk" Style="{DynamicResource Primary}" Content="OK"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Hanger Automation"
        Width="720" Height="760" MinWidth="640" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="6">
    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource EdgeStrongBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================ header ================ -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Image x:Name="Logo" Width="30" Height="30" Margin="0,0,10,0" Cursor="Hand"/>
              <StackPanel>
                <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
                <TextBlock Text="Hanger Automation" FontSize="15" Foreground="{DynamicResource OrangeBrush}" Margin="0,-3,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ThemeBtn" Style="{DynamicResource Chip}" Padding="10,3" Margin="0,0,10,0" Content="Auto" ToolTip="Theme: Auto follows Revit"/>
              <TextBlock x:Name="VerTxt" Text="v1.0.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="ShrinkBtn" Style="{DynamicResource WinBtn}" ToolTip="Shrink to the taskbar - see Revit (Ctrl+Shift+H)">
                <Grid Width="12" Height="12">
                  <Path x:Name="ShrinkIcon" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,3 L6,7 L10,3 M1,11 L11,11"/>
                  <Path x:Name="ExpandIcon" Visibility="Collapsed" Stroke="{DynamicResource GreenBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,1.5 L11,1.5 M6,11 L6,4.5 M2.5,8 L6,4.5 L9.5,8"/>
                </Grid>
              </Button>
              <Button x:Name="FullBtn" Style="{DynamicResource WinBtn}" ToolTip="Full screen (F11)">
                <Border Width="11" Height="11" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1.5"/>
              </Button>
              <Button x:Name="CloseBtn" Style="{DynamicResource CloseBtn}" Content="&#x2715;" ToolTip="Close"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================ tabs ================ -->
        <Border x:Name="TabsBar" Grid.Row="1" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="10,0,10,0">
          <StackPanel Orientation="Horizontal">
            <Button x:Name="TabFab" Style="{DynamicResource TabActive}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                  <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,1 L5,15 M19,1 L19,15 M1,9 L23,9 L23,15 L1,15 Z M2,17 L22,17"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="FAB Hangers" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="TabFam" Style="{DynamicResource Tab}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                  <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M12,1 L22,6.5 L22,17.5 L12,23 L2,17.5 L2,6.5 Z M2,6.5 L12,12 L22,6.5 M12,12 L12,23"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Family Hangers" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="TabFloor" Style="{DynamicResource Tab}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                  <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,8 L22,8 M2,12 L22,12 M6,8 L6,22 M18,8 L18,22 M3,22 L9,22 M15,22 L21,22 M1,2 L23,2"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Family Floor Support" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="TabSvc" Style="{DynamicResource Tab}">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="18" Height="18" Margin="0,0,7,0">
                  <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,1 L4,11 M14,1 L14,11 M1,11 L17,11"/>
                  <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M12,14 L22,14 L22,22 L12,22 L9,18 Z"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Hanger Service Type Assigner" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- ================ FAB hangers ================ -->
        <ScrollViewer x:Name="FabPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10,14,4">
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="2" StrokeLineJoin="Round" Data="M12,3 L22,8 L12,13 L2,8 Z"/>
                  <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,12 L12,17 L22,12"/>
                  <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,16 L12,21 L22,16"/>
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="1" Text="Workset for placed and edited hangers" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="CmbWorkset" Grid.Column="2" ToolTip="Which workset the hangers these tools place or edit go on. Leave as is: new hangers go on their service&apos;s workset and edited ones stay where they are."/>
            </Grid>
          </Border>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="Auto Rehost and size selected" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Text="Finds the nearest duct to each selected fabrication hanger and puts a hanger on it, sized to that duct." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <CheckBox x:Name="ChkReplace" Content="Replace with a new hanger sized to the duct (as if placed new)" ToolTip="Same kind of hanger, sized and hosted as a fresh placement. Keeps workset, Comments, Mark, shared parameters and rod tops. Untick to only move the hanger."/>
              <CheckBox x:Name="ChkExtendAfter" Content="Extend rods to structure afterwards"/>
              <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="90"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Search radius (mm)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtRadius" Grid.Column="1" Tag="1500"/>
                <Button x:Name="BtnRehost" Grid.Column="3" Style="{DynamicResource Primary}" Content="Rehost selected" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="Extend hanger to structure" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Text="Pushes the rods of the selected hangers up to the underside of the nearest structure above." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ChkFloors" Content="Floors" Margin="0,3,18,3"/>
                <CheckBox x:Name="ChkFraming" Content="Structural framing" Margin="0,3,18,3"/>
                <CheckBox x:Name="ChkRoofs" Content="Roofs" Margin="0,3,12,3"/>
                <Button x:Name="BtnRodCatsFab" Style="{DynamicResource Chip}" Padding="9,2" Margin="0,1,0,1" Content="Rod targets..." ToolTip="Choose more categories the rods can run up to (besides floors, framing and roofs)"/>
              </StackPanel>
              <Button x:Name="BtnExtend" Style="{DynamicResource Primary}" Content="Extend selected" HorizontalAlignment="Right" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,10" Margin="0,0,0,10">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Border Width="4" Height="16" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
                <TextBlock Text="Auto place hangers" FontSize="14" FontWeight="SemiBold"/>
              </StackPanel>
              <TextBlock Text="Select a duct run. Hangers go in after each bend, at the spacing below, with an extra one before the next bend or set down. Takeoffs are left alone." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Spacing (mm)" VerticalAlignment="Center" Margin="0,3"/>
                <TextBox x:Name="TxtSpacing" Grid.Row="0" Grid.Column="1" Tag="2000" Width="110" HorizontalAlignment="Left" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Hanger button" VerticalAlignment="Center" Margin="0,3"/>
                <ComboBox x:Name="CmbButton" Grid.Row="1" Grid.Column="1" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Pick scope" VerticalAlignment="Center" Margin="0,3"/>
                <ComboBox x:Name="CmbScope" Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,3"/>
                <TextBlock Grid.Row="3" Text="Dimension type" VerticalAlignment="Center" Margin="0,3"/>
                <ComboBox x:Name="CmbDimType" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
              </Grid>
              <CheckBox x:Name="ChkDims" Content="Add a chained dimension to each straight run (active view)" Margin="0,6,0,3"/>
              <CheckBox x:Name="ChkSkipExisting" Content="Skip places that already have a hanger"/>
              <CheckBox x:Name="ChkExtendPlace" Content="Push the rods up to structure"/>
              <Button x:Name="BtnPlace" Style="{DynamicResource Primary}" Content="Select run and place" HorizontalAlignment="Right" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- ================ Family hangers ================ -->
        <ScrollViewer x:Name="FamPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10,14,4">
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="104" Height="104" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Top">
                <Grid>
                  <TextBlock x:Name="FamPreviewHint" Text="Preview" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="FamPreview" Margin="4" Stretch="Uniform"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1">
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="CmbFamCategory" Grid.Column="0"/>
                  <TextBox x:Name="TxtFamSearch" Grid.Column="2" Tag="Search family or type"/>
                  <CheckBox x:Name="ChkFamSetOnly" Grid.Column="3" Content="Set up only" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="List only the families already set up in Family settings (shown in bold green)"/>
                </Grid>
                <ListBox x:Name="LstFamilies" Height="92" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <Thumb x:Name="ThmFamListSize" Height="10" Cursor="SizeNS" ToolTip="Drag down to see more families (up for fewer)">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="Transparent">
                        <Border Width="40" Height="3" CornerRadius="1.5" Background="{DynamicResource EdgeStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
                <TextBlock x:Name="FamChosenTxt" Text="Choose the hanger family and type" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <Button x:Name="BtnFamSettings" Style="{DynamicResource Chip}" Padding="10,5" Margin="0,0,0,6" ToolTip="Width, drop rod and soffit settings for this family">
                  <StackPanel Orientation="Horizontal">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" Data="M7,0 L7,2.5 M7,11.5 L7,14 M0,7 L2.5,7 M11.5,7 L14,7 M2,2 L3.8,3.8 M10.2,10.2 L12,12 M12,2 L10.2,3.8 M3.8,10.2 L2,12 M7,3.5 A3.5,3.5 0 1 1 6.99,3.5 Z"/>
                    <TextBlock Text="Family settings"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnFamRefresh" Style="{DynamicResource Chip}" Padding="10,5" ToolTip="Read the families in the project again">
                  <StackPanel Orientation="Horizontal">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" Data="M12,7 A5,5 0 1 1 10.5,3.5 M10.5,0.5 L10.5,3.5 L13.5,3.5"/>
                    <TextBlock Text="Refresh list"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnFamRules" Style="{DynamicResource Chip}" Padding="10,5" Margin="0,6,0,0" ToolTip="Rules for hanging several services together">
                  <StackPanel Orientation="Horizontal">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" Data="M0,2 L14,2 M0,7 L14,7 M0,12 L14,12 M4,0 L4,4 M10,5 L10,9 M6,10 L6,14"/>
                    <TextBlock Text="Hanger rules"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="2" StrokeLineJoin="Round" Data="M12,3 L22,8 L12,13 L2,8 Z"/>
                  <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,12 L12,17 L22,12"/>
                  <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,16 L12,21 L22,16"/>
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="1" Text="Workset for placed and edited hangers" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="CmbFamWorkset" Grid.Column="2" ToolTip="Which workset the hangers these tools place or edit go on. Leave as is: new hangers go on their service&apos;s workset and edited ones stay where they are."/>
            </Grid>
          </Border>
          <Button x:Name="BtnFamToggleAll" Style="{DynamicResource Chip}" Padding="10,4" Margin="0,0,0,8" HorizontalAlignment="Left" ToolTip="Show or hide every tool">
            <StackPanel Orientation="Horizontal">
              <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,5 L12,0 M0,7 L6,12 L12,7"/>
              <TextBlock x:Name="FamToggleAllTxt" Text="Collapse all"/>
            </StackPanel>
          </Button>
          <StackPanel>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFamPlace" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,2 L23,2"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,2 L5,17 M15,2 L15,17"/>
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,10 L18,10 L18,16 L2,16 Z"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,17.5 L18,17.5"/>
                      <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M20,15 L20,23 M16,19 L24,19"/>
                    
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Place hanger on service" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFamPlace" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Pick and place" ToolTip="Click on services or units one after another; Esc to finish"/>
                    <Path x:Name="ChvFamPlace" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFamPlace" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Click on a duct, pipe or cable tray: the hanger is centred at the invert, on its level, square to it and stretched to its width. Click mechanical equipment or a duct accessory and it goes under the unit&apos;s bottom face, across the unit and stretched to its width. Or select several services first, press Pick and place and click on one of them: one hanger goes round all of them, centred on them, stretched to the outer edges and at the lowest invert. Esc to finish." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <WrapPanel>
                        <CheckBox x:Name="ChkFamInsPlace" Content="Hanger outside insulation" Margin="0,3,16,3" ToolTip="Ticked: the hanger wraps the insulation (width + 2 x thickness, invert lowered by the thickness). Unticked: it fits the bare duct inside the insulation."/>
                        <CheckBox x:Name="ChkFamLockPlace" Content="Lock to the service centre and bottom" Margin="0,3,16,3" ToolTip="Align-locks the hanger to the service centreline (in the plan view) and its bottom face (in one section per service, reused on later runs). Round services lock to the centre only. Never on shared hangers."/>
                      <CheckBox x:Name="ChkFamRodPlace" Content="Extend drop rod up to soffit" Margin="0,3,8,3"/>
                      <Button x:Name="BtnFamRodCatsPlace" Style="{DynamicResource Chip}" Padding="9,2" Margin="0,2,0,2" Content="Rod targets..." ToolTip="Choose which categories the drop rods can run up to (besides floors, framing and roofs)"/>
                      </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFamRealign" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,2 L23,2"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,2 L8,15 M16,2 L16,15"/>
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,8 L18,8 L18,14 L6,14 Z"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,15.5 L18,15.5"/>
                      <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.5,20 L6,20 M4,18 L6,20 L4,22 M23.5,20 L18,20 M20,18 L18,20 L20,22"/>
                    
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Re-align hangers to service" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFamRealign" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Pick duct, then hangers" ToolTip="Run this tool"/>

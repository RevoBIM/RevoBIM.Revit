                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,10 L20,10 M16,6.5 L20,10 L16,13.5"/>
                      <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M21,18 L4,18 M8,14.5 L4,18 L8,21.5"/>
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>

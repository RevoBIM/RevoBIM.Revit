                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="10"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Distance from hangers" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFamAutoDimOffset" Grid.Column="1" Tag="800" Margin="0,2" ToolTip="How far from the hanger centreline the dimension line goes (mm) - shared with the Dimension placer"/>
                        <TextBlock Grid.Column="3" Text="Type" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <ComboBox x:Name="CmbFamAutoDimType" Grid.Column="4" Margin="0,2" ToolTip="Dimension type - shared with the Dimension placer"/>
                      </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFamSwap" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">

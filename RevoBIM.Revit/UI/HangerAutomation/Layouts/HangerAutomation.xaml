                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,1 L2,23 M22,1 L22,23"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,6 L4,6 M0,18 L4,18 M20,6 L24,6 M20,18 L24,18"/>
                      <Path Stroke="{DynamicResource RedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,2 L9,22 M7,2 L11,2 M7,12 L11,12 M7,22 L11,22 M16,2 L16,22"/>
                      <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="0.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,12 L9,12 M2,2 L16,2 M2,22 L16,22"/>
                    
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Dimension placer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFamDims" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Pick hangers and dimension" ToolTip="Run this tool"/>
                    <Path x:Name="ChvFamDims" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFamDims" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Floor plans only. Isolates the hangers (dimensions stay on), you box-select or click hangers and Finish, then a centre-to-centre chained dimension goes along each run." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="10"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Distance from hangers" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFamDimOffset" Grid.Column="1" Tag="800" Margin="0,2" ToolTip="How far from the hanger centreline the dimension line goes (mm)"/>
                        <TextBlock Grid.Column="3" Text="Type" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <ComboBox x:Name="CmbFamDimType" Grid.Column="4" Margin="0,2"/>
                      </Grid>
                      <TextBlock x:Name="FamDimHint" Text="Open a floor plan to use this." Foreground="{DynamicResource OrangeBrush}" FontSize="11" Margin="0,3,0,0"/>

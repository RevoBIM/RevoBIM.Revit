                      <WrapPanel>
                        <CheckBox x:Name="ChkFamInsAuto" Content="Hanger outside insulation" Margin="0,3,14,3" ToolTip="Ticked: the hanger wraps the insulation (width + 2 x thickness, invert lowered by the thickness). Unticked: it fits the bare duct inside the insulation."/>
                        <CheckBox x:Name="ChkFamLockAuto" Content="Lock to the service centre and bottom" Margin="0,3,14,3" ToolTip="Align-locks the hanger to the service centreline (in the plan view) and its bottom face (in one section per service, reused on later runs). Round services lock to the centre only. Never on shared hangers."/>
                      <CheckBox x:Name="ChkFamAccessory" Content="Support either side of dampers" Margin="0,3,14,3"/>
                        <CheckBox x:Name="ChkFamRodAuto" Content="Drop rods to soffit" Margin="0,3,14,3"/>
                        <CheckBox x:Name="ChkFamSkipExisting" Content="Skip existing hangers" Margin="0,3,14,3"/>
                      </WrapPanel>
                      <!-- ================ dimensions (a subtle divider above) ================ -->
                      <Border Height="1" Background="{DynamicResource EdgeBrush}" Opacity="0.8" Margin="0,8,0,6"/>
                      <CheckBox x:Name="ChkFamDims" Content="Dimension each run" Margin="0,2,0,3" ToolTip="A chained dimension along each run: its ends and every hanger. From a 3D view you are asked which floor plans or sections it goes in."/>

                    <Button x:Name="BtnFamSwap" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Select and swap" ToolTip="Swap the selected fabrication hangers (or the ones you pick) for the family hanger chosen in the list"/>
                    <Path x:Name="ChvFamSwap" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFamSwap" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Swaps MEP Fabrication hangers already in the model for the family hanger chosen in the list. Select the fabrication hangers first (or press Select and swap and pick them). Each family hanger is placed with the same rules as Pick and place - position, service and size are taken from the fabrication hanger it replaces; if that hanger was not hosted on the right service, the family hanger is sized and set to the service it really sits on. The fabrication hanger is removed once its replacement is placed." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="Uses the options of Place hanger on service (outside insulation, lock, drop rod)." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFamRods" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                          <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,2 L24,2"/>
                          <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,4 L6,20 M18,4 L18,20"/>
                          <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,21 L21,21"/>
                          <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M12,17 L12,6 M9,9 L12,6 L15,9"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Drop rod extender" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFamRods" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Pick hangers, then target" ToolTip="Run this tool"/>
                    <Path x:Name="ChvFamRods" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFamRods" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Pick one or more hangers, then the element to hang them from - a floor, beam, steel or service, in this model or a linked one. Each drop rod runs up to that element&apos;s underside above it, or its lowest point." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <CheckBox x:Name="ChkFamRodLinked" Content="Target is in a linked model" ToolTip="Go straight to picking inside a link. Unticked, clicking a link still works - you are asked to click the element inside it next."/>
                    <Button x:Name="BtnFamRodCats" Style="{DynamicResource Chip}" Padding="9,3" Margin="0,6,0,0" HorizontalAlignment="Left" Content="Rod targets..." ToolTip="Choose which categories the drop rods can run up to when Extend drop rod up to soffit is used (besides floors, framing and roofs)"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFamDims" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">

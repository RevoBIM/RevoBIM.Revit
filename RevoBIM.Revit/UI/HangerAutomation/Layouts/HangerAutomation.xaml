                      <CheckBox x:Name="ChkFamRodRealign" Content="Re-extend drop rod to soffit" Margin="0,3,0,3"/>
                      </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">

                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- ================ Family floor support (built from the Family Hangers panel by build_floor_panel.py - do not edit by hand) ================ -->
        <ScrollViewer x:Name="FloorPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10,14,4">
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Width="104" Height="104" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Top">
                <Grid>
                  <TextBlock x:Name="FlrPreviewHint" Text="Preview" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Image x:Name="FlrPreview" Margin="4" Stretch="Uniform"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1">
                <Grid Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <ComboBox x:Name="CmbFlrCategory" Grid.Column="0"/>
                  <TextBox x:Name="TxtFlrSearch" Grid.Column="2" Tag="Search family or type"/>
                  <CheckBox x:Name="ChkFlrSetOnly" Grid.Column="3" Content="Set up only" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="List only the families already set up in Family settings (shown in bold green)"/>
                </Grid>
                <ListBox x:Name="LstFlrFamilies" Height="92" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <Thumb x:Name="ThmFlrListSize" Height="10" Cursor="SizeNS" ToolTip="Drag down to see more families (up for fewer)">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="Transparent">
                        <Border Width="40" Height="3" CornerRadius="1.5" Background="{DynamicResource EdgeStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
                <TextBlock x:Name="FlrChosenTxt" Text="Choose the support family and type" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="10,0,0,0">
                <Button x:Name="BtnFlrSettings" Style="{DynamicResource Chip}" Padding="10,5" Margin="0,0,0,6" ToolTip="Width, first bar and support height settings for this family">
                  <StackPanel Orientation="Horizontal">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" Data="M7,0 L7,2.5 M7,11.5 L7,14 M0,7 L2.5,7 M11.5,7 L14,7 M2,2 L3.8,3.8 M10.2,10.2 L12,12 M12,2 L10.2,3.8 M3.8,10.2 L2,12 M7,3.5 A3.5,3.5 0 1 1 6.99,3.5 Z"/>
                    <TextBlock Text="Family settings"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnFlrRefresh" Style="{DynamicResource Chip}" Padding="10,5" ToolTip="Read the families in the project again">
                  <StackPanel Orientation="Horizontal">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" Data="M12,7 A5,5 0 1 1 10.5,3.5 M10.5,0.5 L10.5,3.5 L13.5,3.5"/>
                    <TextBlock Text="Refresh list"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnFlrRules" Style="{DynamicResource Chip}" Padding="10,5" Margin="0,6,0,0" ToolTip="Rules for supporting several services together (shared with the Family Hangers tab)">
                  <StackPanel Orientation="Horizontal">
                    <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" Data="M0,2 L14,2 M0,7 L14,7 M0,12 L14,12 M4,0 L4,4 M10,5 L10,9 M6,10 L6,14"/>
                    <TextBlock Text="Support rules"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="2" StrokeLineJoin="Round" Data="M12,3 L22,8 L12,13 L2,8 Z"/>
                  <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,12 L12,17 L22,12"/>
                  <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,16 L12,21 L22,16"/>
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="1" Text="Workset for placed and edited supports" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="CmbFlrWorkset" Grid.Column="2" ToolTip="Which workset the supports these tools place or edit go on. Leave as is: new supports go on their service&apos;s workset and edited ones stay where they are."/>
            </Grid>
          </Border>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,3 L6,17 M18,3 L18,17 M3,9 L21,9"/>
                  <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,21 L23,17"/>
                </Canvas>
              </Viewbox>
              <TextBlock Grid.Column="1" Text="Supports stand on" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <ComboBox x:Name="CmbFlrBase" Grid.Column="2" ToolTip="The level: the base sits on the service&apos;s level. A picked element: after you start a tool you click a floor, roof or mechanical equipment (here or in a linked model) and each support&apos;s base is lifted onto its top surface, still hosted on the same level."/>
              <CheckBox x:Name="ChkFlrBaseLinked" Grid.Row="1" Grid.Column="2" Content="It is in a linked model" Margin="0,6,0,0" ToolTip="Go straight to picking inside a link. Unticked, clicking a link still works - you are asked to click the element inside it next."/>
            </Grid>
          </Border>
          <Button x:Name="BtnFlrToggleAll" Style="{DynamicResource Chip}" Padding="10,4" Margin="0,0,0,8" HorizontalAlignment="Left" ToolTip="Show or hide every tool">
            <StackPanel Orientation="Horizontal">
              <Path Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,5 L12,0 M0,7 L6,12 L12,7"/>
              <TextBlock x:Name="FlrToggleAllTxt" Text="Collapse all"/>
            </StackPanel>
          </Button>
          <StackPanel>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFlrPlace" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,2 L23,2"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,2 L5,17 M15,2 L15,17"/>
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,10 L18,10 L18,16 L2,16 Z"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,17.5 L18,17.5"/>
                      <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M20,15 L20,23 M16,19 L24,19"/>
                    
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Place support on service" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFlrPlace" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Pick and place" ToolTip="Click on services or units one after another; Esc to finish"/>
                    <Path x:Name="ChvFlrPlace" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFlrPlace" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Click on a duct, pipe or cable tray: the support stands on the service&apos;s level (or the floor, roof or equipment you pick - see Supports stand on), centred under it and square to it, with its first bar at the service invert, its height to the service depth and its width to the service. Click mechanical equipment or a duct accessory and it goes under the unit&apos;s bottom face. Or select several services first, press Pick and place and click on one of them: one support goes round all of them, centred on them, stretched to the outer edges, standing at the lowest invert and as tall as the tallest. Esc to finish." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <WrapPanel>
                        <CheckBox x:Name="ChkFlrInsPlace" Content="Support outside insulation" Margin="0,3,16,3" ToolTip="Ticked: the support goes round the insulation (width and height + 2 x thickness, first bar lowered by the thickness). Unticked: it fits the bare duct inside the insulation."/>
                        <CheckBox x:Name="ChkFlrLockPlace" Content="Lock to the service centre and bottom" Margin="0,3,16,3" ToolTip="Align-locks the support to the service centreline (in the plan view) and its bottom face (in one section per service, reused on later runs). Round services lock to the centre only. Never on shared supports."/>
                      </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFlrRealign" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,2 L23,2"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M8,2 L8,15 M16,2 L16,15"/>
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,8 L18,8 L18,14 L6,14 Z"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6,15.5 L18,15.5"/>
                      <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0.5,20 L6,20 M4,18 L6,20 L4,22 M23.5,20 L18,20 M20,18 L18,20 L20,22"/>
                    
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Re-align supports to service" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFlrRealign" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Pick duct, then supports" ToolTip="Run this tool"/>
                    <Path x:Name="ChvFlrRealign" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFlrRealign" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Pick the service (several to share supports), Finish, then the supports: each slides sideways under the centreline of the segment above it - never along the run - and its first bar, height and width are refitted." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <WrapPanel>
                        <CheckBox x:Name="ChkFlrInsRealign" Content="Support outside insulation" Margin="0,3,16,3" ToolTip="Ticked: the support goes round the insulation (width and height + 2 x thickness, first bar lowered by the thickness). Unticked: it fits the bare duct inside the insulation."/>
                        <CheckBox x:Name="ChkFlrLockRealign" Content="Lock to the service centre and bottom" Margin="0,3,16,3" ToolTip="Align-locks the support to the service centreline (in the plan view) and its bottom face (in one section per service, reused on later runs). Round services lock to the centre only. Never on shared supports."/>
                      </WrapPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFlrAuto" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,2 L24,2"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,2 L3,15 M12,2 L12,15 M21,2 L21,15"/>
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,9 L24,9 L24,14 L0,14 Z"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,15.5 L5,15.5 M10,15.5 L14,15.5 M19,15.5 L23,15.5"/>
                      <Path Stroke="{DynamicResource GreenBrush}" StrokeThickness="1.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,20 L21,20 M3,18 L3,22 M12,18 L12,22 M21,18 L21,22"/>
                    
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Auto place supports along selected run" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFlrAuto" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Select run and place" ToolTip="Run this tool"/>
                    <Path x:Name="ChvFlrAuto" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFlrAuto" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Flat straights only; first after each bend, one before the next bend, set down or damper, nothing on takeoffs, kept off flanges (mm)." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="10"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="10"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Max spacing" VerticalAlignment="Center" Margin="0,2,6,2" ToolTip="mm"/>
                        <TextBox x:Name="TxtFlrSpacing" Grid.Row="0" Grid.Column="1" Tag="3000" Margin="0,2" ToolTip="Maximum distance between supports (mm)"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="After a bend" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFlrStart" Grid.Row="0" Grid.Column="4" Tag="300" Margin="0,2" ToolTip="First support this far after a bend (mm)"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Before a bend" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFlrEnd" Grid.Row="0" Grid.Column="7" Tag="300" Margin="0,2" ToolTip="Last support this far before a bend, set down or damper (mm)"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Off flanges" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFlrFlange" Grid.Row="1" Grid.Column="1" Tag="150" Margin="0,2" ToolTip="Keep supports this far from every joint / flange (mm)"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Off takeoffs" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFlrTakeoff" Grid.Row="1" Grid.Column="4" Tag="400" Margin="0,2" ToolTip="Keep supports this far from taps and takeoffs (mm)"/>
                      </Grid>
                      <CheckBox x:Name="ChkFlrDw144" Content="Cap spacing at DW/144 for the duct size (3000 / 2500 mm)" ToolTip="DW/144 maximum support spacing for horizontal ducts, by duct weight. Your maximum still applies if smaller."/>
                      <WrapPanel>
                        <CheckBox x:Name="ChkFlrInsAuto" Content="Support outside insulation" Margin="0,3,14,3" ToolTip="Ticked: the support goes round the insulation (width and height + 2 x thickness, first bar lowered by the thickness). Unticked: it fits the bare duct inside the insulation."/>
                        <CheckBox x:Name="ChkFlrLockAuto" Content="Lock to the service centre and bottom" Margin="0,3,14,3" ToolTip="Align-locks the support to the service centreline (in the plan view) and its bottom face (in one section per service, reused on later runs). Round services lock to the centre only. Never on shared supports."/>
                      <CheckBox x:Name="ChkFlrAccessory" Content="Support either side of dampers" Margin="0,3,14,3"/>
                        <CheckBox x:Name="ChkFlrSkipExisting" Content="Skip existing supports" Margin="0,3,14,3"/>
                      </WrapPanel>
                      <!-- ================ dimensions (a subtle divider above) ================ -->
                      <Border Height="1" Background="{DynamicResource EdgeBrush}" Opacity="0.8" Margin="0,8,0,6"/>
                      <CheckBox x:Name="ChkFlrDims" Content="Dimension each run" Margin="0,2,0,3" ToolTip="A chained dimension along each run: its ends and every support. From a 3D view you are asked which floor plans or sections it goes in."/>
                      <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="10"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Distance from supports" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFlrAutoDimOffset" Grid.Column="1" Tag="800" Margin="0,2" ToolTip="How far from the support centreline the dimension line goes (mm) - shared with the Dimension placer"/>
                        <TextBlock Grid.Column="3" Text="Type" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <ComboBox x:Name="CmbFlrAutoDimType" Grid.Column="4" Margin="0,2" ToolTip="Dimension type - shared with the Dimension placer"/>
                      </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8">
              <StackPanel>
                <Border x:Name="HdrFlrDims" Background="Transparent" CornerRadius="5" Padding="12,8" Cursor="Hand" ToolTip="Click to show or hide this tool">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Grid.Column="0" Width="26" Height="26" HorizontalAlignment="Left">
                      <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,1 L2,23 M22,1 L22,23"/>
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M0,6 L4,6 M0,18 L4,18 M20,6 L24,6 M20,18 L24,18"/>
                      <Path Stroke="{DynamicResource RedBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M9,2 L9,22 M7,2 L11,2 M7,12 L11,12 M7,22 L11,22 M16,2 L16,22"/>
                      <Path Stroke="{DynamicResource MutedBrush}" StrokeThickness="0.8" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,12 L9,12 M2,2 L16,2 M2,22 L16,22"/>
                    
                      </Canvas>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="4" Height="16" Background="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
                      <TextBlock Text="Dimension placer" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="BtnFlrDims" Grid.Column="2" Style="{DynamicResource Primary}" Padding="12,3" Margin="8,0,0,0" VerticalAlignment="Center" Content="Pick supports and dimension" ToolTip="Run this tool"/>
                    <Path x:Name="ChvFlrDims" Grid.Column="3" Width="12" Height="8" Stretch="Uniform" VerticalAlignment="Center" Margin="8,0,2,0" RenderTransformOrigin="0.5,0.5" Stroke="{DynamicResource MutedBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M0,0 L6,6 L12,0"/>
                  </Grid>
                </Border>
                <Border x:Name="BodyFlrDims" ClipToBounds="True">
                  <StackPanel Margin="50,0,12,10">
                    <TextBlock Text="Floor plans only. Isolates the supports (dimensions stay on), you box-select or click supports and Finish, then a centre-to-centre chained dimension goes along each run." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="56"/>
                          <ColumnDefinition Width="10"/>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Distance from supports" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <TextBox x:Name="TxtFlrDimOffset" Grid.Column="1" Tag="800" Margin="0,2" ToolTip="How far from the support centreline the dimension line goes (mm)"/>
                        <TextBlock Grid.Column="3" Text="Type" VerticalAlignment="Center" Margin="0,2,6,2"/>
                        <ComboBox x:Name="CmbFlrDimType" Grid.Column="4" Margin="0,2"/>
                      </Grid>
                      <TextBlock x:Name="FlrDimHint" Text="Open a floor plan to use this." Foreground="{DynamicResource OrangeBrush}" FontSize="11" Margin="0,3,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
        </ScrollViewer>

        <!-- ================ Hanger Service Type Assigner ================ -->
        <ScrollViewer x:Name="SvcPanel" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="14,10,14,4">
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,1 L4,11 M14,1 L14,11 M1,11 L17,11"/>
                    <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M12,14 L22,14 L22,22 L12,22 L9,18 Z M14.5,18 L19.5,18"/>
                  </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Hangers in the project" FontWeight="SemiBold"/>
                  <TextBlock Text="FAB hangers and MEP Ancillary Framing, grouped. Click a heading to sort, Shift+click to add a level. F5 reads the model again." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnSvcReload" Grid.Column="2" Style="{DynamicResource Chip}" Padding="10,5" Content="Read again" ToolTip="Read the hangers in the project again (F5)"/>
              </Grid>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CmbSvcCategory" Grid.Column="0" ToolTip="Which hangers to list"/>
                <TextBox x:Name="TxtSvcSearch" Grid.Column="2" Tag="Search family, type, level or comments"/>
              </Grid>
              <WrapPanel Margin="0,8,0,0">
                <TextBlock Text="Group by" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ChkSvcByFamily" Content="Family" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkSvcByType" Content="Type" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkSvcByLevel" Content="Level" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkSvcByComments" Content="Comments" Margin="0,0,12,0" VerticalAlignment="Center"/>
              </WrapPanel>
              <Border Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Margin="0,8,0,0" Padding="2,0,2,0">
                <Grid x:Name="SvcHead">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="HdrSvcFamily" Grid.Column="0" Style="{DynamicResource ColHead}" Content="Family"/>
                  <Button x:Name="HdrSvcType" Grid.Column="1" Style="{DynamicResource ColHead}" Content="Type"/>
                  <Button x:Name="HdrSvcLevel" Grid.Column="2" Style="{DynamicResource ColHead}" Content="Level"/>
                  <Button x:Name="HdrSvcComments" Grid.Column="3" Style="{DynamicResource ColHead}" Content="Comments"/>
                  <Button x:Name="HdrSvcCount" Grid.Column="4" Style="{DynamicResource ColHead}" Content="Count"/>
                </Grid>
              </Border>
              <ListBox x:Name="LstSvc" Height="300" SelectionMode="Extended" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <Thumb x:Name="ThmSvcListSize" Height="10" Cursor="SizeNS" ToolTip="Drag down to see more rows (up for fewer)">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="Transparent">
                        <Border Width="40" Height="3" CornerRadius="1.5" Background="{DynamicResource EdgeStrongBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              <TextBlock x:Name="TxtSvcCount" Text="Reading the hangers..." Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,1,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="5" Padding="12,8" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Services resting within (mm)" VerticalAlignment="Center" Margin="0,3,10,3"/>
              <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <TextBox x:Name="TxtSvcTol" Width="70" ToolTip="A service counts as carried by a hanger when its underside is this close to the hanger's bar (FAB hangers: their host), or its centre this close to a ring"/>
                <TextBlock Text="of a hanger's bar or ring count as carried by it" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock Grid.Row="1" Text="Apply to" VerticalAlignment="Center" Margin="0,3,10,3"/>
              <ComboBox x:Name="CmbSvcScope" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,3"/>
              <WrapPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnSvcReset3D" Content="Reset 3D" Margin="0,0,8,0" ToolTip="Put the 3D view back: colours, section box and isolate"/>
                <Button x:Name="BtnSvcShow3D" Style="{DynamicResource Accent}" Content="Show in default 3D" Margin="0,0,8,0" IsEnabled="False" ToolTip="Select rows first: the default 3D view, cropped to those hangers, with the services they carry see-through and each category in its own colour (temporary)"/>
                <Button x:Name="BtnSvcApply" Style="{DynamicResource Primary}" Content="Apply associated service type to hanger" ToolTip="Write into each hanger's Comments the family, type and service type abbreviation of the services it carries"/>
              </WrapPanel>
            </Grid>
          </Border>
        </StackPanel>
        </ScrollViewer>

        <TextBox x:Name="LogBox" Grid.Row="3" Height="84" Margin="14,0,14,10" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Tag="Results appear here"/>

        <!-- ================ Finish Selection card: shown only while Revit waits on a multiple selection ================ -->
        <Border x:Name="FinishCard" Grid.Row="4" Visibility="Collapsed" Margin="14,0,14,10" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BlueBrush}" BorderThickness="1.5" CornerRadius="4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="4"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="3,0,0,3" Background="{DynamicResource BlueBrush}"/>
            <StackPanel Grid.Column="1" Margin="11,8,12,10">
              <TextBlock x:Name="FinishEyebrow" Text="SELECTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock x:Name="FinishTitle" Text="Select the elements" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock x:Name="FinishDetail" TextWrapping="Wrap" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}"/>
              <Border Background="{DynamicResource BarBrush}" CornerRadius="3" Padding="7,3" Margin="0,7,0,0" HorizontalAlignment="Left">
                <TextBlock x:Name="FinishHint" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" Text="Finish Selection  &#x00B7;  Options Bar Finish  &#x00B7;  Return     &#x00B7;     Esc to stop"/>
              </Border>
              <Button x:Name="BtnFinish" Style="{DynamicResource Primary}" Margin="0,10,0,0" Padding="10,8" FontSize="13" FontWeight="SemiBold" Content="&#x2713;  Finish Selection" ToolTip="Finish the selection - the same as Finish on the Options Bar or Return (pressed once per pick)"/>
            </StackPanel>
          </Grid>
        </Border>
        <!-- ================ footer ================ -->
        <Border x:Name="FooterBar" Grid.Row="5" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusTxt" Grid.Column="0" Text="Ready" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <CheckBox x:Name="ChkDebug" Content="Debug" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Log every step; Copy debug puts it on the clipboard to send over"/>
              <Button x:Name="BtnCopyDebug" Content="Copy debug" Margin="0,0,8,0"/>
              <Button x:Name="BtnClose" Content="Close"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Grid x:Name="GripLayer"/>
  </Grid>
</Window>

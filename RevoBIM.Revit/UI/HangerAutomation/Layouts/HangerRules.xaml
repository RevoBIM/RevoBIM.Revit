<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Hanger rules"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="6">
    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource EdgeStrongBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================ header ================ -->
        <Border x:Name="RulesHeader" Grid.Row="0" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Hanger rules" FontSize="13" Foreground="{DynamicResource OrangeBrush}" Margin="0,-2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="RulesVerTxt" Text="v1.1.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="RulesShrinkBtn" Style="{DynamicResource WinBtn}" ToolTip="Shrink to the taskbar - see Revit (Ctrl+Shift+H)">
                <Grid Width="12" Height="12">
                  <Path x:Name="RulesShrinkIcon" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,3 L6,7 L10,3 M1,11 L11,11"/>
                  <Path x:Name="RulesExpandIcon" Visibility="Collapsed" Stroke="{DynamicResource GreenBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,1.5 L11,1.5 M6,11 L6,4.5 M2.5,8 L6,4.5 L9.5,8"/>
                </Grid>
              </Button>
              <Button x:Name="RulesCloseBtn" Style="{DynamicResource CloseBtn}" Content="&#x2715;" ToolTip="Close without saving"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================ body ================ -->
        <StackPanel Grid.Row="1" Margin="14,12,14,8">
          <TextBlock Text="Several services on one hanger" FontSize="14" FontWeight="SemiBold"/>
          <TextBlock Text="When more than one service is selected, services share a hanger when they run parallel, sit at about the same height and are close together in plan. The hanger sits at the lowest invert and reaches each outer edge." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="230"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Bottoms within (mm)" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox x:Name="RulesZ" Grid.Row="0" Grid.Column="1" Width="90" HorizontalAlignment="Left" Tag="50" Margin="0,3" ToolTip="Largest difference in bottom (invert) level between services on one hanger"/>
            <TextBlock Grid.Row="1" Text="Clear gap between services under (mm)" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox x:Name="RulesGap" Grid.Row="1" Grid.Column="1" Width="90" HorizontalAlignment="Left" Tag="500" Margin="0,3" ToolTip="Edge to edge in plan, neighbour to neighbour"/>
            <TextBlock Grid.Row="2" Text="Parallel within (degrees)" VerticalAlignment="Center" Margin="0,3"/>
            <TextBox x:Name="RulesAngle" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Tag="2" Margin="0,3"/>
            <TextBlock Grid.Row="3" Text="Centre the hanger on" VerticalAlignment="Center" Margin="0,3"/>
            <ComboBox x:Name="RulesCentre" Grid.Row="3" Grid.Column="1" Margin="0,3"/>
          </Grid>
        </StackPanel>

        <!-- ================ footer ================ -->
        <Border Grid.Row="2" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="12,8">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RulesCancel" Content="Cancel" Margin="0,0,8,0"/>
            <Button x:Name="RulesSave" Style="{DynamicResource Primary}" Content="Save"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

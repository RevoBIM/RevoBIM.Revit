<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Number Sequencer - Move to"
        Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">
    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource ChromeEdge}"
            BorderThickness="1" CornerRadius="6">
        <StackPanel>
            <!-- ======== Header ======== -->
            <Border x:Name="PHeader" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0" Padding="12,8">
                <DockPanel>
                    <TextBlock x:Name="PVersion" DockPanel.Dock="Right" Text="v0.0.0" FontSize="11"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Blue}"/>
                        <TextBlock x:Name="PTitle" Text="Move to" FontSize="13" Foreground="{DynamicResource Orange}"
                                   Margin="0,-2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ======== Body ======== -->
            <StackPanel Margin="14,12,14,8">
                <TextBlock x:Name="PMessage" Text="" TextWrapping="Wrap" Foreground="{DynamicResource Text}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="PValue" Tag="Position number"/>
                <TextBlock x:Name="PError" Text="" FontSize="11" Foreground="{DynamicResource Red}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- ======== Footer ======== -->
            <Border Background="{DynamicResource Bar}" CornerRadius="0,0,6,6" Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="PCancel" Style="{DynamicResource ToolButton}" Content="Cancel"/>
                    <Button x:Name="POk" Style="{DynamicResource ActionButton}" Tag="i:apply" Content="Move"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>

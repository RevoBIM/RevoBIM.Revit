<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Number Sequencer"
        Width="980" Height="900" MinWidth="680" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Grid x:Name="MainGrid">
        <Border x:Name="RootBorder" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource ChromeEdge}"
                BorderThickness="1" CornerRadius="6" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ======== Header ======== -->
                <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0"
                        Padding="12,8,8,8">
                    <DockPanel LastChildFill="True">
                        <Image x:Name="HeaderIcon" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ThemeBtn" Style="{DynamicResource ChipButton}" ToolTip="Theme: Auto follows the Revit canvas, then Dark, then Light">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Ellipse Stroke="{DynamicResource Orange}" StrokeThickness="1.4"/>
                                        <Path Data="M6,0.7 A5.3,5.3 0 0 1 6,11.3 Z" Fill="{DynamicResource Orange}"/>
                                    </Grid>
                                    <TextBlock x:Name="ThemeText" Text="Auto" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="11" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <Button x:Name="MinBtn" Style="{DynamicResource ChromeButton}"
                                    ToolTip="Shrink to a bar at the bottom of the screen, so Revit can be seen"/>
                            <Button x:Name="FullBtn" Style="{DynamicResource ChromeButton}" ToolTip="Full screen (F11)">
                                <Border Width="11" Height="10" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5"
                                        CornerRadius="1"/>
                            </Button>
                            <Button x:Name="CloseBtn" Style="{DynamicResource CloseButton}" ToolTip="Close">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Text}" StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock x:Name="RevoText" Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Blue}" HorizontalAlignment="Left" Cursor="Hand"/>
                            <TextBlock x:Name="ToolText" Text="Number Sequencer" FontSize="15"
                                       Foreground="{DynamicResource Orange}" Margin="0,-3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ======== Tabs ======== -->
                <Border Grid.Row="1" Background="{DynamicResource Bar}" Padding="12,0,12,0"
                        BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <!-- fold or open every section on this tab at once -->
                        <Button x:Name="FoldAllBtn" DockPanel.Dock="Right" Style="{DynamicResource ChipButton}"
                                Tag="i:collapse" Content="Collapse all" Margin="0" VerticalAlignment="Center"
                                ToolTip="Fold every section on this tab away (the window shrinks with them) - or open them all again"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabSeq" Tag="i:seq" GroupName="MainTab" Style="{DynamicResource TabButton}"
                                         Content="Sequencer" ToolTip="Number the selected or picked systems"/>
                            <RadioButton x:Name="TabSel" Tag="i:selector" GroupName="MainTab" Style="{DynamicResource TabButton}"
                                         Content="System Selector" ToolTip="Every duct or pipe system in the active view, in the order you set"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ======== Body: the tab's sections over the shared settings, then Tag Views or Sheets ======== -->
                <Grid Grid.Row="2" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="560"/>
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="MainArea" Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- ==== Sequencer tab: systems, then the families in them ==== -->
                        <Grid x:Name="SeqPane" Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="SeqFamRow" Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="SeqSysToggle" DockPanel.Dock="Right" Style="{DynamicResource ChromeButton}"
                                                Width="26" Height="22" ToolTip="Fold this section away / back"/>
                                        <TextBlock x:Name="SysCountText" DockPanel.Dock="Right" Text="" FontSize="11" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <Border Style="{DynamicResource StepBadge}"><TextBlock Style="{DynamicResource StepText}" Text="1"/></Border>
                                        <TextBlock Text="Elements in the sequence" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel x:Name="SeqSysBody" Margin="0,6,0,0">
                                        <WrapPanel Margin="0,0,0,6">
                                            <Button x:Name="AddSelBtn" Tag="i:add" Style="{DynamicResource AccentButton}" Content="Add selection"
                                                    ToolTip="Add the elements selected in Revit - any category (Air Terminals, Sprinklers, Fittings...). Then tick the categories to number."/>
                                            <Button x:Name="AllInViewBtn" Tag="i:show" Style="{DynamicResource ToolButton}" Content="All in view"
                                                    ToolTip="Add every model element visible in the active view, then tick the categories to number"/>
                                            <Button x:Name="PickSysBtn" Visibility="Collapsed" Tag="i:pick" Style="{DynamicResource ToolButton}" Content="Pick systems"
                                                    ToolTip="Click the first element of each system in the order to number them - Esc when done"/>
                                            <Button x:Name="SysUpBtn" Visibility="Collapsed" Tag="i:up" Style="{DynamicResource ChipButton}" Content="Up" ToolTip="Number this system earlier"/>
                                            <Button x:Name="SysDownBtn" Visibility="Collapsed" Tag="i:down" Style="{DynamicResource ChipButton}" Content="Down" ToolTip="Number this system later"/>
                                            <Button x:Name="SysRemoveBtn" Visibility="Collapsed" Tag="i:remove" Style="{DynamicResource ChipButton}" Content="Remove"/>
                                            <Button x:Name="SysClearBtn" Tag="i:clear" Style="{DynamicResource ChipButton}" Content="Clear"/>
                                        </WrapPanel>
                                        <CheckBox x:Name="PosCheck" IsChecked="True" Visibility="Collapsed" Content="Order by position (any category, e.g. Air Terminals)" Margin="0,0,0,4"
                                                  ToolTip="Number whatever is selected in Revit, in the order it sits in the view: a snake left to right, or top to bottom. Add selection reads the selected elements of any category."/>
                                        <WrapPanel x:Name="PosPanel" Margin="0,0,0,6">
                                            <ComboBox x:Name="PosForm" MinWidth="230" Margin="0,0,6,0" ToolTip="The order: across the view row by row, or down it column by column. Each row or column goes back the other way.">
                                                <ComboBoxItem Content="Left to right, rows going down" IsSelected="True"/>
                                                <ComboBoxItem Content="Left to right, rows going up"/>
                                                <ComboBoxItem Content="Top to bottom, columns going right"/>
                                                <ComboBoxItem Content="Top to bottom, columns going left"/>
                                            </ComboBox>
                                            <Button x:Name="PosPickBtn" Tag="i:start" Style="{DynamicResource GreenFillButton}" Content="Pick first element"
                                                    ToolTip="Click the element that gets the first number. The lines in the view show the order; Run Sequence applies it."/>
                                            <Button x:Name="PosClearBtn" Tag="i:remove" Style="{DynamicResource ChipButton}" Content="Clear lines"
                                                    ToolTip="Remove the preview lines and put the view back"/>
                                        </WrapPanel>
                                        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                                                BorderThickness="1" CornerRadius="4">
                                            <ScrollViewer x:Name="SysScroll" MaxHeight="150" MinHeight="40" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="SystemHost" Margin="4"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button x:Name="SeqFamToggle" DockPanel.Dock="Right" Style="{DynamicResource ChromeButton}"
                                                Width="26" Height="22" ToolTip="Fold this section away / back"/>
                                        <TextBlock x:Name="CountText" DockPanel.Dock="Right" Text="" FontSize="11" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <Border Style="{DynamicResource StepBadge}"><TextBlock Style="{DynamicResource StepText}" Text="2"/></Border>
                                        <TextBlock Text="Families in the systems" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Grid x:Name="SeqFamBody" Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button x:Name="ExpandAllBtn" Tag="i:expand" Style="{DynamicResource ChipButton}" ToolTip="Expand all"/>
                                                <Button x:Name="CollapseAllBtn" Tag="i:collapse" Style="{DynamicResource ChipButton}" ToolTip="Collapse all"/>
                                                <Button x:Name="TickAllBtn" Tag="i:tick" Style="{DynamicResource ChipButton}" ToolTip="Tick all"/>
                                                <Button x:Name="UntickAllBtn" Tag="i:untick" Style="{DynamicResource ChipButton}" ToolTip="Untick all"/>
                                            </StackPanel>
                                            <TextBox x:Name="SearchBox" Tag="Search category, family or type" Margin="0,0,6,0"/>
                                        </DockPanel>
                                        <Border Grid.Row="1" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                                                BorderThickness="1" CornerRadius="4">
                                            <ScrollViewer x:Name="TreeScroll" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="TreeHost" Margin="4"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ==== System Selector tab: the families first, then the systems ==== -->
                        <Grid x:Name="SelPane" Grid.Row="0" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition x:Name="SelSysRow" Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- families in the ticked systems: as tall as they are (up to a share of the window) -->
                            <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="SelFamToggle" DockPanel.Dock="Right" Style="{DynamicResource ChromeButton}"
                                                Width="26" Height="22" ToolTip="Slide the families away / back"/>
                                        <TextBlock x:Name="SelCountText" DockPanel.Dock="Right" Text="" FontSize="11" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <Border Style="{DynamicResource StepBadge}"><TextBlock Style="{DynamicResource StepText}" Text="1"/></Border>
                                        <TextBlock Text="Families in the ticked systems" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <StackPanel x:Name="SelFamBody" Margin="0,6,0,0">
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button x:Name="SelExpandAllBtn" Tag="i:expand" Style="{DynamicResource ChipButton}" ToolTip="Expand all"/>
                                                <Button x:Name="SelCollapseAllBtn" Tag="i:collapse" Style="{DynamicResource ChipButton}" ToolTip="Collapse all"/>
                                                <Button x:Name="SelTickAllBtn" Tag="i:tick" Style="{DynamicResource ChipButton}" ToolTip="Tick all"/>
                                                <Button x:Name="SelUntickAllBtn" Tag="i:untick" Style="{DynamicResource ChipButton}" ToolTip="Untick all"/>
                                            </StackPanel>
                                            <TextBox x:Name="SelSearchBox" Tag="Search category, family or type" Margin="0,0,6,0"/>
                                        </DockPanel>
                                        <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                                                BorderThickness="1" CornerRadius="4">
                                            <ScrollViewer x:Name="SelTreeScroll" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="SelTreeHost" Margin="4"/>
                                            </ScrollViewer>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- systems: kind, refresh, one row of tools, the table -->
                            <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel>
                                        <Button x:Name="SelSysToggle" DockPanel.Dock="Right" Style="{DynamicResource ChromeButton}"
                                                Width="26" Height="22" ToolTip="Fold this section away / back"/>
                                        <Button x:Name="SelRefreshBtn" Tag="i:refresh" DockPanel.Dock="Right" Style="{DynamicResource AccentButton}"
                                                Margin="0,0,6,0" Content="Refresh from view"
                                                ToolTip="Read the systems in the active view again - order, ticks and starts are kept"/>
                                        <Border Style="{DynamicResource StepBadge}"><TextBlock Style="{DynamicResource StepText}" Text="2"/></Border>
                                        <TextBlock Text="Systems" FontSize="13" FontWeight="SemiBold" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="SelDuctTab" Tag="i:duct" GroupName="SelKind" Content="Duct Systems"/>
                                            <RadioButton x:Name="SelPipeTab" Tag="i:pipe" GroupName="SelKind" Content="Pipe Systems"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid x:Name="SelSysBody" Grid.Row="1" Margin="0,6,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <!-- step 2 in order: 2.1 isolate in 3D (and group what belongs together),
                                             2.2 pick the start, 2.3 let the tool put the rest in order -->
                                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                            <Button x:Name="SelIso3DBtn" Style="{DynamicResource GreenFillButton}" Tag="i:cube"
                                                    Content="Isolate 3D"
                                                    ToolTip="Open the 3D view chosen beside it, isolate the ticked systems there, fit its section box to them and colour them. Press again to reset that 3D view."/>
                                            <ComboBox x:Name="Sel3DCombo" Width="130" Margin="0,0,6,0" VerticalAlignment="Center"
                                                      ToolTip="The 3D view Isolate 3D uses"/>
                                            <Button x:Name="SelGroupBtn" Style="{DynamicResource GreenButton}" Tag="i:group"
                                                    Content="Group systems"
                                                    ToolTip="Group systems: the systems of the elements selected in the view - or, with nothing selected there, the systems selected in the table. A group is numbered as one block and drawn in one colour, dark to light in its order."/>
                                            <Button x:Name="SelPickStartBtn" Style="{DynamicResource GreenFillButton}" Tag="i:start"
                                                    Content="Pick start"
                                                    ToolTip="Click the element the sequence starts from - its system (or group) goes to #1"/>
                                            <Button x:Name="SelAutoBtn" Style="{DynamicResource ToolButton}" Tag="i:auto"
                                                    Content="Auto Re-order"
                                                    ToolTip="Pick a start first"/>
                                        </WrapPanel>
                                        <TextBlock x:Name="SelViewText" Grid.Row="1" Text="" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>

                                        <!-- every tool on one row: view | order | group | include -->
                                        <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                                            <Button x:Name="SelIsolateBtn" Style="{DynamicResource ToolButton}" Tag="i:isolate"
                                                    Content="Isolate Systems 2D"
                                                    ToolTip="Temporary isolate the ticked systems in this view - only the families ticked above, with their tags - and colour them. Press again to reset."/>
                                            <Button x:Name="SelColourBtn" Style="{DynamicResource ToolButton}" Tag="i:colour"
                                                    ToolTip="Colour each system in the view to match its swatch; the start is drawn heavy in magenta. Press again to clear."/>
                                            <Border Width="1" Height="20" Margin="2,0,8,0" Background="{DynamicResource Edge}" VerticalAlignment="Center"/>
                                            <Button x:Name="SelUpBtn" Style="{DynamicResource ChipButton}" Tag="i:up"
                                                    ToolTip="Up: select the system above.  Shift: move the selected systems up"/>
                                            <Button x:Name="SelDownBtn" Style="{DynamicResource ChipButton}" Tag="i:down"
                                                    ToolTip="Down: select the system below.  Shift: move the selected systems down"/>
                                            <Button x:Name="SelTopBtn" Style="{DynamicResource ChipButton}" Tag="i:top"
                                                    ToolTip="Move the selected systems to the top"/>
                                            <Button x:Name="SelBottomBtn" Style="{DynamicResource ChipButton}" Tag="i:bottom"
                                                    ToolTip="Move the selected systems to the bottom"/>
                                            <Button x:Name="SelAutoOrderBtn" Style="{DynamicResource ChipButton}" Tag="i:order"
                                                    ToolTip="Auto order: keep the first system (or group), then each next system or group is the one whose start is nearest where the last finished. Groups move as one, in their own order."/>
                                            <Border Width="1" Height="20" Margin="2,0,8,0" Background="{DynamicResource Edge}" VerticalAlignment="Center"/>
                                            <Button x:Name="SelUngroupBtn" Style="{DynamicResource ChipButton}" Tag="i:ungroup"
                                                    ToolTip="Ungroup: break up the groups of the selected systems"/>
                                            <Button x:Name="SelGroupOrderBtn" Style="{DynamicResource ChipButton}" Tag="i:regroup"
                                                    ToolTip="Reorder in group: inside the selected systems' groups (every group when none is selected) - first the one nearest where the systems before it finish, then each next the nearest"/>
                                            <Border Width="1" Height="20" Margin="2,0,8,0" Background="{DynamicResource Edge}" VerticalAlignment="Center"/>
                                            <Button x:Name="SelAllOnBtn" Style="{DynamicResource ChipButton}" Tag="i:tick" ToolTip="Tick every system"/>
                                            <Button x:Name="SelAllOffBtn" Style="{DynamicResource ChipButton}" Tag="i:untick" ToolTip="Untick every system"/>
                                            <Button x:Name="SelRemoveBtn" Style="{DynamicResource RedButton}" Tag="i:hide"
                                                    Content="Remove from sequence"
                                                    ToolTip="Remove from sequence: select elements in the view, then press - they are hidden in the view and left out of the numbering"/>
                                            <Button x:Name="SelRestoreBtn" Style="{DynamicResource ToolButton}" Tag="i:restore"
                                                    ToolTip="Restore removed: put every removed element back in the numbering and show it again"/>
                                        </WrapPanel>

                                        <!-- systems table: header and rows built in code from one column list -->
                                        <Border Grid.Row="3" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                                                BorderThickness="1" CornerRadius="4" MinHeight="120">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Border x:Name="SelHeaderHost" Grid.Row="0" Background="{DynamicResource Bar}"
                                                        Padding="4,4,10,4" CornerRadius="4,4,0,0"/>
                                                <ScrollViewer x:Name="SelScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible"
                                                              HorizontalScrollBarVisibility="Disabled" Focusable="True"
                                                              FocusVisualStyle="{x:Null}" AllowDrop="True" Background="Transparent">
                                                    <StackPanel x:Name="SelRows" Margin="4,2,0,2"/>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ==== Shared by both tabs: start point, parameter, sequence ==== -->
                        <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                                BorderThickness="1" CornerRadius="5" Padding="10,8">
                            <StackPanel>
                                <!-- start point -->
                                <DockPanel>
                                    <Button x:Name="StartToggle" DockPanel.Dock="Right" Style="{DynamicResource ChromeButton}"
                                            Width="26" Height="22" ToolTip="Fold this section away / back"/>
                                    <Border Style="{DynamicResource StepBadge}"><TextBlock Style="{DynamicResource StepText}" Text="3"/></Border>
                                    <TextBlock x:Name="StartHead" Text="Start point" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="StartBody" Margin="0,4,0,0">
                                    <TextBlock x:Name="StartText" Text="No systems yet" TextWrapping="Wrap" FontSize="12"
                                               Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                                    <WrapPanel>
                                        <Button x:Name="PickStartBtn" Tag="i:start" Style="{DynamicResource ToolButton}" Content="Pick start"
                                                ToolTip="Click the element to start from - its system is selected and starts there"/>
                                        <Button x:Name="AutoStartBtn" Tag="i:auto" Style="{DynamicResource ToolButton}" Content="Auto"
                                                ToolTip="Start from the equipment connection, else the biggest open end"/>
                                        <Button x:Name="ShowStartBtn" Tag="i:show" Style="{DynamicResource ToolButton}" Content="Show"
                                                ToolTip="Select and zoom to the selected system's start element in Revit"/>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- parameter -->
                                <DockPanel Margin="0,10,0,0">
                                    <Button x:Name="ParamToggle" DockPanel.Dock="Right" Style="{DynamicResource ChromeButton}"
                                            Width="26" Height="22" ToolTip="Fold this section away / back"/>
                                    <Border Style="{DynamicResource StepBadge}"><TextBlock Style="{DynamicResource StepText}" Text="4"/></Border>
                                    <TextBlock Text="Parameter" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="ParamBody" Margin="0,4,0,0">
                                    <!-- type-to-filter dropdown: the list narrows to names containing the text -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBox x:Name="ParamBox" Tag="Type to search parameters" Padding="6,4,30,4"/>
                                        <Button x:Name="ParamDrop" Style="{DynamicResource ChromeButton}" HorizontalAlignment="Right"
                                                Width="26" Height="24" Margin="0,0,2,0" ToolTip="Show every parameter">
                                            <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/>
                                        </Button>
                                        <Popup x:Name="ParamPopup" PlacementTarget="{Binding ElementName=ParamBox}" Placement="Bottom"
                                               StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Blue}"
                                                    BorderThickness="1" CornerRadius="4" Margin="0,2,0,0"
                                                    MinWidth="{Binding ActualWidth, ElementName=ParamBox}">
                                                <ScrollViewer x:Name="ParamScroll" MaxHeight="280" VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel x:Name="ParamListHost" Margin="2"/>
                                                </ScrollViewer>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <TextBlock x:Name="ParamNote" Text="" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Muted}"/>
                                </StackPanel>

                                <!-- sequence: one row -->
                                <DockPanel Margin="0,10,0,0">
                                    <Button x:Name="SequenceToggle" DockPanel.Dock="Right" Style="{DynamicResource ChromeButton}"
                                            Width="26" Height="22" ToolTip="Fold this section away / back"/>
                                    <Border Style="{DynamicResource StepBadge}"><TextBlock Style="{DynamicResource StepText}" Text="5"/></Border>
                                    <TextBlock Text="Sequence" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="SequenceBody" Margin="0,4,0,0">
                                    <WrapPanel>
                                        <TextBlock Text="Format" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <RadioButton x:Name="Fmt3" GroupName="Fmt" Content="001"/>
                                        <RadioButton x:Name="Fmt2" GroupName="Fmt" Content="01"/>
                                        <RadioButton x:Name="Fmt1" GroupName="Fmt" Content="1"/>
                                        <TextBlock Text="Start at" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                   Margin="10,0,8,0"/>
                                        <TextBox x:Name="StartBox" Tag="e.g. 045" Width="80" VerticalAlignment="Center"/>
                                        <TextBlock Text="Count" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                   Margin="14,0,8,0"/>
                                        <RadioButton x:Name="DirUp" GroupName="Dir" Content="Upwards"/>
                                        <RadioButton x:Name="DirDown" GroupName="Dir" Content="Downwards"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="PreviewText" Text="" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Blue}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ==== tags, sheets and views open in their own, bigger window ==== -->
                        <Button x:Name="TagOpenBtn" Grid.Row="2" Style="{DynamicResource GreenButton}" Margin="0,8,0,0"
                                Padding="12,9" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch"
                                ToolTip="Choose the tag and the views or sheets to tag in - opens a bigger window">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource StepBadge}" Margin="0,0,10,0"><TextBlock Style="{DynamicResource StepText}" Text="6"/></Border>
                                <Viewbox Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path x:Name="TagOpenIcon" Width="16" Height="16" StrokeThickness="1.6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock Text="Tag Views or Sheets" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TagOpenNote" Text="" FontSize="12" FontWeight="Normal" Margin="12,0,0,0"
                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ==== tags, sheets and views: kept here, shown in the Tag Views or Sheets window ==== -->
                    <Border x:Name="TagStore" Grid.Column="0" Visibility="Collapsed">
                        <Grid x:Name="TagContent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 6.1 the tag family -->
                            <Border Grid.Row="0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,8" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Border Style="{DynamicResource SubStepBadge}"><TextBlock Style="{DynamicResource SubStepText}" Text="6.1"/></Border>
                                        <TextBlock Text="Tag family" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <CheckBox x:Name="TagCheck" Content="Tag each numbered element (in the views ticked, else the active view)"
                                              Margin="0,0,0,6"/>
                                    <ComboBox x:Name="TagCombo" Margin="0,0,0,4"/>
                                    <CheckBox x:Name="TagUntaggedCheck" Content="Tag untagged only" Margin="0,2,0,4"
                                              ToolTip="Leave elements that already have a tag in a view alone. Off: they get this tag too (never the same tag twice)."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <RadioButton x:Name="TagScopeView" GroupName="TagScope" Content="Current view" IsChecked="True" Margin="0,0,14,0"
                                                     ToolTip="Tag in the view you are in"/>
                                        <RadioButton x:Name="TagScopeTicked" GroupName="TagScope" Content="Ticked views / sheets (6.2)"
                                                     ToolTip="Tag in every view ticked below, wherever the numbered elements show"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TagLeaderCheck" Content="Leader" Margin="0,2,0,4" ToolTip="Draw a leader from the tag to the element"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <TextBlock Text="Offset X" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Muted}"/>
                                        <TextBox x:Name="TagOffX" Width="56" Margin="0,0,10,0" ToolTip="mm to the right of the element (negative = left)"/>
                                        <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Muted}"/>
                                        <TextBox x:Name="TagOffY" Width="56" Margin="0,0,6,0" ToolTip="mm above the element (negative = below)"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                        <CheckBox x:Name="TagElbowCheck" Content="Elbow" Margin="0,0,10,0" ToolTip="Bend the leader: it runs straight in from the tag for this far (needs Leader and an offset)"/>
                                        <TextBox x:Name="TagElbowMm" Width="56" Margin="0,0,6,0"/>
                                        <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="TagRemoveCheck" Content="Remove existing tags on these elements first" Margin="0,2,0,4"
                                              ToolTip="Delete any tag already on a numbered element in the view before placing the new one"/>
                                    <CheckBox x:Name="TagUntangleCheck" Content="Untangle: move overlapping tags apart" Margin="0,2,0,4"
                                              ToolTip="After placing, nudge tags that touch each other apart, up the view"/>
                                    <TextBlock x:Name="TagNote" Text="" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Muted}"/>
                                </StackPanel>
                            </Border>

                            <!-- 6.2 the sheets or views to tag in: one at a time, in tabs -->
                            <Border x:Name="TagViewsCard" Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                                    BorderThickness="1" CornerRadius="5" Padding="10,8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <TextBlock x:Name="TagViewCount" DockPanel.Dock="Right" Text="" FontSize="11"
                                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                        <Border Style="{DynamicResource SubStepBadge}"><TextBlock Style="{DynamicResource SubStepText}" Text="6.2"/></Border>
                                        <TextBlock Text="Sheets or views to tag in" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Border Grid.Row="1" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="TagTabSheets" Tag="i:sheet" GroupName="TagTab" Style="{DynamicResource TabButton}"
                                                         Content="Sheets" ToolTip="Pick sheets: the views placed on them are ticked"/>
                                            <RadioButton x:Name="TagTabViews" Tag="i:show" GroupName="TagTab" Style="{DynamicResource TabButton}"
                                                         Content="Views" ToolTip="Tick the plans, sections and 3D views to tag in"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- sheets: selecting one finds and ticks the views placed on it -->
                                    <Grid x:Name="TagSheetsPanel" Grid.Row="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <Button x:Name="TagSheetClearBtn" DockPanel.Dock="Right" Style="{DynamicResource ChipButton}"
                                                    Tag="i:filter" Content="Clear sheets" Margin="6,0,0,0"
                                                    ToolTip="Deselect the sheets and show every view again (ticks stay)"/>
                                            <TextBox x:Name="TagSheetSearch" Tag="Find sheets by number or name"/>
                                        </DockPanel>
                                        <!-- column headings: drag the edges to size Number and Views -->
                                        <Border x:Name="TagSheetHead" Grid.Row="1" Background="{DynamicResource Bar}"
                                                Padding="4,3,10,3" CornerRadius="4,4,0,0"/>
                                        <Border Grid.Row="2" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                                                BorderThickness="1" CornerRadius="0,0,4,4">
                                            <ScrollViewer x:Name="TagSheetScroll" VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="TagSheetRows" Margin="4,2,0,2"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>

                                    <!-- views: plans, sections and 3D views, grouped by two view parameters chosen in the header -->
                                    <Grid x:Name="TagViewsPanel" Grid.Row="2" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                            <Button x:Name="TagViewFindBtn" Style="{DynamicResource ToolButton}" Tag="i:show"
                                                    Content="Find views with this system"
                                                    ToolTip="Show only the views that show the selected system(s)"/>
                                            <Button x:Name="TagViewAllBtn" Style="{DynamicResource ChipButton}" Tag="i:refresh"
                                                    Content="All views" ToolTip="Show every view again (and read them again)"/>
                                            <Button x:Name="TagViewTickBtn" Style="{DynamicResource ChipButton}" Tag="i:tick"
                                                    Content="Tick shown" ToolTip="Tick every view in the list as filtered"/>
                                            <Button x:Name="TagViewUntickBtn" Style="{DynamicResource ChipButton}" Tag="i:untick"
                                                    Content="Untick all"/>
                                            <Button x:Name="TagViewClearFiltersBtn" Style="{DynamicResource ChipButton}" Tag="i:filter"
                                                    Content="Clear filters" ToolTip="Clear every column's text and value filter"/>
                                        </WrapPanel>
                                        <!-- view types: all on, or any one on its own -->
                                        <WrapPanel Grid.Row="1" Margin="0,0,0,6">
                                            <TextBlock Text="Show:" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <CheckBox x:Name="TagKindPlan" Content="Floor plans" Margin="0,0,14,0"/>
                                            <CheckBox x:Name="TagKindSection" Content="Sections" Margin="0,0,14,0"/>
                                            <CheckBox x:Name="TagKind3D" Content="3D views" Margin="0,0,14,0"
                                                      ToolTip="3D views take tags only when locked - unlocked ones say so in Type"/>
                                        </WrapPanel>
                                        <Border x:Name="TagViewHead" Grid.Row="2" Background="{DynamicResource Bar}"
                                                Padding="4,4,10,4" CornerRadius="4,4,0,0"/>
                                        <Border Grid.Row="3" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                                                BorderThickness="1" CornerRadius="0,0,4,4">
                                            <ScrollViewer x:Name="TagViewScroll" VerticalScrollBarVisibility="Visible"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="TagViewRows" Margin="4,2,0,2"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ======== Footer ======== -->
                <Border Grid.Row="3" Background="{DynamicResource Bar}" CornerRadius="0,0,6,6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="DebugCheck" Content="Debug" Margin="0,0,10,0"/>
                            <Button x:Name="CopyDebugBtn" Tag="i:copy" Style="{DynamicResource ChipButton}" Content="Copy debug"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="" Foreground="{DynamicResource Muted}"
                                   FontSize="12" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="ApplyBtn" Grid.Column="2" Style="{DynamicResource ActionButton}" Padding="30,10" FontSize="15"
                                ToolTip="Number the sequence (and tag it, when Tags is on)">
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{DynamicResource StepBadge}" Margin="0,0,10,0"><TextBlock Style="{DynamicResource StepText}" Text="7"/></Border>
                                <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                                    <Path x:Name="ApplyIcon" Width="16" Height="16" Data="M2,8 L6,12 L14,4"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Viewbox>
                                <TextBlock x:Name="ApplyText" Text="Run Sequence" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ======== Resize grips (no Background, so the window stays clickable) ======== -->
        <Grid x:Name="GripLayer">
            <Thumb x:Name="GripL" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Margin="0,8"/>
            <Thumb x:Name="GripR" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Margin="0,8"/>
            <Thumb x:Name="GripT" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Cursor="SizeNS" Margin="8,0"/>
            <Thumb x:Name="GripB" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Margin="8,0"/>
            <Thumb x:Name="GripTL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
            <Thumb x:Name="GripTR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
            <Thumb x:Name="GripBL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
            <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
        </Grid>
    </Grid>
</Window>



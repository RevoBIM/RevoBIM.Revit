<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Number Sequencer - Tag Views or Sheets"
        Width="900" Height="860" MinWidth="560" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI">
    <Grid>
        <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource ChromeEdge}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ======== Header ======== -->
                <Border x:Name="THeader" Grid.Row="0" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0"
                        Padding="12,8,8,8">
                    <DockPanel>
                        <Image x:Name="TIcon" DockPanel.Dock="Left" Width="28" Height="28" Margin="0,0,10,0"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="TThemeBtn" Style="{DynamicResource ChipButton}"
                                    ToolTip="Theme: Auto follows the Revit canvas, then Dark, then Light">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                                        <Ellipse Stroke="{DynamicResource Orange}" StrokeThickness="1.4"/>
                                        <Path Data="M6,0.7 A5.3,5.3 0 0 1 6,11.3 Z" Fill="{DynamicResource Orange}"/>
                                    </Grid>
                                    <TextBlock x:Name="TThemeText" Text="Auto" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TVersion" Text="v0.0.0" FontSize="11" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center" Margin="4,0,10,0"/>
                            <Button x:Name="TMinBtn" Style="{DynamicResource ChromeButton}"
                                    ToolTip="Shrink to a bar at the bottom of the screen, so Revit can be seen"/>
                            <Button x:Name="TFullBtn" Style="{DynamicResource ChromeButton}" ToolTip="Full screen (F11)">
                                <Border Width="11" Height="10" BorderBrush="{DynamicResource Muted}" BorderThickness="1.5"
                                        CornerRadius="1"/>
                            </Button>
                            <Button x:Name="TCloseX" Style="{DynamicResource CloseButton}" ToolTip="Close (the ticks are kept)">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Text}" StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Blue}"/>
                            <TextBlock Text="Number Sequencer - Tag Views or Sheets" FontSize="13"
                                       Foreground="{DynamicResource Orange}" Margin="0,-3,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ======== the tags, sheets and views (moved in from the main window) ======== -->
                <Border x:Name="THost" Grid.Row="1" Margin="12,10,12,8"/>

                <!-- ======== Footer ======== -->
                <Border Grid.Row="2" Background="{DynamicResource Bar}" CornerRadius="0,0,6,6" Padding="12,8">
                    <DockPanel>
                        <Button x:Name="TApplyBtn" DockPanel.Dock="Right" Style="{DynamicResource ActionButton}"
                                Tag="i:apply" Content="Apply"
                                ToolTip="Keep these tags and views and go back to the sequence"/>
                        <TextBlock x:Name="TStatus" Text="" Foreground="{DynamicResource Muted}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ======== Resize grips (no Background, so the window stays clickable) ======== -->
        <Grid>
            <Thumb x:Name="GripL" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Margin="0,8"/>
            <Thumb x:Name="GripR" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Margin="0,8"/>
            <Thumb x:Name="GripT" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Cursor="SizeNS" Margin="8,0"/>
            <Thumb x:Name="GripB" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Margin="8,0"/>
            <Thumb x:Name="GripTL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
            <Thumb x:Name="GripTR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
            <Thumb x:Name="GripBL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
            <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
        </Grid>
    </Grid>
</Window>

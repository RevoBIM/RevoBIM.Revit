<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Thumbnail - Settings"
        Width="900" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource bWindow}" BorderBrush="{DynamicResource bEdge}">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======================== header ======================== -->
            <Border x:Name="Header" Grid.Row="0" CornerRadius="5,5,0,0" Padding="14,8,10,8"
                    Background="{DynamicResource bBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="HeaderIcon" Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource bBlue}"/>
                        <TextBlock Text="Family Thumbnail - Settings" FontSize="14" Foreground="{DynamicResource bOrange}"/>
                    </StackPanel>
                    <Button x:Name="btnTheme" Grid.Column="2" Style="{DynamicResource ChipButton}"
                            VerticalAlignment="Center" ToolTip="Theme: Auto follows Revit, then Dark, then Light">
                        <TextBlock x:Name="tbTheme" Text="Auto" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="tbVersion" Grid.Column="3" Margin="12,0,8,0" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource bMuted}"/>
                    <Button x:Name="btnShrink" Grid.Column="4" Style="{DynamicResource ShrinkBtn}"
                            VerticalAlignment="Center" ToolTip="Shrink to taskbar (Ctrl+Shift+H)"/>
                    <Button x:Name="btnCloseX" Grid.Column="5" Style="{DynamicResource CloseBtn}"
                            VerticalAlignment="Center" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- ======================== body ======================== -->
            <TabControl x:Name="Tabs" Grid.Row="1" Margin="14,8,14,4">

                <!--  Appearance  -->
                <TabItem Header="Appearance Settings">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource bBlue}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Default Appearance" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="3D Families" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="2D Families" HorizontalAlignment="Center" FontWeight="SemiBold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Display Style" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cbStyle3D" Grid.Row="1" Grid.Column="1"/>
                                    <ComboBox x:Name="cbStyle2D" Grid.Row="1" Grid.Column="3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Detail Level" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cbDetail3D" Grid.Row="2" Grid.Column="1"/>
                                    <ComboBox x:Name="cbDetail2D" Grid.Row="2" Grid.Column="3"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="View Scale" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cbScale3D" Grid.Row="3" Grid.Column="1"/>
                                    <ComboBox x:Name="cbScale2D" Grid.Row="3" Grid.Column="3"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="View Type" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="cbView3D" Grid.Row="4" Grid.Column="1"/>
                                    <TextBlock Grid.Row="4" Grid.Column="3" Text="The family's own plan view"
                                               VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource bMuted}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <Button x:Name="btnAddOverride" Style="{DynamicResource AddButton}" Margin="0,0,10,0"
                                            ToolTip="Add an override for a family category"/>
                                    <TextBlock Text="Override Appearance By Category" FontWeight="SemiBold" FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,10,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Category" Foreground="{DynamicResource bMuted}" Margin="2,0,0,0"/>
                                    <TextBlock Grid.Column="1" Text="View Type" Foreground="{DynamicResource bMuted}" Margin="2,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="Display Style" Foreground="{DynamicResource bMuted}" Margin="2,0,0,0"/>
                                    <TextBlock Grid.Column="3" Text="Detail Level" Foreground="{DynamicResource bMuted}" Margin="2,0,0,0"/>
                                    <TextBlock Grid.Column="4" Text="View Scale" Foreground="{DynamicResource bMuted}" Margin="2,0,0,0"/>
                                </Grid>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="OverrideList"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!--  General  -->
                <TabItem Header="General Settings">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource bBlue}" Margin="0,0,8,0"/>
                                    <TextBlock Text="View General Options" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="36"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Thumbnail View Name" VerticalAlignment="Center"/>
                                    <TextBox x:Name="tbViewName" Grid.Row="0" Grid.Column="1" Width="320" HorizontalAlignment="Left"/>

                                    <CheckBox x:Name="cbExport" Grid.Row="1" Grid.Column="0" Content="Export Images" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton x:Name="rbResize" Content="Resize Image To Fit" GroupName="fit" Margin="0,0,20,0"/>
                                        <RadioButton x:Name="rbSquare" Content="Maintain 1:1 Aspect Ratio" GroupName="fit" Margin="0,0,28,0"/>
                                        <TextBlock Text="Size (px)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBox x:Name="tbSize" Width="64" Margin="0,0,16,0"/>
                                        <ComboBox x:Name="cbFormat" Width="76"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Export Folder" VerticalAlignment="Center"/>
                                    <Grid Grid.Row="2" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="tbFolder" Grid.Column="0" Margin="0,0,8,0"/>
                                        <Button x:Name="btnBrowse" Grid.Column="1" Content="Browse..." Padding="12,3"/>
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource bOrange}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Hide While Exporting" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <CheckBox x:Name="cbLock" Content="Lock 3D View Orientation" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideDim" Content="Hide Dimensions" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideRefPts" Content="Hide Reference Points" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideRefLines" Content="Hide Reference Lines" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideRefPlanes" Content="Hide Reference Planes" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideText" Content="Hide Text Notes"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="cbHideInvisible" Content="Hide Invisible Lines" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideFlip" Content="Hide Flip Controls" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideRoomPts" Content="Hide Room Calculation Points" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideHost" Content="Hide Host Elements" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideConn" Content="Hide Connector Elements" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideVoid" Content="Hide Void Elements" Margin="0,0,0,7"/>
                                        <CheckBox x:Name="cbHideImported" Content="Hide Imported Elements"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{DynamicResource CardBorder}">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Top">
                                <CheckBox x:Name="cbCategoryFolders" Content="Save into a sub-folder named after the family category" Margin="0,0,34,6" ToolTip="Doors go to Export folder\\Doors, Lighting Fixtures to Export folder\\Lighting Fixtures, and so on"/>
                                <CheckBox x:Name="cbPrompt" Content="Prompt to open the folder once saved" Margin="0,0,34,6"/>
                                <CheckBox x:Name="cbLeave" Content="Leave the Thumbnail View open when finished" Margin="0,0,0,6"/>
                            </WrapPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!--  Family parameters  -->
                <TabItem Header="Family Parameters">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{DynamicResource CardBorder}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource bBlue}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Fill Parameters On Update" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <CheckBox x:Name="cbFillParams" Content="Fill in the family parameters below every time a family is updated (Update Current and Update Batch)" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Shared parameter file" VerticalAlignment="Center"/>
                                    <TextBox x:Name="tbSharedFile" Grid.Column="1" IsReadOnly="True" Margin="0,0,8,0"
                                             ToolTip="Parameters missing from a family are added from this file, under Identity Data"/>
                                    <Button x:Name="btnBrowseShared" Grid.Column="2" Content="Browse..." Width="90" Margin="0,0,8,0"/>
                                    <Button x:Name="btnDefaultShared" Grid.Column="3" Content="Use default" Width="100"/>
                                </Grid>
                                <TextBlock x:Name="tbParamFile" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource bMuted}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" VerticalAlignment="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210"/>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Creator parameter" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cbParamCreator" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" ToolTip="Text shared parameters from the current shared parameter file"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Revision parameter" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cbParamRevision" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" ToolTip="Text shared parameters from the current shared parameter file"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Date parameter" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cbParamDate" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" ToolTip="Text shared parameters from the current shared parameter file"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Creator value" VerticalAlignment="Center" Margin="0,6,0,10"/>
                                <TextBox x:Name="tbCreator" Grid.Row="3" Grid.Column="1" Margin="0,6,0,10" ToolTip="Leave blank to use the Revit user name"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Blank = Revit user name" Margin="12,6,0,10" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource bMuted}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Revision goes up by" VerticalAlignment="Center" Margin="0,0,0,10"/>
                                <ComboBox x:Name="cbRevisionStep" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="MAJOR.MINOR.PATCH, first update is 1.0.0" Margin="12,0,0,10" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource bMuted}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Date format" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="YYYY-MM-DD (today)" VerticalAlignment="Center" Foreground="{DynamicResource bMuted}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!--  Background  -->
                <TabItem Header="Gradient Background">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource bBlue}" Margin="0,0,8,0"/>
                                    <TextBlock Text="3D Background" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <CheckBox x:Name="cbGradient" Content="Apply a gradient background to the thumbnail" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                        <RowDefinition Height="38"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Sky" VerticalAlignment="Center"/>
                                    <Button x:Name="swSky" Grid.Row="0" Grid.Column="1" Style="{DynamicResource SwatchButton}" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="tbSky" Grid.Row="0" Grid.Column="2" Width="96" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Top of the view in elevations (Front, Back, Left, Right)"
                                               FontSize="12" Foreground="{DynamicResource bMuted}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Horizon" VerticalAlignment="Center"/>
                                    <Button x:Name="swHorizon" Grid.Row="1" Grid.Column="1" Style="{DynamicResource SwatchButton}" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="tbHorizon" Grid.Row="1" Grid.Column="2" Width="96" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="Top of the gradient in 3D and Top views"
                                               FontSize="12" Foreground="{DynamicResource bMuted}" VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ground" VerticalAlignment="Center"/>
                                    <Button x:Name="swGround" Grid.Row="2" Grid.Column="1" Style="{DynamicResource SwatchButton}" HorizontalAlignment="Left"/>
                                    <TextBox x:Name="tbGround" Grid.Row="2" Grid.Column="2" Width="96" HorizontalAlignment="Left"/>
                                    <TextBlock Grid.Row="2" Grid.Column="3" Text="Bottom of the gradient in 3D and Top views"
                                               FontSize="12" Foreground="{DynamicResource bMuted}" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource bOrange}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Presets" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <WrapPanel x:Name="presetPanel"/>

                                <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource bMuted}"
                                           Text="Colours are typed as hex (#RRGGBB) or picked from the swatch. The background is applied to the thumbnail view only while the image is exported, then put back."/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{DynamicResource CardBorder}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource bBlue}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Preview" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <TextBlock Text="3D and Top views" FontSize="12" Foreground="{DynamicResource bMuted}" Margin="0,0,0,4"/>
                                <Border x:Name="prevDown" Height="150" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource bEdge}"/>
                                <TextBlock Text="Elevation views" FontSize="12" Foreground="{DynamicResource bMuted}" Margin="0,14,0,4"/>
                                <Border x:Name="prevElev" Height="150" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource bEdge}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ======================== footer ======================== -->
            <Border x:Name="Footer" Grid.Row="2" CornerRadius="0,0,5,5" Padding="14,10"
                    Background="{DynamicResource bBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbStatus" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource bMuted}"/>
                    <Button x:Name="btnSave" Grid.Column="1" Content="Save" Width="110" Margin="0,0,10,0"
                            Style="{DynamicResource GreenButton}"/>
                    <Button x:Name="btnClose" Grid.Column="2" Content="Close" Width="110"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Thumbnail - Update Batch"
        Width="780" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource bWindow}" BorderBrush="{DynamicResource bEdge}">
        <Grid x:Name="Root">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border x:Name="Header" Grid.Row="0" CornerRadius="5,5,0,0" Padding="14,8,10,8"
                    Background="{DynamicResource bBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="HeaderIcon" Grid.Column="0" Width="36" Height="36" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource bBlue}"/>
                        <TextBlock Text="Family Thumbnail - Update Batch" FontSize="14" Foreground="{DynamicResource bOrange}"/>
                    </StackPanel>
                    <Button x:Name="btnSettings" Grid.Column="2" Style="{DynamicResource ChipButton}"
                            VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Settings (before the run)">
                        <TextBlock Text="&#x2699;" FontSize="14" FontFamily="Segoe UI Symbol"/>
                    </Button>
                    <Button x:Name="btnTheme" Grid.Column="3" Style="{DynamicResource ChipButton}"
                            VerticalAlignment="Center" ToolTip="Theme: Auto follows Revit, then Dark, then Light">
                        <TextBlock x:Name="tbTheme" Text="Auto" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="tbVersion" Grid.Column="4" Margin="12,0,8,0" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource bMuted}"/>
                    <Button x:Name="btnShrink" Grid.Column="5" Style="{DynamicResource ShrinkBtn}"
                            VerticalAlignment="Center" ToolTip="Shrink to taskbar (Ctrl+Shift+H)"/>
                    <Button x:Name="btnCloseX" Grid.Column="6" Style="{DynamicResource CloseBtn}"
                            VerticalAlignment="Center" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- summary -->
            <StackPanel Grid.Row="1" Margin="18,14,18,6">
                <TextBlock x:Name="tbSummary" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="tbOptions" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource bMuted}"/>
                <TextBlock x:Name="tbSkipped" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource bOrange}"/>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tbFilter" Grid.Column="0" Margin="0,0,10,0" ToolTip="Filter by family or category name. Separate several names with commas"/>
                    <Button x:Name="btnShowAll" Grid.Column="1" Content="Show all families" Width="140" Margin="0,0,8,0"/>
                    <Button x:Name="btnTickShown" Grid.Column="2" Content="Tick shown" Width="110" Margin="0,0,8,0"/>
                    <Button x:Name="btnClear" Grid.Column="3" Content="Clear ticks" Width="110"/>
                </Grid>
            </StackPanel>

            <!-- family list -->
            <Border Grid.Row="2" Style="{DynamicResource CardBorder}" Margin="18,6,18,8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="10,2,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Family" FontSize="12" Foreground="{DynamicResource bMuted}"/>
                        <TextBlock Grid.Column="2" Text="Category" FontSize="12" Foreground="{DynamicResource bMuted}"/>
                        <TextBlock Grid.Column="3" Text="Status" FontSize="12" Foreground="{DynamicResource bMuted}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FamilyList"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- progress -->
            <StackPanel Grid.Row="3" Margin="18,0,18,10">
                <Border Height="14" CornerRadius="7" Background="{DynamicResource bField}"
                        BorderBrush="{DynamicResource bEdge}" BorderThickness="1">
                    <Grid x:Name="barGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="6" Background="{DynamicResource bGreen}"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="tbProgress" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource bMuted}"/>
            </StackPanel>

            <!-- footer -->
            <Border x:Name="Footer" Grid.Row="4" CornerRadius="0,0,5,5" Padding="14,10"
                    Background="{DynamicResource bBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbStatus" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource bMuted}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnDebug" Content="Save debug log" Width="130" Margin="0,0,10,0"
                                ToolTip="Writes what the tool can see (selection, settings, Revit's Project Browser pane) to a file for diagnosis"/>
                        <Button x:Name="btnStart" Content="Start Update" Width="140" Margin="0,0,10,0"
                                Style="{DynamicResource GreenButton}"/>
                        <Button x:Name="btnClose" Content="Close" Width="110"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

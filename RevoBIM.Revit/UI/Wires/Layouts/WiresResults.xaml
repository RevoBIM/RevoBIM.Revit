<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Wire Fix"
        Width="760" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

  <Border x:Name="Chrome" CornerRadius="6" Background="{DynamicResource Shell}"
          BorderBrush="{DynamicResource Rim}" BorderThickness="1">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource Bar}"
              CornerRadius="6,6,0,0" Padding="14,10">
        <!-- icon, name, spacer, theme chip, version, then the window
             controls together at the right-hand end: shrink, close -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderIcon" Grid.Column="0" Width="30" Height="30"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Blue}"/>
            <TextBlock x:Name="ToolName" Text="Wires" FontSize="15"
                       Foreground="{DynamicResource Orange}" Margin="0,-2,0,0"/>
          </StackPanel>
          <Button x:Name="ThemeChip" Grid.Column="3" Style="{DynamicResource Chip}"
                  VerticalAlignment="Center" Margin="12,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Grid Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
                <Path Data="M 5,0 A 5,5 0 0 1 5,10 Z" Fill="{DynamicResource Muted}"/>
              </Grid>
              <TextBlock x:Name="ThemeText" Text="Auto" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v0.0.0" FontSize="11"
                     Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <Button x:Name="ShrinkButton" Grid.Column="5" Style="{DynamicResource BtnWin}"
                  VerticalAlignment="Center"
                  ToolTip="Shrink to the bottom of the screen (Ctrl+Shift+H)">
            <Grid Width="12" Height="14">
              <Path x:Name="ShrinkGlyph" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 6,1 L 6,9 M 2,5.5 L 6,9.5 L 10,5.5 M 1,13 L 11,13"/>
              <Path x:Name="ExpandGlyph" Stroke="{DynamicResource Green}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 6,13 L 6,5 M 2,8.5 L 6,4.5 L 10,8.5 M 1,1 L 11,1"
                    Visibility="Collapsed"/>
            </Grid>
          </Button>
          <Button x:Name="CloseButton" Grid.Column="6" Content="&#x2715;"
                  Style="{DynamicResource BtnClose}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- body -->
      <Grid Grid.Row="1" Margin="14,12,14,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="4" Height="16" Background="{DynamicResource Blue}"
                  CornerRadius="2" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="SummaryText" Text="" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource Fg}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource Field}"
                BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                CornerRadius="4" MinHeight="120" MaxHeight="480">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled" Padding="10,8">
            <StackPanel x:Name="LineList"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="2" Background="{DynamicResource Bar}"
              CornerRadius="0,0,6,6" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="" FontSize="11"
                     Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="DebugButton" Content="Debug report"
                    Style="{DynamicResource BtnGhost}" Margin="0"/>
            <Button x:Name="OkButton" Content="Close"
                    Style="{DynamicResource Btn}" IsDefault="True"/>
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

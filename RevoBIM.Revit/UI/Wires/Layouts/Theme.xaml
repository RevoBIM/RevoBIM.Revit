<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ==========================================================
       RevoBIM PY - Wires theme

       Every brush and control template for every Wires window.

       Layout files reference these with DynamicResource ONLY: this
       dictionary is merged into each window after XamlReader has
       parsed the layout, so a StaticResource there fails at load.

       The brushes below are the dark palette and are only the
       fallback. wires_theme writes the live palette straight onto
       window.Resources, which WPF looks in before a merged
       dictionary - so the palette swaps on an open window with no
       reload. Inside this file StaticResource is used for one thing
       only, BasedOn, which WPF will not accept as dynamic.
       ========================================================== -->

  <SolidColorBrush x:Key="Shell"      Color="#3C4454"/>
  <SolidColorBrush x:Key="Card"       Color="#343C4A"/>
  <SolidColorBrush x:Key="Field"      Color="#2D3441"/>
  <SolidColorBrush x:Key="Bar"        Color="#222933"/>
  <SolidColorBrush x:Key="Edge"       Color="#515C6B"/>
  <SolidColorBrush x:Key="Rim"        Color="#5A6372"/>
  <SolidColorBrush x:Key="Fg"         Color="#EEF0F4"/>
  <SolidColorBrush x:Key="Muted"      Color="#A4AAB1"/>
  <SolidColorBrush x:Key="Blue"       Color="#5AAEEB"/>
  <SolidColorBrush x:Key="Orange"     Color="#E8912D"/>
  <SolidColorBrush x:Key="Green"      Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHi"    Color="#4EC06D"/>
  <SolidColorBrush x:Key="Red"        Color="#D9534F"/>
  <SolidColorBrush x:Key="Sel"        Color="#3A7392"/>
  <SolidColorBrush x:Key="Ghost"      Color="#46505F"/>
  <SolidColorBrush x:Key="Disabled"   Color="#3A414D"/>
  <SolidColorBrush x:Key="DisabledFg" Color="#7B8290"/>
  <SolidColorBrush x:Key="OnAccent"   Color="#FFFFFF"/>
  <SolidColorBrush x:Key="OnBlue"     Color="#0E2233"/>

  <!-- ==========================================================
       buttons
       ========================================================== -->

  <Style x:Key="Btn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="Background" Value="{DynamicResource Green}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="16,6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shape" CornerRadius="3" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource GreenHi}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Disabled}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Ghost}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
  </Style>

  <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource Btn}">
    <Setter Property="Background" Value="{DynamicResource Orange}"/>
  </Style>

  <!-- The window controls in the top right: shrink to taskbar, and
       close. One size, one corner, one hover, so they read as a set
       across every RevoBIM tool. -->
  <Style x:Key="BtnWin" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Margin" Value="2,0,0,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shape" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Ghost}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnWin}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shape" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Red}"/>
              <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The light/dark chip in the header. -->
  <Style x:Key="Chip" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shape" CornerRadius="11" Background="Transparent"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="TabBtn" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shape" Background="Transparent"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="0,0,0,2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Card}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Segment" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="14,5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Shape" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                  CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnStep" TargetType="RepeatButton">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border x:Name="Shape" Background="{DynamicResource Ghost}" CornerRadius="2"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                  Margin="0,0,0,1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Blue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       inputs - every one retemplated, because the stock templates
       fall back to the system theme and show through as white
       ========================================================== -->

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource Field}"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Fg}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Sel}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Shape" CornerRadius="3" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,3,0,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                    Background="{DynamicResource Field}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                    VerticalAlignment="Center" Margin="0,0,7,0">
              <Path x:Name="Mark" Stretch="Uniform" Margin="2"
                    Data="M 0,4 L 3,7 L 9,0" Stroke="{DynamicResource OnBlue}"
                    StrokeThickness="2" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Blue}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Blue}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A setting that reaches wider than it looks is styled to look like it. -->
  <Style x:Key="CheckWarn" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Red}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,3,0,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                    Background="{DynamicResource Field}"
                    BorderBrush="{DynamicResource Red}" BorderThickness="1"
                    VerticalAlignment="Center" Margin="0,0,7,0">
              <Path x:Name="Mark" Stretch="Uniform" Margin="2"
                    Data="M 0,4 L 3,7 L 9,0" Stroke="{DynamicResource OnAccent}"
                    StrokeThickness="2" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Red}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Shape" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Sel}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Shape" Property="Background" Value="{DynamicResource Sel}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Shape" CornerRadius="3" Background="{DynamicResource Field}"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1">
            <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                  Data="M 0,0 L 8,0 L 4,5 Z" Fill="{DynamicResource Muted}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Shape" Property="BorderBrush" Value="{DynamicResource Blue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_Toggle" Style="{DynamicResource ComboToggle}"
                          Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Margin="8,0,24,0" VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"/>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                      BorderThickness="1" CornerRadius="3"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="220">
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       scrolling and sliding
       ========================================================== -->

  <Style x:Key="Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="{DynamicResource Rim}" CornerRadius="3" Margin="3,0,3,0"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollLine" TargetType="RepeatButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{DynamicResource ScrollLine}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{DynamicResource Thumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{DynamicResource ScrollLine}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Width="12" Height="12" CornerRadius="6"
                  Background="{DynamicResource Blue}"
                  BorderBrush="{DynamicResource Rim}" BorderThickness="1"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="Height" Value="20"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource Field}"
                    BorderBrush="{DynamicResource Edge}" BorderThickness="1"/>
            <Track x:Name="PART_Track">
              <Track.Thumb>
                <Thumb Style="{DynamicResource SliderThumb}"/>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The window controls and the chip all carry tooltips; the stock one
       is the system's pale yellow-white, whatever the theme. -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                  BorderThickness="1" CornerRadius="3" Padding="8,5" MaxWidth="320">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="TextWrapping" Value="Wrap"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==========================================================
       text
       ========================================================== -->

  <Style x:Key="Head" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Lbl" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,2,0,6"/>
  </Style>

</ResourceDictionary>

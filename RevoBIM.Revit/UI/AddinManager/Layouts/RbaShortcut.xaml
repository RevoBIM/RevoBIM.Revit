<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard shortcut"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BgWindow}"
            BorderBrush="{DynamicResource BrdWindow}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================ header ============================ -->
            <Border x:Name="HeaderBar" Grid.Row="0" Tag="round"
                    Background="{DynamicResource BgBar}"
                    CornerRadius="6,6,0,0" Padding="14,10,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RevoBIM" FontFamily="Segoe UI" FontSize="18"
                                   FontWeight="Bold" Foreground="{DynamicResource AccBlue}" />
                        <TextBlock x:Name="SubTitle" Text="Keyboard shortcut"
                                   FontFamily="Segoe UI" FontSize="13"
                                   Foreground="{DynamicResource AccOrange}" Margin="0,-3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <TextBlock x:Name="VersionText" Text="v0.0.0" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="{DynamicResource FgMuted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button x:Name="ShrinkBtn" Style="{DynamicResource WinButton}"
                                ToolTip="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)">
                            <Grid>
                                <Path x:Name="ShrinkGlyph" Stroke="{DynamicResource FgText}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 6,1 L 6,9 M 2.5,5.5 L 6,9 L 9.5,5.5 M 1.5,12 L 10.5,12" />
                                <Path x:Name="ExpandGlyph" Stroke="{DynamicResource AccGreen}"
                                      StrokeThickness="2.2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"
                                      Data="M 6,12 L 6,2 M 1.5,6.5 L 6,2 L 10.5,6.5" />
                            </Grid>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{DynamicResource CloseButton}" Margin="2,0,0,0"
                                ToolTip="Close">
                            <Path Stroke="{DynamicResource FgText}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 1,1 L 10,10 M 10,1 L 1,10" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================= body ============================= -->
            <StackPanel Grid.Row="1" Margin="16,14,16,10">
                <TextBlock x:Name="TargetText" Text=""
                           FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgText}" TextWrapping="Wrap" />
                <TextBlock x:Name="CurrentText" Text=""
                           FontFamily="Segoe UI" FontSize="11.5"
                           Foreground="{DynamicResource FgMuted}" Margin="0,3,0,0"
                           TextWrapping="Wrap" />

                <TextBlock Text="Press the keys you want"
                           FontFamily="Segoe UI" FontSize="12"
                           Foreground="{DynamicResource FgText}" Margin="0,14,0,5" />

                <Border x:Name="CaptureBox" Background="{DynamicResource BgField}"
                        BorderBrush="{DynamicResource BrdEdge}" BorderThickness="1"
                        CornerRadius="3" Height="52" Focusable="True">
                    <TextBlock x:Name="KeysText" Text="waiting..."
                               FontFamily="Consolas" FontSize="20"
                               Foreground="{DynamicResource FgText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Letters typed one after another make a sequence, the way VG does. Hold Ctrl, Shift or Alt for a combination. Backspace clears."
                           FontFamily="Segoe UI" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource FgMuted}" Margin="0,6,0,0" />

                <Border x:Name="ClashPanel" Background="{DynamicResource BgCard}"
                        BorderBrush="{DynamicResource AccRed}" BorderThickness="1"
                        CornerRadius="3" Padding="10,8,10,8" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="ClashTitle" Text=""
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccRed}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ClashDetail" Text=""
                                   FontFamily="Segoe UI" FontSize="11.5"
                                   Foreground="{DynamicResource FgText}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============================ footer ============================ -->
            <Border Grid.Row="2" Background="{DynamicResource BgBar}"
                    CornerRadius="0,0,6,6" Padding="14,9,14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RevitBtn" Grid.Column="0"
                            Content="Revit's own dialog" MinHeight="28"
                            ToolTip="Open Revit's Keyboard Shortcuts dialog instead, with this addin's name on the clipboard" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="ClearBtn" Content="Remove" MinWidth="80" MinHeight="28"
                                ToolTip="Take the shortcut off this addin" />
                        <Button x:Name="CancelBtn" Content="Cancel" MinWidth="78" MinHeight="28"
                                Margin="8,0,0,0" />
                        <Button x:Name="ApplyBtn" Content="Assign" MinWidth="90" MinHeight="28"
                                Margin="8,0,0,0" Style="{DynamicResource GreenButton}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

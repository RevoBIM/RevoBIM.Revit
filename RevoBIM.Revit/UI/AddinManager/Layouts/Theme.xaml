<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====================================================== -->
    <!-- Palette keys. Every one of these is overwritten at run  -->
    <!-- time by rba_theme.apply, which writes the chosen        -->
    <!-- palette straight onto the element's own Resources.      -->
    <!-- The values here are the dark palette, so the layout     -->
    <!-- still renders if that write ever fails.                 -->
    <!-- ====================================================== -->

    <SolidColorBrush x:Key="BgWindow" Color="#3B4453" />
    <SolidColorBrush x:Key="BgCard" Color="#333B49" />
    <SolidColorBrush x:Key="BgField" Color="#2C3440" />
    <SolidColorBrush x:Key="BgBar" Color="#222933" />
    <SolidColorBrush x:Key="BgHover" Color="#414B5A" />
    <SolidColorBrush x:Key="BrdEdge" Color="#515C6B" />
    <SolidColorBrush x:Key="BrdWindow" Color="#515C6B" />
    <SolidColorBrush x:Key="FgText" Color="#F5F5F5" />
    <SolidColorBrush x:Key="FgMuted" Color="#9DA5B0" />
    <SolidColorBrush x:Key="AccBlue" Color="#4FA3E3" />
    <SolidColorBrush x:Key="AccOrange" Color="#E8912D" />
    <SolidColorBrush x:Key="AccGreen" Color="#3FA75A" />
    <SolidColorBrush x:Key="AccGreenHover" Color="#4EC06D" />
    <SolidColorBrush x:Key="AccRed" Color="#D9534F" />
    <SolidColorBrush x:Key="AccStar" Color="#F5C542" />
    <Color x:Key="ShadowColor">#000000</Color>
    <SolidColorBrush x:Key="SelHighlight" Color="#2D5B80" />

    <!-- ====================================================== -->
    <!-- TextBox. The placeholder is driven by Tag, so a bare    -->
    <!-- search box says what it searches.                       -->
    <!-- ====================================================== -->

    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="Background" Value="{DynamicResource BgField}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrdEdge}" />
        <Setter Property="CaretBrush" Value="{DynamicResource FgText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource SelHighlight}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="7,3,7,3" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource FgMuted}"
                                       Margin="9,0,9,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================== -->
    <!-- Button. A bare WPF Button has no implicit style and     -->
    <!-- falls back to the OS chrome, which is a light grey      -->
    <!-- lozenge in a dark header.                               -->
    <!-- ====================================================== -->

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrdEdge}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,3,8,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BgHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccBlue}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource AccGreen}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccGreen}" />
    </Style>

    <!-- ====================================================== -->
    <!-- Window controls: dock, shrink, full screen, close.      -->
    <!-- Flat, glyph only, not focusable so keyboard focus stays -->
    <!-- in the body. Tag="on" marks the active dock side.       -->
    <!-- ====================================================== -->

    <Style x:Key="WinButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SelHighlight}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The panel's tools: square, carded, glyph only. Tag="on" lights it. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrdEdge}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="on">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource SelHighlight}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource BgHover}" />
                            <Setter TargetName="Chrome" Property="BorderBrush"
                                    Value="{DynamicResource AccBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background"
                                    Value="{DynamicResource AccRed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================== -->
    <!-- CheckBox                                                -->
    <!-- ====================================================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="15" Height="15" CornerRadius="2"
                                Background="{DynamicResource BgField}"
                                BorderBrush="{DynamicResource BrdEdge}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Border x:Name="Tick" Width="7" Height="7" CornerRadius="1"
                                    Background="{DynamicResource AccBlue}"
                                    Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccBlue}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccBlue}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================== -->
    <!-- ScrollBar. Thin, and themed end to end: the stock one   -->
    <!-- ignores Background and shows the system chrome.         -->
    <!-- ====================================================== -->

    <!-- The eight resize grips. Transparent, but a Border with an
         explicit Background is hit testable where a bare one is not. -->
    <Style x:Key="GripThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Margin="3,2,3,2"
                            Background="{DynamicResource BrdEdge}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource FgMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{DynamicResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================== -->
    <!-- ComboBox, for the settings window                       -->
    <!-- ====================================================== -->

    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="Background" Value="{DynamicResource BgField}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,5,8,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource SelHighlight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="Background" Value="{DynamicResource BgField}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrdEdge}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_Toggle"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{DynamicResource BgField}"
                                            BorderBrush="{DynamicResource BrdEdge}"
                                            BorderThickness="1" CornerRadius="3">
                                        <Border x:Name="Caret" Width="7" Height="7"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="0,0,10,0"
                                                CornerRadius="1"
                                                Background="{DynamicResource FgMuted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccBlue}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                          Margin="9,0,26,0"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               Focusable="False"
                               PopupAnimation="None">
                            <Border Background="{DynamicResource BgField}"
                                    BorderBrush="{DynamicResource BrdEdge}"
                                    BorderThickness="1" CornerRadius="3"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="260">
                                    <StackPanel IsItemsHost="True" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================== -->
    <!-- ContextMenu. The stock one ignores Background and       -->
    <!-- renders as the OS menu, which in a dark panel is a      -->
    <!-- white slab.                                             -->
    <!-- ====================================================== -->

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource BgCard}" />
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BrdEdge}"
                            BorderThickness="1" CornerRadius="4"
                            Padding="3">
                        <StackPanel IsItemsHost="True" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Row" Background="Transparent"
                            CornerRadius="3" Padding="10,6,14,6">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background"
                                    Value="{DynamicResource SelHighlight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="8,4,8,4"
                            Background="{DynamicResource BrdEdge}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================================================== -->
    <!-- ToolTip                                                 -->
    <!-- ====================================================== -->

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource FgText}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource BgCard}"
                            BorderBrush="{DynamicResource BrdEdge}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="8,6,8,6" MaxWidth="320">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

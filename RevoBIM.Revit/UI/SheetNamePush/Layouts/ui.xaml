<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="False"
    ResizeMode="CanResize"
    Width="900" Height="740"
    MinWidth="620" MinHeight="440"
    Background="#232326"
    Title="RevoBIM Sheet Name Push">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgWindow"   Color="#232326"/>
        <SolidColorBrush x:Key="BgCard"     Color="#2B2B2E"/>
        <SolidColorBrush x:Key="BgField"    Color="#1C1C1F"/>
        <SolidColorBrush x:Key="BgBar"      Color="#1C1C1F"/>
        <SolidColorBrush x:Key="BorderCol"  Color="#3E3E42"/>
        <SolidColorBrush x:Key="EdgeCol"    Color="#4A4A50"/>
        <SolidColorBrush x:Key="TextCol"    Color="#E4E4E4"/>
        <SolidColorBrush x:Key="MutedCol"   Color="#9A9A9E"/>
        <SolidColorBrush x:Key="BlueCol"    Color="#4FA3E3"/>
        <SolidColorBrush x:Key="OrangeCol"  Color="#E8912D"/>
        <SolidColorBrush x:Key="GreenCol"   Color="#3FA75A"/>
        <SolidColorBrush x:Key="GreenHover" Color="#4EC06D"/>
        <SolidColorBrush x:Key="RedCol"     Color="#D9534F"/>
        <SolidColorBrush x:Key="SelCol"     Color="#2B5473"/>
        <SolidColorBrush x:Key="HoverCol"   Color="#34343A"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverCol}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource EdgeCol}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5E"/>
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource GreenCol}"
                                BorderBrush="{StaticResource GreenCol}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GreenHover}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply Edits: orange when idle, script swaps to green when edits pending -->
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent"
                                BorderBrush="{StaticResource OrangeCol}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A2E1C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5E"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderCol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource MutedCol}"/>
        </Style>

        <!-- Icon tool button: image + label -->
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedCol}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RedCol}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GearButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverCol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextCol}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SelCol}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inline cell editor: tighter padding, blue edge -->
        <Style x:Key="CellEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="3,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BlueCol}"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                    Background="{StaticResource BgField}"
                                    BorderBrush="{StaticResource BorderCol}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Visibility="Collapsed"
                                      Data="M 2.5 6.5 L 5.5 9.5 L 10.5 3.5"
                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Border>
                            <ContentPresenter x:Name="Cp" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource BlueCol}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Outer" Stroke="{StaticResource BorderCol}" StrokeThickness="1.5"
                                         Fill="{StaticResource BgField}"/>
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource BlueCol}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Th" Background="#4A4A50" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Th" Property="Background" Value="#5E5E66"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgWindow}" BorderBrush="{StaticResource EdgeCol}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Border x:Name="header_bar" Grid.Row="0" Background="{StaticResource BgBar}"
                    BorderBrush="{StaticResource BorderCol}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="header_drag">
                <Grid Margin="14,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="img_icon" Grid.Column="0" Width="34" Height="34"
                           Margin="0,0,12,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" Foreground="{StaticResource BlueCol}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Sheet Name Push" Foreground="{StaticResource OrangeCol}" FontSize="15" Margin="1,-2,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="tb_version" Grid.Column="3" Text="v0.0.0"
                               Foreground="{StaticResource MutedCol}" FontSize="11"
                               VerticalAlignment="Top" Margin="0,2,10,0"/>

                    <Button x:Name="btn_settings" Grid.Column="4" Style="{StaticResource GearButton}"
                            Width="30" Height="30" VerticalAlignment="Top" Margin="0,-2,4,0"
                            Click="settings_click" ToolTip="Settings - choose target parameters">
                        <Image x:Name="img_gear" Width="17" Height="17"/>
                    </Button>

                    <Button x:Name="btn_close_x" Grid.Column="5" Content="&#x2715;"
                            Width="26" Height="26" VerticalAlignment="Top"
                            Style="{StaticResource CloseButton}" Click="cancel_click"/>
                </Grid>
            </Border>

            <!-- ===== BODY ===== -->
            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="4" Height="16" Background="{StaticResource BlueCol}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="Sheets" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="tb_count" Text="" Foreground="{StaticResource MutedCol}"
                               FontSize="11" VerticalAlignment="Center" Margin="10,1,0,0"/>
                </StackPanel>

                <!-- search + tick all/none -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="tb_filter" Grid.Column="0" TextChanged="filter_changed" Margin="0,0,8,0"
                             ToolTip="Search sheet number or sheet name.&#10;Click a row to highlight, Ctrl+click to add, Shift+click for a range."/>
                    <Button x:Name="btn_tick_all" Grid.Column="1" Content="Tick All" Style="{StaticResource SmallButton}"
                            Click="tick_all_click" Margin="0,0,6,0"/>
                    <Button x:Name="btn_tick_none" Grid.Column="2" Content="Tick None" Style="{StaticResource SmallButton}"
                            Click="tick_none_click"/>
                </Grid>

                <!-- edit tools -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="btn_findreplace" Style="{StaticResource IconButton}" Click="findreplace_click"
                            Margin="0,0,8,0" ToolTip="Find and replace in sheet name or number">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="img_find" Width="15" Height="15" Margin="0,0,7,0"/>
                            <TextBlock Text="Find &amp; Replace" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_affix" Style="{StaticResource IconButton}" Click="affix_click"
                            Margin="0,0,8,0" ToolTip="Add or remove a prefix / suffix">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="img_affix" Width="15" Height="15" Margin="0,0,7,0"/>
                            <TextBlock Text="Prefix / Suffix" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_revert" Content="Revert Edits" Style="{StaticResource SmallButton}"
                            Click="revert_click" ToolTip="Discard all staged edits"/>
                </StackPanel>

                <!-- filters -->
                <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCol}"
                        BorderThickness="1" CornerRadius="4" Padding="10,7" Margin="0,0,0,8">
                    <StackPanel>
                        <CheckBox x:Name="cb_show_all" Click="show_all_click" Visibility="Collapsed"
                                  Content="Show all sheets in the project (ticked sheets stay ticked)"/>
                        <CheckBox x:Name="cb_dupes_only" Click="dupes_click" Margin="0,4,0,0"
                                  Content="Isolate sheet numbers already in use"/>
                    </StackPanel>
                </Border>

                <!-- column headers -->
                <Border Grid.Row="4" BorderBrush="{StaticResource BorderCol}" BorderThickness="0,0,0,1"
                        Padding="10,0,10,6" Margin="0,2,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition x:Name="col_hdr_number" Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="SHEET NUMBER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedCol}"/>
                        <TextBlock Grid.Column="2" Text="SHEET NAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedCol}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Background="{StaticResource BgField}" BorderBrush="{StaticResource BorderCol}"
                        BorderThickness="1" CornerRadius="4" Margin="0,6,0,10">
                    <ScrollViewer x:Name="sv_sheets" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="4">
                        <StackPanel x:Name="sp_sheets"/>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="6">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" Background="{StaticResource OrangeCol}" CornerRadius="2" Margin="0,0,8,0"/>
                        <TextBlock Text="Text Format for the Push" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="remembered between runs" Foreground="{StaticResource MutedCol}"
                                   FontSize="11" VerticalAlignment="Center" Margin="10,1,0,0"/>
                    </StackPanel>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCol}"
                            BorderThickness="1" CornerRadius="4" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="rb_upper" GroupName="fmt" Content="UPPERCASE" IsChecked="True" Click="format_changed" Margin="0,0,22,0"/>
                            <RadioButton x:Name="rb_title" GroupName="fmt" Content="Camel Case" Click="format_changed" Margin="0,0,22,0"/>
                            <RadioButton x:Name="rb_none"  GroupName="fmt" Content="Don't Format Text" Click="format_changed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== FOOTER ===== -->
            <Border Grid.Row="2" Background="{StaticResource BgBar}" BorderBrush="{StaticResource BorderCol}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btn_apply_edits" Grid.Column="0" Content="Apply Edits"
                            Style="{StaticResource OrangeButton}" Click="apply_edits_click"
                            Width="130" IsEnabled="False" Margin="0,0,14,0"/>
                    <TextBlock x:Name="tb_status" Grid.Column="1" Text="" Foreground="{StaticResource MutedCol}"
                               FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btn_cancel" Content="Close" Click="cancel_click" Width="90" Margin="0,0,8,0"/>
                        <Button x:Name="btn_push" Content="Push Sheet Name" Style="{StaticResource GreenButton}"
                                Click="push_click" Width="160"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

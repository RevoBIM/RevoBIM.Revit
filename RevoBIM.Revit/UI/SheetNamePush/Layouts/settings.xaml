<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
    Width="520" Height="470" MinWidth="420" MinHeight="380"
    Background="#232326" Title="RevoBIM Sheet Name Push - Settings">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="BgWindow"   Color="#232326"/>
        <SolidColorBrush x:Key="BgCard"     Color="#2B2B2E"/>
        <SolidColorBrush x:Key="BgField"    Color="#1C1C1F"/>
        <SolidColorBrush x:Key="BgBar"      Color="#1C1C1F"/>
        <SolidColorBrush x:Key="BorderCol"  Color="#3E3E42"/>
        <SolidColorBrush x:Key="EdgeCol"    Color="#4A4A50"/>
        <SolidColorBrush x:Key="TextCol"    Color="#E4E4E4"/>
        <SolidColorBrush x:Key="MutedCol"   Color="#9A9A9E"/>
        <SolidColorBrush x:Key="BlueCol"    Color="#4FA3E3"/>
        <SolidColorBrush x:Key="OrangeCol"  Color="#E8912D"/>
        <SolidColorBrush x:Key="GreenCol"   Color="#3FA75A"/>
        <SolidColorBrush x:Key="GreenHover" Color="#4EC06D"/>
        <SolidColorBrush x:Key="RedCol"     Color="#D9534F"/>
        <SolidColorBrush x:Key="SelCol"     Color="#2B5473"/>
        <SolidColorBrush x:Key="HoverCol"   Color="#34343A"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverCol}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5A5A5E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource GreenCol}"
                                BorderBrush="{StaticResource GreenCol}" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource MutedCol}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource RedCol}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextCol}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource SelCol}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                    Background="{StaticResource BgField}"
                                    BorderBrush="{StaticResource BorderCol}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Visibility="Collapsed"
                                      Data="M 2.5 6.5 L 5.5 9.5 L 10.5 3.5"
                                      Stroke="#FFFFFF" StrokeThickness="1.8"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource BlueCol}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse x:Name="Outer" Stroke="{StaticResource BorderCol}" StrokeThickness="1.5"
                                         Fill="{StaticResource BgField}"/>
                                <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{StaticResource BlueCol}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Outer" Property="Stroke" Value="{StaticResource BlueCol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderCol}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource BgField}"
                                                BorderBrush="{StaticResource BorderCol}" BorderThickness="1" CornerRadius="4">
                                            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" Data="M 0 0 L 5 5 L 10 0 Z" Fill="{StaticResource MutedCol}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BlueCol}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              Margin="9,0,28,0" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260"
                                        Background="{StaticResource BgCard}" BorderBrush="{StaticResource EdgeCol}"
                                        BorderThickness="1" CornerRadius="4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverCol}"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelCol}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Th" Background="#4A4A50" CornerRadius="4" Margin="2,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Th" Property="Background" Value="#5E5E66"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextCol}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgWindow}" BorderBrush="{StaticResource EdgeCol}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="header_bar" Grid.Row="0" Background="{StaticResource BgBar}"
                    BorderBrush="{StaticResource BorderCol}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="header_drag">
                <Grid Margin="14,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="img_icon" Grid.Column="0" Width="30" Height="30" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" Foreground="{StaticResource BlueCol}" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="Settings" Foreground="{StaticResource OrangeCol}" FontSize="13" Margin="1,-2,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="tb_version" Grid.Column="3" Text="v0.0.0" Foreground="{StaticResource MutedCol}"
                               FontSize="11" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <Button x:Name="btn_close_x" Grid.Column="4" Content="&#x2715;" Width="26" Height="26"
                            VerticalAlignment="Top" Style="{StaticResource CloseButton}" Click="cancel_click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <Grid Margin="16,14,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="4" Height="16" Background="{StaticResource BlueCol}" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="Target Parameters" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Each segment of the sheet name, split on &quot;_&quot;, is written to the parameter chosen here. Only text parameters available on sheets are listed."
                               Foreground="{StaticResource MutedCol}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Segment 1  (before the 1st underscore)" Foreground="{StaticResource MutedCol}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cb_p1" Margin="0,0,0,12"/>

                    <TextBlock Text="Segment 2  (before the 2nd underscore)" Foreground="{StaticResource MutedCol}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cb_p2" Margin="0,0,0,12"/>

                    <TextBlock Text="Segment 3  (before the 3rd underscore)" Foreground="{StaticResource MutedCol}" FontSize="11" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cb_p3" Margin="0,0,0,14"/>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderCol}"
                            BorderThickness="1" CornerRadius="4" Padding="10,8">
                        <TextBlock x:Name="tb_note" Foreground="{StaticResource MutedCol}" FontSize="11" TextWrapping="Wrap"
                                   Text="Saved to %APPDATA%\RevoBIM\sheet_management.txt and reused next run."/>
                    </Border>
                </StackPanel>

              </Grid>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{StaticResource BgBar}" BorderBrush="{StaticResource BorderCol}"
                    BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btn_defaults" Grid.Column="0" Content="Restore Defaults" Click="defaults_click" Width="140"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="btn_cancel" Content="Cancel" Click="cancel_click" Width="90" Margin="0,0,8,0"/>
                        <Button x:Name="btn_apply" Content="Apply" Style="{StaticResource GreenButton}" Click="apply_click" Width="110"/>
                    </StackPanel>
                </Grid>

            </Border>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM"
        Width="680" Height="640" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False">

    <Border CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="5,5,0,0"
                    Padding="12,9" Background="{DynamicResource BarBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="AccentTick" Width="4" Height="16" CornerRadius="2"
                                Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{DynamicResource OrangeBrush}"/>
                        <StackPanel>
                            <TextBlock Text="RevoBIM" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource BlueBrush}"/>
                            <TextBlock x:Name="TitleText" FontSize="12" Margin="1,-2,0,0"
                                       Text="Rename templates"
                                       Foreground="{DynamicResource OrangeBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="11" Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"/>
                        <Button x:Name="CloseButton" Style="{DynamicResource CloseButton}"
                                Content="&#x2715;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="16,14,16,4">

                <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="13"
                           Margin="0,0,0,10"
                           Foreground="{DynamicResource TextBrush}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource SectionTickBlue}"/>
                    <TextBlock Text="Find and replace"
                               Style="{DynamicResource SectionLabel}"/>
                </StackPanel>

                <Border CornerRadius="4" BorderThickness="1" Padding="11"
                        Margin="0,0,0,12" Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource EdgeBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Find"
                                   Style="{DynamicResource MutedLabel}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Replace with"
                                   Style="{DynamicResource MutedLabel}" Margin="0,0,0,3"/>
                        <TextBox x:Name="FindBox" Grid.Row="1" Grid.Column="0" Height="32"
                                 Tag="text to look for"/>
                        <TextBox x:Name="ReplaceBox" Grid.Row="1" Grid.Column="2" Height="32"
                                 Tag="leave empty to delete it"/>
                        <CheckBox x:Name="MatchCaseCheck" Grid.Row="2" Grid.Column="0"
                                  Grid.ColumnSpan="3" Margin="0,10,0,0"
                                  Content="Match upper and lower case exactly"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource SectionTickOrange}"/>
                    <TextBlock Text="Prefix and suffix"
                               Style="{DynamicResource SectionLabel}"/>
                </StackPanel>

                <Border CornerRadius="4" BorderThickness="1" Padding="11"
                        Margin="0,0,0,12" Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource EdgeBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Put on the front"
                                   Style="{DynamicResource MutedLabel}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Put on the end"
                                   Style="{DynamicResource MutedLabel}" Margin="0,0,0,3"/>
                        <TextBox x:Name="PrefixBox" Grid.Row="1" Grid.Column="0" Height="32"
                                 Tag="prefix"/>
                        <TextBox x:Name="SuffixBox" Grid.Row="1" Grid.Column="2" Height="32"
                                 Tag="suffix"/>
                        <CheckBox x:Name="DropMasterCheck" Grid.Row="2" Grid.Column="0"
                                  Grid.ColumnSpan="3" Margin="0,10,0,0"
                                  Content="Also take the word Master out of the name"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Style="{DynamicResource SectionTickBlue}"/>
                    <TextBlock Text="What this will do"
                               Style="{DynamicResource SectionLabel}"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="2" CornerRadius="4" BorderThickness="1"
                    Margin="16,0,16,10" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}">
                <DataGrid x:Name="PreviewGrid" Margin="1"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" ColumnHeaderHeight="30"
                          CanUserResizeRows="False" SelectionMode="Single"
                          Background="Transparent" BorderThickness="0"/>
            </Border>

            <Border Grid.Row="3" CornerRadius="0,0,5,5" Padding="12,10"
                    Background="{DynamicResource BarBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CountText" Grid.Column="0"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button x:Name="CancelButton" Style="{DynamicResource GhostButton}"
                                Content="Cancel" MinWidth="92" Margin="0,0,6,0"/>
                        <Button x:Name="OkButton" Style="{DynamicResource PrimaryButton}"
                                Content="Rename" MinWidth="130" Height="32"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

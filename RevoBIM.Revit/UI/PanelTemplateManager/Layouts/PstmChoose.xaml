<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM"
        Width="520" Height="440" MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False">

    <Border CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="5,5,0,0"
                    Padding="12,9" Background="{DynamicResource BarBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border x:Name="AccentTick" Width="4" Height="16" CornerRadius="2"
                                Margin="0,0,8,0" VerticalAlignment="Center"
                                Background="{DynamicResource OrangeBrush}"/>
                        <StackPanel>
                            <TextBlock Text="RevoBIM" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource BlueBrush}"/>
                            <TextBlock x:Name="TitleText" FontSize="12" Margin="1,-2,0,0"
                                       Foreground="{DynamicResource OrangeBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="11" Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"/>
                        <Button x:Name="CloseButton" Style="{DynamicResource CloseButton}"
                                Content="&#x2715;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="16,14,16,8"
                       TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource TextBrush}"/>

            <ListBox x:Name="ChoiceList" Grid.Row="2" Margin="16,0,16,8"/>

            <Border Grid.Row="3" CornerRadius="0,0,5,5" Padding="12,10"
                    Background="{DynamicResource BarBg}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{DynamicResource GhostButton}"
                            Content="Cancel" MinWidth="92" Margin="0,0,6,0"/>
                    <Button x:Name="OkButton" Style="{DynamicResource PrimaryButton}"
                            Content="Merge" MinWidth="120" Height="32"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

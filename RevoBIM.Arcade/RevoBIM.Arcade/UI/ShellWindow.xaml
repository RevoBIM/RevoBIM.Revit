<Window x:Class="RevoBIM.Arcade.UI.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Arcade" Width="760" Height="560" MinWidth="520" MinHeight="380"
        WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="RootBorder" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
    <Grid x:Name="Root">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- header bar: logo, title, shrink, close -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" Padding="10,4" Tag="round">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="LogoHit" Grid.Column="0" Background="Transparent" Cursor="Hand" ToolTip="RevoBIM">
            <Image x:Name="LogoImage" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
          </Border>
          <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                     Text="RevoBIM Arcade" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}"/>
          <Button x:Name="ShrinkButton" Grid.Column="2" Style="{StaticResource HeaderButton}">
            <Grid>
              <TextBlock x:Name="ShrinkGlyph" Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
              <TextBlock x:Name="ExpandGlyph" Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         Foreground="{DynamicResource GreenBrush}" Visibility="Collapsed"/>
            </Grid>
          </Button>
          <Button x:Name="CloseButton" Grid.Column="3" Style="{StaticResource CloseButton}" ToolTip="Close">
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
          </Button>
        </Grid>
      </Border>

      <!-- body: the picker, or a game board -->
      <Grid x:Name="Body" Grid.Row="1">
        <ScrollViewer x:Name="PickerView" VerticalScrollBarVisibility="Auto" Padding="22,18">
          <StackPanel MaxWidth="560" HorizontalAlignment="Center">
            <TextBlock Text="Pick a game" FontFamily="Segoe UI" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock x:Name="PickerNote" Text="" FontFamily="Segoe UI" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap"/>
            <ItemsControl x:Name="PickerList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource CardButton}" Tag="{Binding Key}" Click="OnPickGame">
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" FontFamily="Segoe UI" FontSize="15" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="{Binding BestText}" FontFamily="Segoe UI" FontSize="12" Margin="0,2,0,0"
                                 Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Viewbox x:Name="GameView" Stretch="Uniform" Margin="14" Visibility="Collapsed">
          <Canvas x:Name="Board" Width="640" Height="400" ClipToBounds="True"
                  Background="{DynamicResource FieldBg}"/>
        </Viewbox>
      </Grid>

      <!-- footer: status left, key hints right -->
      <Border x:Name="Footer" Grid.Row="2" Background="{DynamicResource BarBg}" Padding="12,5">
        <Grid>
          <TextBlock x:Name="StatusText" HorizontalAlignment="Left" FontFamily="Segoe UI" FontSize="12"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="HintText" HorizontalAlignment="Right" FontFamily="Segoe UI" FontSize="11.5"
                     Foreground="{DynamicResource MutedBrush}"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Tag Aligner" Width="560" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
  <Border x:Name="Root" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource WinEdge}" Background="{DynamicResource Bg}">
    <DockPanel>

      <!-- ==================== header ==================== -->
      <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0" Padding="12,8,8,8">
        <DockPanel LastChildFill="False">
          <Image x:Name="HeaderIcon" DockPanel.Dock="Left" Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blue}"/>
            <TextBlock x:Name="TitleText" Text="Tag Aligner" FontSize="15" Foreground="{DynamicResource Orange}" Margin="0,-3,0,0"/>
          </StackPanel>
          <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{DynamicResource TaCloseButton}" VerticalAlignment="Center" ToolTip="Close"/>
          <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="v0.0.0" FontSize="11" Foreground="{DynamicResource Muted}"
                     VerticalAlignment="Center" Margin="10,0,8,0"/>
          <Border x:Name="ThemeChip" DockPanel.Dock="Right" Style="{DynamicResource TaChip}" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Grid x:Name="GlyphAuto">
                  <Path Data="M 7,1.5 A 5.5,5.5 0 0 0 7,12.5 Z" Fill="{DynamicResource Blue}"/>
                  <Path Data="M 7,1.5 A 5.5,5.5 0 1 1 6.99,1.5 Z" Stroke="{DynamicResource Blue}" StrokeThickness="1.3" Fill="Transparent"/>
                </Grid>
                <Path x:Name="GlyphDark" Data="M 9,1.5 A 5.5,5.5 0 1 0 12.5,9 A 4.5,4.5 0 0 1 9,1.5 Z"
                      Stroke="{DynamicResource Blue}" StrokeThickness="1.3" Fill="Transparent" Visibility="Collapsed"/>
                <Path x:Name="GlyphLight" Data="M 7,4.5 A 2.5,2.5 0 1 1 6.99,4.5 Z M 7,0.5 L 7,2.3 M 7,11.7 L 7,13.5 M 0.5,7 L 2.3,7 M 11.7,7 L 13.5,7 M 2.4,2.4 L 3.6,3.6 M 10.4,10.4 L 11.6,11.6 M 2.4,11.6 L 3.6,10.4 M 10.4,3.6 L 11.6,2.4"
                      Stroke="{DynamicResource Blue}" StrokeThickness="1.3" Fill="Transparent" Visibility="Collapsed"/>
              </Grid>
              <TextBlock x:Name="ThemeChipText" Text="Auto" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </DockPanel>
      </Border>

      <!-- ==================== footer ==================== -->
      <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bar}" CornerRadius="0,0,6,6" Padding="12,9">
        <DockPanel LastChildFill="True">
          <Button x:Name="OkButton" DockPanel.Dock="Right" Style="{DynamicResource TaPrimaryButton}" Content="OK" Margin="8,0,0,0"/>
          <Button x:Name="OpenLogButton" DockPanel.Dock="Right" Style="{DynamicResource TaButton}" Content="Open debug log"/>
          <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>

      <!-- ==================== body ==================== -->
      <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="4" Margin="12" Padding="12,10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="LinesPanel"/>
        </ScrollViewer>
      </Border>
    </DockPanel>
  </Border>
</Window>

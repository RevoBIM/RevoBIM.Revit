<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circuit Manager" Width="1260" Height="760" MinWidth="820" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Border x:Name="frame" CornerRadius="6" BorderThickness="2" BorderBrush="{DynamicResource FrameEdge}"
          Background="{DynamicResource BodyBg}">
  <Grid x:Name="root_grid">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ==================== header: icon, RevoBIM, tool, chip, version, window controls ==================== -->
    <Border x:Name="header_bar" Grid.Row="0" Background="{DynamicResource TitleBg}" CornerRadius="5,5,0,0"
            Padding="10,6,6,6">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="theme_btn" Style="{DynamicResource ChipBtn}" ToolTip="Theme: Auto follows Revit's canvas - click for Dark, Light, Auto">
            <StackPanel Orientation="Horizontal">
              <Path x:Name="theme_glyph" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                    Fill="{DynamicResource Orange}"
                    Data="M 7,0 A 7,7 0 1 0 7,14 A 7,7 0 0 1 7,0 Z"/>
              <TextBlock x:Name="theme_text" Text="Auto" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="version_text" Text="v0.0.0" Foreground="{DynamicResource Muted}" FontSize="11"
                     VerticalAlignment="Center" Margin="2,0,8,0"/>
          <Button x:Name="shrink_btn" Style="{DynamicResource ChromeBtn}" ToolTip="Shrink to taskbar (Ctrl+Shift+H)">
            <Grid Width="14" Height="15">
              <Path x:Name="shrink_glyph" Data="M 7,1 L 7,10 M 3,6.5 L 7,10.5 L 11,6.5 M 1.5,14 L 12.5,14"
                    StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <Path x:Name="expand_glyph" Visibility="Collapsed" Data="M 7,14 L 7,4.5 M 3,8 L 7,4 L 11,8 M 1.5,1 L 12.5,1"
                    StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Stroke="{DynamicResource Green}"/>
            </Grid>
          </Button>
          <Button x:Name="max_btn" Style="{DynamicResource ChromeBtn}" ToolTip="Full screen (F11)">
            <Path Data="M 1.5,1.5 L 11.5,1.5 L 11.5,11.5 L 1.5,11.5 Z" StrokeThickness="1.4"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <Button x:Name="close_btn" Style="{DynamicResource CloseBtn}" ToolTip="Close">
            <Path Data="M 1,1 L 11,11 M 11,1 L 1,11" StrokeThickness="1.6"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </StackPanel>
        <Image x:Name="icon_img" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="RevoBIM" Foreground="{DynamicResource Blue}" FontSize="19" FontWeight="Bold" Margin="0,-3,0,-2"/>
          <TextBlock x:Name="tool_text" Text="Circuit Manager" Foreground="{DynamicResource Orange}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ==================== toolbar ==================== -->
    <Border x:Name="toolbar" Grid.Row="1" Background="{DynamicResource ToolbarBg}" Padding="10,7">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button x:Name="add_col_btn" Style="{DynamicResource GreenBtn}" Padding="10,5"
                  ToolTip="Add circuit parameters as columns">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 6,1 L 6,11 M 1,6 L 11,6" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" VerticalAlignment="Center"/>
              <TextBlock Text="Add parameter column" Margin="7,0,0,0"/>
            </StackPanel>
          </Button>
          <Button x:Name="reset_btn" Margin="8,0,0,0" ToolTip="Clear every column filter">
            <TextBlock x:Name="reset_text" Text="Reset filters"/>
          </Button>
          <Button x:Name="refresh_btn" Margin="8,0,0,0" ToolTip="Read the circuits from the model again - staged edits are kept">
            <TextBlock Text="Refresh"/>
          </Button>
        </StackPanel>
        <TextBlock x:Name="hint_text" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                   Text="Ctrl / Shift to select circuits  |  click a Path Mode to change all selected  |  Ctrl+C / Ctrl+V on Path Offset  |  F5 re-sorts"/>
      </DockPanel>
    </Border>

    <!-- ==================== body ==================== -->
    <Grid x:Name="body" Grid.Row="2" Margin="10,8,10,8">
      <DataGrid x:Name="dg" Style="{DynamicResource CmGrid}" ColumnHeaderStyle="{DynamicResource CmHeader}"
                RowHeaderStyle="{DynamicResource CmRowHeader}" RowStyle="{DynamicResource CmRow}"
                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserReorderColumns="True" CanUserResizeColumns="True" CanUserSortColumns="True"
                SelectionUnit="CellOrRowHeader" SelectionMode="Extended" HeadersVisibility="All"
                ClipboardCopyMode="ExcludeHeader" EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderThickness="1"/>
    </Grid>

    <!-- ==================== footer ==================== -->
    <Border x:Name="footer" Grid.Row="3" Background="{DynamicResource TitleBg}" CornerRadius="0,0,5,5" Padding="10,7">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource StagedBg}" Margin="0,0,5,0"/>
            <TextBlock Text="Staged" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource CopyBg}" Margin="0,0,5,0"/>
            <TextBlock Text="Copied" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource ReadOnlyBg}" Margin="0,0,5,0"/>
            <TextBlock Text="Read only" Foreground="{DynamicResource Muted}" Margin="0,0,12,0"/>
            <Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource BadBg}" Margin="0,0,5,0"/>
            <TextBlock Text="Revit refused" Foreground="{DynamicResource Muted}"/>
          </StackPanel>
          <TextBlock x:Name="status_text" Foreground="{DynamicResource Text}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Text="Reading circuits..."/>
        </DockPanel>
        <DockPanel Grid.Row="1">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="undo_btn" Margin="0,0,8,0" ToolTip="Undo the last staged change (Ctrl+Z)">
              <TextBlock Text="Undo"/>
            </Button>
            <Button x:Name="clear_btn" Margin="0,0,8,0" ToolTip="Drop every staged change">
              <TextBlock Text="Clear staged"/>
            </Button>
            <Button x:Name="apply_btn" Style="{DynamicResource GreenBtn}" Padding="18,6" ToolTip="Write the staged changes to the model (Ctrl+S)">
              <TextBlock x:Name="apply_text" Text="Apply (0)"/>
            </Button>
          </StackPanel>
          <CheckBox x:Name="debug_chk" VerticalAlignment="Center" ToolTip="Write a debug log to %APPDATA%\RevoBIM\circuit_manager_debug.txt">
            <TextBlock Text="Debug log" Foreground="{DynamicResource Muted}"/>
          </CheckBox>
          <TextBlock x:Name="sel_text" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </DockPanel>
      </Grid>
    </Border>

    <Grid x:Name="grips" Grid.RowSpan="4">
      <Thumb x:Name="grip_n" Style="{DynamicResource Grip}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="5" Cursor="SizeNS"/>
      <Thumb x:Name="grip_s" Style="{DynamicResource Grip}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="5" Cursor="SizeNS"/>
      <Thumb x:Name="grip_w" Style="{DynamicResource Grip}" VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="5" Cursor="SizeWE"/>
      <Thumb x:Name="grip_e" Style="{DynamicResource Grip}" VerticalAlignment="Stretch" HorizontalAlignment="Right" Width="5" Cursor="SizeWE"/>
      <Thumb x:Name="grip_nw" Style="{DynamicResource Grip}" VerticalAlignment="Top" HorizontalAlignment="Left" Height="8" Width="8" Cursor="SizeNWSE"/>
      <Thumb x:Name="grip_ne" Style="{DynamicResource Grip}" VerticalAlignment="Top" HorizontalAlignment="Right" Height="8" Width="8" Cursor="SizeNESW"/>
      <Thumb x:Name="grip_sw" Style="{DynamicResource Grip}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="8" Width="8" Cursor="SizeNESW"/>
      <Thumb x:Name="grip_se" Style="{DynamicResource Grip}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="8" Width="8" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
  </Border>
</Window>

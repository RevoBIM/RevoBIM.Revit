<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Wires"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">

  <Border x:Name="Chrome" CornerRadius="6" Background="{DynamicResource Shell}"
          BorderBrush="{DynamicResource Rim}" BorderThickness="1">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource Bar}"
              CornerRadius="6,6,0,0" Padding="12,8">
        <!-- icon, name, spacer, theme chip, version, then the window
             controls together at the right-hand end: shrink, close -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderIcon" Grid.Column="0" Width="24" Height="24"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource Blue}"/>
            <TextBlock x:Name="ToolName" Text="Auto Wire" FontSize="12"
                       Foreground="{DynamicResource Orange}" Margin="0,-2,0,0"/>
          </StackPanel>
          <Button x:Name="ThemeChip" Grid.Column="3" Style="{DynamicResource Chip}"
                  VerticalAlignment="Center" Margin="12,0,10,0">
            <StackPanel Orientation="Horizontal">
              <Grid Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource Muted}" StrokeThickness="1.2"/>
                <Path Data="M 5,0 A 5,5 0 0 1 5,10 Z" Fill="{DynamicResource Muted}"/>
              </Grid>
              <TextBlock x:Name="ThemeText" Text="Auto" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v0.0.0" FontSize="11"
                     Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                     Margin="0,0,8,0"/>
          <Button x:Name="ShrinkButton" Grid.Column="5" Style="{DynamicResource BtnWin}"
                  VerticalAlignment="Center"
                  ToolTip="Shrink to the bottom of the screen (Ctrl+Shift+H)">
            <Grid Width="12" Height="14">
              <Path x:Name="ShrinkGlyph" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 6,1 L 6,9 M 2,5.5 L 6,9.5 L 10,5.5 M 1,13 L 11,13"/>
              <Path x:Name="ExpandGlyph" Stroke="{DynamicResource Green}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 6,13 L 6,5 M 2,8.5 L 6,4.5 L 10,8.5 M 1,1 L 11,1"
                    Visibility="Collapsed"/>
            </Grid>
          </Button>
          <Button x:Name="CloseButton" Grid.Column="6" Content="&#x2715;"
                  Style="{DynamicResource BtnClose}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="14,12,14,10">
        <TextBlock x:Name="HeadlineText" Text="" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
        <TextBlock x:Name="RouteText" Text="" FontSize="11" Margin="0,4,0,0"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Wires" FontSize="12"
                     VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="ArcButton" Content="Arc"
                    Style="{DynamicResource Segment}" Margin="0,0,4,0"/>
            <Button x:Name="ChamferButton" Content="Chamfer"
                    Style="{DynamicResource Segment}"/>
          </StackPanel>
        </Grid>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Vertices on each wire"
                     FontSize="12" VerticalAlignment="Center"
                     Foreground="{DynamicResource Fg}"/>
          <Border Grid.Column="1" Background="{DynamicResource Field}"
                  BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                  CornerRadius="3" Width="40" Height="26" Margin="0,0,6,0">
            <TextBlock x:Name="VertexCount" Text="1" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Fg}"/>
          </Border>
          <StackPanel Grid.Column="2">
            <RepeatButton x:Name="VertexUp" Content="&#x25B2;"
                          Style="{DynamicResource BtnStep}"/>
            <RepeatButton x:Name="VertexDown" Content="&#x25BC;"
                          Style="{DynamicResource BtnStep}"/>
          </StackPanel>
        </Grid>

        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Arc depth" FontSize="12"
                     VerticalAlignment="Center" Foreground="{DynamicResource Fg}"/>
          <TextBlock x:Name="OffsetValue" Grid.Column="1" Text="18%"
                     FontSize="11" VerticalAlignment="Center"
                     Foreground="{DynamicResource Muted}"/>
        </Grid>
        <Slider x:Name="OffsetSlider" Minimum="0" Maximum="45" Value="18"
                TickFrequency="0.5" IsSnapToTickEnabled="True"
                Margin="0,2,0,0"/>

        <CheckBox x:Name="AvoidClashBox" Margin="0,12,0,0"
                  Content="Route clear of fittings on other circuits"/>
        <TextBlock x:Name="ClashText" Text="" FontSize="11" Margin="21,3,0,0"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>

        <TextBlock Text="Shuffle and Previous step through the route options. Keep leaves one undo step; Cancel puts the view back exactly as it was."
                   FontSize="11" Margin="0,10,0,0"
                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
      </StackPanel>

      <Border Grid.Row="2" Background="{DynamicResource Bar}"
              CornerRadius="0,0,6,6" Padding="12,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal">
            <Button x:Name="PreviousButton" Content="Previous"
                    Style="{DynamicResource BtnGhost}" Margin="0"/>
            <Button x:Name="ShuffleButton" Content="Shuffle"
                    Style="{DynamicResource BtnOrange}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button x:Name="CancelButton" Content="Cancel" Style="{DynamicResource BtnGhost}"/>
            <Button x:Name="KeepButton" Content="Keep" Style="{DynamicResource Btn}"
                    IsDefault="True"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

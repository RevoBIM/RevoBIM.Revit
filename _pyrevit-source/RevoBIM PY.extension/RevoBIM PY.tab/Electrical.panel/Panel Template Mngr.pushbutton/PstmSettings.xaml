<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Panel Template Settings"
        Width="600" Height="700" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False">

    <Border CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdge}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="5,5,0,0"
                    Padding="12,9" Background="{DynamicResource BarBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ToolIcon" Grid.Column="0" Width="26" Height="26"
                           Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource BlueBrush}"/>
                        <TextBlock Text="Panel Template Settings" FontSize="13"
                                   Margin="1,-3,0,0"
                                   Foreground="{DynamicResource OrangeBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" FontSize="11" Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"/>
                        <Button x:Name="CloseButton" Style="{DynamicResource CloseButton}"
                                Content="&#x2715;"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="14,12,14,8"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Auto Assign -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{DynamicResource SectionTickBlue}"/>
                        <TextBlock Text="Auto Assign Template"
                                   Style="{DynamicResource SectionLabel}"/>
                    </StackPanel>

                    <Border CornerRadius="4" BorderThickness="1" Padding="11"
                            Margin="0,0,0,14" Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource EdgeBrush}">
                        <StackPanel>
                            <TextBlock Text="Number of ways parameter"
                                       Style="{DynamicResource MutedLabel}" Margin="0,0,0,3"/>
                            <TextBox x:Name="WaysSearch" Height="32" Margin="0,0,0,4"
                                     Tag="Search parameters"/>
                            <ComboBox x:Name="WaysCombo" Margin="0,0,0,10"/>

                            <TextBlock Text="Number of phases parameter"
                                       Style="{DynamicResource MutedLabel}" Margin="0,0,0,3"/>
                            <TextBox x:Name="PhasesSearch" Height="32" Margin="0,0,0,4"
                                     Tag="Search parameters"/>
                            <ComboBox x:Name="PhasesCombo" Margin="0,0,0,10"/>

                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                       Style="{DynamicResource MutedLabel}"
                                       Text="Ways are added up first, then multiplied by the phases: 12 ways on 3 phase is 36 slots, and 8+8 ways on 3 phase is (8 + 8) x 3 = 48 slots."/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Phases to assume when the parameter is blank"
                                           Style="{DynamicResource MutedLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="PhasesFallbackBox" Width="58" Height="32"
                                         Margin="8,0,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="MatchTypeCheck"
                                      Content="Only match templates of the same schedule type"/>
                        </StackPanel>
                    </Border>

                    <!-- Template names -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{DynamicResource SectionTickOrange}"/>
                        <TextBlock Text="Reading the slot number out of a template name"
                                   Style="{DynamicResource SectionLabel}"/>
                    </StackPanel>

                    <Border CornerRadius="4" BorderThickness="1" Padding="11"
                            Margin="0,0,0,14" Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource EdgeBrush}">
                        <StackPanel>
                            <RadioButton x:Name="RuleLargest" GroupName="NameRule"
                                         Margin="0,0,0,4"
                                         Content="The largest number in the name"/>
                            <RadioButton x:Name="RuleFirst" GroupName="NameRule"
                                         Margin="0,0,0,4"
                                         Content="The first number in the name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton x:Name="RuleKeyword" GroupName="NameRule"
                                             VerticalAlignment="Center"
                                             Content="The number just before"/>
                                <TextBox x:Name="KeywordBox" Width="120" Height="32"
                                         Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="NameRulePreview" TextWrapping="Wrap"
                                       Style="{DynamicResource MutedLabel}"/>
                        </StackPanel>
                    </Border>

                    <!-- Lists and window -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Style="{DynamicResource SectionTickBlue}"/>
                        <TextBlock Text="Lists and appearance"
                                   Style="{DynamicResource SectionLabel}"/>
                    </StackPanel>

                    <Border CornerRadius="4" BorderThickness="1" Padding="11"
                            Margin="0,0,0,4" Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource EdgeBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Template list opens on this type"
                                               Style="{DynamicResource MutedLabel}"
                                               Margin="0,0,0,3"/>
                                    <ComboBox x:Name="DefaultTypeCombo"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="and this configuration"
                                               Style="{DynamicResource MutedLabel}"
                                               Margin="0,0,0,3"/>
                                    <ComboBox x:Name="DefaultConfigCombo"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,0,0,10" Width="180"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Theme" Style="{DynamicResource MutedLabel}"
                                           Margin="0,0,0,3"/>
                                <ComboBox x:Name="ThemeCombo"/>
                            </StackPanel>

                            <TextBlock Text="Slot numbers offered by the duplicator"
                                       Style="{DynamicResource MutedLabel}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="multiples of" Style="{DynamicResource MutedLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotStepBox" Width="54" Height="32"
                                         Margin="6,0,10,0"/>
                                <TextBlock Text="from" Style="{DynamicResource MutedLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotMinBox" Width="58" Height="32"
                                         Margin="6,0,10,0"/>
                                <TextBlock Text="to" Style="{DynamicResource MutedLabel}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="SlotMaxBox" Width="64" Height="32"
                                         Margin="6,0,0,0"/>
                            </StackPanel>

                            <CheckBox x:Name="ConfirmApplyCheck" Margin="0,10,0,0"
                                      Content="Show what Apply will do before it does it"/>
                            <CheckBox x:Name="RebuildScheduleCheck" Margin="0,8,0,0"
                                      Content="If Revit will not swap a template in place, rebuild that panel's schedule"/>
                            <TextBlock Style="{DynamicResource MutedLabel}"
                                       TextWrapping="Wrap" Margin="24,2,0,0"
                                       Text="Schedules already placed on a sheet are never rebuilt - they are reported instead."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" CornerRadius="0,0,5,5" Padding="12,10"
                    Background="{DynamicResource BarBg}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DefaultsButton" Grid.Column="0"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource GhostButton}"
                            Content="Restore defaults"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CancelButton" Style="{DynamicResource GhostButton}"
                                Content="Cancel" MinWidth="90" Margin="0,0,6,0"/>
                        <Button x:Name="SaveButton" Style="{DynamicResource PrimaryButton}"
                                Content="Save" MinWidth="110" Height="30"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

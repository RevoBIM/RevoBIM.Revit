<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Legend Creator"
        Height="300" Width="500"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12">

  <Window.Resources>
    <!-- lgc:theme -->
  </Window.Resources>

  <!-- gentle pulse, roughly 0.7 Hz. Slow enough to read, and well below
       the flash rates associated with photosensitive seizures. -->
  <Window.Triggers>
    <EventTrigger RoutedEvent="Window.Loaded">
      <BeginStoryboard>
        <Storyboard>
          <DoubleAnimation Storyboard.TargetName="flash_tb"
                           Storyboard.TargetProperty="Opacity"
                           From="1.0" To="0.18" Duration="0:0:0.7"
                           AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
      </BeginStoryboard>
    </EventTrigger>
  </Window.Triggers>

  <Border Background="{DynamicResource Base}" BorderBrush="{DynamicResource Edge}"
          BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="header_bar" Grid.Row="0" Background="{DynamicResource Bar}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
              CornerRadius="5,5,0,0">
        <Grid Margin="18,12,10,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Canvas Grid.Column="0" Width="30" Height="30" Margin="0,0,12,0"
                  VerticalAlignment="Center">
            <Border Canvas.Left="1" Canvas.Top="3" Width="28" Height="24"
                    BorderBrush="{DynamicResource Blue}" BorderThickness="1.6"
                    CornerRadius="2"/>
            <Rectangle Canvas.Left="4" Canvas.Top="6" Width="12" Height="2"
                       Fill="{DynamicResource Orange}"/>
            <Ellipse Canvas.Left="5" Canvas.Top="12" Width="5" Height="5"
                     Fill="{DynamicResource Orange}"/>
            <Ellipse Canvas.Left="5" Canvas.Top="20" Width="5" Height="5"
                     Fill="{DynamicResource Orange}"/>
            <Rectangle Canvas.Left="14" Canvas.Top="14" Width="12" Height="1.6"
                       Fill="{DynamicResource Muted}"/>
            <Rectangle Canvas.Left="14" Canvas.Top="22" Width="12" Height="1.6"
                       Fill="{DynamicResource Muted}"/>
          </Canvas>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Blue}"/>
            <TextBlock Text="Legend Creator" FontSize="15"
                       Foreground="{DynamicResource Orange}" Margin="0,-2,0,0"/>
          </StackPanel>

          <TextBlock x:Name="version_tb" Grid.Column="2" FontSize="11"
                     Foreground="{DynamicResource Muted}"
                     VerticalAlignment="Top" Margin="0,2,10,0"/>

          <Button x:Name="shrink_btn" Grid.Column="3" Style="{StaticResource ShrinkBtn}"
                  VerticalAlignment="Top" Margin="0,0,2,0"/>
          <Button x:Name="close_btn" Grid.Column="4" Style="{StaticResource Chrome}" VerticalAlignment="Top" ToolTip="Close"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,0,24,0">
        <TextBlock x:Name="flash_tb"
                   Text="Wow, look how much time you saved with that!"
                   FontSize="17" FontWeight="Bold"
                   Foreground="{DynamicResource Ink}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock x:Name="summary_tb" Margin="0,12,0,0"
                   Foreground="{DynamicResource Muted}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock x:Name="ask_tb" Margin="0,16,0,0"
                   Foreground="{DynamicResource Ink}"
                   TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>

      <Border Grid.Row="2" Background="{DynamicResource Bar}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              CornerRadius="0,0,5,5" Padding="18,12,18,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="done_btn" Style="{StaticResource Quiet}"
                  Content="Not now" IsCancel="True"/>
          <Button x:Name="open_btn" Style="{StaticResource Create}" Margin="8,0,0,0"
                  Content="Open legend" IsDefault="True"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>

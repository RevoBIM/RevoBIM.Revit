<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Legend Creator"
        Height="820" Width="640"
        MinHeight="600" MinWidth="560"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12">

  <Window.Resources>
    <!-- lgc:theme -->
  </Window.Resources>

  <Border Background="{DynamicResource Base}" BorderBrush="{DynamicResource Edge}"
          BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Border x:Name="header_bar" Grid.Row="0" Background="{DynamicResource Bar}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
              CornerRadius="5,5,0,0">
        <Grid Margin="18,12,10,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- icon: a small legend panel drawn in the house colours -->
          <Canvas Grid.Column="0" Width="30" Height="30" Margin="0,0,12,0"
                  VerticalAlignment="Center">
            <Border Canvas.Left="1" Canvas.Top="3" Width="28" Height="24"
                    BorderBrush="{DynamicResource Blue}" BorderThickness="1.6"
                    CornerRadius="2"/>
            <Rectangle Canvas.Left="4" Canvas.Top="6" Width="12" Height="2"
                       Fill="{DynamicResource Orange}"/>
            <Ellipse Canvas.Left="5" Canvas.Top="12" Width="5" Height="5"
                     Fill="{DynamicResource Orange}"/>
            <Ellipse Canvas.Left="5" Canvas.Top="20" Width="5" Height="5"
                     Fill="{DynamicResource Orange}"/>
            <Rectangle Canvas.Left="14" Canvas.Top="14" Width="12" Height="1.6"
                       Fill="{DynamicResource Muted}"/>
            <Rectangle Canvas.Left="14" Canvas.Top="22" Width="12" Height="1.6"
                       Fill="{DynamicResource Muted}"/>
          </Canvas>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource Blue}"/>
            <TextBlock Text="Legend Creator" FontSize="15"
                       Foreground="{DynamicResource Orange}" Margin="0,-2,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Top" Margin="0,1,0,0">
            <Button x:Name="theme_btn" Style="{StaticResource Chip}"
                    ToolTip="Switch between dark and light"/>
            <TextBlock x:Name="version_tb" FontSize="11"
                       Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center" Margin="10,0,10,0"/>
          </StackPanel>

          <Button x:Name="shrink_btn" Grid.Column="3" Style="{StaticResource ShrinkBtn}"
                  VerticalAlignment="Top" Margin="0,0,2,0"/>
          <Button x:Name="close_btn" Grid.Column="4" Style="{StaticResource Chrome}" VerticalAlignment="Top" ToolTip="Close"/>
        </Grid>
      </Border>

      <!-- body -->
      <TabControl x:Name="tabs" Grid.Row="1">

        <TabItem Header="Family Legend">
        <Grid Margin="18,14,18,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- source card -->
          <Border Grid.Row="0" Background="{DynamicResource Card}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="4" Padding="14,11" Margin="0,0,0,12">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Style="{StaticResource TickBlue}"/>
                <TextBlock Text="WHAT TO READ" Style="{StaticResource Heading}"/>
              </StackPanel>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Phase" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="phase_cb" Grid.Column="1" Margin="0,0,16,0"
                          ToolTip="Only types placed on this phase are listed"/>
                <TextBlock Text="Name from" Grid.Column="2"
                           Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="param_cb" Grid.Column="3"
                          ToolTip="The type parameter the description text is read from"/>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Text style" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="text_cb" Grid.Column="1" Margin="0,0,16,0"
                          ToolTip="Text note type used for the descriptions"/>
                <TextBlock Text="Text case" Grid.Column="2"
                           Style="{StaticResource FieldLabel}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <RadioButton x:Name="case_asis" GroupName="txtcase"
                               Content="As written" IsChecked="True"
                               ToolTip="Use the parameter exactly as typed"/>
                  <RadioButton x:Name="case_upper" GroupName="txtcase"
                               Content="UPPER" Margin="14,0,0,0"/>
                  <RadioButton x:Name="case_camel" GroupName="txtcase"
                               Content="Camel" Margin="14,0,0,0"
                               ToolTip="Capitalise Each Word. Tokens containing digits, such as FD30 or 900x2100, are left alone."/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <!-- filter -->
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="filter_tb" Grid.Column="0"
                     Style="{StaticResource Search}" ToolTip="Filter categories"/>
            <Button x:Name="sel_all_btn" Grid.Column="1" Style="{StaticResource Quiet}" Margin="8,0,0,0"
                    Content="Select all"/>
            <Button x:Name="clear_btn" Grid.Column="2" Style="{StaticResource Quiet}" Margin="2,0,0,0"
                    Content="Clear"/>
          </Grid>

          <!-- list headings -->
          <Grid Grid.Row="2" Margin="12,0,14,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="CATEGORY" Style="{StaticResource Heading}"/>
            <TextBlock Grid.Column="1" Text="TYPES"
                       Style="{StaticResource Heading}"
                       HorizontalAlignment="Right"/>
          </Grid>

          <!-- category list -->
          <Border Grid.Row="3" Background="{DynamicResource Field}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="4" Padding="6" MinHeight="150">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="list_panel"/>
            </ScrollViewer>
          </Border>

          <!-- output card -->
          <Border Grid.Row="4" Background="{DynamicResource Card}"
                  BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="4" Padding="14,11" Margin="0,12,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Border Style="{StaticResource TickOrange}"/>
                <TextBlock Text="WHAT TO BUILD" Style="{StaticResource Heading}"/>
              </StackPanel>

              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Scale" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="scale_cb" Grid.Column="1" Margin="0,0,16,0"
                          ToolTip="View scale of the new legends. The distances below restate themselves so the layout stays the same size on paper."/>
                <TextBlock Text="Row spacing" Grid.Column="2"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="row_tb" Grid.Column="3"
                         ToolTip="Vertical gap between components, in view mm at the chosen scale"/>
              </Grid>

              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="96"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Text offset" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="text_tb" Grid.Column="1" Margin="0,0,16,0"
                         ToolTip="Gap between a component and its description text, in view mm"/>
                <TextBlock Text="Column spacing" Grid.Column="2"
                           Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="spacing_tb" Grid.Column="3"
                         ToolTip="Gap between category columns in a combined legend, in view mm"/>
              </Grid>

              <CheckBox x:Name="combine_cb"
                        Content="Add all selected to one legend (WIP_COMBINED)"
                        ToolTip="Off: one legend per category. On: every ticked category side by side in a single legend, one column each."/>
            </StackPanel>
          </Border>

        </Grid>
        </TabItem>

        <TabItem Header="System Colour Legend">
          <Grid Margin="18,14,18,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- what to read -->
            <Border Grid.Row="0" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="14,11" Margin="0,0,0,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Style="{StaticResource TickBlue}"/>
                  <TextBlock Text="WHERE THE COLOURS COME FROM"
                             Style="{StaticResource Heading}"/>
                </StackPanel>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Legend type" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="kind_cb" Grid.Column="1"
                            ToolTip="Which system legend to build"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="template_lbl" Text="View template"
                             Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="template_cb" Grid.Column="1"
                            ToolTip="The filters on this template are what the legend is built from"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- filter list header -->
            <Grid Grid.Row="1" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="sys_status_tb" Style="{StaticResource Heading}"
                         VerticalAlignment="Center"/>
              <Button x:Name="sys_sel_btn" Grid.Column="1" Style="{StaticResource Quiet}"
                      Content="Select all"/>
              <Button x:Name="sys_clear_btn" Grid.Column="2" Style="{StaticResource Quiet}"
                      Margin="2,0,0,0" Content="Clear"/>
            </Grid>

            <Grid Grid.Row="2" Margin="12,0,14,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="SWATCH" Style="{StaticResource Heading}"/>
              <TextBlock Grid.Column="1" Text="NAME ON THE LEGEND"
                         Style="{StaticResource Heading}"/>
            </Grid>

            <!-- filters -->
            <Border Grid.Row="3" Background="{DynamicResource Field}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="6" MinHeight="130">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="filter_panel"/>
              </ScrollViewer>
            </Border>

            <!-- what to build -->
            <Border Grid.Row="4" Background="{DynamicResource Card}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="14,11" Margin="0,12,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Style="{StaticResource TickOrange}"/>
                  <TextBlock Text="WHAT TO BUILD" Style="{StaticResource Heading}"/>
                </StackPanel>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Legend name" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="sys_name_tb" Grid.Column="1" Margin="0,0,16,0"
                           ToolTip="View name. A number is appended if it is already taken."/>
                  <TextBlock Text="Scale" Grid.Column="2"
                             Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="sys_scale_cb" Grid.Column="3"
                            ToolTip="Swatch sizes below are quoted at 1:200 and restate themselves for the scale you pick"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Text style" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="sys_text_cb" Grid.Column="1" Margin="0,0,16,0"
                            ToolTip="Text note type for the names"/>
                  <TextBlock Text="Heading style" Grid.Column="2"
                             Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="sys_head_cb" Grid.Column="3"
                            ToolTip="Text note type for the CONTAINMENT LEGEND heading"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Swatch width" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="sw_tb" Grid.Column="1" Margin="0,0,16,0"
                           ToolTip="Filled region width, in view mm"/>
                  <TextBlock Text="Height" Grid.Column="2"
                             Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="sh_tb" Grid.Column="3"
                           ToolTip="Filled region height, in view mm"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Row pitch" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="pitch_tb" Grid.Column="1" Margin="0,0,16,0"
                           ToolTip="Centre to centre between swatches, in view mm"/>
                  <TextBlock Text="Text gap" Grid.Column="2"
                             Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="gap_tb" Grid.Column="3"
                           ToolTip="Right edge of the swatch to the start of the text, in view mm"/>
                </Grid>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Line weight" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="sys_lw_tb" Grid.Column="1" Margin="0,0,16,0"
                           ToolTip="Line weight for the swatches, 1 to 16. Existing line styles and filled region types are overwritten with it."/>
                  <CheckBox x:Name="sys_upper_cb" Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="Names in UPPERCASE"
                            ToolTip="Matches the house legend. Untick to use the name exactly as written."/>
                </Grid>
              </StackPanel>
            </Border>

          </Grid>
        </TabItem>

      </TabControl>

      <!-- footer -->
      <Border Grid.Row="2" Background="{DynamicResource Bar}"
              BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
              CornerRadius="0,0,5,5" Padding="18,12,18,12" Margin="0,16,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="status_tb" Foreground="{DynamicResource Muted}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <CheckBox x:Name="debug_cb" Grid.Column="1" Content="Debug"
                    VerticalAlignment="Center" Margin="12,0,16,0"
                    Foreground="{DynamicResource Muted}"
                    ToolTip="Write a step-by-step log of the run to %APPDATA%\RevoBIM\legend_creator_debug.txt. Off by default."/>
          <Button x:Name="cancel_btn" Grid.Column="2" Content="Cancel"/>
          <Button x:Name="create_btn" Grid.Column="3" Style="{StaticResource Create}" Margin="8,0,0,0"
                  Content="Create legends" IsDefault="True"/>
        </Grid>
      </Border>


      <!-- resize grips. The overlay Grid itself has no Background, so only
           the eight strips are hit testable and the middle stays clickable. -->
      <Grid Grid.RowSpan="3">
        <Grid.RowDefinitions>
          <RowDefinition Height="6"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="6"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="6"/>
        </Grid.ColumnDefinitions>
        <Thumb x:Name="grip_tl" Style="{StaticResource Grip}" Cursor="SizeNWSE"
               Grid.Row="0" Grid.Column="0"/>
        <Thumb x:Name="grip_t"  Style="{StaticResource Grip}" Cursor="SizeNS"
               Grid.Row="0" Grid.Column="1"/>
        <Thumb x:Name="grip_tr" Style="{StaticResource Grip}" Cursor="SizeNESW"
               Grid.Row="0" Grid.Column="2"/>
        <Thumb x:Name="grip_l"  Style="{StaticResource Grip}" Cursor="SizeWE"
               Grid.Row="1" Grid.Column="0"/>
        <Thumb x:Name="grip_r"  Style="{StaticResource Grip}" Cursor="SizeWE"
               Grid.Row="1" Grid.Column="2"/>
        <Thumb x:Name="grip_bl" Style="{StaticResource Grip}" Cursor="SizeNESW"
               Grid.Row="2" Grid.Column="0"/>
        <Thumb x:Name="grip_b"  Style="{StaticResource Grip}" Cursor="SizeNS"
               Grid.Row="2" Grid.Column="1"/>
        <Thumb x:Name="grip_br" Style="{StaticResource Grip}" Cursor="SizeNWSE"
               Grid.Row="2" Grid.Column="2"/>
      </Grid>

    </Grid>
  </Border>
</Window>

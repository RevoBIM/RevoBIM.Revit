<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Match Offset"
        Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="Transparent" ShowInTaskbar="False">
  <Border Background="{DynamicResource WindowBrush}"
          BorderBrush="{DynamicResource EdgeBrush}"
          BorderThickness="1" CornerRadius="6">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ================= header ================= -->
      <Border x:Name="HeaderBar" Grid.Row="0"
              Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="12,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel x:Name="LogoArea" Grid.Column="0"
                      Orientation="Horizontal" Background="Transparent">
            <Image x:Name="LogoImage" Width="28" Height="28"
                   VerticalAlignment="Center" />
            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}" />
              <TextBlock Text="Match Offset" FontSize="12"
                         Foreground="{DynamicResource OrangeBrush}" />
            </StackPanel>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="2" Content="Auto"
                  Style="{DynamicResource ChipButton}"
                  VerticalAlignment="Center" Margin="0,0,10,0"
                  ToolTip="Auto follows Revit's own canvas theme" />

          <TextBlock x:Name="VersionLabel" Grid.Column="3" Text="v1.0.0"
                     Style="{DynamicResource MutedText}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />

          <Button x:Name="CloseButton" Grid.Column="4" Content="&#x2715;"
                  Style="{DynamicResource CloseButton}"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ================= body ================= -->
      <StackPanel Grid.Row="1" Margin="18,16,18,10">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Border Width="4" Background="{DynamicResource BlueBrush}"
                  CornerRadius="2" Margin="0,0,9,0" />
          <TextBlock x:Name="MessageTitle" Text=""
                     Style="{DynamicResource SectionText}"
                     VerticalAlignment="Center" />
        </StackPanel>
        <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="MessageBody" Text="" TextWrapping="Wrap"
                     LineHeight="19" />
        </ScrollViewer>
      </StackPanel>

      <!-- ================= footer ================= -->
      <Border Grid.Row="2" Background="{DynamicResource BarBrush}"
              CornerRadius="0,0,6,6" Padding="14,10,14,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,8,0"
                  Visibility="Collapsed" />
          <Button x:Name="AltButton" Content="No" Margin="0,0,8,0"
                  Visibility="Collapsed" />
          <Button x:Name="PrimaryButton" Content="OK"
                  Style="{DynamicResource PrimaryButton}" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>

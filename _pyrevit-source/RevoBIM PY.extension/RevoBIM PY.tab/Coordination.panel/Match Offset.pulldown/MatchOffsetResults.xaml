<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Match Offset"
        Width="620" Height="440" MinWidth="460" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Background="Transparent" ShowInTaskbar="False">
  <Border Background="{DynamicResource WindowBrush}"
          BorderBrush="{DynamicResource EdgeBrush}"
          BorderThickness="1" CornerRadius="6">
    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ================= header ================= -->
      <Border x:Name="HeaderBar" Grid.Row="0"
              Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="12,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel x:Name="LogoArea" Grid.Column="0"
                      Orientation="Horizontal" Background="Transparent">
            <Image x:Name="LogoImage" Width="28" Height="28"
                   VerticalAlignment="Center" />
            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}" />
              <TextBlock Text="Match Offset" FontSize="12"
                         Foreground="{DynamicResource OrangeBrush}" />
            </StackPanel>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="2" Content="Auto"
                  Style="{DynamicResource ChipButton}"
                  VerticalAlignment="Center" Margin="0,0,10,0"
                  ToolTip="Auto follows Revit's own canvas theme" />

          <TextBlock x:Name="VersionLabel" Grid.Column="3" Text="v1.0.0"
                     Style="{DynamicResource MutedText}"
                     VerticalAlignment="Center" Margin="0,0,8,0" />

          <Button x:Name="CloseButton" Grid.Column="4" Content="&#x2715;"
                  Style="{DynamicResource CloseButton}"
                  VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- ================= summary ================= -->
      <Border Grid.Row="1" Background="{DynamicResource CardBrush}"
              Margin="14,12,14,0" CornerRadius="4" Padding="12,9,12,9">
        <StackPanel>
          <TextBlock x:Name="SummaryLine" Text="" TextWrapping="Wrap"
                     FontWeight="SemiBold" />
          <TextBlock x:Name="DatumLine" Text=""
                     Style="{DynamicResource MutedText}"
                     Margin="0,3,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- ================= the list ================= -->
      <ScrollViewer Grid.Row="2" Margin="14,10,14,10"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="ReportPanel" />
      </ScrollViewer>

      <!-- ================= footer ================= -->
      <Border Grid.Row="3" Background="{DynamicResource BarBrush}"
              CornerRadius="0,0,6,6" Padding="14,10,14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text=""
                     Style="{DynamicResource MutedText}"
                     VerticalAlignment="Center" />
          <Button x:Name="DoneButton" Grid.Column="1" Content="Close"
                  Style="{DynamicResource PrimaryButton}" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D Extend - Settings"
        Width="520"
        SizeToContent="Height"
        MinHeight="420"
        MaxHeight="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#FF1E1E1E">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FFE6E6E6"/>
        <SolidColorBrush x:Key="Muted" Color="#FF9A9A9A"/>
        <SolidColorBrush x:Key="Accent" Color="#FF4FA3E3"/>
        <SolidColorBrush x:Key="Panel" Color="#FF262626"/>
        <SolidColorBrush x:Key="Edge" Color="#FF3A3A3A"/>
        <SolidColorBrush x:Key="FieldBg" Color="#FF141414"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBg}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Ink}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Image x:Name="header_icon" Width="34" Height="34"
                       Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="3D Extend" FontSize="17"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="RevoBIM PY" Style="{StaticResource Hint}"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="version_label" Text="v4.1.0"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Foreground="#FF9A9A9A" FontSize="11"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,6,0">
          <StackPanel>

        <!-- cable tray -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="CABLE TRAY"
                           Style="{StaticResource SectionHead}"/>

                <TextBlock Text="Angle of tray as it drops" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="tray_90_rb" GroupName="trayangle"
                                 Content="90 deg" Margin="0,0,22,0"/>
                    <RadioButton x:Name="tray_45_rb" GroupName="trayangle"
                                 Content="45 deg" Margin="0,0,22,0"/>
                    <RadioButton x:Name="tray_custom_rb" GroupName="trayangle"
                                 Content="Custom" Margin="0,0,10,0"/>
                    <TextBox x:Name="tray_custom_tb" Width="60"/>
                    <TextBlock Text="deg" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#FF9A9A9A"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="90 is a straight vertical drop. Anything shallower sets the source tray back so the sloped run still lands on the crossing point."/>

                <CheckBox x:Name="tray_connect_cb"
                          Content="Connect the branch into the tray system"
                          Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Joins the branch into the tray system, leaving the main tray whole - it is never cut. Landing on a free end connects the two directly; mid-run it taps in with a takeoff from the tray type's routing preferences. If neither will take, the branch is run up close to the main tray and left loose."/>
            </StackPanel>
        </Border>

        <!-- pipes -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="PIPES" Style="{StaticResource SectionHead}"/>

                <TextBlock Text="Angle of connection" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="pipe_90_rb" GroupName="pipeangle"
                                 Content="90 deg" Margin="0,0,22,0"/>
                    <RadioButton x:Name="pipe_45_rb" GroupName="pipeangle"
                                 Content="45 deg" Margin="0,0,22,0"/>
                    <RadioButton x:Name="pipe_custom_rb" GroupName="pipeangle"
                                 Content="Custom" Margin="0,0,10,0"/>
                    <TextBox x:Name="pipe_custom_tb" Width="60"/>
                    <TextBlock Text="deg" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#FF9A9A9A"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}"
                           Text="The target pipe is broken at the crossing point and a tee is placed. If the target stops short of the crossing it is brought out to meet the branch and joined with a bend instead."/>
            </StackPanel>
        </Border>

        <!-- ducts -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="DUCTS" Style="{StaticResource SectionHead}"/>

                <TextBlock Text="Angle of connection" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="duct_90_rb" GroupName="ductangle"
                                 Content="90 deg" Margin="0,0,22,0"/>
                    <RadioButton x:Name="duct_45_rb" GroupName="ductangle"
                                 Content="45 deg" Margin="0,0,22,0"/>
                    <RadioButton x:Name="duct_custom_rb" GroupName="ductangle"
                                 Content="Custom" Margin="0,0,10,0"/>
                    <TextBox x:Name="duct_custom_tb" Width="60"/>
                    <TextBlock Text="deg" Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#FF9A9A9A"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="Branch size follows the source, round or rectangular."/>

                <TextBlock Text="Connect with" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <RadioButton x:Name="duct_tap_rb" GroupName="ductfitting"
                                 Content="Shoe / tap" Margin="0,0,22,0"/>
                    <RadioButton x:Name="duct_tee_rb" GroupName="ductfitting"
                                 Content="Tee"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                           Text="Shoe takes the fitting from the duct type's Tap routing preference and leaves the main duct whole, so several branches can tap the same run. Tee breaks the main duct at the crossing point and uses the Junction preference instead."/>

                <CheckBox x:Name="show_report_cb"
                          Content="Show a summary when 3D Extend finishes"
                          Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Off by default, so the tool finishes silently. Turn it on to see the angle actually used and anything that was skipped."/>
            </StackPanel>
        </Border>

        <!-- keyboard shortcuts -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="KEYBOARD SHORTCUTS"
                           Style="{StaticResource SectionHead}"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="3D Extend" Width="150"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="sc_tool_tb" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="3D Extend Settings" Width="150"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="sc_settings_tb" Width="150"/>
                </StackPanel>

                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Type the keystroke as Revit writes it, e.g. EX, or CTRL+SHIFT+E. Separate more than one with #. Applying writes them into Revit's KeyboardShortcuts.xml, with a .bak backup, and refuses any keystroke already taken by another command. Revit has to be restarted before a new shortcut works."/>

                <TextBlock x:Name="id_label" Text=""
                           TextWrapping="Wrap"
                           Foreground="#FF6E6E6E" FontSize="10"/>
            </StackPanel>
        </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- status and buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <TextBlock x:Name="status_label" Text=""
                           TextWrapping="Wrap"
                           Foreground="#FF7FC08A" FontSize="11"/>
                <TextBlock x:Name="path_label" Text=""
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="#FF6E6E6E" FontSize="10"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Reset" Click="on_reset"/>
                <Button Content="Cancel" Click="on_cancel"/>
                <Button Content="Apply" Click="on_apply"/>
                <Button Content="Save" Click="on_save"
                        Background="#FF2E6FA3" BorderBrush="#FF4FA3E3"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find in View"
        Width="460" SizeToContent="Height" MinHeight="170"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI" FontSize="12.5">

  <Border x:Name="RootBorder" CornerRadius="6" Margin="6"
          Background="{DynamicResource WindowBg}"
          BorderBrush="{DynamicResource ChromeEdge}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
    </Border.Effect>

    <Grid x:Name="RootGrid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="5,5,0,0"
              Background="{DynamicResource BarBg}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1"
              Padding="14,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderIcon" Grid.Column="0" Width="26" Height="26"
                 Margin="0,0,9,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1">
            <TextBlock Text="RevoBIM" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource BlueBrush}"/>
            <TextBlock x:Name="TitleTool" Text="Find in View" FontSize="13"
                       Margin="1,-2,0,0"
                       Foreground="{DynamicResource OrangeBrush}"/>
          </StackPanel>
          <TextBlock x:Name="VersionText" Grid.Column="3" Text="v1.0.0" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,8,0"
                     Foreground="{DynamicResource MutedBrush}"/>
<Button x:Name="ShrinkBtn" Grid.Column="4"
                  Style="{DynamicResource ChromeButton}"
                  ToolTip="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)">
            <Grid Width="12" Height="12">
              <Path x:Name="PathShrink" StrokeThickness="1.4"
                    Stroke="{DynamicResource MutedBrush}"
                    Data="M 6,0.5 L 6,7 M 3,4.2 L 6,7.4 L 9,4.2 M 1.5,10.5 L 10.5,10.5"/>
              <Path x:Name="PathExpand" StrokeThickness="1.6" Visibility="Collapsed"
                    Stroke="{DynamicResource GreenBrush}"
                    Data="M 6,11 L 6,4.5 M 3,7.3 L 6,4.1 L 9,7.3 M 1.5,1 L 10.5,1"/>
            </Grid>
          </Button>

          <Button x:Name="CloseBtn" Grid.Column="5" Content="&#x2715;"
                  Style="{DynamicResource CloseButton}"/>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" Margin="16,14,16,4" MaxHeight="420"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextBrush}"/>
      </ScrollViewer>

      <Border Grid.Row="2" CornerRadius="0,0,5,5"
              Background="{DynamicResource BarBg}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0"
              Padding="14,9">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="NoBtn" Content="No" Margin="0,0,10,0"
                  Style="{DynamicResource ThemedButton}" Visibility="Collapsed"/>
          <Button x:Name="OkBtn" Content="OK" MinWidth="96"
                  Style="{DynamicResource ThemedButton}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>

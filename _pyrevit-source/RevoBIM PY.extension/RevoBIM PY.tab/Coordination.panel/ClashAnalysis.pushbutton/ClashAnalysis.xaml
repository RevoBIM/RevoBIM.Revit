<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Clash Analysis" Width="1280" Height="800" MinWidth="1000" MinHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12"
        Foreground="{DynamicResource Text}">

    <Border x:Name="OuterBorder" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Edge}"
            BorderThickness="1" CornerRadius="6">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== Header ==================== -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0"
                    Padding="10,6">
                <DockPanel LastChildFill="True">
                    <Image x:Name="LogoIcon" Width="30" Height="30" Margin="0,0,10,0" DockPanel.Dock="Left"
                           Cursor="Hand" ToolTip="RevoBIM"/>
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blue}"
                                   Margin="0,-3,0,-2"/>
                        <TextBlock x:Name="ToolText" Text="Clash Analysis" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Orange}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="ThemeBtn" Style="{DynamicResource ChipBtn}" ToolTip="Theme: Auto follows Revit's canvas, then Dark, then Light">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6,0 A6,6 0 1 0 6,12 A4,6 0 1 1 6,0 Z" Fill="{DynamicResource Orange}"
                                      VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="ThemeText" Text="Auto" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="VersionText" Text="v0.0.0" Foreground="{DynamicResource Muted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,10,0"/>
                        <Button x:Name="ShrinkBtn" Style="{DynamicResource ShrinkButton}"/>
                        <Button x:Name="MaxBtn" Style="{DynamicResource ChromeBtn}" ToolTip="Full screen (F11)">
                            <Border Width="11" Height="10" BorderBrush="{DynamicResource Text}" BorderThickness="1.5"/>
                        </Button>
                        <Button x:Name="CloseBtn" Style="{DynamicResource CloseBtn}" ToolTip="Close"/>
                    </StackPanel>
                    <Border/>
                </DockPanel>
            </Border>

            <!-- ==================== Body ==================== -->
            <TabControl x:Name="MainTabs" Grid.Row="1" Margin="6,6,6,0">

                <!-- ========== Clash tests ========== -->
                <TabItem x:Name="TabTests">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,4 L14,4 M4,0 L10,14" Stroke="{DynamicResource Blue}" StrokeThickness="2.2" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clash Tests" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition x:Name="SetsRow" Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- saved tests: collapsible strip across the top -->
                        <Border Style="{DynamicResource Card}">
                            <DockPanel>
                            <Border x:Name="TestsHeader" DockPanel.Dock="Top" Background="Transparent" Cursor="Hand" Margin="0,0,0,4" ToolTip="Click to show or hide the saved clash tests">
                                <DockPanel>
                                    <Path x:Name="TestsChevron" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource Text}" StrokeThickness="1.8" Width="12" Height="12" Stretch="None" Margin="0,3,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.45,0.25"/>
                                    <Border Width="4" Height="16" Background="{DynamicResource Blue}" CornerRadius="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="Saved clash tests" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TestsSummary" Text="" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="TestsBody" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel>
                                        <TextBox x:Name="TestSearch" DockPanel.Dock="Top" Tag="Search clash tests"/>
                                        <ListBox x:Name="TestList" Height="150" ToolTip="Right-click a test to rename, duplicate, run or delete it"/>
                                    </DockPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" MinWidth="110">
                                        <Button x:Name="NewTestBtn" Style="{DynamicResource Btn}" ToolTip="Start a new clash test">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M5,0 L5,10 M0,5 L10,5" Stroke="{DynamicResource Green}" StrokeThickness="2" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="New"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DuplicateTestBtn" Style="{DynamicResource Btn}" ToolTip="Copy the selected test">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,3 L7,3 L7,10 L0,10 Z M3,0 L10,0 L10,7" Stroke="{DynamicResource Blue}" StrokeThickness="1.4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Duplicate"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RenameTestBtn" Style="{DynamicResource Btn}" ToolTip="Rename the selected test (F2, or right-click the test)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,11 L0,8 L8,0 L11,3 L3,11 Z M6,2 L9,5" Stroke="{DynamicResource Orange}" StrokeThickness="1.4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Rename"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="DeleteTestBtn" Style="{DynamicResource Btn}" ToolTip="Delete the selected test">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource Red}" StrokeThickness="1.8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Delete"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="RunAllBtn" Style="{DynamicResource Btn}" ToolTip="Run every saved test again and report the counts">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,0 L8,5 L0,10 Z M6,0 L14,5 L6,10" Fill="{DynamicResource Green}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Run all"/>
                                        </StackPanel>
                                    </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </DockPanel>
                        </Border>

                        <!-- set A + set B: collapsible -->
                        <Border x:Name="SetsCard" Grid.Row="1" Style="{DynamicResource Card}">
                            <DockPanel>
                            <Border x:Name="SetsHeader" DockPanel.Dock="Top" Background="Transparent" Cursor="Hand" Margin="0,0,0,4" ToolTip="Click to show or hide Set A and Set B">
                                <DockPanel>
                                    <Path x:Name="SetsChevron" Data="M0,0 L5,5 L10,0" Stroke="{DynamicResource Text}" StrokeThickness="1.8" Width="12" Height="12" Stretch="None" Margin="0,3,6,0" VerticalAlignment="Center" RenderTransformOrigin="0.45,0.25"/>
                                    <Border Width="4" Height="16" Background="{DynamicResource Orange}" CornerRadius="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="Set A + Set B" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SetsSummary" Text="" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Border>
                            <Border x:Name="SetsBody" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                    <ColumnDefinition Width="*" MinWidth="300"/>
                                </Grid.ColumnDefinitions>
                                <!-- set A -->
                                <Border Grid.Column="0" Style="{DynamicResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition x:Name="ModelsRowA" Height="174" MinHeight="48"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="90"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,4">
                                            <Border Width="4" Height="16" Background="{DynamicResource Blue}" CornerRadius="2" Margin="0,0,7,0"/>
                                            <TextBlock Text="Set A" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Blue}"/>
                                            <TextBlock x:Name="CountA" Text="" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="Models - tick a model to list its categories" Foreground="{DynamicResource Muted}" Margin="3,2"/>
                                        <ListBox x:Name="ModelsA" Grid.Row="2"/>
                                        <GridSplitter x:Name="SplitA" Grid.Row="3" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS" ToolTip="Drag to show more or fewer models">
                                            <GridSplitter.Template>
                                                <ControlTemplate TargetType="GridSplitter">
                                                    <Border Background="Transparent">
                                                        <Border Height="3" Width="40" CornerRadius="1.5" Background="{DynamicResource Edge}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </GridSplitter.Template>
                                        </GridSplitter>
                                        <DockPanel Grid.Row="4">
                                            <DockPanel DockPanel.Dock="Top">
                                            <Button x:Name="ClearA" DockPanel.Dock="Right" Style="{DynamicResource Btn}" Content="Clear" ToolTip="Untick everything in Set A"/>
                                            <Button x:Name="ExpandA" DockPanel.Dock="Right" Style="{DynamicResource Btn}" Content="+/-" ToolTip="Expand or collapse every category"/>
                                            <TextBox x:Name="SearchA" Tag="Search categories and families"/>
                                            </DockPanel>
                                            <ListBox x:Name="TreeA" VirtualizingPanel.IsVirtualizing="True"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>

                                <!-- set B -->
                                <Border Grid.Column="1" Style="{DynamicResource Card}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition x:Name="ModelsRowB" Height="174" MinHeight="48"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*" MinHeight="90"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,4">
                                            <Border Width="4" Height="16" Background="{DynamicResource Orange}" CornerRadius="2" Margin="0,0,7,0"/>
                                            <TextBlock Text="Set B" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Orange}"/>
                                            <TextBlock x:Name="CountB" Text="" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="Models - tick a model to list its categories" Foreground="{DynamicResource Muted}" Margin="3,2"/>
                                        <ListBox x:Name="ModelsB" Grid.Row="2"/>
                                        <GridSplitter x:Name="SplitB" Grid.Row="3" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Center" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS" ToolTip="Drag to show more or fewer models">
                                            <GridSplitter.Template>
                                                <ControlTemplate TargetType="GridSplitter">
                                                    <Border Background="Transparent">
                                                        <Border Height="3" Width="40" CornerRadius="1.5" Background="{DynamicResource Edge}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </GridSplitter.Template>
                                        </GridSplitter>
                                        <DockPanel Grid.Row="4">
                                            <DockPanel DockPanel.Dock="Top">
                                            <Button x:Name="ClearB" DockPanel.Dock="Right" Style="{DynamicResource Btn}" Content="Clear" ToolTip="Untick everything in Set B"/>
                                            <Button x:Name="ExpandB" DockPanel.Dock="Right" Style="{DynamicResource Btn}" Content="+/-" ToolTip="Expand or collapse every category"/>
                                            <TextBox x:Name="SearchB" Tag="Search categories and families"/>
                                            </DockPanel>
                                            <ListBox x:Name="TreeB" VirtualizingPanel.IsVirtualizing="True"/>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                            </Border>
                            </DockPanel>
                        </Border>

                        <!-- test options -->
                        <Border Grid.Row="2" Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="2*" MinWidth="160"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Clash test name" VerticalAlignment="Center" Margin="3,0,6,0"/>
                                <TextBox x:Name="TestName" Grid.Column="1" Tag="e.g. L02 Cable Tray vs Steel"/>
                                <TextBlock Grid.Column="2" Text="Detection" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <ComboBox x:Name="ModeCombo" Grid.Column="3"/>
                                <Button x:Name="SaveTestBtn" Grid.Column="4" Grid.RowSpan="2" Style="{DynamicResource Btn}" ToolTip="Save this clash test to the list">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M0,0 L9,0 L11,2 L11,11 L0,11 Z M2,0 L2,4 L8,4 L8,0" Stroke="{DynamicResource Blue}" StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Save test"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RunTestBtn" Grid.Column="5" Grid.RowSpan="2" Style="{DynamicResource GreenBtn}" ToolTip="Save and run this clash test">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M0,0 L10,6 L0,12 Z" Fill="{DynamicResource OnAccent}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="RunTestLabel" Text="Run clash test"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Run on" VerticalAlignment="Center" Margin="3,0,6,0"/>
                                    <ComboBox x:Name="RunScopeCombo" Width="130" Margin="0,0,16,0" ToolTip="Whole project: every element in the ticked models. Current view: only what the active view shows, host and links. Clash families from a floor plan run go on that plan's level."/>
                                    <TextBlock Text="Ignore touching under" VerticalAlignment="Center" Margin="3,0,6,0"/>
                                    <TextBox x:Name="TouchBox" Width="60" Text="5" ToolTip="Overlaps thinner than this (mm) are faces touching, not clashes"/>
                                    <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="2,0,16,0"/>
                                    <CheckBox x:Name="SkipConnected" Content="Skip elements connected to each other or nested in each other" IsChecked="True"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========== Results ========== -->
                <TabItem x:Name="TabResults">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,12 L0,6 M5,12 L5,2 M10,12 L10,8" Stroke="{DynamicResource Orange}" StrokeThickness="2.4" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Results" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="320"/>
                            <ColumnDefinition Width="1.6*" MinWidth="420"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.ColumnSpan="2" Style="{DynamicResource Card}">
                            <DockPanel>
                                <TextBlock Text="Result for" VerticalAlignment="Center" Margin="3,0,6,0"/>
                                <ComboBox x:Name="ResultCombo" Width="280"/>
                                <Border Background="{DynamicResource HeadBg}" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TotalText" Text="No test run yet" FontWeight="SemiBold" Foreground="{DynamicResource Orange}"/>
                                </Border>
                                <TextBlock x:Name="ResultInfo" Text="" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{DynamicResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <Border Width="4" Height="16" Background="{DynamicResource Blue}" CornerRadius="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="Clashing pairs" FontWeight="SemiBold" FontSize="13"/>
                                    <Button x:Name="AllPairsBtn" Style="{DynamicResource Btn}" Content="Show all" Margin="12,0,0,0" ToolTip="Clear the pair filter on the clash list"/>
                                </StackPanel>
                                <DataGrid x:Name="PairGrid" SelectionMode="Single"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{DynamicResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Border Width="4" Height="16" Background="{DynamicResource Orange}" CornerRadius="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="Clashes" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox x:Name="ClashSearch" Tag="Search clashes" Margin="12,0,0,0"/>
                                </DockPanel>
                                <DataGrid x:Name="ClashGrid" SelectionMode="Extended"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="2*" MinWidth="220"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" MinWidth="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Clash family" VerticalAlignment="Center" Margin="3,0,6,0"/>
                                <ComboBox x:Name="MarkerCombo" Grid.Column="1" ToolTip="Family placed at each clash, centred on the intersection"/>
                                <TextBlock Grid.Column="2" Text="Workset" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <ComboBox x:Name="WorksetCombo" Grid.Column="3" ToolTip="Workset for the clash families and their group"/>
                                <TextBlock Grid.Column="4" Text="Comment" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <ComboBox x:Name="CommentCombo" Grid.Column="5" ToolTip="What is written into each clash family's Comments"/>
                                <Button x:Name="PlaceBtn" Grid.Column="6" Grid.RowSpan="2" Style="{DynamicResource GreenBtn}" ToolTip="Place a clash family at each clash and group them">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M6,0 L6,12 M0,6 L12,6 M2,2 L10,10 M10,2 L2,10" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.8" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="PlaceLabel" Text="Place clash families"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,4,0,0">
                                    <ComboBox x:Name="ScopeCombo" Width="190"/>
                                    <TextBlock x:Name="CommentPreview" Text="" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                    <Button x:Name="ShowBtn" Style="{DynamicResource Btn}" ToolTip="Zoom the active view to the selected clash">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M4,0 A4,4 0 1 0 4.01,0 M7,7 L11,11" Stroke="{DynamicResource Blue}" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Zoom to clash"/>
                                        </StackPanel>
                                    </Button>
                                    <CheckBox x:Name="SectionBoxChk" Content="Section box in 3D" IsChecked="True" Margin="8,0,0,0"/>
                                    <Button x:Name="ScheduleBtn" Style="{DynamicResource Btn}" Margin="12,0,0,0" ToolTip="Create or update BIM_Clash Analysis Schedule: Generic Models of the clash family above, Level and Comments, sorted by Level">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,0 L12,0 L12,12 L0,12 Z M0,4 L12,4 M0,8 L12,8 M4,4 L4,12" Stroke="{DynamicResource Green}" StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Create Clash schedule"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========== Clash groups in the model ========== -->
                <TabItem x:Name="TabGroups">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M0,0 L6,0 L6,6 L0,6 Z M8,6 L14,6 L14,12 L8,12 Z" Stroke="{DynamicResource Green}" StrokeThickness="1.6" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clash Groups" FontWeight="SemiBold"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="380"/>
                            <ColumnDefinition Width="1.3*" MinWidth="420"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Style="{DynamicResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                    <Border Width="4" Height="16" Background="{DynamicResource Blue}" CornerRadius="2" Margin="0,0,7,0"/>
                                    <TextBlock Text="CLASH- groups in this model" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                    <Button x:Name="RefreshGroupsBtn" DockPanel.Dock="Right" Style="{DynamicResource Btn}" HorizontalAlignment="Right" ToolTip="Read the groups from the model again">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M10,3 A5,5 0 1 0 11,7 M10,0 L10,3 L7,3" Stroke="{DynamicResource Blue}" StrokeThickness="1.6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                                <TextBox x:Name="GroupSearch" DockPanel.Dock="Top" Tag="Search clash groups"/>
                                <DataGrid x:Name="GroupGrid" SelectionMode="Single"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{DynamicResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="0.8*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,4">
                                    <Border Width="4" Height="16" Background="{DynamicResource Orange}" CornerRadius="2" Margin="0,0,7,0"/>
                                    <Button x:Name="CopyReportBtn" DockPanel.Dock="Right" Style="{DynamicResource Btn}" ToolTip="Copy both tables to the clipboard, ready to paste into Excel">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,3 L7,3 L7,10 L0,10 Z M3,0 L10,0 L10,7" Stroke="{DynamicResource Blue}" StrokeThickness="1.4" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Copy report"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="ReportTitle" Text="Pick a group to see its report" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DataGrid x:Name="SummaryGrid" Grid.Row="1" SelectionMode="Single"/>
                                <DockPanel Grid.Row="2" Margin="3,6,3,2">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="Set review status" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button x:Name="StatusNotBtn" Style="{DynamicResource Btn}" ToolTip="Mark the highlighted clash families Not reviewed">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{DynamicResource Red}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Not reviewed"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="StatusReviewedBtn" Style="{DynamicResource Btn}" ToolTip="Mark the highlighted clash families Reviewed (Zoom to family does this for you)">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{DynamicResource Orange}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Reviewed"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="StatusOkBtn" Style="{DynamicResource Btn}" ToolTip="Mark the highlighted clash families OK">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="11" Height="11" Fill="{DynamicResource Green}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="OK"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Clash families in the group" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ReviewSummary" Text="" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <DataGrid x:Name="DetailGrid" Grid.Row="3" SelectionMode="Extended"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Card}">
                            <DockPanel>
                                <Button x:Name="DeleteGroupBtn" DockPanel.Dock="Right" Style="{DynamicResource RedBtn}" ToolTip="Delete the group, its clash families and its group type">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M0,2 L12,2 M4,2 L4,0 L8,0 L8,2 M2,2 L3,12 L9,12 L10,2" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Delete group"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AssignWorksetBtn" DockPanel.Dock="Right" Style="{DynamicResource GreenBtn}" ToolTip="Put the group and its clash families on the chosen workset">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M0,4 L6,0 L12,4 L6,8 Z M0,8 L6,12 L12,8" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.5" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Assign workset"/>
                                    </StackPanel>
                                </Button>
                                <ComboBox x:Name="GroupWorksetCombo" DockPanel.Dock="Right" Width="220"/>
                                <TextBlock DockPanel.Dock="Right" Text="Workset" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="SelectGroupBtn" Style="{DynamicResource Btn}" ToolTip="Select the group (or the highlighted clash families) in Revit">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M0,0 L0,11 L3,8 L5,12 L7,11 L5,7 L9,7 Z" Fill="{DynamicResource Blue}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Select in Revit"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ZoomGroupBtn" Style="{DynamicResource Btn}" ToolTip="Zoom to the highlighted clash family">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M4,0 A4,4 0 1 0 4.01,0 M7,7 L11,11" Stroke="{DynamicResource Blue}" StrokeThickness="1.8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Zoom to family"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="IsolateBtn" Style="{DynamicResource GreenBtn}" Margin="10,2,2,2" ToolTip="Temporarily show only this group's clash spheres (or the highlighted ones) on their floor plan, zoomed to fit. Uses Temporary View Properties and Temporary Isolate, so nothing changes for good.">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M6,0 A6,6 0 1 0 6.01,0 M6,3 A3,3 0 1 0 6.01,3" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Isolate Clash Sphere"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ResetViewBtn" Style="{DynamicResource Btn}" ToolTip="End Temporary Hide/Isolate and Temporary View Properties on the active view (and the view last isolated)">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M10,3 A5,5 0 1 0 11,7 M10,0 L10,3 L7,3" Stroke="{DynamicResource Orange}" StrokeThickness="1.6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Reset view"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                        <ComboBox x:Name="View3DCombo" Width="190" VerticalAlignment="Center" ToolTip="3D view to open - your default 3D view unless you pick another"/>
                                        <Button x:Name="View3DBtn" Style="{DynamicResource Btn}" ToolTip="Open the 3D view, box its section round the clash spheres (the highlighted ones, or the whole group) and zoom to fit">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M0,3 L6,0 L12,3 L12,10 L6,13 L0,10 Z M0,3 L6,6 L12,3 M6,6 L6,13" Stroke="{DynamicResource Blue}" StrokeThickness="1.4" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="View in 3D"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- ==================== Footer ==================== -->
            <Border x:Name="FooterBar" Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6" Padding="10,5" Margin="0,6,0,0">
                <DockPanel>
                    <CheckBox x:Name="DebugChk" DockPanel.Dock="Right" Content="Debug log" ToolTip="Write a debug log to %APPDATA%\RevoBIM\clash_analysis_debug.txt"/>
                    <TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <!-- ==================== Resize grips (no Background, so the window stays clickable) ==================== -->
            <Grid x:Name="GripLayer" Grid.RowSpan="3">
                <Thumb x:Name="GripL" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Margin="0,8"/>
                <Thumb x:Name="GripR" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Margin="0,8"/>
                <Thumb x:Name="GripT" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Cursor="SizeNS" Margin="8,0"/>
                <Thumb x:Name="GripB" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Margin="8,0"/>
                <Thumb x:Name="GripTL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
                <Thumb x:Name="GripTR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
                <Thumb x:Name="GripBL" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
                <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Clash Analysis" Width="480" SizeToContent="Height" MinHeight="150" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12"
        Foreground="{DynamicResource Text}">
    <Border x:Name="OuterBorder" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Edge}"
            BorderThickness="1" CornerRadius="6">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBar" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0" Padding="10,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="VersionText" Text="v0.0.0" Foreground="{DynamicResource Muted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,10,0"/>
                        <Button x:Name="ShrinkBtn" Style="{DynamicResource ShrinkButton}"/>
                        <Button x:Name="CloseBtn" Style="{DynamicResource CloseBtn}" ToolTip="Close"/>
                    </StackPanel>
                    <TextBlock Text="RevoBIM" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Blue}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TitleText" Text="Clash Analysis" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Orange}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,12">
                <StackPanel>
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="18"/>
                    <TextBox x:Name="InputBox" Visibility="Collapsed" Margin="0,10,0,0" MinHeight="28"/>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6" Padding="8,6">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>

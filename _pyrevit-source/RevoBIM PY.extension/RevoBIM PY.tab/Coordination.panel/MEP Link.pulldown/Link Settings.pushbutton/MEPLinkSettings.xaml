<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM MEP Link Settings"
        Width="470"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">

  <Window.Resources>
    <SolidColorBrush x:Key="WinBack"     Color="#FF232326"/>
    <SolidColorBrush x:Key="PanelBack"   Color="#FF2B2B2E"/>
    <SolidColorBrush x:Key="FieldBack"   Color="#FF1C1C1F"/>
    <SolidColorBrush x:Key="EdgeBrush"   Color="#FF3E3E42"/>
    <SolidColorBrush x:Key="TextBrush"   Color="#FFE4E4E4"/>
    <SolidColorBrush x:Key="MutedBrush"  Color="#FF9A9A9E"/>
    <SolidColorBrush x:Key="BlueBrush"   Color="#FF4FA3E3"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="#FFE8912D"/>
    <SolidColorBrush x:Key="GreenBrush"  Color="#FF3FA75A"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Margin" Value="0,2,12,2"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource FieldBack}"/>
      <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Padding" Value="3,1,3,1"/>
      <Setter Property="CaretBrush" Value="{StaticResource OrangeBrush}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#FF10240F"/>
      <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="27"/>
      <Setter Property="Width" Value="86"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF4EC06D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="#FF3A3A3E"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
                    CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FF4A4A4F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource WinBack}" CornerRadius="6"
          BorderBrush="#FF4A4A50" BorderThickness="1">
    <StackPanel>

      <!-- header -->
      <Border Background="#FF1C1C1F" CornerRadius="6,6,0,0"
              MouseLeftButtonDown="drag_window">
        <Grid Margin="14,9,10,9">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image x:Name="tool_icon" Width="30" Height="30" Margin="0,0,10,0"
                   SnapsToDevicePixels="True"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                         Foreground="{StaticResource BlueBrush}"/>
              <TextBlock Text="MEP Link Settings" FontSize="15"
                         Foreground="{StaticResource OrangeBrush}"
                         Margin="0,-2,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="version_tb" Text="v0.0.0" FontSize="11"
                     Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,0,22,0"/>
          <TextBlock Text="&#215;" FontSize="16" Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-3,0,0" Cursor="Hand"
                     MouseLeftButtonDown="close_click"/>
        </Grid>
      </Border>

      <!-- Rejoin 3D -->
      <Border Background="{StaticResource PanelBack}" CornerRadius="3"
              BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
              Margin="12,12,12,0">
        <StackPanel Margin="12,9,12,11">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <Border Width="4" Height="14" Background="{StaticResource BlueBrush}"
                    Margin="0,0,8,0"/>
            <TextBlock Text="Riser Link" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Bend angle" Style="{StaticResource Label}"/>
            <RadioButton x:Name="rj_90" GroupName="rj" Content="90&#176;"/>
            <RadioButton x:Name="rj_45" GroupName="rj" Content="45&#176;"/>
            <RadioButton x:Name="rj_custom" GroupName="rj" Content="Custom"
                         Margin="0,2,6,2"/>
            <TextBox x:Name="rj_value" Width="42" Height="21"
                     TextAlignment="Right" GotFocus="rj_focus"/>
            <TextBlock Text="&#176;" Margin="4,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Corner Trim -->
      <Border Background="{StaticResource PanelBack}" CornerRadius="3"
              BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
              Margin="12,8,12,0">
        <StackPanel Margin="12,9,12,11">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <Border Width="4" Height="14" Background="{StaticResource BlueBrush}"
                    Margin="0,0,8,0"/>
            <TextBlock Text="Corner Link" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Rise angle" Style="{StaticResource Label}"/>
            <RadioButton x:Name="ct_90" GroupName="ct" Content="90&#176;"/>
            <RadioButton x:Name="ct_45" GroupName="ct" Content="45&#176;"/>
            <RadioButton x:Name="ct_custom" GroupName="ct" Content="Custom"
                         Margin="0,2,6,2"/>
            <TextBox x:Name="ct_value" Width="42" Height="21"
                     TextAlignment="Right" GotFocus="ct_focus"/>
            <TextBlock Text="&#176;" Margin="4,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Hint}"
                     Text="The angle the run sets up or down at before it turns. Cable trays and unequal-sided ducts always take this route - they cannot drop and turn in one bend. Round and square profiles drop straight down where the level change allows it. Too small a level change falls back to a shallower angle. Angles are held to multiples of five degrees."/>
        </StackPanel>
      </Border>

      <!-- Align + Height -->
      <Border Background="{StaticResource PanelBack}" CornerRadius="3"
              BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
              Margin="12,8,12,0">
        <StackPanel Margin="12,9,12,11">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <Border Width="4" Height="14" Background="{StaticResource OrangeBrush}"
                    Margin="0,0,8,0"/>
            <TextBlock Text="Centreline Snap" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Align in" Style="{StaticResource Label}"/>
            <RadioButton x:Name="al_xy" GroupName="al" Content="Plan (X-Y)"/>
            <RadioButton x:Name="al_z" GroupName="al" Content="Level (Z)"/>
            <RadioButton x:Name="al_both" GroupName="al" Content="Both"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Behaviour -->
      <Border Background="{StaticResource PanelBack}" CornerRadius="3"
              BorderBrush="{StaticResource EdgeBrush}" BorderThickness="1"
              Margin="12,8,12,0">
        <StackPanel Margin="12,9,12,11">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <Border Width="4" Height="14" Background="{StaticResource OrangeBrush}"
                    Margin="0,0,8,0"/>
            <TextBlock Text="Behaviour" FontWeight="Bold"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
            <TextBlock Text="Show results" Style="{StaticResource Label}"/>
            <RadioButton x:Name="rp_problems" GroupName="rp"
                         Content="Only if something needs a look"/>
            <RadioButton x:Name="rp_always" GroupName="rp" Content="Always"/>
            <RadioButton x:Name="rp_never" GroupName="rp" Content="Never"/>
          </StackPanel>
          <CheckBox x:Name="keep_going"
                    Content="Keep picking pairs until Escape"/>
        </StackPanel>
      </Border>

      <!-- footer -->
      <Border Background="#FF1C1C1F" CornerRadius="0,0,6,6" Margin="0,12,0,0">
        <Grid Margin="12,9,12,9">
          <Button Content="Keyboard Shortcuts" Style="{StaticResource Quiet}"
                  Width="132" HorizontalAlignment="Left" Margin="0"
                  Click="shortcuts_click"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource Quiet}"
                    Click="close_click"/>
            <Button Content="Apply" Style="{StaticResource Primary}"
                    Click="apply_click"/>
          </StackPanel>
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</Window>

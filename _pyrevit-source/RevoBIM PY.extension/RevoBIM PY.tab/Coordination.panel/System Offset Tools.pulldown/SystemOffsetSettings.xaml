<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM System Offset Settings"
        Width="520" Height="420" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==============================================
                 Header
                 ============================================== -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="6,6,0,0" Padding="14,9,9,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="LogoImage" Grid.Column="0"
                           Width="32" Height="32" Margin="0,0,11,0"
                           Cursor="Hand" VerticalAlignment="Center"
                           ToolTip="RevoBIM PY"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontFamily="Segoe UI"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource Blue}"/>
                        <TextBlock Text="System Offset Settings" FontFamily="Segoe UI"
                                   FontSize="14" Margin="0,-3,0,0"
                                   Foreground="{DynamicResource Orange}"/>
                    </StackPanel>

                    <Button x:Name="ThemeChip" Grid.Column="3"
                            Style="{DynamicResource ChipButton}"
                            Content="Auto" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Follow Revit, Dark or Light"/>

                    <TextBlock x:Name="VersionText" Grid.Column="4"
                               Text="v5.5.0" FontFamily="Segoe UI" FontSize="11"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedText}"/>

                    <Button x:Name="CloseButton" Grid.Column="5"
                            Style="{DynamicResource CloseButton}"
                            Content="&#x2715;" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- ==============================================
                 Body. Two settings, and nothing else.
                 ============================================== -->
            <StackPanel Grid.Row="1" Margin="16,14,16,10">

                <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{DynamicResource TickBlue}"/>
                            <TextBlock Text="How far to offset"
                                       Style="{DynamicResource SectionHeading}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WidthFactorBox" Grid.Column="0"
                                     Tag="1" FontSize="14"/>
                            <TextBlock Grid.Column="1"
                                       Text="x the width of the service"
                                       Style="{DynamicResource LabelText}"
                                       Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock x:Name="DistanceNote"
                                   Style="{DynamicResource MutedLabel}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Style="{DynamicResource TickBlue}"/>
                            <TextBlock Text="Angle of offset"
                                       Style="{DynamicResource SectionHeading}"/>
                        </StackPanel>

                        <ComboBox x:Name="AngleCombo"/>

                        <TextBlock x:Name="AngleNote"
                                   Style="{DynamicResource MutedLabel}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==============================================
                 Footer
                 ============================================== -->
            <Border Grid.Row="2" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,6,6" Padding="14,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ShortcutButton" Grid.Column="0"
                            Content="Keyboard shortcuts..."
                            ToolTip="Opens Revit's own Keyboard Shortcuts dialog. Search for RevoBIM System Offset."/>

                    <TextBlock x:Name="StatusText" Grid.Column="1"
                               Style="{DynamicResource MutedLabel}"
                               Margin="14,0,14,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="CancelButton" Grid.Column="2"
                            Content="Cancel" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Grid.Column="3"
                            Style="{DynamicResource PrimaryButton}"
                            Content="Apply"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

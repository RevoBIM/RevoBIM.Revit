<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM System Offset"
        Width="430" Height="404" MinWidth="430" MinHeight="404"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==============================================
                 Header
                 ============================================== -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="6,6,0,0" Padding="12,8,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="LogoImage" Grid.Column="0"
                           Width="30" Height="30" Margin="0,0,10,0"
                           Cursor="Hand" VerticalAlignment="Center"
                           ToolTip="RevoBIM PY"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontFamily="Segoe UI"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource Blue}"/>
                        <TextBlock x:Name="ToolNameText" Text="System Offset" FontFamily="Segoe UI"
                                   FontSize="13" Margin="0,-2,0,0"
                                   Foreground="{DynamicResource Orange}"/>
                    </StackPanel>

                    <Button x:Name="ThemeChip" Grid.Column="3"
                            Style="{DynamicResource ChipButton}"
                            Content="Auto" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Follow Revit, Dark or Light"/>

                    <TextBlock x:Name="VersionText" Grid.Column="4"
                               Text="v5.5.0" FontFamily="Segoe UI" FontSize="11"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedText}"/>

                    <Button x:Name="CloseButton" Grid.Column="5"
                            Style="{DynamicResource CloseButton}"
                            Content="&#x2715;" ToolTip="Cancel this offset (Escape)"/>
                </Grid>
            </Border>

            <!-- ==============================================
                 Body
                 ============================================== -->
            <StackPanel Grid.Row="1" Margin="16,14,16,8">

                <Grid Margin="0,0,0,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="104"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Offset distance"
                               Style="{DynamicResource SectionHeading}"/>
                    <TextBox x:Name="DistanceBox" Grid.Column="1"
                             Tag="150" FontSize="14"/>
                    <TextBlock Grid.Column="2" Text="mm"
                               Style="{DynamicResource MutedLabel}"
                               Margin="8,0,0,0"/>
                </Grid>

                <TextBlock x:Name="DefaultNote"
                           Style="{DynamicResource MutedLabel}"
                           TextWrapping="Wrap" Margin="0,0,0,2"/>
                <TextBlock x:Name="RoomNote"
                           Style="{DynamicResource MutedLabel}"
                           TextWrapping="Wrap" Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Style="{DynamicResource TickOrange}"/>
                    <TextBlock x:Name="WhichWayText" Text="Which way"
                               Style="{DynamicResource SectionHeading}"/>
                </StackPanel>

                <!-- Arrows are Path geometry, not a symbol font, so
                     they cannot render as empty boxes on a machine
                     without that font. -->
                <UniformGrid Columns="4" Rows="1">
                    <Button x:Name="UpButton" Style="{DynamicResource DirTile}"
                            ToolTip="Offset up">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Fill="{DynamicResource Blue}"
                                  Data="M 12,0 L 24,13 L 17,13 L 17,26 L 7,26 L 7,13 L 0,13 Z"/>
                            <TextBlock Text="Up" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" FontFamily="Segoe UI"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource BodyText}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DownButton" Style="{DynamicResource DirTile}"
                            ToolTip="Offset down">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Fill="{DynamicResource Blue}"
                                  Data="M 12,26 L 0,13 L 7,13 L 7,0 L 17,0 L 17,13 L 24,13 Z"/>
                            <TextBlock Text="Down" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" FontFamily="Segoe UI"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource BodyText}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="LeftButton" Style="{DynamicResource DirTile}"
                            ToolTip="Offset left">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Fill="{DynamicResource Blue}"
                                  Data="M 0,12 L 13,0 L 13,7 L 26,7 L 26,17 L 13,17 L 13,24 Z"/>
                            <TextBlock Text="Left" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" FontFamily="Segoe UI"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource BodyText}"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="RightButton" Style="{DynamicResource DirTile}"
                            ToolTip="Offset right">
                        <StackPanel>
                            <Path Width="26" Height="26" Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  Fill="{DynamicResource Blue}"
                                  Data="M 26,12 L 13,24 L 13,17 L 0,17 L 0,7 L 13,7 L 13,0 Z"/>
                            <TextBlock Text="Right" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" FontFamily="Segoe UI"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource BodyText}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>

            <!-- ==============================================
                 Footer
                 ============================================== -->
            <Border Grid.Row="2" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,6,6" Padding="16,9,16,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Style="{DynamicResource MutedLabel}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CancelButton" Grid.Column="1"
                            Content="Cancel"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

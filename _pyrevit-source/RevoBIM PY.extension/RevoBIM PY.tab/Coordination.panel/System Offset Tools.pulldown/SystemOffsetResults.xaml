<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM System Offset"
        Width="640" Height="460" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==============================================
                 Header
                 ============================================== -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="6,6,0,0" Padding="14,9,9,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="LogoImage" Grid.Column="0"
                           Width="34" Height="34" Margin="0,0,11,0"
                           Cursor="Hand" VerticalAlignment="Center"
                           ToolTip="RevoBIM PY"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontFamily="Segoe UI"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="{DynamicResource Blue}"/>
                        <TextBlock x:Name="ToolNameText" Text="System Offset" FontFamily="Segoe UI"
                                   FontSize="15" Margin="0,-3,0,0"
                                   Foreground="{DynamicResource Orange}"/>
                    </StackPanel>

                    <Button x:Name="ThemeChip" Grid.Column="3"
                            Style="{DynamicResource ChipButton}"
                            Content="Auto" Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            ToolTip="Follow Revit, Dark or Light"/>

                    <TextBlock x:Name="VersionText" Grid.Column="4"
                               Text="v5.5.0" FontFamily="Segoe UI" FontSize="11"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedText}"/>

                    <Button x:Name="FullScreenButton" Grid.Column="5"
                            Style="{DynamicResource GlyphButton}"
                            ToolTip="Full screen (F11)">
                        <Border Width="12" Height="10" BorderThickness="1.4"
                                BorderBrush="{DynamicResource MutedText}"/>
                    </Button>

                    <Button x:Name="CloseButton" Grid.Column="6"
                            Style="{DynamicResource CloseButton}"
                            Content="&#x2715;" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- ==============================================
                 Body
                 ============================================== -->
            <Grid Grid.Row="1" Margin="14,12,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Style="{DynamicResource TickBlue}"/>
                    <TextBlock x:Name="SummaryText"
                               Style="{DynamicResource SectionHeading}"
                               Text="Done"/>
                </StackPanel>

                <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RowsPanel" Margin="10,8,10,8"/>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ==============================================
                 Footer
                 ============================================== -->
            <Border Grid.Row="2" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,6,6" Padding="14,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Style="{DynamicResource MutedLabel}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="OkButton" Grid.Column="1"
                            Style="{DynamicResource PrimaryButton}"
                            Content="Close"/>
                </Grid>
            </Border>

            <!-- ==============================================
                 Resize grips
                 ============================================== -->
            <Grid>
                <Thumb x:Name="GripN" Height="5" VerticalAlignment="Top"
                       HorizontalAlignment="Stretch" Margin="6,0,6,0" Opacity="0"/>
                <Thumb x:Name="GripS" Height="5" VerticalAlignment="Bottom"
                       HorizontalAlignment="Stretch" Margin="6,0,6,0" Opacity="0"/>
                <Thumb x:Name="GripW" Width="5" HorizontalAlignment="Left"
                       VerticalAlignment="Stretch" Margin="0,6,0,6" Opacity="0"/>
                <Thumb x:Name="GripE" Width="5" HorizontalAlignment="Right"
                       VerticalAlignment="Stretch" Margin="0,6,0,6" Opacity="0"/>
                <Thumb x:Name="GripNW" Width="6" Height="6"
                       HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0"/>
                <Thumb x:Name="GripNE" Width="6" Height="6"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0"/>
                <Thumb x:Name="GripSW" Width="6" Height="6"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Opacity="0"/>
                <Thumb x:Name="GripSE" Width="6" Height="6"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>

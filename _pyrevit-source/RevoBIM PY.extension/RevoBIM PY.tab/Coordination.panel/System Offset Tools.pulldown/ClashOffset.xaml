<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Clash Offset"
        Width="700" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==============================================
                 Header
                 ============================================== -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="6,6,0,0" Padding="14,9,9,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="LogoImage" Grid.Column="0"
                           Width="32" Height="32" Margin="0,0,11,0"
                           Cursor="Hand" VerticalAlignment="Center"
                           ToolTip="RevoBIM PY"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontFamily="Segoe UI"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource Blue}"/>
                        <TextBlock Text="Clash Offset" FontFamily="Segoe UI"
                                   FontSize="14" Margin="0,-3,0,0"
                                   Foreground="{DynamicResource Orange}"/>
                    </StackPanel>

                    <Button x:Name="ThemeChip" Grid.Column="3"
                            Style="{DynamicResource ChipButton}"
                            Content="Auto" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Follow Revit, Dark or Light"/>

                    <TextBlock x:Name="VersionText" Grid.Column="4"
                               Text="v5.5.0" FontFamily="Segoe UI" FontSize="11"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedText}"/>

                    <Button x:Name="FullScreenButton" Grid.Column="5"
                            Style="{DynamicResource GlyphButton}"
                            ToolTip="Full screen (F11)">
                        <Border Width="12" Height="10" BorderThickness="1.4"
                                BorderBrush="{DynamicResource MutedText}"/>
                    </Button>

                    <Button x:Name="CloseButton" Grid.Column="6"
                            Style="{DynamicResource CloseButton}"
                            Content="&#x2715;" ToolTip="Close"/>
                </Grid>
            </Border>

            <!-- ==============================================
                 Clearances
                 ============================================== -->
            <Border Grid.Row="1" Style="{DynamicResource Card}"
                    Margin="14,12,14,0" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Clear it by"
                               Style="{DynamicResource LabelText}"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="ClearanceBox" Grid.Column="1" Tag="50"/>
                    <TextBlock Grid.Column="2" Text="mm"
                               Style="{DynamicResource MutedLabel}"
                               Margin="8,0,22,0"/>

                    <TextBlock Grid.Column="3" Text="Start the bend"
                               Style="{DynamicResource LabelText}"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="LeadBox" Grid.Column="4" Tag="100"/>
                    <TextBlock Grid.Column="5" Text="mm before it"
                               Style="{DynamicResource MutedLabel}"
                               Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- ==============================================
                 What it will do
                 ============================================== -->
            <Border Grid.Row="2" Style="{DynamicResource Card}"
                    Margin="14,12,14,10" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="RowsPanel" Margin="10,8,10,8"/>
                </ScrollViewer>
            </Border>

            <!-- ==============================================
                 Footer
                 ============================================== -->
            <Border Grid.Row="3" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,6,6" Padding="14,10,14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Style="{DynamicResource MutedLabel}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CancelButton" Grid.Column="1"
                            Content="Cancel" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Grid.Column="2"
                            Style="{DynamicResource PrimaryButton}"
                            Content="Offset Around It"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

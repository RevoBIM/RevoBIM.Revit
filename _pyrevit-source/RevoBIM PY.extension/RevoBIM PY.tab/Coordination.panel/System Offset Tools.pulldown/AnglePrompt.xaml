<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Click System"
        Width="430" Height="810" MinWidth="430" MinHeight="810"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==============================================
                 Header
                 ============================================== -->
            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="6,6,0,0" Padding="12,8,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="LogoImage" Grid.Column="0"
                           Width="28" Height="28" Margin="0,0,10,0"
                           Cursor="Hand" VerticalAlignment="Center"
                           ToolTip="RevoBIM PY"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontFamily="Segoe UI"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource Blue}"/>
                        <TextBlock Text="Click System" FontFamily="Segoe UI"
                                   FontSize="12.5" Margin="0,-2,0,0"
                                   Foreground="{DynamicResource Orange}"/>
                    </StackPanel>

                    <Button x:Name="ThemeChip" Grid.Column="3"
                            Style="{DynamicResource ChipButton}"
                            Content="Auto" Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            ToolTip="Follow Revit, Dark or Light"/>

                    <TextBlock x:Name="VersionText" Grid.Column="4"
                               Text="v5.5.0" FontFamily="Segoe UI" FontSize="11"
                               Margin="0,0,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedText}"/>

                    <Button x:Name="CloseButton" Grid.Column="5"
                            Style="{DynamicResource CloseButton}"
                            Content="&#x2715;" ToolTip="Finish (Escape)"/>
                </Grid>
            </Border>

            <!-- ==============================================
                 Body
                 ============================================== -->
            <StackPanel Grid.Row="1" Margin="14,12,14,8">

                <!-- ===== horizontal placement ===== -->
                <Border Style="{DynamicResource Card}" Margin="0,0,0,12"
                        Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{DynamicResource TickBlue}"/>
                            <TextBlock Text="Horizontal placement"
                                       Style="{DynamicResource SectionHeading}"/>
                        </StackPanel>

                        <TextBlock x:Name="BankNote"
                                   Style="{DynamicResource MutedLabel}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <UniformGrid Columns="4" Rows="1" Margin="0,0,0,10">
                            <Button x:Name="Angle90" Style="{DynamicResource DirTile}"
                                    ToolTip="A square corner">
                                <StackPanel>
                                    <TextBlock Text="90" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Blue}"/>
                                    <TextBlock Text="degrees" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="10.5"
                                               Foreground="{DynamicResource MutedText}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Angle45" Style="{DynamicResource DirTile}">
                                <StackPanel>
                                    <TextBlock Text="45" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Blue}"/>
                                    <TextBlock Text="degrees" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="10.5"
                                               Foreground="{DynamicResource MutedText}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Angle30" Style="{DynamicResource DirTile}">
                                <StackPanel>
                                    <TextBlock Text="30" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="19"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Blue}"/>
                                    <TextBlock Text="degrees" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="10.5"
                                               Foreground="{DynamicResource MutedText}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="Angle225" Style="{DynamicResource DirTile}">
                                <StackPanel>
                                    <TextBlock Text="22.5" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="17"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Blue}"/>
                                    <TextBlock Text="degrees" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI" FontSize="10.5"
                                               Foreground="{DynamicResource MutedText}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Angle"
                                       Style="{DynamicResource LabelText}"/>
                            <TextBox x:Name="ManualBox" Grid.Column="1" Tag="90"/>
                            <TextBlock Grid.Column="2" Text="degrees"
                                       Style="{DynamicResource MutedLabel}"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Length"
                                       Style="{DynamicResource LabelText}"/>
                            <TextBox x:Name="LengthBox" Grid.Column="1"
                                     Tag="to the click"/>
                            <TextBlock Grid.Column="2" Text="mm"
                                       Style="{DynamicResource MutedLabel}"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <TextBlock Text="Leave the length blank and the new piece runs to wherever you click. Fill it in and the click only sets the corner and which way to turn."
                                   Style="{DynamicResource MutedLabel}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Button x:Name="PlaceHorizontalButton"
                                Style="{DynamicResource PrimaryButton}"
                                Content="Place Horizontal Bends"
                                HorizontalAlignment="Stretch" MinHeight="34"/>
                    </StackPanel>
                </Border>

                <!-- ===== height adjustment ===== -->
                <Border Style="{DynamicResource Card}" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Style="{DynamicResource TickOrange}"/>
                            <TextBlock Text="Height adjustment"
                                       Style="{DynamicResource SectionHeading}"/>
                        </StackPanel>

                        <TextBlock Text="Pick a direction, then click in Revit. The run carries on, rises or falls by the offset, and then runs straight to the click. If the click is close, the run on shortens and then the angle steepens to fit &#x2014; the offset itself is always achieved."
                                   Style="{DynamicResource MutedLabel}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Run on"
                                       Style="{DynamicResource LabelText}"/>
                            <TextBox x:Name="LeadBox" Grid.Column="1" Tag="500"/>
                            <TextBlock Grid.Column="2" Text="mm before it turns"
                                       Style="{DynamicResource MutedLabel}"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Offset"
                                       Style="{DynamicResource LabelText}"/>
                            <TextBox x:Name="HeightBox" Grid.Column="1" Tag="500"/>
                            <TextBlock Grid.Column="2" Text="mm up or down"
                                       Style="{DynamicResource MutedLabel}"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Angle"
                                       Style="{DynamicResource LabelText}"/>
                            <TextBox x:Name="RiseAngleBox" Grid.Column="1" Tag="45"/>
                            <TextBlock Grid.Column="2" Text="degrees"
                                       Style="{DynamicResource MutedLabel}"
                                       Margin="8,0,0,0"/>
                        </Grid>

                        <UniformGrid Columns="2" Rows="1">
                            <Button x:Name="SetUpButton"
                                    Style="{DynamicResource DirTile}"
                                    ToolTip="Take the run straight up by the offset">
                                <StackPanel>
                                    <Path Width="24" Height="24" Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Fill="{DynamicResource Green}"
                                          Data="M 12,0 L 24,13 L 17,13 L 17,26 L 7,26 L 7,13 L 0,13 Z"/>
                                    <TextBlock Text="Set Up" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontFamily="Segoe UI"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource BodyText}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SetDownButton"
                                    Style="{DynamicResource DirTile}"
                                    ToolTip="Take the run straight down by the offset">
                                <StackPanel>
                                    <Path Width="24" Height="24" Stretch="Uniform"
                                          HorizontalAlignment="Center"
                                          Fill="{DynamicResource Orange}"
                                          Data="M 12,26 L 0,13 L 7,13 L 7,0 L 17,0 L 17,13 L 24,13 Z"/>
                                    <TextBlock Text="Set Down" HorizontalAlignment="Center"
                                               Margin="0,6,0,0" FontFamily="Segoe UI"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource BodyText}"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <CheckBox x:Name="KeepCheck" Margin="2,12,0,0"
                          Content="Keep these for the rest of the run"/>
            </StackPanel>

            <!-- ==============================================
                 Footer
                 ============================================== -->
            <Border Grid.Row="2" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,6,6" Padding="14,9,14,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0"
                               Style="{DynamicResource MutedLabel}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CancelButton" Grid.Column="1"
                            Content="Finish"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

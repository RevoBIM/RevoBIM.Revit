<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Nudge Settings"
        Width="380" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

  <Window.Resources>
    <SolidColorBrush x:Key="ShellBrush"   Color="#FF262A31"/>
    <SolidColorBrush x:Key="PanelBrush"   Color="#FF2F343C"/>
    <SolidColorBrush x:Key="SunkenBrush"  Color="#FF21252B"/>
    <SolidColorBrush x:Key="EdgeBrush"    Color="#FF3A404A"/>
    <SolidColorBrush x:Key="TextBrush"    Color="#FFE4E7EB"/>
    <SolidColorBrush x:Key="MutedBrush"   Color="#FF8B929C"/>
    <SolidColorBrush x:Key="BlueBrush"    Color="#FF3D9BE9"/>
    <SolidColorBrush x:Key="OrangeBrush"  Color="#FFF07C10"/>

    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionHead" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- text entry -->
    <Style x:Key="Entry" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource SunkenBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource OrangeBrush}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource BlueBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{StaticResource EdgeBrush}"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush"
                        Value="{StaticResource OrangeBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- preset chip -->
    <Style x:Key="Chip" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="3" Padding="11,5"
                    Background="{StaticResource SunkenBrush}"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush"
                        Value="{StaticResource OrangeBrush}"/>
                <Setter TargetName="bd" Property="Background" Value="#FF2A2F37"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- checkbox, custom chrome -->
    <Style x:Key="Tick" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="15" Height="15" CornerRadius="3"
                      Background="{StaticResource SunkenBrush}"
                      BorderBrush="{StaticResource EdgeBrush}"
                      BorderThickness="1" VerticalAlignment="Center">
                <TextBlock x:Name="mark" Text="&#10003;" FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource OrangeBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                <Setter TargetName="box" Property="BorderBrush"
                        Value="{StaticResource OrangeBrush}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="box" Property="BorderBrush"
                        Value="{StaticResource BlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- primary action -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="3" Padding="16,7"
                    Background="{StaticResource OrangeBrush}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#FFFF9128"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- secondary action -->
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="3" Padding="14,7"
                    Background="Transparent"
                    BorderBrush="{StaticResource EdgeBrush}"
                    BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush"
                        Value="{StaticResource BlueBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource ShellBrush}" CornerRadius="5"
          BorderBrush="#FF161A1F" BorderThickness="1">
    <StackPanel Margin="0">

      <!-- ============ header ============ -->
      <Grid x:Name="header" Background="{StaticResource PanelBrush}"
            MouseLeftButtonDown="header_drag">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="tool_icon" Grid.Column="0" Width="34" Height="34"
               Margin="14,12,0,12" VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" Margin="11,12,0,12"
                    VerticalAlignment="Center">
          <TextBlock Text="RevoBIM" FontFamily="Segoe UI" FontSize="21"
                     FontWeight="Bold"
                     Foreground="{StaticResource BlueBrush}"/>
          <TextBlock Text="Nudge Settings" FontFamily="Segoe UI" FontSize="11.5"
                     Margin="1,-2,0,0"
                     Foreground="{StaticResource OrangeBrush}"/>
        </StackPanel>

        <Grid Grid.Column="2" Margin="0,7,10,7">
          <TextBlock Text="&#215;" FontSize="16" Margin="0,-2,2,0"
                     Foreground="{StaticResource MutedBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Cursor="Hand" MouseLeftButtonDown="close_click"/>
          <TextBlock x:Name="version_tb" Text="v0.0.0" FontSize="10"
                     FontFamily="Segoe UI" Margin="0,0,3,0"
                     Foreground="#FF6E6E72"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
        </Grid>
      </Grid>

      <Border Height="2" Background="{StaticResource OrangeBrush}"/>

      <!-- ============ body ============ -->
      <StackPanel Margin="16,14,16,14">

        <TextBlock Text="INCREMENT" Style="{StaticResource SectionHead}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,8"
                   Text="How far Nudge Up and Nudge Down move an element on each press."/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="tb_step" Grid.Column="0"
                   Style="{StaticResource Entry}" Text="50"/>
          <TextBlock Grid.Column="1" Text="mm" Margin="9,0,0,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource Lbl}"
                     Foreground="{StaticResource MutedBrush}"/>
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
          <Button x:Name="chip_1" Style="{StaticResource Chip}" Content="10"
                  Click="preset_click"/>
          <Button x:Name="chip_2" Style="{StaticResource Chip}" Content="25"
                  Click="preset_click"/>
          <Button x:Name="chip_3" Style="{StaticResource Chip}" Content="50"
                  Click="preset_click"/>
          <Button x:Name="chip_4" Style="{StaticResource Chip}" Content="100"
                  Click="preset_click"/>
        </StackPanel>

        <CheckBox x:Name="cb_snap" Style="{StaticResource Tick}"
                  Margin="0,13,0,0"
                  Content="Round the final elevation to the nearest"/>

        <Grid Margin="23,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="78"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="tb_snap" Grid.Column="0"
                   Style="{StaticResource Entry}" Text="5"
                   Padding="7,4" FontSize="12"/>
          <TextBlock Grid.Column="1" Text="mm" Margin="8,0,0,0"
                     VerticalAlignment="Center"
                     Style="{StaticResource Lbl}"
                     Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="23,6,0,0"
                   Text="An element sitting on an odd figure is tidied onto the grid on the first press, then moves by the full increment after that."/>

        <Border Height="1" Background="{StaticResource EdgeBrush}"
                Margin="0,15,0,13"/>

        <TextBlock Text="BEHAVIOUR" Style="{StaticResource SectionHead}"
                   Margin="0,0,0,9"/>

        <CheckBox x:Name="cb_keep" Style="{StaticResource Tick}"
                  Content="Keep the selection after nudging"/>
        <TextBlock Style="{StaticResource Hint}" Margin="23,-4,0,10"
                   Text="Press the button again, or its shortcut, and the same elements move again."/>

        <CheckBox x:Name="cb_loop" Style="{StaticResource Tick}"
                  Content="Keep clicking when nothing is selected"/>
        <TextBlock Style="{StaticResource Hint}" Margin="23,-4,0,10"
                   Text="Every element you click moves straight away. Escape ends the loop."/>

        <CheckBox x:Name="cb_fittings" Style="{StaticResource Tick}"
                  Content="Allow fittings, accessories and equipment"/>
        <TextBlock Style="{StaticResource Hint}" Margin="23,-4,0,10"
                   Text="Untick to restrict nudging to straight pipe, duct, tray and conduit."/>

        <CheckBox x:Name="cb_fab" Style="{StaticResource Tick}"
                  Content="Allow fabrication fittings, hangers and ancillary framing"/>
        <TextBlock Style="{StaticResource Hint}" Margin="23,-4,0,10"
                   Text="FAB ductwork, pipework and containment straights are always allowed. This adds their fittings, FAB hangers, and MEP ancillary framing - strut, channel and trapeze."/>

        <CheckBox x:Name="cb_rods" Style="{StaticResource Tick}"
                  Content="Re-cut hanger rods so their tops stay put"/>
        <TextBlock Style="{StaticResource Hint}" Margin="23,-4,0,0"
                   Text="Raising a FAB hanger shortens its manual rods, lowering lengthens them. Hosted rods re-solve themselves."/>

        <Border Height="1" Background="{StaticResource EdgeBrush}"
                Margin="0,15,0,13"/>

        <TextBlock Text="KEYBOARD SHORTCUTS" Style="{StaticResource SectionHead}"/>
        <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,9"
                   Text="Written straight into Revit's shortcuts file. Revit only reads that file at startup, so a restart is needed either way."/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="96"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Nudge Up"
                     Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
          <TextBox x:Name="ks_up" Grid.Row="0" Grid.Column="1"
                   Style="{StaticResource Entry}" Margin="0,0,0,6"
                   Padding="7,4" FontSize="12"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Nudge Down"
                     Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
          <TextBox x:Name="ks_down" Grid.Row="1" Grid.Column="1"
                   Style="{StaticResource Entry}" Margin="0,0,0,6"
                   Padding="7,4" FontSize="12"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Nudge Settings"
                     Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
          <TextBox x:Name="ks_settings" Grid.Row="2" Grid.Column="1"
                   Style="{StaticResource Entry}"
                   Padding="7,4" FontSize="12"/>
        </Grid>

        <TextBlock x:Name="ks_note" Style="{StaticResource Hint}"
                   Margin="0,8,0,0"
                   Text="Two or three letters each, no modifier needed. Leave blank for none."/>

        <Border Height="1" Background="{StaticResource EdgeBrush}"
                Margin="0,15,0,11"/>

        <TextBlock x:Name="status_tb" Style="{StaticResource Hint}"
                   Text="Increment applies to both Nudge Up and Nudge Down."/>

        <Grid Margin="0,13,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{StaticResource Secondary}"
                  Content="Reset" Click="reset_click"/>
          <Button Grid.Column="2" Style="{StaticResource Primary}"
                  Content="Save" Click="save_click"/>
        </Grid>

      </StackPanel>
    </StackPanel>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM QFR Remover"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Width="520"
        Height="620"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="12">

  <Window.Resources>

    <!-- softer, slightly faded blacks - matches the System Offset window -->
    <SolidColorBrush x:Key="Shell"     Color="#FF262A31"/>
    <SolidColorBrush x:Key="Panel"     Color="#FF2F343C"/>
    <SolidColorBrush x:Key="Sunken"    Color="#FF21252B"/>
    <SolidColorBrush x:Key="Edge"      Color="#FF3E444E"/>
    <SolidColorBrush x:Key="Ink"       Color="#FFEAEEF3"/>
    <SolidColorBrush x:Key="InkSoft"   Color="#FF9EA8B4"/>

    <!-- blue + orange -->
    <SolidColorBrush x:Key="Blue"      Color="#FF3D9BE9"/>
    <SolidColorBrush x:Key="BlueHi"    Color="#FF5CB2F5"/>
    <SolidColorBrush x:Key="BlueDim"   Color="#FF2A78BC"/>
    <SolidColorBrush x:Key="Orange"    Color="#FFF07C10"/>
    <SolidColorBrush x:Key="OrangeHi"  Color="#FFFF9736"/>
    <SolidColorBrush x:Key="OrangeDim" Color="#FFC5620A"/>

    <!-- tick boxes -->
    <Style x:Key="DarkCheck" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,3,0,3"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0">
                  <Rectangle x:Name="Box" RadiusX="2" RadiusY="2"
                             Stroke="#FF737D8A" StrokeThickness="1.2"
                             Fill="{StaticResource Sunken}"/>
                  <Path x:Name="Tick" Stretch="Uniform" Width="9" Height="9"
                        Stroke="{StaticResource Orange}" StrokeThickness="2"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                        StrokeLineJoin="Round" Visibility="Collapsed"
                        Data="M 0,5 L 4,9 L 11,0"/>
                </Grid>
                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="Stroke" Value="{StaticResource Orange}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="Stroke" Value="{StaticResource BlueHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- rows in the family list -->
    <Style x:Key="RowCheck" TargetType="CheckBox" BasedOn="{StaticResource DarkCheck}">
      <Setter Property="Margin" Value="10,0,10,0"/>
      <Setter Property="Padding" Value="0,6,0,6"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>

    <!-- primary action button -->
    <Style x:Key="RunButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="3"
                    Background="{StaticResource Orange}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource OrangeHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource OrangeDim}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#FF4A4F58"/>
                <Setter Property="Foreground" Value="#FF8B939E"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- quiet buttons -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="12,0,12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="3"
                    Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Edge}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Blue}"/>
                <Setter Property="Foreground" Value="{StaticResource BlueHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Sunken}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- window close glyph -->
    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource InkSoft}"/>
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="3">
              <Path Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                    Data="M 0,0 L 9,9 M 9,0 L 0,9"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#FFC0392B"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- dark text box -->
    <Style x:Key="DarkBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Sunken}"/>
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Ink}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5,7,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Chrome" CornerRadius="3"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Blue}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- dark scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="9"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Background="#FF4A505A" Margin="2,0,2,0"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border Background="{StaticResource Shell}" CornerRadius="5"
          BorderBrush="{StaticResource Edge}" BorderThickness="1">
    <Grid Margin="0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>   <!-- header      -->
        <RowDefinition Height="Auto"/>   <!-- search      -->
        <RowDefinition Height="*"/>      <!-- family list -->
        <RowDefinition Height="Auto"/>   <!-- options     -->
        <RowDefinition Height="Auto"/>   <!-- footer      -->
      </Grid.RowDefinitions>

      <!-- ============================ header ============================ -->
      <Grid x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource Shell}"
            Margin="0,0,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Image x:Name="BrandIcon" Grid.Column="0" Width="34" Height="34"
               Margin="16,14,10,10" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,0,8">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="RevoBIM" FontSize="21" FontWeight="Bold"
                       Foreground="{StaticResource Blue}"/>
            <TextBlock Text="QFR Remover" FontSize="15" FontWeight="SemiBold"
                       Foreground="{StaticResource Orange}"
                       VerticalAlignment="Bottom" Margin="8,0,0,3"/>
          </StackPanel>
          <TextBlock Text="Delete fittings and merge the runs back into one"
                     Foreground="{StaticResource InkSoft}" FontSize="11" Margin="1,2,0,0"/>
        </StackPanel>

        <Button x:Name="CloseBtn" Grid.Column="2" Style="{StaticResource CloseButton}"
                Margin="0,10,10,0" VerticalAlignment="Top"/>
      </Grid>

      <Rectangle Grid.Row="0" Height="2" VerticalAlignment="Bottom"
                 Fill="{StaticResource Orange}" Margin="16,0,16,0"/>

      <!-- ============================ search ============================ -->
      <Grid Grid.Row="1" Margin="16,14,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
          <TextBox x:Name="SearchBox" Style="{StaticResource DarkBox}"/>
          <TextBlock x:Name="SearchHint" Text="Search families..."
                     Foreground="#FF6E7885" IsHitTestVisible="False"
                     Margin="9,0,0,0" VerticalAlignment="Center"/>
        </Grid>

        <Button x:Name="AllBtn" Grid.Column="1" Content="All"
                Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
        <Button x:Name="NoneBtn" Grid.Column="2" Content="None"
                Style="{StaticResource GhostButton}" Margin="6,0,0,0"/>
      </Grid>

      <!-- ========================== family list ========================= -->
      <Border Grid.Row="2" Margin="16,0,16,10" CornerRadius="3"
              Background="{StaticResource Sunken}"
              BorderBrush="{StaticResource Edge}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Background="{StaticResource Panel}" Height="26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="132"/>
              <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="FAMILY" Margin="34,0,0,0" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="CATEGORY" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="QTY" FontSize="10"
                       FontWeight="SemiBold" Foreground="{StaticResource InkSoft}"
                       VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,12,0"/>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="FamilyList" Margin="0,6,0,6"/>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- =========================== options ============================ -->
      <StackPanel Grid.Row="3" Margin="16,0,16,10">
        <CheckBox x:Name="TrimChk" Style="{StaticResource DarkCheck}" IsChecked="True"
                  Content="Trim the runs together into one continuous element"/>
        <CheckBox x:Name="UnpinChk" Style="{StaticResource DarkCheck}" IsChecked="True"
                  Content="Unpin elements where needed (re-pinned afterwards)"/>
        <CheckBox x:Name="ViewChk" Style="{StaticResource DarkCheck}" IsChecked="True"
                  Content="Current view only (untick to sweep the whole project)"/>
      </StackPanel>

      <!-- ============================ footer ============================ -->
      <Grid Grid.Row="4" Background="{StaticResource Panel}" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="16,10,16,0"
                   Foreground="{StaticResource InkSoft}" TextWrapping="Wrap"
                   Text="Nothing selected."/>

        <Grid Grid.Row="1" Margin="16,10,16,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="RunBtn" Grid.Column="0" Style="{StaticResource RunButton}"
                  Content="Run QFR Remover" IsEnabled="False"/>
          <Button x:Name="CancelBtn" Grid.Column="1" Content="Cancel" Height="34"
                  Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
        </Grid>
      </Grid>

    </Grid>
  </Border>
</Window>

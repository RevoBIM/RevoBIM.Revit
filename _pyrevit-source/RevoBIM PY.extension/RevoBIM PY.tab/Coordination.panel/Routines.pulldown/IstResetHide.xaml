<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Reset Hide"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="True">

  <Border Background="{DynamicResource WindowBrush}" CornerRadius="6"
          BorderBrush="{DynamicResource ChromeBrush}" BorderThickness="1">
    <StackPanel>

      <!-- ============ header ============ -->
      <Border x:Name="HeaderBar" Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="12,7,8,7">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="HeaderIcon" Grid.Column="0" Width="22" Height="22"
                 Margin="0,0,8,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="15" FontWeight="Bold"
                       Foreground="{DynamicResource BlueBrush}"/>
            <TextBlock x:Name="ToolText" Text="Reset Hide" FontSize="12.5"
                       Margin="0,-2,0,0" Foreground="{DynamicResource OrangeBrush}"/>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="3" Content="Light"
                  Style="{DynamicResource IstChip}" Margin="0,0,8,0"
                  VerticalAlignment="Center"/>

          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v" FontSize="10.5"
                     Margin="0,0,6,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Button x:Name="CloseButton" Grid.Column="5" Content="&#x2715;"
                  Style="{DynamicResource IstCloseButton}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ============ the most recent hide ============ -->
      <Border Margin="12,12,12,8" Padding="12,10,12,12" CornerRadius="4"
              Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="ViewText" Text="Nothing hidden" FontSize="13.5"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource TextBrush}"/>
          <TextBlock x:Name="CountText" Text="Hide Service Type remembers what it hides here."
                     FontSize="11.5" Margin="0,2,0,10" TextWrapping="Wrap"
                     Foreground="{DynamicResource MutedBrush}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="MainButton" Grid.Column="0" Content="Reset Hide"
                    Style="{DynamicResource IstGreenButton}" MinHeight="34"
                    Margin="0,0,8,0"/>
            <Button x:Name="ForgetButton" Grid.Column="1" Content="Forget"
                    Style="{DynamicResource IstButton}" MinHeight="34"
                    ToolTip="Show it if it is hidden, then drop it from memory"/>
          </Grid>
          <Button x:Name="NewSelectionButton" Content="New selection..."
                  Style="{DynamicResource IstButton}" Margin="0,8,0,0"
                  ToolTip="Open the category list clean, to tick a new hide or pick another template"/>
        </StackPanel>
      </Border>

      <!-- ============ every other view with a remembered hide ============ -->
      <TextBlock x:Name="OthersLabel" Text="Other views" FontSize="11.5"
                 Margin="14,2,12,4" Foreground="{DynamicResource MutedBrush}"/>
      <ScrollViewer MaxHeight="220" Margin="12,0,12,8"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="OtherViews"/>
      </ScrollViewer>

      <!-- ============ footer ============ -->
      <Border Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6"
              Padding="12,8,12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="" FontSize="11"
                     VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
          <Button x:Name="ResetAllButton" Grid.Column="1" Content="Reset all"
                  Style="{DynamicResource IstChip}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

    </StackPanel>
  </Border>
</Window>

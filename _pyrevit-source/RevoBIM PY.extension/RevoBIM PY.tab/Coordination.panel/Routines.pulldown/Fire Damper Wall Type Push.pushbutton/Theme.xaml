<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ====================================================================
       RevoBIM shared theme. Every brush here is also written straight onto
       window.Resources at runtime, which sits in front of a merged
       dictionary in WPF's lookup order - that is what lets the palette be
       swapped on an open window with no reload and no loss of state.
       Layouts must reference these with DynamicResource only.
       ==================================================================== -->

  <SolidColorBrush x:Key="WindowBg" Color="#232326"/>
  <SolidColorBrush x:Key="CardBg" Color="#2B2B2E"/>
  <SolidColorBrush x:Key="FieldBg" Color="#1C1C1F"/>
  <SolidColorBrush x:Key="BarBg" Color="#1C1C1F"/>
  <SolidColorBrush x:Key="EdgeBrush" Color="#3E3E42"/>
  <SolidColorBrush x:Key="OuterEdgeBrush" Color="#4A4A50"/>
  <SolidColorBrush x:Key="BodyText" Color="#E4E4E4"/>
  <SolidColorBrush x:Key="MutedText" Color="#9A9A9E"/>
  <SolidColorBrush x:Key="BlueBrush" Color="#4FA3E3"/>
  <SolidColorBrush x:Key="OrangeBrush" Color="#E8912D"/>
  <SolidColorBrush x:Key="GreenBrush" Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHoverBrush" Color="#4EC06D"/>
  <SolidColorBrush x:Key="RedBrush" Color="#D9534F"/>
  <SolidColorBrush x:Key="SelectBrush" Color="#2B5473"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#33333A"/>
  <SolidColorBrush x:Key="RowChangeBg" Color="#3A2E1C"/>
  <SolidColorBrush x:Key="RowSameBg" Color="#1F2E23"/>
  <SolidColorBrush x:Key="RowReviewBg" Color="#3A2223"/>

  <!-- ====================================================================
       TextBox
       ==================================================================== -->
  <Style TargetType="TextBox" x:Key="RevoTextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource BodyText}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="5,3,5,3"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"
                          Background="Transparent"
                          Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource RevoTextBox}"/>

  <!-- ====================================================================
       ScrollBar
       ==================================================================== -->
  <Style x:Key="RevoScrollThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Background="#55555C" CornerRadius="3" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#6E6E77"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RevoScrollLine" TargetType="RepeatButton">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar" x:Key="RevoScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{DynamicResource RevoScrollLine}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{DynamicResource RevoScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{DynamicResource RevoScrollLine}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource RevoScrollBar}"/>

  <!-- ====================================================================
       ComboBox
       ==================================================================== -->
  <Style x:Key="RevoComboToggle" TargetType="ToggleButton">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd"
                  Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1"
                  CornerRadius="3">
            <Path x:Name="Arrow"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Margin="0,0,8,0"
                  Data="M 0 0 L 8 0 L 4 5 Z"
                  Fill="{DynamicResource MutedText}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem" x:Key="RevoComboItem">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="Padding" Value="7,4,7,4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource RevoComboItem}"/>

  <Style TargetType="ComboBox" x:Key="RevoCombo">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Grid.Column="2"
                          Style="{DynamicResource RevoComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="ContentSite"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="8,0,24,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"/>
            <Popup x:Name="PART_Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Slide">
              <Border x:Name="DropDownBorder"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource CardBg}"
                      BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="1"
                      CornerRadius="3">
                <ScrollViewer SnapsToDevicePixels="True">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource RevoCombo}"/>

  <!-- ====================================================================
       CheckBox
       ==================================================================== -->
  <Style TargetType="CheckBox" x:Key="RevoCheck">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box"
                    Width="14" Height="14"
                    Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="2">
              <Path x:Name="Tick"
                    Data="M 2 6 L 5 9 L 11 2"
                    Stroke="{DynamicResource BlueBrush}"
                    StrokeThickness="2"
                    Visibility="Collapsed"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource RevoCheck}"/>

  <!-- ====================================================================
       RadioButton
       ==================================================================== -->
  <Style TargetType="RadioButton" x:Key="RevoRadio">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Ring"
                    Width="13" Height="13"
                    Margin="0,0,7,0"
                    VerticalAlignment="Center"
                    CornerRadius="7"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1">
              <Ellipse x:Name="Dot"
                       Width="7" Height="7"
                       Fill="{DynamicResource BlueBrush}"
                       Visibility="Collapsed"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource RevoRadio}"/>

  <!-- ====================================================================
       Buttons
       ==================================================================== -->
  <Style TargetType="Button" x:Key="RevoButton">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="14,5,14,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
              <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource RevoButton}"/>

  <Style TargetType="Button" x:Key="RevoGreenButton" BasedOn="{StaticResource RevoButton}">
    <Setter Property="Background" Value="{DynamicResource GreenBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource GreenHoverBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource GreenHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" x:Key="RevoOrangeButton" BasedOn="{StaticResource RevoButton}">
    <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
  </Style>

  <Style TargetType="Button" x:Key="RevoCloseButton">
    <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RedBrush}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" x:Key="RevoChipButton">
    <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="9,2,9,2"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="Transparent"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================================================================
       Resize grips and the splitter.

       A WindowStyle="None" + AllowsTransparency="True" window has no frame to
       hit test, so the grips ARE the frame: invisible thumbs that still take
       the mouse because their background is Transparent rather than null.
       ==================================================================== -->
  <Style TargetType="Thumb" x:Key="ResizeGrip">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="GridSplitter" x:Key="RevoSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GridSplitter">
          <Border x:Name="Bd" Background="Transparent">
            <Border x:Name="Grip"
                    Width="2"
                    Margin="0,26,0,26"
                    CornerRadius="1"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource EdgeBrush}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Grip" Property="Background" Value="{DynamicResource BlueBrush}"/>
              <Setter TargetName="Grip" Property="Width" Value="3"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Grip" Property="Background" Value="{DynamicResource BlueBrush}"/>
              <Setter TargetName="Grip" Property="Width" Value="3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================================================================
       ToolTip
       ==================================================================== -->
  <Style TargetType="ToolTip" x:Key="RevoToolTip">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource CardBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="7,4,7,4">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ToolTip" BasedOn="{StaticResource RevoToolTip}"/>

  <!-- ====================================================================
       Cards, section headings and text
       ==================================================================== -->
  <Style TargetType="Border" x:Key="CardBorder">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="12"/>
  </Style>

  <Style TargetType="TextBlock" x:Key="LabelText">
    <Setter Property="Foreground" Value="{DynamicResource MutedText}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>

  <Style TargetType="TextBlock" x:Key="BodyTextStyle">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style TargetType="TextBlock" x:Key="SectionText">
    <Setter Property="Foreground" Value="{DynamicResource BodyText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style TargetType="Border" x:Key="BlueTick">
    <Setter Property="Background" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Width" Value="4"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style TargetType="Border" x:Key="OrangeTick" BasedOn="{StaticResource BlueTick}">
    <Setter Property="Background" Value="{DynamicResource OrangeBrush}"/>
  </Style>

</ResourceDictionary>

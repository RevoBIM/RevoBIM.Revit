<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM"
        Height="330" Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

  <Border CornerRadius="6"
          BorderThickness="1"
          BorderBrush="{DynamicResource OuterEdgeBrush}"
          Background="{DynamicResource WindowBg}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="46"/>
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBar" Grid.Row="0"
              Background="{DynamicResource BarBg}"
              CornerRadius="6,6,0,0">
        <Grid Margin="12,0,8,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="RevoBIM"
                     FontSize="17"
                     FontWeight="Bold"
                     Foreground="{DynamicResource BlueBrush}"
                     VerticalAlignment="Center"/>

          <TextBlock x:Name="TxtTitle" Grid.Column="1"
                     Text="Result"
                     FontSize="13"
                     Margin="8,2,0,0"
                     Foreground="{DynamicResource OrangeBrush}"
                     VerticalAlignment="Center"/>

          <TextBlock x:Name="TxtVersion" Grid.Column="3"
                     Text="v0.0.0"
                     FontSize="11"
                     Margin="0,0,10,0"
                     Foreground="{DynamicResource MutedText}"
                     VerticalAlignment="Center"/>

          <Button x:Name="BtnClose" Grid.Column="4"
                  Content="&#x2715;"
                  Style="{DynamicResource RevoCloseButton}"
                  VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Margin="14,12,14,6"
              Background="{DynamicResource FieldBg}"
              BorderBrush="{DynamicResource EdgeBrush}"
              BorderThickness="1"
              CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10,10,10">
          <TextBlock x:Name="TxtBody"
                     Text=""
                     FontSize="12"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource BodyText}"/>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="2"
              Background="{DynamicResource BarBg}"
              CornerRadius="0,0,6,6">
        <Button x:Name="BtnOk"
                Content="OK"
                Style="{DynamicResource RevoGreenButton}"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,14,0"/>
      </Border>
    </Grid>
  </Border>
</Window>

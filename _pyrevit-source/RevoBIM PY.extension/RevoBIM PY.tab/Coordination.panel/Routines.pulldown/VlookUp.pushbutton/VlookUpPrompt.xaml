<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM VlookUp"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

  <Border Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource BorderOuter}"
          BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BgBar}" CornerRadius="5,5,0,0"
              BorderBrush="{DynamicResource BorderEdge}" BorderThickness="0,0,0,1">
        <Grid Margin="12,7,8,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TitleLabel" Grid.Column="0" Text="VlookUp"
                     Style="{DynamicResource HeaderTool}" VerticalAlignment="Center"/>
          <Button x:Name="CloseBtn" Grid.Column="1" Style="{DynamicResource CloseButton}" Content="&#x2715;"/>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="14,14,14,4">
        <TextBlock x:Name="MessageLabel" Style="{DynamicResource BodyText}" TextWrapping="Wrap"/>
        <TextBox x:Name="InputBox" Style="{DynamicResource DarkTextBox}" Height="26" Margin="0,10,0,0"
                 VerticalContentAlignment="Center" Visibility="Collapsed"/>
      </StackPanel>

      <Border Grid.Row="2" Background="{DynamicResource BgBar}" CornerRadius="0,0,5,5"
              BorderBrush="{DynamicResource BorderEdge}" BorderThickness="0,1,0,0" Margin="0,12,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,8">
          <Button x:Name="CancelBtn" Style="{DynamicResource FlatButton}" Content="Cancel" Height="26"/>
          <Button x:Name="OkBtn" Style="{DynamicResource GreenButton}" Content="OK" Margin="8,0,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>

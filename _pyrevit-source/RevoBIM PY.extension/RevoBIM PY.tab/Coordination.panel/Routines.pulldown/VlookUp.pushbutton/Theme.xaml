<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ============================ palette ============================ -->
  <SolidColorBrush x:Key="BgWindow"     Color="#232326"/>
  <SolidColorBrush x:Key="BgCard"       Color="#2B2B2E"/>
  <SolidColorBrush x:Key="BgField"      Color="#1C1C1F"/>
  <SolidColorBrush x:Key="BgBar"        Color="#1C1C1F"/>
  <SolidColorBrush x:Key="BorderEdge"   Color="#3E3E42"/>
  <SolidColorBrush x:Key="BorderOuter"  Color="#4A4A50"/>
  <SolidColorBrush x:Key="TextBody"     Color="#E4E4E4"/>
  <SolidColorBrush x:Key="TextMuted"    Color="#9A9A9E"/>
  <SolidColorBrush x:Key="AccentBlue"   Color="#4FA3E3"/>
  <SolidColorBrush x:Key="AccentOrange" Color="#E8912D"/>
  <SolidColorBrush x:Key="ActionGreen"  Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHover"   Color="#4EC06D"/>
  <SolidColorBrush x:Key="WarnRed"      Color="#D9534F"/>
  <SolidColorBrush x:Key="SelectHigh"   Color="#2B5473"/>
  <SolidColorBrush x:Key="Transparent0" Color="#00000000"/>

  <!-- ============================ scroll bars ============================ -->
  <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="tb" Background="#4A4A50" CornerRadius="4" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="tb" Property="Background" Value="#6A6A72"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="tb" Property="Background" Value="#4FA3E3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="#00000000"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkScrollBarV" TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Width" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="#1C1C1F">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkScrollBarH" TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Height" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="#1C1C1F">
            <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPageButton}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPageButton}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkScrollViewer" TargetType="ScrollViewer">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="#00000000"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0"
                                    CanContentScroll="{TemplateBinding CanContentScroll}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Orientation="Vertical"
                       Style="{StaticResource DarkScrollBarV}"
                       Value="{TemplateBinding VerticalOffset}"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                       Style="{StaticResource DarkScrollBarH}"
                       Value="{TemplateBinding HorizontalOffset}"
                       Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ buttons ============================ -->
  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="12,5,12,5"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="#33333A" BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#3E3E47"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#4FA3E3"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2A2A31"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="#2A2A2D"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#3A3A3E"/>
              <Setter Property="Foreground" Value="#66666A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GreenButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,6,16,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="#3FA75A" BorderBrush="#3FA75A" BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#4EC06D"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#4EC06D"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#33874A"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="#2F3A33"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#3A4740"/>
              <Setter Property="Foreground" Value="#77807A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="OrangeButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#1C1C1F"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="16,6,16,6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="#E8912D" BorderBrush="#E8912D" BorderThickness="1" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#F2A247"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#F2A247"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#C4761E"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="#3A352E"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="#463F35"/>
              <Setter Property="Foreground" Value="#807A70"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CloseButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#9A9A9E"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="#00000000" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#D9534F"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- column header button used in the spreadsheet preview -->
  <Style x:Key="ColHeaderButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="#33333A" BorderBrush="#3E3E42" BorderThickness="0,0,1,1">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,3,6,3"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2B5473"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ text box ============================ -->
  <Style x:Key="DarkTextBox" TargetType="TextBox">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="CaretBrush" Value="#E4E4E4"/>
    <Setter Property="SelectionBrush" Value="#2B5473"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="6,4,6,4"/>
    <Setter Property="AllowDrop" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="#1C1C1F" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#4FA3E3"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#66666A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ combo box ============================ -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="#1C1C1F" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
              </Grid.ColumnDefinitions>
              <Path x:Name="ar" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M 0 0 L 8 0 L 4 5 Z" Fill="#9A9A9E"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="#4FA3E3"/>
              <Setter TargetName="ar" Property="Fill" Value="#4FA3E3"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="#232326"/>
              <Setter TargetName="ar" Property="Fill" Value="#55555A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="#00000000" Padding="7,4,7,4" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2B5473"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2B5473"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkCombo" TargetType="ComboBox">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MaxDropDownHeight" Value="320"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_Toggle" Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="7,0,22,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
              <Border Background="#232326" BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="3"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Margin="1">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#66666A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ check box ============================ -->
  <Style x:Key="DarkCheck" TargetType="CheckBox">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="#00000000">
            <Border x:Name="box" Width="14" Height="14" CornerRadius="2" Background="#1C1C1F"
                    BorderBrush="#5A5A60" BorderThickness="1" VerticalAlignment="Center">
              <Path x:Name="tick" Data="M 1.5 5 L 4.5 8.5 L 10 1.5" Stroke="#4FA3E3" StrokeThickness="1.8"
                    Visibility="Collapsed" SnapsToDevicePixels="True"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="BorderBrush" Value="#4FA3E3"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="#4FA3E3"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#66666A"/>
              <Setter TargetName="box" Property="BorderBrush" Value="#3E3E42"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkRadio" TargetType="RadioButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="#00000000">
            <Border x:Name="box" Width="14" Height="14" CornerRadius="7" Background="#1C1C1F"
                    BorderBrush="#5A5A60" BorderThickness="1" VerticalAlignment="Center">
              <Ellipse x:Name="dot" Width="6" Height="6" Fill="#4FA3E3" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="BorderBrush" Value="#4FA3E3"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="#4FA3E3"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ list box ============================ -->
  <Style x:Key="DarkListItem" TargetType="ListBoxItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="#00000000" Padding="6,3,6,3" SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2E2E33"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#2B5473"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DarkListBox" TargetType="ListBox">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="#1C1C1F"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkListItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="3">
            <ScrollViewer Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Margin="1" Focusable="False">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ tool tip ============================ -->
  <Style x:Key="DarkToolTip" TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Foreground" Value="#E4E4E4"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="#1C1C1F" BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="3" Padding="7,4,7,4">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ text styles ============================ -->
  <Style x:Key="HeaderBrand" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style x:Key="HeaderTool" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style x:Key="VersionText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="FontSize" Value="11.5"/>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SectionLabelBlue" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SectionLabelOrange" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentOrange}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TickBlue" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
    <Setter Property="Width" Value="4"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TickOrange" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AccentOrange}"/>
    <Setter Property="Width" Value="4"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="10"/>
  </Style>

</ResourceDictionary>

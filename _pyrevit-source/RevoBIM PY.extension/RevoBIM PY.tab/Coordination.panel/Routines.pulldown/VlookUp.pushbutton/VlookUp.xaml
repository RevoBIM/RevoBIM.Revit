<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM VlookUp"
        Width="1220" Height="790" MinWidth="1020" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

  <Border Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource BorderOuter}"
          BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ============================ header ============================ -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BgBar}" CornerRadius="5,5,0,0"
              BorderBrush="{DynamicResource BorderEdge}" BorderThickness="0,0,0,1">
        <Grid Margin="12,8,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="IconImage" Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0"
                 VerticalAlignment="Center" Stretch="Uniform"/>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" Style="{DynamicResource HeaderBrand}"/>
            <TextBlock Text="VlookUp" Style="{DynamicResource HeaderTool}" Margin="1,-3,0,0"/>
          </StackPanel>

          <TextBlock x:Name="VersionLabel" Grid.Column="3" Style="{DynamicResource VersionText}"
                     VerticalAlignment="Top" Margin="0,2,10,0" Text="v0.0.0"/>

          <Button x:Name="CloseBtn" Grid.Column="4" Style="{DynamicResource CloseButton}"
                  Content="&#x2715;" VerticalAlignment="Top"/>
        </Grid>
      </Border>

      <!-- ============================ source + scope ============================ -->
      <Grid Grid.Row="1" Margin="10,10,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- spreadsheet card -->
        <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0,0,5,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
              <Border Style="{DynamicResource TickBlue}"/>
              <TextBlock Text="Spreadsheet" Style="{DynamicResource SectionLabelBlue}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="File" Style="{DynamicResource FieldLabel}" Margin="0,0,8,0"/>
              <TextBox x:Name="FilePathBox" Grid.Column="1" Style="{DynamicResource DarkTextBox}"
                       IsReadOnly="True" Height="24" VerticalContentAlignment="Center"/>
              <Button x:Name="BrowseBtn" Grid.Column="2" Style="{DynamicResource FlatButton}"
                      Content="Browse" Margin="6,0,0,0" Height="24"/>
              <Button x:Name="ReloadBtn" Grid.Column="3" Style="{DynamicResource FlatButton}"
                      Content="Reload" Margin="5,0,0,0" Height="24"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.4*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Sheet" Style="{DynamicResource FieldLabel}" Margin="0,0,8,0"/>
              <ComboBox x:Name="SheetCombo" Grid.Column="1" Style="{DynamicResource DarkCombo}"/>
              <TextBlock Grid.Column="2" Text="Header row" Style="{DynamicResource FieldLabel}" Margin="10,0,6,0"/>
              <TextBox x:Name="HeaderRowBox" Grid.Column="3" Style="{DynamicResource DarkTextBox}"
                       Width="38" Height="24" Text="1" VerticalContentAlignment="Center"/>
              <TextBlock Grid.Column="4" Text="Lookup column" Style="{DynamicResource FieldLabel}" Margin="10,0,6,0"/>
              <ComboBox x:Name="LookupCombo" Grid.Column="5" Style="{DynamicResource DarkCombo}"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,2,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <CheckBox x:Name="IgnoreCaseChk" Grid.Column="0" Style="{DynamicResource DarkCheck}"
                        Content="Ignore case" IsChecked="True"/>
              <CheckBox x:Name="TrimChk" Grid.Column="1" Style="{DynamicResource DarkCheck}"
                        Content="Trim spaces" IsChecked="True" Margin="14,0,0,0"/>
              <CheckBox x:Name="NumericChk" Grid.Column="2" Style="{DynamicResource DarkCheck}"
                        Content="Number-aware" IsChecked="True" Margin="14,0,0,0"/>
              <TextBlock Grid.Column="3" Text="Duplicate keys" Style="{DynamicResource FieldLabel}"
                         HorizontalAlignment="Right" Margin="14,0,6,0"/>
              <ComboBox x:Name="DuplicateCombo" Grid.Column="4" Style="{DynamicResource DarkCombo}" Width="130"/>
            </Grid>

            <TextBlock x:Name="SheetInfoLabel" Grid.Row="4" Style="{DynamicResource MutedText}"
                       Text="No spreadsheet loaded." TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
          </Grid>
        </Border>

        <!-- model card -->
        <Border Grid.Column="1" Style="{DynamicResource CardBorder}" Margin="5,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
              <Border Style="{DynamicResource TickOrange}"/>
              <TextBlock Text="Model" Style="{DynamicResource SectionLabelOrange}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1.3*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Scope" Style="{DynamicResource FieldLabel}" Margin="0,0,8,0"/>
              <ComboBox x:Name="ScopeCombo" Grid.Column="1" Style="{DynamicResource DarkCombo}"/>
              <TextBlock Grid.Column="2" Text="Key parameter" Style="{DynamicResource FieldLabel}" Margin="10,0,6,0"/>
              <ComboBox x:Name="KeyParamCombo" Grid.Column="3" Style="{DynamicResource DarkCombo}"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Categories" Style="{DynamicResource FieldLabel}" Margin="0,0,8,0"/>
              <TextBox x:Name="CatSearchBox" Grid.Column="1" Style="{DynamicResource DarkTextBox}"
                       Height="22" VerticalContentAlignment="Center"/>
              <Button x:Name="CatAllBtn" Grid.Column="2" Style="{DynamicResource FlatButton}"
                      Content="All" Margin="6,0,0,0" Height="22" Padding="10,2,10,2"/>
              <Button x:Name="CatNoneBtn" Grid.Column="3" Style="{DynamicResource FlatButton}"
                      Content="None" Margin="5,0,0,0" Height="22" Padding="10,2,10,2"/>
            </Grid>

            <Border Grid.Row="3" Background="{DynamicResource BgField}" BorderBrush="{DynamicResource BorderEdge}"
                    BorderThickness="1" CornerRadius="3" Height="74">
              <ScrollViewer x:Name="CatScroller" Style="{DynamicResource DarkScrollViewer}"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="1">
                <StackPanel x:Name="CatPanel" Margin="6,4,6,4"/>
              </ScrollViewer>
            </Border>

            <TextBlock x:Name="ScopeInfoLabel" Grid.Row="4" Style="{DynamicResource MutedText}"
                       Text="Nothing scoped yet." TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ============================ preview + mapping ============================ -->
      <Grid Grid.Row="2" Margin="10,10,10,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Margin="0,0,5,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal">
                <Border Style="{DynamicResource TickBlue}"/>
                <TextBlock Text="Spreadsheet preview" Style="{DynamicResource SectionLabelBlue}"/>
              </StackPanel>
              <TextBlock x:Name="PreviewHintLabel" Style="{DynamicResource MutedText}"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Text="Click a column header to use it as the lookup column."/>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BgField}" BorderBrush="{DynamicResource BorderEdge}"
                    BorderThickness="1" CornerRadius="3">
              <ScrollViewer x:Name="PreviewScroller" Style="{DynamicResource DarkScrollViewer}"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="1">
                <Grid x:Name="PreviewGrid" Margin="0"/>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="1" Style="{DynamicResource CardBorder}" Margin="5,0,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal">
                <Border Style="{DynamicResource TickOrange}"/>
                <TextBlock Text="Column to parameter" Style="{DynamicResource SectionLabelOrange}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AutoMatchBtn" Style="{DynamicResource FlatButton}" Content="Auto-match"
                        Height="22" Padding="9,2,9,2"/>
                <Button x:Name="ClearMapBtn" Style="{DynamicResource FlatButton}" Content="Clear"
                        Height="22" Padding="9,2,9,2" Margin="5,0,0,0"/>
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Spreadsheet column" Style="{DynamicResource FieldLabel}"/>
              <TextBlock Grid.Column="1" Text="Revit parameter" Style="{DynamicResource FieldLabel}"
                         Width="228" Margin="8,0,0,0"/>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource BgField}" BorderBrush="{DynamicResource BorderEdge}"
                    BorderThickness="1" CornerRadius="3">
              <ScrollViewer x:Name="MappingScroller" Style="{DynamicResource DarkScrollViewer}"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="1">
                <StackPanel x:Name="MappingPanel" Margin="6,5,6,5"/>
              </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,7,0,0">
              <CheckBox x:Name="SkipBlanksChk" Style="{DynamicResource DarkCheck}"
                        Content="Skip blank cells" IsChecked="True"/>
              <CheckBox x:Name="TypeParamsChk" Style="{DynamicResource DarkCheck}"
                        Content="Offer type parameters" IsChecked="False" Margin="14,0,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ============================ footer ============================ -->
      <Border Grid.Row="3" Background="{DynamicResource BgBar}" CornerRadius="0,0,5,5"
              BorderBrush="{DynamicResource BorderEdge}" BorderThickness="0,1,0,0" Margin="0,10,0,0">
        <Grid Margin="12,8,12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="StatusLabel" Grid.Column="0" Style="{DynamicResource MutedText}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="Ready."/>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock Text="Profile" Style="{DynamicResource FieldLabel}" Margin="0,0,6,0"/>
            <ComboBox x:Name="ProfileCombo" Style="{DynamicResource DarkCombo}" Width="150"/>
            <Button x:Name="SaveProfileBtn" Style="{DynamicResource FlatButton}" Content="Save"
                    Height="24" Padding="10,3,10,3" Margin="5,0,0,0"/>
            <Button x:Name="DeleteProfileBtn" Style="{DynamicResource FlatButton}" Content="Delete"
                    Height="24" Padding="10,3,10,3" Margin="5,0,0,0"/>
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="PreviewBtn" Style="{DynamicResource OrangeButton}" Content="Check matches"
                    IsEnabled="False"/>
            <Button x:Name="ApplyBtn" Style="{DynamicResource GreenButton}" Content="Apply"
                    Margin="8,0,0,0" IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM VlookUp results"
        Width="760" Height="620" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

  <Border Background="{DynamicResource BgWindow}" BorderBrush="{DynamicResource BorderOuter}"
          BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BgBar}" CornerRadius="5,5,0,0"
              BorderBrush="{DynamicResource BorderEdge}" BorderThickness="0,0,0,1">
        <Grid Margin="12,8,8,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" Style="{DynamicResource HeaderBrand}"/>
            <TextBlock x:Name="SubTitleLabel" Text="VlookUp results" Style="{DynamicResource HeaderTool}"
                       Margin="1,-3,0,0"/>
          </StackPanel>
          <TextBlock x:Name="VersionLabel" Grid.Column="2" Style="{DynamicResource VersionText}"
                     VerticalAlignment="Top" Margin="0,2,10,0" Text="v0.0.0"/>
          <Button x:Name="CloseBtn" Grid.Column="3" Style="{DynamicResource CloseButton}"
                  Content="&#x2715;" VerticalAlignment="Top"/>
        </Grid>
      </Border>

      <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Margin="10,10,10,0">
        <TextBlock x:Name="SummaryLabel" Style="{DynamicResource BodyText}" TextWrapping="Wrap"/>
      </Border>

      <Border Grid.Row="2" Background="{DynamicResource BgField}" BorderBrush="{DynamicResource BorderEdge}"
              BorderThickness="1" CornerRadius="4" Margin="10,10,10,0">
        <ScrollViewer x:Name="BodyScroller" Style="{DynamicResource DarkScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="1">
          <StackPanel x:Name="BodyPanel" Margin="10,8,10,10"/>
        </ScrollViewer>
      </Border>

      <Border Grid.Row="3" Background="{DynamicResource BgBar}" CornerRadius="0,0,5,5"
              BorderBrush="{DynamicResource BorderEdge}" BorderThickness="0,1,0,0" Margin="0,10,0,0">
        <Grid Margin="12,8,12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="FooterLabel" Grid.Column="0" Style="{DynamicResource MutedText}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text=""/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="CopyBtn" Style="{DynamicResource FlatButton}" Content="Copy" Height="26"/>
            <Button x:Name="SaveBtn" Style="{DynamicResource FlatButton}" Content="Save as text"
                    Height="26" Margin="6,0,0,0"/>
            <Button x:Name="OkBtn" Style="{DynamicResource GreenButton}" Content="Close" Margin="8,0,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

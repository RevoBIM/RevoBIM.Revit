<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Param Push" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" MinWidth="1040" MinHeight="620"
        FontFamily="Segoe UI" FontSize="12">
  <Border x:Name="root_border" Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="6">
    <Grid x:Name="root_grid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="header_bar" Grid.Row="0" Background="{DynamicResource TitleBgBrush}"
              CornerRadius="6,6,0,0" Padding="10,7">
        <DockPanel>
          <Image x:Name="logo_img" Width="28" Height="28" Margin="0,0,8,0" DockPanel.Dock="Left"/>
          <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}" FontSize="20"
                     FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBlock x:Name="txt_title" Text="Family Param Push" Foreground="{DynamicResource OrangeBrush}"
                     FontSize="15" Margin="9,3,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
            <Button x:Name="btn_theme" Style="{DynamicResource ChipBtn}" ToolTip="Theme: Auto follows Revit's canvas">
              <TextBlock x:Name="txt_theme" Text="Auto"/>
            </Button>
            <TextBlock x:Name="txt_version" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,6,0"/>
            <Button x:Name="shrink_btn" Style="{DynamicResource WinBtn}" ToolTip="Shrink to taskbar (Ctrl+Shift+H)">
              <Grid>
                <Path x:Name="shrink_glyph" Data="M6,0 L6,8 M2,5 L6,9 L10,5 M0,12 L12,12"
                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"/>
                <Path x:Name="expand_glyph" Data="M6,12 L6,2 M1,7 L6,1 L11,7"
                      Stroke="{DynamicResource GreenBrush}" StrokeThickness="2.2" Visibility="Collapsed"/>
              </Grid>
            </Button>
          <Button x:Name="btn_full" Style="{DynamicResource WinBtn}" ToolTip="Full screen (F11)">
            <Border Width="11" Height="11" BorderBrush="{DynamicResource TextBrush}" BorderThickness="1.4"/>
          </Button>
            <Button x:Name="btn_close" Style="{DynamicResource CloseBtn}" ToolTip="Close">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <StackPanel x:Name="tab_strip" Grid.Row="1" Orientation="Horizontal" Margin="10,6,10,0">
        <Button x:Name="btn_tab_push" Content="Family Param - Push" Style="{DynamicResource TabBtn}" Tag="on"/>
        <Button x:Name="btn_tab_replace" Content="Family Param - Replace" Style="{DynamicResource TabBtn}"/>
      </StackPanel>

      <Grid x:Name="body_grid" Grid.Row="2" Margin="10,10,10,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="330"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="1.7*" MinWidth="560"/>
        </Grid.ColumnDefinitions>

        <!-- ===== left: families ===== -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,7">
            <Button x:Name="btn_reload" Content="Reload" Style="{DynamicResource GhostBtn}" Padding="9,3"
                    DockPanel.Dock="Right" ToolTip="Read the families again"/>
            <TextBlock x:Name="txt_count" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                       Margin="0,0,4,0" DockPanel.Dock="Right"/>
            <StackPanel Orientation="Horizontal">
              <Border Width="4" Height="15" Background="{DynamicResource BlueBrush}" Margin="0,0,7,0"/>
              <TextBlock Text="Families" Style="{DynamicResource SectionTitle}"/>
            </StackPanel>
          </DockPanel>
          <ComboBox x:Name="combo_category" Grid.Row="1" Margin="0,0,0,6"/>
          <TextBox x:Name="txt_search" Grid.Row="2" Tag="Search families and types" Margin="0,0,0,6"/>
          <DataGrid x:Name="grid_left" Grid.Row="3" Style="{DynamicResource ThemedGrid}" SelectionMode="Extended"/>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

        <!-- ===== right ===== -->
        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,70,8,0">
            <Button x:Name="btn_push" Style="{DynamicResource BlueBtn}" Margin="0,0,0,8" Padding="0,10"
                    ToolTip="Push the selected families and types across">
              <Path Data="M0,8 L18,8 M11,1 L18,8 L11,15" Stroke="White" StrokeThickness="2.4"/>
            </Button>
            <Button x:Name="btn_back" Style="{DynamicResource GhostBtn}" Margin="0" Padding="0,10"
                    ToolTip="Take the selected rows back off">
              <Path Data="M18,8 L0,8 M7,1 L0,8 L7,15" Stroke="{DynamicResource TextBrush}" StrokeThickness="2.4"/>
            </Button>
          </StackPanel>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="1*" MinHeight="96"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="1.5*" MinHeight="140"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="1*" MinHeight="90"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
              <Border Width="4" Height="15" Background="{DynamicResource OrangeBrush}" Margin="0,0,7,0"/>
              <TextBlock Text="Selected families and types" Style="{DynamicResource SectionTitle}"/>
            </StackPanel>
            <DataGrid x:Name="grid_right" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Extended"/>
            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <DockPanel Grid.Row="3" Margin="0,2,0,6">
              <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="15" Background="{DynamicResource GreenBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="Parameter mapping" Style="{DynamicResource SectionTitle}"/>
                <TextBlock x:Name="txt_focus" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
            <Grid Grid.Row="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="search_source" Tag="Search source parameters" Margin="0,0,0,4"/>
                <DataGrid x:Name="grid_source" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Single"/>
              </Grid>
              <Button x:Name="btn_add" Grid.Column="1" Style="{DynamicResource GreenBtn}" Margin="8,0" Padding="9,10"
                      VerticalAlignment="Center" ToolTip="Add this mapping (or double-click the target)">
                <StackPanel>
                  <Path Data="M0,8 L22,8 M15,1 L22,8 L15,15" Stroke="White" StrokeThickness="2.4" HorizontalAlignment="Center"/>
                  <TextBlock Text="Map" Foreground="White" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="search_target" Tag="Search target parameters (writable)" Margin="0,0,0,4"/>
                <DataGrid x:Name="grid_target" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Single"/>
              </Grid>
            </Grid>
            <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Row="6">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,5">
                <Button x:Name="btn_unmap" Content="Remove Mapping" Style="{DynamicResource OrangeBtn}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                  <ComboBox x:Name="combo_sets" Width="170" Height="26" ToolTip="Saved mappings"/>
                  <Button x:Name="btn_load_set" Content="Load" Style="{DynamicResource GhostBtn}" Padding="10,3" ToolTip="Add this saved set to the right"/>
                  <Button x:Name="btn_delete_set" Content="Delete" Style="{DynamicResource GhostBtn}" Padding="10,3" ToolTip="Delete this saved set"/>
                  <Button x:Name="btn_save_set" Content="Save Mappings" Style="{DynamicResource BlueBtn}" Padding="10,3" ToolTip="Save everything mapped on the right as a named set"/>
                </StackPanel>
                <TextBlock Text="Mappings" Style="{DynamicResource SectionTitle}"/>
              </DockPanel>
              <DataGrid x:Name="grid_maps" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Extended"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <!-- ===== replace tab ===== -->
      <Grid x:Name="body_replace" Grid.Row="2" Margin="10,10,10,8" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="330"/>
          <ColumnDefinition Width="6"/>
          <ColumnDefinition Width="1.7*" MinWidth="560"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,7">
            <Button x:Name="btn_rreload" Content="Reload" Style="{DynamicResource GhostBtn}" Padding="9,3"
                    DockPanel.Dock="Right" ToolTip="Read the families and the shared parameter file again"/>
            <TextBlock x:Name="txt_rcount" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                       Margin="0,0,4,0" DockPanel.Dock="Right"/>
            <StackPanel Orientation="Horizontal">
              <Border Width="4" Height="15" Background="{DynamicResource BlueBrush}" Margin="0,0,7,0"/>
              <TextBlock Text="Loadable families" Style="{DynamicResource SectionTitle}"/>
            </StackPanel>
          </DockPanel>
          <ComboBox x:Name="combo_rcategory" Grid.Row="1" Margin="0,0,0,6"/>
          <TextBox x:Name="txt_rsearch" Grid.Row="2" Tag="Search families" Margin="0,0,0,6"/>
          <DataGrid x:Name="grid_rleft" Grid.Row="3" Style="{DynamicResource ThemedGrid}" SelectionMode="Extended"/>
        </Grid>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Grid Grid.Column="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,70,8,0">
            <Button x:Name="btn_rpush" Style="{DynamicResource BlueBtn}" Margin="0,0,0,8" Padding="0,10"
                    ToolTip="Push the selected families across">
              <Path Data="M0,8 L18,8 M11,1 L18,8 L11,15" Stroke="White" StrokeThickness="2.4"/>
            </Button>
            <Button x:Name="btn_rback" Style="{DynamicResource GhostBtn}" Margin="0" Padding="0,10"
                    ToolTip="Take the selected families back off">
              <Path Data="M18,8 L0,8 M7,1 L0,8 L7,15" Stroke="{DynamicResource TextBrush}" StrokeThickness="2.4"/>
            </Button>
          </StackPanel>
          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="0.8*" MinHeight="90"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="1.5*" MinHeight="140"/>
              <RowDefinition Height="6"/>
              <RowDefinition Height="0.9*" MinHeight="90"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,3,0,10">
              <Border Width="4" Height="15" Background="{DynamicResource OrangeBrush}" Margin="0,0,7,0"/>
              <TextBlock Text="Selected families" Style="{DynamicResource SectionTitle}"/>
            </StackPanel>
            <DataGrid x:Name="grid_rright" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Extended"/>
            <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <DockPanel Grid.Row="3" Margin="0,2,0,6">
              <TextBlock x:Name="txt_rfile" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right" Margin="10,0,0,0"
                         MaxWidth="340" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal">
                <Border Width="4" Height="15" Background="{DynamicResource GreenBrush}" Margin="0,0,7,0"/>
                <TextBlock Text="Replace with shared parameter" Style="{DynamicResource SectionTitle}"/>
                <TextBlock x:Name="txt_rfocus" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </DockPanel>
            <Grid Grid.Row="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="search_rsource" Tag="Search family parameters" Margin="0,0,0,4"/>
                <DataGrid x:Name="grid_rsource" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Single"/>
              </Grid>
              <Button x:Name="btn_rmap" Grid.Column="1" Style="{DynamicResource GreenBtn}" Margin="8,0" Padding="9,10"
                      VerticalAlignment="Center" ToolTip="Add this mapping (or double-click the shared parameter)">
                <StackPanel>
                  <Path Data="M0,8 L22,8 M15,1 L22,8 L15,15" Stroke="White" StrokeThickness="2.4" HorizontalAlignment="Center"/>
                  <TextBlock Text="Map" Foreground="White" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBox x:Name="search_rtarget" Tag="Search shared parameters" Margin="0,0,0,4"/>
                <DataGrid x:Name="grid_rtarget" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Single"/>
              </Grid>
            </Grid>
            <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Row="6">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <DockPanel Margin="0,0,0,5">
                <Button x:Name="btn_runmap" Content="Remove Mapping" Style="{DynamicResource OrangeBtn}" DockPanel.Dock="Right"/>
                <TextBlock Text="Mappings" Style="{DynamicResource SectionTitle}"/>
              </DockPanel>
              <DataGrid x:Name="grid_rmaps" Grid.Row="1" Style="{DynamicResource ThemedGrid}" SelectionMode="Extended"/>
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <Border x:Name="progress_band" Grid.Row="3" Visibility="Collapsed" Padding="12,4,12,6">
        <DockPanel>
          <TextBlock x:Name="txt_progress" Foreground="{DynamicResource MutedBrush}" DockPanel.Dock="Right" Margin="10,0,0,0"/>
          <ProgressBar x:Name="progress_bar" Height="7" Minimum="0" Maximum="100" BorderThickness="0"
                       Background="{DynamicResource FieldBgBrush}" Foreground="{DynamicResource GreenBrush}"/>
        </DockPanel>
      </Border>

      <Border x:Name="footer_bar" Grid.Row="4" Background="{DynamicResource TitleBgBrush}"
              CornerRadius="0,0,6,6" Padding="12,8">
        <DockPanel>
          <CheckBox x:Name="tick_debug" Content="Debug" DockPanel.Dock="Left"/>
          <CheckBox x:Name="tick_clear" Content="Blank source clears target text" Margin="14,0,0,0" DockPanel.Dock="Left"/>
          <Button x:Name="btn_run" Style="{DynamicResource GreenBtn}" DockPanel.Dock="Right" MinWidth="120"
                  ToolTip="Push the mapped values">
            <StackPanel Orientation="Horizontal">
              <Path Data="M0,0 L10,6 L0,12 Z" Fill="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
              <TextBlock x:Name="txt_run" Text="Run"/>
            </StackPanel>
          </Button>
          <TextBlock x:Name="txt_status" Foreground="{DynamicResource MutedBrush}" Margin="16,0,8,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Border>
      <Grid x:Name="grip_layer" Grid.RowSpan="5">
        <Thumb x:Name="grip_n" Style="{DynamicResource GripThumb}" VerticalAlignment="Top" HorizontalAlignment="Stretch" Cursor="SizeNS" Height="5"/>
        <Thumb x:Name="grip_s" Style="{DynamicResource GripThumb}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Cursor="SizeNS" Height="5"/>
        <Thumb x:Name="grip_e" Style="{DynamicResource GripThumb}" VerticalAlignment="Stretch" HorizontalAlignment="Right" Cursor="SizeWE" Width="5"/>
        <Thumb x:Name="grip_w" Style="{DynamicResource GripThumb}" VerticalAlignment="Stretch" HorizontalAlignment="Left" Cursor="SizeWE" Width="5"/>
        <Thumb x:Name="grip_ne" Style="{DynamicResource GripThumb}" VerticalAlignment="Top" HorizontalAlignment="Right" Cursor="SizeNESW" Width="9" Height="9"/>
        <Thumb x:Name="grip_nw" Style="{DynamicResource GripThumb}" VerticalAlignment="Top" HorizontalAlignment="Left" Cursor="SizeNWSE" Width="9" Height="9"/>
        <Thumb x:Name="grip_se" Style="{DynamicResource GripThumb}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="SizeNWSE" Width="9" Height="9"/>
        <Thumb x:Name="grip_sw" Style="{DynamicResource GripThumb}" VerticalAlignment="Bottom" HorizontalAlignment="Left" Cursor="SizeNESW" Width="9" Height="9"/>
      </Grid>
    </Grid>
  </Border>
</Window>

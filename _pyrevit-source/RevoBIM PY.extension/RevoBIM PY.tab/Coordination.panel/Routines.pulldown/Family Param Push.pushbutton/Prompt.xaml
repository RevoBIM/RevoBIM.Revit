<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Param Push" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        SizeToContent="Height" Width="560" MinHeight="150" FontFamily="Segoe UI" FontSize="12">
  <Border x:Name="root_border" Background="{DynamicResource WindowBgBrush}"
          BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="6">
    <Grid x:Name="root_grid">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border x:Name="header_bar" Grid.Row="0" Background="{DynamicResource TitleBgBrush}"
              CornerRadius="6,6,0,0" Padding="10,7">
        <DockPanel>
          <Image x:Name="logo_img" Width="28" Height="28" Margin="0,0,8,0" DockPanel.Dock="Left"/>
          <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}" FontSize="20"
                     FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <TextBlock x:Name="txt_title" Text="Family Param Push" Foreground="{DynamicResource OrangeBrush}"
                     FontSize="15" Margin="9,3,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
            <Button x:Name="btn_theme" Style="{DynamicResource ChipBtn}" ToolTip="Theme: Auto follows Revit's canvas">
              <TextBlock x:Name="txt_theme" Text="Auto"/>
            </Button>
            <TextBlock x:Name="txt_version" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                       VerticalAlignment="Center" Margin="10,0,6,0"/>
            <Button x:Name="shrink_btn" Style="{DynamicResource WinBtn}" ToolTip="Shrink to taskbar (Ctrl+Shift+H)">
              <Grid>
                <Path x:Name="shrink_glyph" Data="M6,0 L6,8 M2,5 L6,9 L10,5 M0,12 L12,12"
                      Stroke="{DynamicResource TextBrush}" StrokeThickness="1.6"/>
                <Path x:Name="expand_glyph" Data="M6,12 L6,2 M1,7 L6,1 L11,7"
                      Stroke="{DynamicResource GreenBrush}" StrokeThickness="2.2" Visibility="Collapsed"/>
              </Grid>
            </Button>
            <Button x:Name="btn_close" Style="{DynamicResource CloseBtn}" ToolTip="Close">
              <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"/>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border x:Name="body_panel" Grid.Row="1" Padding="14,12">
        <StackPanel>
          <TextBox x:Name="txt_message" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="420"
                   VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0"/>
          <TextBox x:Name="txt_input" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
      <Border x:Name="footer_bar" Grid.Row="2" Background="{DynamicResource TitleBgBrush}"
              CornerRadius="0,0,6,6" Padding="12,8">
        <StackPanel x:Name="button_row" Orientation="Horizontal" HorizontalAlignment="Right"/>
      </Border>
    </Grid>
  </Border>
</Window>

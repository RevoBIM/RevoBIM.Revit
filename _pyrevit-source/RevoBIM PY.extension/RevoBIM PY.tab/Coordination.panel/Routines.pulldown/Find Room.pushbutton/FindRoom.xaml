<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Find Room" Width="1040" Height="680" MinWidth="780" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Grid>
        <Border x:Name="Root" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource WinEdge}" Background="{DynamicResource Bg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="46"/>
                </Grid.RowDefinitions>

                <!-- ========== Header ========== -->
                <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0">
                    <DockPanel Margin="12,0,8,0" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="Logo" Width="32" Height="32" Margin="0,0,10,0" Cursor="Hand"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Blue}" Margin="0,-3,0,-2"/>
                                <TextBlock Text="Find Room" FontSize="15" Foreground="{DynamicResource Orange}"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ThemeBtn" Style="{DynamicResource ChipButton}"
                                    ToolTip="Theme: Auto follows Revit's canvas. Click for Auto, Dark, Light.">
                                <StackPanel Orientation="Horizontal">
                                    <Path x:Name="ThemeIcon" Width="14" Height="14" Stretch="Uniform"
                                          Fill="{DynamicResource Orange}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ThemeText" Text="Auto" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SettingsBtn" Style="{DynamicResource ChipButton}" ToolTip="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Blue}"
                                          VerticalAlignment="Center"
                                          Data="F0 M6,0 H8 L8.4,1.9 A5.2,5.2 0 0 1 9.8,2.5 L11.4,1.4 L12.6,2.6 L11.5,4.2 A5.2,5.2 0 0 1 12.1,5.6 L14,6 V8 L12.1,8.4 A5.2,5.2 0 0 1 11.5,9.8 L12.6,11.4 L11.4,12.6 L9.8,11.5 A5.2,5.2 0 0 1 8.4,12.1 L8,14 H6 L5.6,12.1 A5.2,5.2 0 0 1 4.2,11.5 L2.6,12.6 L1.4,11.4 L2.5,9.8 A5.2,5.2 0 0 1 1.9,8.4 L0,8 V6 L1.9,5.6 A5.2,5.2 0 0 1 2.5,4.2 L1.4,2.6 L2.6,1.4 L4.2,2.5 A5.2,5.2 0 0 1 5.6,1.9 Z M7,4.6 A2.4,2.4 0 1 0 7,9.4 A2.4,2.4 0 1 0 7,4.6 Z"/>
                                    <TextBlock Text="Settings" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11" Margin="10,0,6,0"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                            <Button x:Name="FullBtn" Style="{DynamicResource WinButton}" ToolTip="Full screen (F11)">
                                <Border Width="11" Height="10" BorderThickness="1.5" CornerRadius="1"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                            <Button x:Name="CloseBtn" Style="{DynamicResource CloseButton}" ToolTip="Close">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.6"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </StackPanel>
                        <Border/>
                    </DockPanel>
                </Border>

                <!-- ========== Toolbar: what to find, and where ========== -->
                <Border Grid.Row="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}"
                        BorderThickness="0,0,0,1" Padding="12,9">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Left" Background="{DynamicResource Field}" CornerRadius="4"
                                BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RoomsRadio" GroupName="FrmMode" Style="{DynamicResource SegRadio}"
                                             Content="Rooms" IsChecked="True"/>
                                <RadioButton x:Name="SpacesRadio" GroupName="FrmMode" Style="{DynamicResource SegRadio}"
                                             Content="Spaces"/>
                            </StackPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="Model" Margin="18,0,8,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}"/>
                        <ComboBox x:Name="ModelCombo" DockPanel.Dock="Left" Width="340" VerticalAlignment="Center"
                                  ToolTip="Which model to find rooms in - this model or a linked model"/>
                        <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}"
                                ToolTip="Read the model again (F5)">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Blue}"
                                      StrokeThickness="1.6" VerticalAlignment="Center"
                                      Data="M11,2 A5.5,5.5 0 1 0 12.5,7 M11,0 V3 H8"/>
                                <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ModelNote" Margin="12,0,12,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- ========== Body ========== -->
                <Grid x:Name="Body" Grid.Row="2" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftCol" Width="55*" MinWidth="320"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition x:Name="RightCol" Width="45*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Rooms by level -->
                    <Border Grid.Column="0" Background="{DynamicResource Card}" CornerRadius="5"
                            BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2"
                                        Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="RoomsHeading" DockPanel.Dock="Left" Text="Rooms by level"
                                           FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text}"/>
                                <TextBlock x:Name="RoomsCount" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Muted}"/>
                            </DockPanel>
                            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button x:Name="CollapseBtn" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}"
                                        Margin="6,0,0,0" Padding="8,0" ToolTip="Collapse all levels">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Text}"
                                          StrokeThickness="1.6" Data="M1,5 L6,1 L11,5 M1,11 L6,7 L11,11"/>
                                </Button>
                                <Button x:Name="ExpandBtn" DockPanel.Dock="Right" Style="{DynamicResource GhostButton}"
                                        Margin="6,0,0,0" Padding="8,0" ToolTip="Expand all levels">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Text}"
                                          StrokeThickness="1.6" Data="M1,1 L6,5 L11,1 M1,7 L6,11 L11,7"/>
                                </Button>
                                <CheckBox x:Name="UnplacedCheck" DockPanel.Dock="Right" Content="Unplaced"
                                          Margin="10,0,4,0" VerticalAlignment="Center"
                                          ToolTip="Also list rooms that are not placed or not enclosed (they cannot be found on a plan)"/>
                                <TextBox x:Name="SearchBox" Tag="Search number, name or level"/>
                            </DockPanel>
                            <Border Grid.Row="2" Background="{DynamicResource Field}" CornerRadius="3"
                                    BorderBrush="{DynamicResource Edge}" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="RoomList" Padding="2"
                                             VirtualizingStackPanel.IsVirtualizing="True"
                                             VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                                    <TextBlock x:Name="RoomsEmpty" Text="Reading the model..." Margin="16"
                                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="3" Margin="2,8,0,0" Foreground="{DynamicResource Faint}" TextWrapping="Wrap"
                                       Text="Pick a room to list the floor plans on its level. Double-click or Enter goes straight to the first plan."/>
                        </Grid>
                    </Border>

                    <GridSplitter x:Name="Split" Grid.Column="1" Width="10" HorizontalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" Style="{DynamicResource Splitter}"/>

                    <!-- Floor plans on the room's level -->
                    <Border Grid.Column="2" Background="{DynamicResource Card}" CornerRadius="5"
                            BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,2">
                                <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2"
                                        Background="{DynamicResource Orange}" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ViewsHeading" Text="Floor plans" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text}"
                                           TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                            <TextBlock x:Name="ViewsSub" Grid.Row="1" Margin="12,0,0,8" Foreground="{DynamicResource Muted}"
                                       TextWrapping="Wrap" Text="Pick a room on the left."/>
                            <TextBox x:Name="ViewSearch" Grid.Row="2" Tag="Search plans" Margin="0,0,0,8"/>
                            <Border Grid.Row="3" Background="{DynamicResource Field}" CornerRadius="3"
                                    BorderBrush="{DynamicResource Edge}" BorderThickness="1">
                                <Grid>
                                    <ListBox x:Name="ViewList" Padding="2"/>
                                    <TextBlock x:Name="ViewsEmpty" Text="" Margin="16" Foreground="{DynamicResource Muted}"
                                               TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
                                <Button x:Name="GoBtn" DockPanel.Dock="Right" Style="{DynamicResource GoButton}"
                                        IsEnabled="False" ToolTip="Open the plan, switch room references and colour fill on, colour the room and zoom to it (Enter)">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Width="13" Height="13" Stretch="Uniform" StrokeThickness="2"
                                              Stroke="{DynamicResource OnAccent}" VerticalAlignment="Center"
                                              Data="M5,1 A4,4 0 1 0 5.01,1 M8,8 L12,12"/>
                                        <TextBlock x:Name="GoText" Text="Go to view" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource Faint}"
                                           Text="Click a plan to go to it" TextWrapping="Wrap" MaxWidth="170"/>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== Footer ========== -->
                <Border Grid.Row="3" Background="{DynamicResource Bar}" CornerRadius="0,0,6,6"
                        BorderBrush="{DynamicResource Edge}" BorderThickness="0,1,0,0">
                    <DockPanel Margin="12,0,12,0" LastChildFill="True">
                        <CheckBox x:Name="DebugCheck" DockPanel.Dock="Left" Content="Debug" VerticalAlignment="Center"
                                  ToolTip="Write a debug log to %APPDATA%\RevoBIM\find_room_debug.txt"/>
                        <Button x:Name="CopyDebugBtn" DockPanel.Dock="Left" Style="{DynamicResource GhostButton}"
                                Height="24" Margin="8,0,0,0" Content="Copy debug" ToolTip="Copy the debug report to send to Claude"/>
                        <Button x:Name="ClearBtn" DockPanel.Dock="Right" Style="{DynamicResource OrangeButton}"
                                VerticalAlignment="Center" IsEnabled="False"
                                ToolTip="Take the temporary colour fill off and restore the view's own properties">
                            <TextBlock x:Name="ClearText" Text="Clear highlight"/>
                        </Button>
                        <TextBlock x:Name="Status" Margin="14,0,14,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <!-- ========== Settings (over the body) ========== -->
                <Border x:Name="SettingsPanel" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource Overlay}"
                        Visibility="Collapsed">
                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                            CornerRadius="6" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Border DockPanel.Dock="Left" Width="4" Height="16" CornerRadius="2"
                                        Background="{DynamicResource Blue}" Margin="0,0,8,0"/>
                                <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                    <RowDefinition Height="36"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Highlight colour" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                                <DockPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <Border x:Name="HlSwatch" DockPanel.Dock="Right" Width="28" Height="24" CornerRadius="3"
                                            Margin="8,0,0,0" BorderBrush="{DynamicResource Edge}" BorderThickness="1"/>
                                    <TextBox x:Name="HlText" Tag="#E8912D"/>
                                </DockPanel>
                                <TextBlock Grid.Row="1" Text="Fill transparency (%)" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                                <TextBox x:Name="TransText" Grid.Row="1" Grid.Column="1" Tag="0 to 90" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2" Text="Zoom margin (mm)" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
                                <TextBox x:Name="MarginText" Grid.Row="2" Grid.Column="1" Tag="1500" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Text="Linked level match (mm)" VerticalAlignment="Center" Foreground="{DynamicResource Text}"
                                           ToolTip="How close a linked model's level must be to one of this model's levels"/>
                                <TextBox x:Name="TolText" Grid.Row="3" Grid.Column="1" Tag="50" VerticalAlignment="Center"/>
                                <CheckBox x:Name="RestoreCheck" Grid.Row="4" Grid.ColumnSpan="2" VerticalAlignment="Center"
                                          Content="Clear the highlight when the window closes"/>
                            </Grid>
                            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                                <Button x:Name="SettingsSave" DockPanel.Dock="Right" Style="{DynamicResource AccentButton}" Content="Done"/>
                                <Button x:Name="SettingsReset" DockPanel.Dock="Left" Style="{DynamicResource GhostButton}" Content="Defaults"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- ========== Resize grips (no Background: everything underneath stays clickable) ========== -->
        <Grid>
            <Thumb x:Name="GripN" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Margin="10,0" Cursor="SizeNS"/>
            <Thumb x:Name="GripS" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Margin="10,0" Cursor="SizeNS"/>
            <Thumb x:Name="GripW" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Margin="0,10" Cursor="SizeWE"/>
            <Thumb x:Name="GripE" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Margin="0,10" Cursor="SizeWE"/>
            <Thumb x:Name="GripNW" Style="{DynamicResource Grip}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
            <Thumb x:Name="GripNE" Style="{DynamicResource Grip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
            <Thumb x:Name="GripSW" Style="{DynamicResource Grip}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
            <Thumb x:Name="GripSE" Style="{DynamicResource Grip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
        </Grid>
    </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explode Import Symbol Multiple" Width="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Border x:Name="Frame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Frame}"
            BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== header ==================== -->
            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource Bar}"
                    CornerRadius="6,6,0,0" Padding="12,8,8,8">
                <DockPanel LastChildFill="True">
                    <Image x:Name="HeaderIcon" DockPanel.Dock="Left" Width="32" Height="32"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="ThemeChip" Style="{DynamicResource ChipBorder}" VerticalAlignment="Center"
                                ToolTip="Theme: Auto follows Revit's canvas. Click to cycle Auto, Dark, Light.">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse Stroke="{DynamicResource Text}" StrokeThickness="1.2"/>
                                    <Path Data="M6,0.6 A5.4,5.4 0 0 1 6,11.4 Z" Fill="{DynamicResource Text}"/>
                                </Grid>
                                <TextBlock x:Name="ThemeChipText" Text="Auto" Foreground="{DynamicResource Text}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="VersionText" Text="v0.0.0" Foreground="{DynamicResource Muted}"
                                   FontSize="11" Margin="10,0,8,0" VerticalAlignment="Center"/>
                        <Border x:Name="CloseButton" Style="{DynamicResource CloseBorder}" Width="28" Height="24"
                                ToolTip="Close (Esc)">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Text}" StrokeThickness="1.4"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Blue}"/>
                        <TextBlock x:Name="ToolNameText" Text="Explode Import Symbol Multiple" FontSize="15"
                                   Foreground="{DynamicResource Orange}" Margin="0,-4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ==================== body ==================== -->
            <StackPanel Grid.Row="1" Margin="16,14,16,14">

                <StackPanel x:Name="PromptPanel">
                    <TextBlock x:Name="SummaryText" Text="0 import symbols selected" FontSize="14"
                               FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SkipText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                               Margin="0,3,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,8">
                        <Border Width="4" Height="14" Background="{DynamicResource Blue}" CornerRadius="1"
                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="How should they be exploded?" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PartialButton" Grid.Column="0" Style="{DynamicResource CardButton}"
                                ToolTip="Partial Explode every selected import (P)">
                            <StackPanel Margin="14,12,14,12">
                                <Image x:Name="PartialIcon" Width="64" Height="64" HorizontalAlignment="Left"/>
                                <TextBlock Text="Partial Explode" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource Blue}" Margin="0,8,0,2"/>
                                <TextBlock Text="One level down. Each block and xref becomes its own import symbol."
                                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text="Press P" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="FullButton" Grid.Column="2" Style="{DynamicResource CardButton}"
                                ToolTip="Full Explode every selected import (F)">
                            <StackPanel Margin="14,12,14,12">
                                <Image x:Name="FullIcon" Width="64" Height="64" HorizontalAlignment="Left"/>
                                <TextBlock Text="Full Explode" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource Orange}" Margin="0,8,0,2"/>
                                <TextBlock Text="All the way. Lines, text and filled regions, with a line style per layer."
                                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                <TextBlock Text="Press F" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <WrapPanel Margin="0,14,0,0">
                        <CheckBox x:Name="SelectResultsCheck" Content="Select the results when done" Margin="0,0,18,0"/>
                        <CheckBox x:Name="DebugCheck" Content="Debug log"/>
                    </WrapPanel>
                </StackPanel>

                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Height="16" Background="{DynamicResource Orange}" CornerRadius="1"
                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ResultTitle" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1" CornerRadius="4" Margin="0,10,0,0" MaxHeight="280">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="10,8"
                                       Foreground="{DynamicResource Text}" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ==================== footer ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource Bar}" CornerRadius="0,0,6,6" Padding="12,8">
                <DockPanel>
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{DynamicResource FooterButton}">
                        <TextBlock x:Name="CancelText" Text="Cancel"/>
                    </Button>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

  <Border Background="{DynamicResource WindowBrush}" CornerRadius="6"
          BorderBrush="{DynamicResource ChromeBrush}" BorderThickness="1">
    <StackPanel>
      <Border x:Name="HeaderBar" Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="14,9,10,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="PromptTitle" Grid.Column="0" Text="Save template"
                     FontSize="14" VerticalAlignment="Center"
                     Foreground="{DynamicResource OrangeBrush}"/>
          <Button x:Name="CloseButton" Grid.Column="1" Content="&#x2715;"
                  Style="{DynamicResource IstCloseButton}"/>
        </Grid>
      </Border>

      <StackPanel Margin="16,14,16,14">
        <TextBlock x:Name="PromptText" Text="Name" FontSize="12.5"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource TextBrush}"/>
        <TextBox x:Name="PromptBox" Style="{DynamicResource IstTextBox}"/>
        <TextBlock x:Name="PromptHint" Text="" FontSize="11.5" TextWrapping="Wrap"
                   Margin="0,6,0,0" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>

      <Border Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6"
              Padding="16,10,16,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PromptCancel" Content="Cancel"
                  Style="{DynamicResource IstButton}" Margin="0,0,10,0"/>
          <Button x:Name="PromptOk" Content="Save"
                  Style="{DynamicResource IstGreenButton}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</Window>

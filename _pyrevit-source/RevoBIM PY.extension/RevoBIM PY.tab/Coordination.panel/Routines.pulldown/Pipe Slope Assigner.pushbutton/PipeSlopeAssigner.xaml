<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Pipe Slope Assigner"
        Width="600" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True">

    <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource WindowEdge}" Background="{DynamicResource BgWindow}">
        <DockPanel LastChildFill="True">

            <!-- ============ header ============ -->
            <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource BgBar}"
                    CornerRadius="6,6,0,0" Padding="12,9,8,9">
                <DockPanel LastChildFill="True">
                    <StackPanel x:Name="RevoLogo" DockPanel.Dock="Left" Orientation="Horizontal"
                                Background="Transparent">
                        <Image x:Name="HeaderIcon" Width="34" Height="34" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Blue}"/>
                            <TextBlock x:Name="ToolTitle" Text="Pipe Slope Assigner" FontSize="15"
                                       Foreground="{DynamicResource Orange}" Margin="0,-5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{DynamicResource PsaCloseButton}"
                            ToolTip="Close (Esc)" VerticalAlignment="Top" Margin="6,0,0,0"/>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="v0.0.0" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top"
                               Margin="10,6,0,0"/>
                    <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{DynamicResource PsaChip}"
                            VerticalAlignment="Top" ToolTip="Theme: Auto follows Revit's canvas, then Dark, then Light">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource Text}" StrokeThickness="1.3"/>
                                <Path Data="M6,0 A6,6 0 0 1 6,12 Z" Fill="{DynamicResource Text}"/>
                            </Grid>
                            <TextBlock x:Name="ThemeText" Text="Auto" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border/>
                </DockPanel>
            </Border>

            <!-- ============ footer ============ -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBar}" CornerRadius="0,0,6,6"
                    Padding="14,10,12,10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Style="{DynamicResource PsaButton}" Content="Cancel"
                                Margin="0,0,8,0"/>
                        <Button x:Name="ApplyButton" Style="{DynamicResource PsaPrimaryButton}"
                                ToolTip="Apply (Enter)">
                            <TextBlock x:Name="ApplyText" Text="Apply 1:100"/>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <CheckBox x:Name="DebugCheck" Style="{DynamicResource PsaCheck}"
                                  Content="Debug - show a report to send to Claude"
                                  ToolTip="Shows the full run report afterwards, with a Copy button. The last run is always written to %APPDATA%\RevoBIM\pipe_slope_assigner_debug.txt"/>
                        <TextBlock x:Name="StatusText" Text="" FontSize="11.5" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ============ body ============ -->
            <StackPanel x:Name="BodyPanel" Margin="16,14,16,10">

                <Border Background="{DynamicResource BgCard}" CornerRadius="5" Padding="12,9"
                        BorderBrush="{DynamicResource Edge}" BorderThickness="1" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="SelectionText" Text="" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="ScopeText" Text="" TextWrapping="Wrap" Margin="0,3,0,0"
                                   FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Border>

                <!-- ============ slope ============ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="4" Height="15" Background="{DynamicResource Blue}" CornerRadius="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Slope" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    <TextBlock Text="  keys 1 to 4" FontSize="11" Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <UniformGrid Columns="4" Margin="0,0,-8,16">
                    <RadioButton x:Name="Slope100" GroupName="slope" Style="{DynamicResource PsaSlopeTile}">
                        <StackPanel>
                            <Canvas Width="46" Height="16" HorizontalAlignment="Center">
                                <Line X1="3" Y1="4" X2="43" Y2="8" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource Blue}"/>
                            </Canvas>
                            <TextBlock Text="1:100" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="1 %  |  10 mm/m" FontSize="10.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Slope80" GroupName="slope" Style="{DynamicResource PsaSlopeTile}">
                        <StackPanel>
                            <Canvas Width="46" Height="16" HorizontalAlignment="Center">
                                <Line X1="3" Y1="3" X2="43" Y2="9" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource Blue}"/>
                            </Canvas>
                            <TextBlock Text="1:80" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="1.25 %  |  12.5 mm/m" FontSize="10.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Slope60" GroupName="slope" Style="{DynamicResource PsaSlopeTile}">
                        <StackPanel>
                            <Canvas Width="46" Height="16" HorizontalAlignment="Center">
                                <Line X1="3" Y1="3" X2="43" Y2="11" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource Blue}"/>
                            </Canvas>
                            <TextBlock Text="1:60" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="1.67 %  |  16.7 mm/m" FontSize="10.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Slope40" GroupName="slope" Style="{DynamicResource PsaSlopeTile}">
                        <StackPanel>
                            <Canvas Width="46" Height="16" HorizontalAlignment="Center">
                                <Line X1="3" Y1="2" X2="43" Y2="14" StrokeThickness="4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{DynamicResource Blue}"/>
                            </Canvas>
                            <TextBlock Text="1:40" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Text}"/>
                            <TextBlock Text="2.5 %  |  25 mm/m" FontSize="10.5" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- ============ apply to ============ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="4" Height="15" Background="{DynamicResource Orange}" CornerRadius="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Apply to" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButton x:Name="ScopeRun" GroupName="scope" Style="{DynamicResource PsaRadio}">
                    <StackPanel>
                        <TextBlock Text="Current horizontal run" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="The line of pipe clicked - through bends, straight on through tees. Pipes off a branch stretch to stay joined."
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ScopeNetwork" GroupName="scope" Style="{DynamicResource PsaRadio}">
                    <StackPanel>
                        <TextBlock Text="Current run and adjoining horizontal runs" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="Every horizontal pipe joined to it, through tees, as far as the first set up or set down."
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="ScopeSystem" GroupName="scope" Style="{DynamicResource PsaRadio}">
                    <StackPanel>
                        <TextBlock Text="Selected pipes and fittings, as one system" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="Only what is selected, falling together to one outlet. Pipes joined on but not selected stretch to stay joined."
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </RadioButton>
                <StackPanel Orientation="Horizontal" Margin="25,2,0,14">
                    <TextBlock Text="Set up / set down is steeper than" Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,14,0" VerticalAlignment="Top" Padding="0,1,0,0"/>
                    <RadioButton x:Name="Upright5" GroupName="upright" Style="{DynamicResource PsaRadio}"
                                 Margin="0,0,16,0" Content="5&#176;"/>
                    <RadioButton x:Name="Upright10" GroupName="upright" Style="{DynamicResource PsaRadio}"
                                 Margin="0,0,16,0" Content="10&#176;"/>
                    <RadioButton x:Name="Upright15" GroupName="upright" Style="{DynamicResource PsaRadio}"
                                 Margin="0,0,16,0" Content="15&#176;"/>
                    <RadioButton x:Name="Upright30" GroupName="upright" Style="{DynamicResource PsaRadio}"
                                 Margin="0" Content="30&#176;"/>
                </StackPanel>

                <!-- ============ direction of fall ============ -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="4" Height="15" Background="{DynamicResource Blue}" CornerRadius="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Direction of fall" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <RadioButton x:Name="DirAuto" GroupName="direction" Style="{DynamicResource PsaRadio}">
                    <StackPanel>
                        <TextBlock Text="Keep the current fall" Foreground="{DynamicResource Text}"/>
                        <TextBlock x:Name="DirAutoHint"
                                   Text="A run that falls keeps its direction. A level run falls towards its stack or the run it joins."
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="DirPick" GroupName="direction" Style="{DynamicResource PsaRadio}">
                    <StackPanel>
                        <TextBlock Text="Define the direction of fall - two clicks" Foreground="{DynamicResource Text}"/>
                        <TextBlock Text="After Apply: first click where the fall starts (fall from), second click where it falls to."
                                   FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </RadioButton>
                <StackPanel Orientation="Horizontal" Margin="25,2,0,12">
                    <TextBlock Text="Hold the elevation at" Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,14,0" VerticalAlignment="Top" Padding="0,1,0,0"/>
                    <RadioButton x:Name="AnchorLow" GroupName="anchor" Style="{DynamicResource PsaRadio}"
                                 Margin="0,0,18,0" Content="the low end (fall to)"/>
                    <RadioButton x:Name="AnchorHigh" GroupName="anchor" Style="{DynamicResource PsaRadio}"
                                 Margin="0" Content="the high end (fall from)"/>
                </StackPanel>

                <TextBlock Text="Set ups, set downs and uprights are not re-sloped - the fall stops there and they stretch to stay joined. Parameter values are kept."
                           FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

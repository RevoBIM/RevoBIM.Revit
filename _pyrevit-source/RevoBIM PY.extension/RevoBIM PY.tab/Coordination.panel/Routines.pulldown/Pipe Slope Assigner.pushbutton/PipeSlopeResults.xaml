<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Pipe Slope Assigner - results"
        Width="760" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12.5" UseLayoutRounding="True">

    <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource WindowEdge}" Background="{DynamicResource BgWindow}">
        <DockPanel LastChildFill="True">

            <!-- ============ header ============ -->
            <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource BgBar}"
                    CornerRadius="6,6,0,0" Padding="12,9,8,9">
                <DockPanel LastChildFill="True">
                    <StackPanel x:Name="RevoLogo" DockPanel.Dock="Left" Orientation="Horizontal"
                                Background="Transparent">
                        <Image x:Name="HeaderIcon" Width="34" Height="34" Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource Blue}"/>
                            <TextBlock x:Name="ToolTitle" Text="Pipe Slope Assigner - results" FontSize="15"
                                       Foreground="{DynamicResource Orange}" Margin="0,-5,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{DynamicResource PsaCloseButton}"
                            ToolTip="Close (Esc)" VerticalAlignment="Top" Margin="6,0,0,0"/>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="v0.0.0" FontSize="11"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Top"
                               Margin="10,6,0,0"/>
                    <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{DynamicResource PsaChip}"
                            VerticalAlignment="Top" ToolTip="Theme: Auto follows Revit's canvas, then Dark, then Light">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse Stroke="{DynamicResource Text}" StrokeThickness="1.3"/>
                                <Path Data="M6,0 A6,6 0 0 1 6,12 Z" Fill="{DynamicResource Text}"/>
                            </Grid>
                            <TextBlock x:Name="ThemeText" Text="Auto" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border/>
                </DockPanel>
            </Border>

            <!-- ============ footer ============ -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgBar}" CornerRadius="0,0,6,6"
                    Padding="14,10,12,10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyButton" Style="{DynamicResource PsaButton}" Content="Copy report"
                                Margin="0,0,8,0" ToolTip="Copies the full report, ready to paste to Claude"/>
                        <Button x:Name="FolderButton" Style="{DynamicResource PsaButton}" Content="Open folder"
                                Margin="0,0,8,0"/>
                        <Button x:Name="OkButton" Style="{DynamicResource PsaPrimaryButton}" MinWidth="90">
                            <TextBlock Text="Close"/>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="" FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- ============ body ============ -->
            <StackPanel Margin="16,14,16,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="4" Height="15" Background="{DynamicResource Blue}" CornerRadius="1"
                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="What happened" FontWeight="SemiBold" FontSize="13.5"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" Text="" TextWrapping="Wrap" Margin="0,0,0,10"
                           Foreground="{DynamicResource Text}"/>
                <Border Background="{DynamicResource BgField}" BorderBrush="{DynamicResource Edge}"
                        BorderThickness="1" CornerRadius="4">
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="RowsPanel" Margin="0,4"/>
                    </ScrollViewer>
                </Border>

                <StackPanel x:Name="DebugPanel" Visibility="Collapsed" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="15" Background="{DynamicResource Orange}" CornerRadius="1"
                                Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Debug report - copy and send to Claude" FontWeight="SemiBold"
                                   FontSize="13.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="DebugBox" Style="{DynamicResource PsaTextBox}" Height="260"
                             IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>

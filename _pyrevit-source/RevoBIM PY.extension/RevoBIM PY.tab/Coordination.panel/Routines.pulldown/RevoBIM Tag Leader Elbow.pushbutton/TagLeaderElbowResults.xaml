<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Tag Leader Elbow"
        Width="820" Height="560" MinWidth="560" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

  <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
          BorderBrush="#4A4A50" Background="{DynamicResource WindowBackBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ====================== header ====================== -->
      <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="6,6,0,0"
              Background="{DynamicResource BarBrush}" Padding="14,9,10,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Canvas Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path Fill="{DynamicResource BlueBrush}"
                  Data="M 9,2 L 24,2 L 24,12 L 9,12 L 3,7 Z"/>
            <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2"
                  Data="M 9,16 L 3,16 L 3,23"/>
            <Ellipse Canvas.Left="0" Canvas.Top="20" Width="6" Height="6"
                     Fill="{DynamicResource OrangeBrush}"/>
          </Canvas>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" Style="{DynamicResource TitleText}"/>
            <TextBlock Text="Tag Leader Elbow" Style="{DynamicResource ToolTitle}" Margin="1,-3,0,0"/>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="3" Content="Light" VerticalAlignment="Center"
                  Margin="0,0,12,0" Style="{DynamicResource ChipButton}"/>

          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v1.0.0" VerticalAlignment="Center"
                     Margin="0,0,10,0" Style="{DynamicResource VersionText}"/>

          <Button x:Name="FullBtn" Grid.Column="5" VerticalAlignment="Center"
                  Style="{DynamicResource CloseButton}" ToolTip="Full screen (F11)">
            <Border Width="11" Height="9" BorderThickness="1.4"
                    BorderBrush="{DynamicResource MutedBrush}"/>
          </Button>

          <Button x:Name="CloseBtn" Grid.Column="6" Content="&#x2715;" VerticalAlignment="Center"
                  Style="{DynamicResource CloseButton}"/>
        </Grid>
      </Border>

      <!-- ====================== summary ====================== -->
      <Border Grid.Row="1" Padding="16,12,16,6">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                    Background="{DynamicResource BlueBrush}"/>
            <TextBlock x:Name="SummaryText" Style="{DynamicResource SectionHead}" Text="Result"/>
          </StackPanel>
          <TextBlock x:Name="DetailText" Style="{DynamicResource Muted}" Margin="12,5,0,0"/>
        </StackPanel>
      </Border>

      <!-- ====================== rows ====================== -->
      <Border Grid.Row="2" Margin="16,4,16,10" CornerRadius="4" BorderThickness="1"
              BorderBrush="{DynamicResource EdgeBrush}"
              Background="{DynamicResource CardBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="10,8,10,8">
          <StackPanel x:Name="RowsPanel"/>
        </ScrollViewer>
      </Border>

      <!-- ====================== footer ====================== -->
      <Border Grid.Row="3" CornerRadius="0,0,6,6" Padding="16,10,16,10"
              Background="{DynamicResource BarBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                     Style="{DynamicResource Muted}"/>
          <Button x:Name="CopyBtn" Grid.Column="1" Content="Copy list"
                  Margin="0,0,10,0" Style="{DynamicResource GhostButton}"/>
          <Button x:Name="OkBtn" Grid.Column="2" Content="Close"
                  Style="{DynamicResource PrimaryButton}" MinWidth="110"/>
        </Grid>
      </Border>

      <!-- ====================== resize grips ====================== -->
      <!-- A borderless AllowsTransparency window has nothing hit testable in
           its frame, so it carries its own grips.  No Background on the grid
           so everything underneath stays clickable.                        -->
      <Grid>
        <Thumb x:Name="GripL" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Cursor="SizeWE" Opacity="0"/>
        <Thumb x:Name="GripR" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" Opacity="0"/>
        <Thumb x:Name="GripT" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top"
               Cursor="SizeNS" Opacity="0"/>
        <Thumb x:Name="GripB" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Cursor="SizeNS" Opacity="0"/>
        <Thumb x:Name="GripTL" Width="8" Height="8" HorizontalAlignment="Left"
               VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0"/>
        <Thumb x:Name="GripTR" Width="8" Height="8" HorizontalAlignment="Right"
               VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0"/>
        <Thumb x:Name="GripBL" Width="8" Height="8" HorizontalAlignment="Left"
               VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0"/>
        <Thumb x:Name="GripBR" Width="8" Height="8" HorizontalAlignment="Right"
               VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0"/>
      </Grid>

    </Grid>
  </Border>
</Window>

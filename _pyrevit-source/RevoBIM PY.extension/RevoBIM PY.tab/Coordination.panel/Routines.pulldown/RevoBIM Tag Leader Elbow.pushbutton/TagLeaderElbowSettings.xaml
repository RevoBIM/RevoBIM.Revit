<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Tag Elbow Settings"
        Width="820" Height="680" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

  <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
          BorderBrush="#4A4A50" Background="{DynamicResource WindowBackBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ====================== header ====================== -->
      <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="6,6,0,0"
              Background="{DynamicResource BarBrush}" Padding="14,9,10,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Canvas Grid.Column="0" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
            <Path Fill="{DynamicResource BlueBrush}"
                  Data="M 9,2 L 24,2 L 24,12 L 9,12 L 3,7 Z"/>
            <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2"
                  Data="M 9,16 L 3,16 L 3,23"/>
            <Ellipse Canvas.Left="0" Canvas.Top="20" Width="6" Height="6"
                     Fill="{DynamicResource OrangeBrush}"/>
          </Canvas>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" Style="{DynamicResource TitleText}"/>
            <TextBlock Text="Tag Leader Elbow settings" Style="{DynamicResource ToolTitle}"
                       Margin="1,-3,0,0"/>
          </StackPanel>

          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v1.0.0" VerticalAlignment="Center"
                     Margin="0,0,10,0" Style="{DynamicResource VersionText}"/>
          <Button x:Name="CloseBtn" Grid.Column="5" Content="&#x2715;" VerticalAlignment="Center"
                  Style="{DynamicResource CloseButton}"/>
        </Grid>
      </Border>

      <!-- ====================== body ====================== -->
      <Grid Grid.Row="1" Margin="16,14,16,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left: the elbow -->
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                    Background="{DynamicResource BlueBrush}"/>
            <TextBlock Text="The elbow" Style="{DynamicResource SectionHead}"/>
          </StackPanel>

          <Grid Margin="12,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Leg length, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
              <TextBox x:Name="ElbowMmBox" Style="{DynamicResource ThemedBox}"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Quoted at view scale 1:" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
              <TextBox x:Name="BaseScaleBox" Style="{DynamicResource ThemedBox}"/>
            </StackPanel>
          </Grid>

          <CheckBox x:Name="ScaleChk" Margin="12,0,0,4" Style="{DynamicResource ThemedCheck}"
                    Content="Scale the leg with the view scale"/>
          <TextBlock x:Name="ScaleNote" Style="{DynamicResource Muted}" Margin="34,0,0,12"/>

          <TextBlock Text="Work the tag's extent out by" Style="{DynamicResource Muted}"
                     Margin="12,0,0,4"/>
          <ComboBox x:Name="ExtentCombo" Margin="12,0,0,4" Style="{DynamicResource ThemedCombo}"/>
          <TextBlock x:Name="ExtentNote" Style="{DynamicResource Muted}" Margin="12,0,0,12"/>

          <TextBlock Text="Measure the leg from" Style="{DynamicResource Muted}"
                     Margin="12,0,0,4"/>
          <ComboBox x:Name="StartCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

          <TextBlock Text="Where the tag text sits (fallback only)" Style="{DynamicResource Muted}"
                     Margin="12,0,0,4"/>
          <ComboBox x:Name="JustifyCombo" Margin="12,0,0,4" Style="{DynamicResource ThemedCombo}"/>
          <TextBlock x:Name="JustifyNote" Style="{DynamicResource Muted}" Margin="12,0,0,12"/>

          <TextBlock Text="Which way the leg goes" Style="{DynamicResource Muted}"
                     Margin="12,0,0,4"/>
          <ComboBox x:Name="DirectionCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

          <TextBlock Text="Tags that already have an elbow" Style="{DynamicResource Muted}"
                     Margin="12,0,0,4"/>
          <ComboBox x:Name="ExistingCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

          <TextBlock Text="Leader with no side to elbow towards" Style="{DynamicResource Muted}"
                     Margin="12,0,0,4"/>
          <ComboBox x:Name="AmbiguousCombo" Margin="12,0,0,0" Style="{DynamicResource ThemedCombo}"/>
        </StackPanel>

        <!-- right: running it -->
        <StackPanel Grid.Column="2">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                    Background="{DynamicResource OrangeBrush}"/>
            <TextBlock Text="Running it" Style="{DynamicResource SectionHead}"/>
          </StackPanel>

          <CheckBox x:Name="SpatialChk" Margin="12,0,0,9" Style="{DynamicResource ThemedCheck}"
                    Content="Include room and space tags"/>
          <CheckBox x:Name="PromptChk" Margin="12,0,0,9" Style="{DynamicResource ThemedCheck}"
                    Content="Ask me to pick tags when nothing is selected"/>
          <CheckBox x:Name="HeadChk" Margin="12,0,0,9" Style="{DynamicResource ThemedCheck}"
                    Content="Put the tag head back if Revit nudges it"/>
          <CheckBox x:Name="UnpinChk" Margin="12,0,0,14" Style="{DynamicResource ThemedCheck}"
                    Content="Unpin a pinned tag, and pin it again after"/>

          <TextBlock Text="Where the tag head sits vertically (fallback only)" Style="{DynamicResource Muted}"
                     Margin="12,0,0,4"/>
          <ComboBox x:Name="VerticalCombo" Margin="12,0,0,4" Style="{DynamicResource ThemedCombo}"/>
          <TextBlock x:Name="VerticalNote" Style="{DynamicResource Muted}" Margin="12,0,0,12"/>

          <TextBlock Text="Show results" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
          <ComboBox x:Name="ResultsCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

          <TextBlock Text="Theme" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
          <ComboBox x:Name="ThemeCombo" Margin="12,0,0,14" Style="{DynamicResource ThemedCombo}"/>

          <Button x:Name="ShortcutBtn" HorizontalAlignment="Left" Margin="12,0,0,0"
                  Style="{DynamicResource GhostButton}"
                  Content="Open Revit's Keyboard Shortcuts"/>
          <TextBlock Style="{DynamicResource Muted}" Margin="12,7,0,0"
                     Text="Search for RevoBIM Tag Leader Elbow to bind keys to it."/>
        </StackPanel>
      </Grid>

      <!-- ====================== footer ====================== -->
      <Border Grid.Row="2" CornerRadius="0,0,6,6" Padding="16,10,16,10"
              Background="{DynamicResource BarBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                     Style="{DynamicResource Muted}"/>
          <Button x:Name="CancelBtn" Grid.Column="1" Content="Cancel" Margin="0,0,10,0"
                  Style="{DynamicResource GhostButton}" MinWidth="90"/>
          <Button x:Name="ApplyBtn" Grid.Column="2" Content="Apply"
                  Style="{DynamicResource PrimaryButton}" MinWidth="110"/>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

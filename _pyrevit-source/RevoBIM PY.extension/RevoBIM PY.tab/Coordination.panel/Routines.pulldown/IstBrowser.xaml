<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Hide Service Type"
        Width="720" Height="800" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">

  <Border Background="{DynamicResource WindowBrush}" CornerRadius="6"
          BorderBrush="{DynamicResource ChromeBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ============ header ============ -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="14,9,10,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="HeaderIcon" Grid.Column="0" Width="26" Height="26"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource BlueBrush}"/>
            <TextBlock x:Name="ToolText" Text="Hide Service Type" FontSize="14"
                       Margin="0,-2,0,0" Foreground="{DynamicResource OrangeBrush}"/>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="3" Content="Light"
                  Style="{DynamicResource IstChip}" Margin="0,0,12,0"
                  VerticalAlignment="Center"/>

          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v" FontSize="11"
                     Margin="0,0,8,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Button x:Name="CloseButton" Grid.Column="5" Content="&#x2715;"
                  Style="{DynamicResource IstCloseButton}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ============ templates + toolbar ============ -->
      <StackPanel Grid.Row="1" Margin="16,12,16,8">
      <Grid Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="Template" FontSize="12.5"
                   VerticalAlignment="Center" Margin="0,0,10,0"
                   Foreground="{DynamicResource TextBrush}"/>
        <ComboBox x:Name="TemplateCombo" Grid.Column="1"
                  Style="{DynamicResource IstCombo}" Margin="0,0,10,0"/>
        <Button x:Name="SaveTemplateButton" Grid.Column="2" Content="Save template..."
                Style="{DynamicResource IstChip}" Margin="0,0,6,0"
                VerticalAlignment="Center"/>
        <Button x:Name="DeleteTemplateButton" Grid.Column="3" Content="Delete"
                Style="{DynamicResource IstChip}" VerticalAlignment="Center"/>
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="SearchBox" Grid.Column="0" Tag="search categories, services, families, types"
                 Style="{DynamicResource IstTextBox}" Margin="0,0,10,0"/>
        <Button x:Name="ExpandButton" Grid.Column="1" Content="Expand"
                Style="{DynamicResource IstChip}" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <Button x:Name="CollapseButton" Grid.Column="2" Content="Collapse"
                Style="{DynamicResource IstChip}" Margin="0,0,6,0" VerticalAlignment="Center"/>
        <Button x:Name="ClearButton" Grid.Column="3" Content="Clear ticks"
                Style="{DynamicResource IstChip}" VerticalAlignment="Center"/>
      </Grid>
      </StackPanel>

      <!-- ============ the list ============ -->
      <TreeView x:Name="Tree" Grid.Row="2" Margin="16,0,16,8"
                Style="{DynamicResource IstTree}"/>

      <!-- ============ how links hide ============ -->
      <Border Grid.Row="3" Margin="16,0,16,10" Padding="10,7,10,7" CornerRadius="3"
              Background="{DynamicResource CardBrush}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
        <TextBlock TextWrapping="Wrap" FontSize="11.5"
                   Foreground="{DynamicResource MutedBrush}"
                   Text="Linked models are hidden with RevoBIM Temp Hide view filters - Revit cannot hide a linked element by itself. A filter cannot tell this model from a link, so an orange +N is what the same filter also hides here. Reset takes the filters off again; until then they stay on the view through a save."/>
      </Border>

      <!-- ============ footer ============ -->
      <Border Grid.Row="4" Background="{DynamicResource BarBrush}"
              CornerRadius="0,0,6,6" Padding="16,10,16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="Nothing ticked."
                     FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                     Margin="0,0,10,0" Foreground="{DynamicResource MutedBrush}"/>
          <Button x:Name="ResetButton" Grid.Column="1" Content="Reset view"
                  Style="{DynamicResource IstButton}" Margin="0,0,10,0"/>
          <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel"
                  Style="{DynamicResource IstButton}" Margin="0,0,10,0"/>
          <Button x:Name="HideButton" Grid.Column="3" Content="Hide"
                  Style="{DynamicResource IstGreenButton}"/>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

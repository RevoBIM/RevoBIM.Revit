<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Bulk Rebind"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Width="820" Height="600"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                            Background="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,-2"/>
                        <TextBlock Text="Bulk rebind - one parameter across many families"
                                   Foreground="{DynamicResource OrangeBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2" Text=""
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{DynamicResource CloseButtonStyle}"
                            VerticalAlignment="Center">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" StrokeThickness="1.4"
                              Stroke="{DynamicResource MutedTextBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="14,12,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" MinWidth="220"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.6*" MinWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- ==================== scope ==================== -->
                <DockPanel Grid.Column="0">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Height="20">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="14" CornerRadius="2"
                                    Background="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="1.  Which families" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ScopePanel" Margin="5"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                <!-- ==================== parameter ==================== -->
                <DockPanel Grid.Column="2">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="4" Height="14" CornerRadius="2"
                                    Background="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="2.  Which parameter" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="ParamSearchBox" Grid.Column="1"
                                 Style="{DynamicResource ThemedTextBoxStyle}" Tag="Search parameters..."/>
                    </Grid>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BarBg}" CornerRadius="4,4,0,0"
                            Padding="13,6,13,6" Margin="0,0,0,-1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.4*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PARAMETER" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="FAMILIES" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="SHARED" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Grid.Column="3" Text="NOT SHARED" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                        </Grid>
                    </Border>
                    <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                            BorderThickness="1" CornerRadius="0,0,4,4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ParamPanel" Margin="5"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ==================== shared parameter + preview ==================== -->
            <Border Grid.Row="2" Margin="14,4,14,8" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="14" CornerRadius="2"
                                Background="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="3.  Rebind to" Margin="8,0,12,0"
                                   Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SharedParamText" Grid.Row="0" Grid.Column="1" Text="(none chosen)"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="ChooseSharedButton" Grid.Row="0" Grid.Column="2" Content="Choose shared parameter..."
                            Style="{DynamicResource GhostButtonStyle}" Padding="12,5" VerticalAlignment="Center"/>
                    <CheckBox x:Name="SkipAlreadyBoundCheck" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                              Style="{DynamicResource ThemedCheckBoxStyle}" Margin="0,10,0,0" IsChecked="True"
                              Content="Skip families whose parameter is already bound to this shared parameter"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PreviewText" Grid.Column="0" Text="Pick a scope, a parameter and a shared parameter."
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel"
                            Style="{DynamicResource GhostButtonStyle}" Padding="16,7" Margin="0,0,8,0"
                            VerticalAlignment="Center"/>
                    <Button x:Name="QueueButton" Grid.Column="2" Content="Queue"
                            Style="{DynamicResource GreenButtonStyle}" Padding="22,7"
                            VerticalAlignment="Center" IsEnabled="False"
                            ToolTip="Adds these rebinds to the queue - nothing is written until Apply"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Choose Shared Parameter"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Width="520" Height="600"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                            Background="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,-2"/>
                        <TextBlock Text="Choose a shared parameter" Foreground="{DynamicResource OrangeBrush}"
                                   FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2" Text=""
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{DynamicResource CloseButtonStyle}"
                            VerticalAlignment="Center">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" StrokeThickness="1.4"
                              Stroke="{DynamicResource MutedTextBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="14,12,14,6">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{DynamicResource ThemedTextBoxStyle}"
                         Tag="Search shared parameters or groups..." Margin="0,0,0,8"/>
                <TextBlock x:Name="InfoText" DockPanel.Dock="Bottom" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"/>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="DefinitionListPanel" Margin="5"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BrowseFileButton" Grid.Column="0" Content="Shared parameter file..."
                            Style="{DynamicResource GhostButtonStyle}" HorizontalAlignment="Left" Padding="12,7"
                            VerticalAlignment="Center"
                            ToolTip="Point Revit at a different shared parameter file"/>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel"
                            Style="{DynamicResource GhostButtonStyle}" Padding="16,7" Margin="0,0,8,0"
                            VerticalAlignment="Center"/>
                    <Button x:Name="OkButton" Grid.Column="2" Content="Use This"
                            Style="{DynamicResource GreenButtonStyle}" Padding="20,7"
                            VerticalAlignment="Center" IsEnabled="False"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

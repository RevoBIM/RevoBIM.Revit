<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Width="560" Height="470"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="TitleTick" Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                            Background="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,-2"/>
                        <TextBlock x:Name="TitleText" Text="Family Parameter Changer"
                                   Foreground="{DynamicResource OrangeBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2" Text=""
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="14,12,14,10" Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="10,8,10,8">
                    <StackPanel x:Name="BodyPanel"/>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SecondaryButton" Grid.Column="1" Content="Cancel"
                            Style="{DynamicResource GhostButtonStyle}" Padding="16,7" Margin="0,0,8,0"
                            VerticalAlignment="Center"/>
                    <Button x:Name="PrimaryButton" Grid.Column="2" Content="OK"
                            Style="{DynamicResource GreenButtonStyle}" Padding="22,7"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

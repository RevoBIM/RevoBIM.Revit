<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Family Parameter Changer"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        MinWidth="940" MinHeight="580" Width="1220" Height="740"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Grid>
        <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                </Grid.RowDefinitions>

                <!-- ==================== header ==================== -->
                <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Image x:Name="HeaderIcon" Grid.Column="0" Width="30" Height="30"
                               Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                                       FontWeight="Bold" FontSize="20" Margin="0,0,0,-3"/>
                            <TextBlock Text="Family Parameter Changer" Foreground="{DynamicResource OrangeBrush}"
                                       FontSize="15"/>
                        </StackPanel>

                        <TextBlock x:Name="ProgressText" Grid.Column="3" Text=""
                                   Foreground="{DynamicResource GreenBrush}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,14,0" Visibility="Collapsed"/>

                        <!-- settings gear: drawn from a Path, never a symbol font -->
                        <Button x:Name="SettingsButton" Grid.Column="4" Style="{DynamicResource ChipButtonStyle}"
                                Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="Settings">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.3"
                                      Stroke="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                                      Data="M12,8 A4,4 0 1 1 12,7.99 M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M4.9,19.1 L7,17 M17,7 L19.1,4.9"/>
                                <TextBlock Text="Settings" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="ThemeToggleButton" Grid.Column="5" Content="Light"
                                Style="{DynamicResource ChipButtonStyle}" Margin="0,0,12,0"
                                VerticalAlignment="Center" ToolTip="Switch between the dark and light palette"/>

                        <TextBlock x:Name="VersionText" Grid.Column="6" Text="v1.3.0"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <!-- full screen: a square drawn from a Border, never a symbol font -->
                        <Button x:Name="FullScreenButton" Grid.Column="7" Style="{DynamicResource GlyphButtonStyle}"
                                VerticalAlignment="Center" Margin="0,0,2,0" ToolTip="Full screen (F11)">
                            <Border Width="11" Height="11" BorderThickness="1.4"
                                    BorderBrush="{DynamicResource MutedTextBrush}"/>
                        </Button>

                        <!-- close: two strokes drawn from a Path -->
                        <Button x:Name="CloseButton" Grid.Column="8" Style="{DynamicResource CloseButtonStyle}"
                                VerticalAlignment="Center" ToolTip="Close">
                            <Path Data="M0,0 L11,11 M11,0 L0,11" StrokeThickness="1.4"
                                  Stroke="{DynamicResource MutedTextBrush}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ==================== progress strip ====================
                     Two star columns whose weights are the done and remaining
                     counts, so no ActualWidth arithmetic is needed. -->
                <Grid x:Name="ProgressStrip" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ProgressDone" Width="0*"/>
                        <ColumnDefinition x:Name="ProgressRest" Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource GreenBrush}"/>
                    <Border Grid.Column="1" Background="{DynamicResource FieldBg}"/>
                </Grid>

                <!-- ==================== body ==================== -->
                <Grid x:Name="BodyGrid" Grid.Row="2" Margin="14,12,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" MinWidth="260"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2.2*" MinWidth="520"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================== families ==================== -->
                    <DockPanel Grid.Column="0">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Height="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                                    Background="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Families" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                       FontSize="13" VerticalAlignment="Center"/>
                            <Button x:Name="BulkButton" Grid.Column="3" Content="Bulk rebind..."
                                    Style="{DynamicResource OrangeButtonStyle}" FontSize="11" Padding="8,2"
                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                    ToolTip="Queue one parameter across every family in a category, or the whole project"/>
                            <Button x:Name="ExpandAllButton" Grid.Column="4" Content="Expand all"
                                    Style="{DynamicResource GhostButtonStyle}" FontSize="11" Padding="6,2"
                                    VerticalAlignment="Center"/>
                        </Grid>

                        <TextBox x:Name="FamilySearchBox" DockPanel.Dock="Top"
                                 Style="{DynamicResource ThemedTextBoxStyle}"
                                 Tag="Search families or categories..." Margin="0,0,0,8"/>

                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                                BorderThickness="1" CornerRadius="4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="FamilyListPanel" Margin="5"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                    <!-- ==================== parameters ==================== -->
                    <DockPanel Grid.Column="2">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Height="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                                    Background="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SelectedFamilyHeader" Grid.Column="1"
                                       Text="Select a family on the left" Margin="8,0,12,0"
                                       Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="ParamSearchBox" Grid.Column="2"
                                     Style="{DynamicResource ThemedTextBoxStyle}"
                                     Tag="Search parameters..."/>
                        </Grid>

                        <Border DockPanel.Dock="Top" Background="{DynamicResource BarBg}" CornerRadius="4,4,0,0"
                                Padding="13,6,13,6" Margin="0,0,0,-1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*" MinWidth="130"/>
                                    <ColumnDefinition Width="0.8*" MinWidth="62"/>
                                    <ColumnDefinition Width="2.2*" MinWidth="140"/>
                                    <ColumnDefinition Width="1.7*" MinWidth="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PARAMETER" FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Grid.Column="1" Text="KIND" FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Grid.Column="2" Text="BOUND TO" FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Grid.Column="3" Text="REBIND TO" FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </Grid>
                        </Border>

                        <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                                BorderThickness="1" CornerRadius="0,0,4,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="ParamListPanel" Margin="5"/>
                            </ScrollViewer>
                        </Border>
                    </DockPanel>
                </Grid>

                <!-- ==================== footer ==================== -->
                <Border Grid.Row="3" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
                    <Grid Margin="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ClearPendingButton" Grid.Column="0" Content="Clear queued changes"
                                Style="{DynamicResource OrangeButtonStyle}" Padding="12,6"
                                VerticalAlignment="Center" IsEnabled="False"/>
                        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="14,0,14,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh"
                                Style="{DynamicResource GhostButtonStyle}" Padding="16,7" Margin="0,0,8,0"
                                VerticalAlignment="Center" ToolTip="Re-read the families from the model (F5)"/>
                        <Button x:Name="CancelRunButton" Grid.Column="3" Content="Cancel"
                                Style="{DynamicResource OrangeButtonStyle}" Padding="16,7" Margin="0,0,8,0"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                ToolTip="Stop after the family currently being processed"/>
                        <Button x:Name="ApplyButton" Grid.Column="4" Content="Apply"
                                Style="{DynamicResource GreenButtonStyle}" Padding="24,7"
                                VerticalAlignment="Center" IsEnabled="False"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== resize overlay ====================
             No Background on the Grid, so everything underneath stays
             clickable; only the Thumb strips are hit testable. -->
        <Grid x:Name="ResizeOverlay" Panel.ZIndex="999">
            <Thumb x:Name="ThumbTop" Height="5" VerticalAlignment="Top" Cursor="SizeNS" Style="{DynamicResource ResizeThumbStyle}"/>
            <Thumb x:Name="ThumbBottom" Height="5" VerticalAlignment="Bottom" Cursor="SizeNS" Style="{DynamicResource ResizeThumbStyle}"/>
            <Thumb x:Name="ThumbLeft" Width="5" HorizontalAlignment="Left" Cursor="SizeWE" Style="{DynamicResource ResizeThumbStyle}"/>
            <Thumb x:Name="ThumbRight" Width="5" HorizontalAlignment="Right" Cursor="SizeWE" Style="{DynamicResource ResizeThumbStyle}"/>
            <Thumb x:Name="ThumbTopLeft" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" Style="{DynamicResource ResizeThumbStyle}"/>
            <Thumb x:Name="ThumbTopRight" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" Style="{DynamicResource ResizeThumbStyle}"/>
            <Thumb x:Name="ThumbBottomLeft" Width="9" Height="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" Style="{DynamicResource ResizeThumbStyle}"/>
            <Thumb x:Name="ThumbBottomRight" Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Style="{DynamicResource ResizeThumbStyle}"/>
        </Grid>
    </Grid>
</Window>

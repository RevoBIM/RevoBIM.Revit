<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Family Parameter Changer Settings"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" Width="520" Height="400"
        WindowStartupLocation="CenterOwner">

    <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="4" Height="14" CornerRadius="2"
                            Background="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,0,-2"/>
                        <TextBlock Text="Family Parameter Changer - Settings"
                                   Foreground="{DynamicResource OrangeBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2" Text=""
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{DynamicResource CloseButtonStyle}"
                            VerticalAlignment="Center">
                        <Path Data="M0,0 L11,11 M11,0 L0,11" StrokeThickness="1.4"
                              Stroke="{DynamicResource MutedTextBrush}"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="18,16,18,10">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Appearance" Margin="8,0,0,0" Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="LightThemeCheck" Style="{DynamicResource ThemedCheckBoxStyle}"
                          Content="Light palette (the header chip toggles this too)" Margin="12,0,0,18"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="4" Height="14" CornerRadius="2" Background="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Applying" Margin="8,0,0,0" Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <CheckBox x:Name="ConfirmCheck" Style="{DynamicResource ThemedCheckBoxStyle}"
                          Content="Show what Apply will do first" Margin="12,0,0,8"/>
                <CheckBox x:Name="SkipBoundCheck" Style="{DynamicResource ThemedCheckBoxStyle}"
                          Content="Bulk rebind skips families already bound to the chosen shared parameter" Margin="12,0,0,8"/>
                <CheckBox x:Name="LogCheck" Style="{DynamicResource ThemedCheckBoxStyle}"
                          Content="Write every run to a log" Margin="12,0,0,4"/>
                <TextBlock x:Name="LogPathText" Text="" Margin="34,0,0,0" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="OpenLogButton" Grid.Column="0" Content="Open log folder"
                            Style="{DynamicResource GhostButtonStyle}" Padding="12,7"
                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel"
                            Style="{DynamicResource GhostButtonStyle}" Padding="16,7" Margin="0,0,8,0"
                            VerticalAlignment="Center"/>
                    <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply"
                            Style="{DynamicResource GreenButtonStyle}" Padding="22,7"
                            VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

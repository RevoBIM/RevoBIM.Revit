<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Isolate Service Type Settings"
        Width="940" Height="990"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

  <Border Background="{DynamicResource WindowBrush}" CornerRadius="6"
          BorderBrush="{DynamicResource ChromeBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ============ header ============ -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="14,9,10,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="HeaderIcon" Grid.Column="0" Width="26" Height="26"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource BlueBrush}"/>
            <TextBlock x:Name="ToolText" Text="Service Type Settings"
                       FontSize="14" Margin="0,-2,0,0"
                       Foreground="{DynamicResource OrangeBrush}"/>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="3" Content="Light"
                  Style="{DynamicResource IstChip}" Margin="0,0,12,0"
                  VerticalAlignment="Center"/>

          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v" FontSize="11"
                     Margin="0,0,8,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Button x:Name="CloseButton" Grid.Column="5" Content="&#x2715;"
                  Style="{DynamicResource IstCloseButton}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ============ body ============ -->
      <Grid Grid.Row="1" Margin="16,14,16,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== service type parameter ========== -->
        <StackPanel Grid.Row="0" Grid.Column="0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="4" Height="18" CornerRadius="2"
                    Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="Service type parameter" FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <TextBlock Text="Which parameter holds the service, per discipline. Tray and conduit default to Service Type, duct and pipe to System Type."
                     TextWrapping="Wrap" FontSize="11.5" Margin="12,0,0,8"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Border Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Cable tray" FontSize="12.5"
                         VerticalAlignment="Center" Margin="0,0,8,4"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBox x:Name="TrayFilter" Grid.Row="0" Grid.Column="1" Tag="search"
                       Style="{DynamicResource IstTextBox}" Margin="0,0,0,4" MinHeight="26"/>
              <ComboBox x:Name="TrayCombo" Grid.Row="1" Grid.Column="1"
                        Style="{DynamicResource IstCombo}" Margin="0,0,0,10"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Conduit" FontSize="12.5"
                         VerticalAlignment="Center" Margin="0,0,8,4"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBox x:Name="ConduitFilter" Grid.Row="2" Grid.Column="1" Tag="search"
                       Style="{DynamicResource IstTextBox}" Margin="0,0,0,4" MinHeight="26"/>
              <ComboBox x:Name="ConduitCombo" Grid.Row="3" Grid.Column="1"
                        Style="{DynamicResource IstCombo}" Margin="0,0,0,10"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Duct" FontSize="12.5"
                         VerticalAlignment="Center" Margin="0,0,8,4"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBox x:Name="DuctFilter" Grid.Row="4" Grid.Column="1" Tag="search"
                       Style="{DynamicResource IstTextBox}" Margin="0,0,0,4" MinHeight="26"/>
              <ComboBox x:Name="DuctCombo" Grid.Row="5" Grid.Column="1"
                        Style="{DynamicResource IstCombo}" Margin="0,0,0,10"/>

              <TextBlock Grid.Row="6" Grid.Column="0" Text="Pipe" FontSize="12.5"
                         VerticalAlignment="Center" Margin="0,0,8,4"
                         Foreground="{DynamicResource TextBrush}"/>
              <TextBox x:Name="PipeFilter" Grid.Row="6" Grid.Column="1" Tag="search"
                       Style="{DynamicResource IstTextBox}" Margin="0,0,0,4" MinHeight="26"/>
              <ComboBox x:Name="PipeCombo" Grid.Row="7" Grid.Column="1"
                        Style="{DynamicResource IstCombo}"/>
            </Grid>
          </Border>
        </StackPanel>

        <!-- ========== behaviour ========== -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Width="4" Height="18" CornerRadius="2"
                    Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="Behaviour" FontSize="14" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>

          <Border Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12">
            <StackPanel>
              <TextBlock Text="A picked element with no service type value"
                         FontSize="12.5" Margin="0,0,0,4"
                         Foreground="{DynamicResource TextBrush}"/>
              <RadioButton x:Name="BlankSkip" GroupName="Blank"
                           Content="is left out and reported"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,2"/>
              <RadioButton x:Name="BlankBlank" GroupName="Blank"
                           Content="matches everything else that is also blank"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,2"/>
              <RadioButton x:Name="BlankGroup" GroupName="Blank"
                           Content="takes in the whole group it belongs to"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,8"/>

              <CheckBox x:Name="FallbackBuiltin" Style="{DynamicResource IstCheck}"
                        Content="If that is blank, try Revit's own System Type / Service Type"/>
              <CheckBox x:Name="MatchCase" Style="{DynamicResource IstCheck}"
                        Content="Match the value exactly, letter case included"/>
              <CheckBox x:Name="IncludeInsulation" Style="{DynamicResource IstCheck}"
                        Content="Keep insulation and lining with what it wraps"/>
              <CheckBox x:Name="IncludeSelection" Style="{DynamicResource IstCheck}"
                        Content="Always keep everything that was selected"/>
              <CheckBox x:Name="EmptyResets" Style="{DynamicResource IstCheck}"
                        Content="Finishing with nothing picked resets the view"/>
              <CheckBox x:Name="HideUncaptured" Style="{DynamicResource IstCheck}"
                        Content="Say nothing about elements left out of the isolation"/>

              <TextBlock Text="Run with nothing selected"
                         FontSize="12.5" Margin="0,10,0,4"
                         Foreground="{DynamicResource TextBrush}"/>
              <RadioButton x:Name="NothingPick" GroupName="Nothing"
                           Content="pick several, then Finish on the Options Bar"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,2"/>
              <RadioButton x:Name="NothingReset" GroupName="Nothing"
                           Content="reset the view straight away"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,2"/>
              <CheckBox x:Name="HideBrowse" Style="{DynamicResource IstCheck}"
                        Margin="10,4,0,2"
                        Content="Hide Service Type opens the category list instead"/>
              <RadioButton x:Name="TemplateApply" GroupName="TemplateRun"
                           Content="with a last template: hide it straight away"
                           Style="{DynamicResource IstRadio}" Margin="28,2,0,2"/>
              <RadioButton x:Name="TemplateList" GroupName="TemplateRun"
                           Content="with a last template: open the list with it ticked"
                           Style="{DynamicResource IstRadio}" Margin="28,2,0,2"/>
              <CheckBox x:Name="HideReplaces" Style="{DynamicResource IstCheck}"
                        Margin="10,4,0,2"
                        Content="A new hide puts the view's last one back first"/>

              <TextBlock Text="Hide Service Type puts elements away"
                         FontSize="12.5" Margin="0,10,0,4"
                         Foreground="{DynamicResource TextBrush}"/>
              <RadioButton x:Name="HideMemory" GroupName="HideMode"
                           Content="remembered, put back from the Reset Hide window"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,2"/>
              <RadioButton x:Name="HideTemporary" GroupName="HideMode"
                           Content="Revit's Temporary Hide, undone by the same reset"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,2"/>
              <RadioButton x:Name="HidePermanent" GroupName="HideMode"
                           Content="as Hide in View, undone by Reveal Hidden Elements"
                           Style="{DynamicResource IstRadio}" Margin="10,2,0,2"/>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Show results" FontSize="12.5"
                           VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <ComboBox x:Name="ResultsCombo" Grid.Column="1"
                          Style="{DynamicResource IstCombo}"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ========== categories ========== -->
        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="2">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Border Width="4" Height="18" CornerRadius="2"
                    Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="Categories isolated with each discipline" FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <TextBlock Text="Picking one element isolates every ticked category that carries the same service type."
                     TextWrapping="Wrap" FontSize="11.5" Margin="12,0,0,8"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Border Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                <TextBlock Text="Cable tray" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,0,0,3" Foreground="{DynamicResource OrangeBrush}"/>
                <StackPanel x:Name="CatsTray"/>
              </StackPanel>

              <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                <TextBlock Text="Conduit" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,0,0,3" Foreground="{DynamicResource OrangeBrush}"/>
                <StackPanel x:Name="CatsConduit"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="0">
                <TextBlock Text="Duct" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,0,0,3" Foreground="{DynamicResource OrangeBrush}"/>
                <StackPanel x:Name="CatsDuct"/>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="2">
                <TextBlock Text="Pipe" FontSize="12.5" FontWeight="SemiBold"
                           Margin="0,0,0,3" Foreground="{DynamicResource OrangeBrush}"/>
                <StackPanel x:Name="CatsPipe"/>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,4">
            <Border Width="4" Height="18" CornerRadius="2"
                    Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
            <TextBlock Text="Categories with no service type" FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}"/>
          </StackPanel>
          <TextBlock Text="Pick an electrical board alongside a tray and the tray isolates by service type as normal. This is what happens to the board."
                     TextWrapping="Wrap" FontSize="11.5" Margin="12,0,0,8"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Border Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12">
            <StackPanel>
              <RadioButton x:Name="OtherCategory" GroupName="Other"
                           Content="Isolate the whole category"
                           Style="{DynamicResource IstRadio}"/>
              <RadioButton x:Name="OtherFamily" GroupName="Other"
                           Content="Isolate only that family"
                           Style="{DynamicResource IstRadio}"/>
              <RadioButton x:Name="OtherType" GroupName="Other"
                           Content="Isolate only that type"
                           Style="{DynamicResource IstRadio}"/>
              <RadioButton x:Name="OtherIgnore" GroupName="Other"
                           Content="Leave it out and say so"
                           Style="{DynamicResource IstRadio}"/>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Keyboard shortcut" FontSize="12.5" FontWeight="SemiBold"
                         Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock Text="View &#x2192; User Interface &#x2192; Keyboard Shortcuts, search &quot;RevoBIM Isolate Service Type&quot; and bind a key. The command opens no window, so it is one keypress from a selection to an isolated view."
                         TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,8"
                         Foreground="{DynamicResource MutedBrush}"/>
              <Button x:Name="ShortcutButton" Content="Open Keyboard Shortcuts"
                      Style="{DynamicResource IstButton}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- ============ footer ============ -->
      <Border Grid.Row="2" Background="{DynamicResource BarBrush}"
              CornerRadius="0,0,6,6" Padding="16,10,16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Text="" FontSize="11.5"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource MutedBrush}"/>
          <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel"
                  Style="{DynamicResource IstButton}" Margin="0,0,10,0"/>
          <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply"
                  Style="{DynamicResource IstGreenButton}"/>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM"
        SizeToContent="Height"
        Width="480" MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource WinBg}" CornerRadius="6"
            BorderBrush="{DynamicResource EdgeSoft}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" x:Name="msg_header"
                    Background="{DynamicResource BarBg}" CornerRadius="5,5,0,0"
                    Padding="14,8,4,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BlueBrush}"/>
                        <TextBlock x:Name="sub_txt" Text="Space Name To Element" FontSize="11"
                                   Foreground="{DynamicResource OrangeBrush}" Margin="0,-2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="msg_close" Content="&#x2715;"
                            Style="{DynamicResource BtnClose}" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="440">
                <TextBlock x:Name="body_txt" Margin="16,14,16,14" TextWrapping="Wrap"
                           FontSize="12.5" LineHeight="19"
                           Foreground="{DynamicResource TextBrush}"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,5,5"
                    Padding="14,10,14,10" BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="no_btn" Content="Cancel" Width="90" Margin="0,0,8,0"
                            Style="{DynamicResource BtnGhost}"/>
                    <Button x:Name="yes_btn" Content="OK" Width="110"
                            Style="{DynamicResource BtnGreen}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

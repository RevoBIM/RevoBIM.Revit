<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Isolate Service Type"
        Width="600" Height="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

  <Border Background="{DynamicResource WindowBrush}" CornerRadius="6"
          BorderBrush="{DynamicResource ChromeBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ============ header ============ -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBrush}"
              CornerRadius="6,6,0,0" Padding="14,9,10,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="HeaderIcon" Grid.Column="0" Width="26" Height="26"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource BlueBrush}"/>
            <TextBlock x:Name="ToolText" Text="Isolate Service Type" FontSize="14"
                       Margin="0,-2,0,0" Foreground="{DynamicResource OrangeBrush}"/>
          </StackPanel>

          <TextBlock x:Name="VersionText" Grid.Column="3" Text="v" FontSize="11"
                     Margin="0,0,8,0" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"/>

          <Button x:Name="CloseButton" Grid.Column="4" Content="&#x2715;"
                  Style="{DynamicResource IstCloseButton}" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ============ body ============ -->
      <Grid Grid.Row="1" Margin="16,14,16,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
          <Border Width="4" Height="18" CornerRadius="2"
                  Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
          <TextBlock x:Name="HeadingText" Text="Result" FontSize="14"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}"/>
        </StackPanel>

        <ListBox x:Name="BodyList" Grid.Row="1" Style="{DynamicResource IstList}"
                 Padding="4"/>
      </Grid>

      <!-- ============ footer ============ -->
      <Border Grid.Row="2" Background="{DynamicResource BarBrush}"
              CornerRadius="0,0,6,6" Padding="16,10,16,10">
        <Grid>
          <TextBlock Text="Run it again and press Finish with nothing picked to reset the view."
                     FontSize="11.5" VerticalAlignment="Center"
                     Foreground="{DynamicResource MutedBrush}"/>
          <Button x:Name="OkButton" Content="Close" HorizontalAlignment="Right"
                  Style="{DynamicResource IstButton}"/>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

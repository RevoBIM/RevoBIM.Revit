<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Service Spacing"
        Width="720" SizeToContent="Height" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">

  <Window.Resources>
    <SolidColorBrush x:Key="Shell"   Color="#232326"/>
    <SolidColorBrush x:Key="Card"    Color="#2B2B2E"/>
    <SolidColorBrush x:Key="Field"   Color="#1C1C1F"/>
    <SolidColorBrush x:Key="Bar"     Color="#1C1C1F"/>
    <SolidColorBrush x:Key="Edge"    Color="#3E3E42"/>
    <SolidColorBrush x:Key="Body"    Color="#E4E4E4"/>
    <SolidColorBrush x:Key="Muted"   Color="#9A9A9E"/>
    <SolidColorBrush x:Key="Blue"    Color="#4FA3E3"/>
    <SolidColorBrush x:Key="Orange"  Color="#E8912D"/>
    <SolidColorBrush x:Key="Green"   Color="#3FA75A"/>
    <SolidColorBrush x:Key="GreenHi" Color="#4EC06D"/>
    <SolidColorBrush x:Key="Red"     Color="#D9534F"/>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9A9A9E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chrome" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chrome" Property="Background" Value="#D9534F"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Green}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chrome" CornerRadius="3"
                    Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chrome" Property="Background"
                        Value="{StaticResource GreenHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tick" TargetType="Border">
      <Setter Property="Width" Value="4"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Shell}" CornerRadius="6"
          BorderBrush="#4A4A50" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource Bar}"
              CornerRadius="6,6,0,0" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderIcon" Grid.Column="0" Width="30" Height="30"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Blue}"/>
            <TextBlock Text="Service Spacing" FontSize="15"
                       Foreground="{StaticResource Orange}" Margin="0,-2,0,0"/>
          </StackPanel>
          <TextBlock x:Name="VersionText" Grid.Column="2" FontSize="11"
                     Foreground="{StaticResource Muted}"
                     VerticalAlignment="Top" Margin="0,2,10,0"/>
          <Button x:Name="CloseBtn" Grid.Column="3" Content="&#x2715;"
                  Style="{StaticResource CloseButton}" VerticalAlignment="Top"/>
        </Grid>
      </Border>

      <!-- body -->
      <Grid Grid.Row="1" Margin="14,12,14,8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
          <Border Style="{StaticResource Tick}" Background="{StaticResource Blue}"/>
          <TextBlock Text="What was spaced" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource Body}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="SummaryText" Grid.Row="1" FontSize="12"
                   Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                   Margin="12,0,0,8"/>

        <Border Grid.Row="2" Background="{StaticResource Field}"
                BorderBrush="{StaticResource Edge}" BorderThickness="1"
                CornerRadius="3" Margin="12,0,0,10" MinHeight="150"
                MaxHeight="320">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto" Padding="10,8">
            <TextBlock x:Name="TableText" FontFamily="Consolas" FontSize="11.5"
                       Foreground="{StaticResource Body}"/>
          </ScrollViewer>
        </Border>

        <StackPanel x:Name="NotesHeader" Grid.Row="3" Orientation="Horizontal"
                    Margin="0,4,0,6" Visibility="Collapsed">
          <Border Style="{StaticResource Tick}" Background="{StaticResource Orange}"/>
          <TextBlock Text="Left alone" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource Body}" VerticalAlignment="Center"/>
        </StackPanel>

        <Border x:Name="NotesBox" Grid.Row="4" Background="{StaticResource Field}"
                BorderBrush="{StaticResource Edge}" BorderThickness="1"
                CornerRadius="3" Margin="12,0,0,0" MaxHeight="150"
                Visibility="Collapsed">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
            <TextBlock x:Name="NotesText" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource Body}"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="2" Background="{StaticResource Bar}"
              CornerRadius="0,0,6,6" Padding="14,8">
        <Grid>
          <TextBlock x:Name="StatusText" HorizontalAlignment="Left"
                     VerticalAlignment="Center" FontSize="11"
                     Foreground="{StaticResource Muted}"/>
          <Button x:Name="OkBtn" Content="Close" Style="{StaticResource Action}"
                  HorizontalAlignment="Right"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Service Spacing Settings"
        Width="790" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">

  <Window.Resources>
    <SolidColorBrush x:Key="Shell"   Color="#232326"/>
    <SolidColorBrush x:Key="Card"    Color="#2B2B2E"/>
    <SolidColorBrush x:Key="Field"   Color="#1C1C1F"/>
    <SolidColorBrush x:Key="Bar"     Color="#1C1C1F"/>
    <SolidColorBrush x:Key="Edge"    Color="#3E3E42"/>
    <SolidColorBrush x:Key="Body"    Color="#E4E4E4"/>
    <SolidColorBrush x:Key="Muted"   Color="#9A9A9E"/>
    <SolidColorBrush x:Key="Blue"    Color="#4FA3E3"/>
    <SolidColorBrush x:Key="Orange"  Color="#E8912D"/>
    <SolidColorBrush x:Key="Green"   Color="#3FA75A"/>
    <SolidColorBrush x:Key="GreenHi" Color="#4EC06D"/>
    <SolidColorBrush x:Key="Select"  Color="#2B5473"/>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9A9A9E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chrome" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chrome" Property="Background" Value="#D9534F"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Action" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Green}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="chrome" CornerRadius="3"
                    Background="{TemplateBinding Background}">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="chrome" Property="Background"
                        Value="{StaticResource GreenHi}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="#3A3A40"/>
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Body}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Body}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="CaretBrush" Value="{StaticResource Body}"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Select}"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource Field}"/>
      <Setter Property="Foreground" Value="{StaticResource Body}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,3"/>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#1C1C1F"/>
      <Setter Property="Foreground" Value="{StaticResource Body}"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="chrome" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="chrome" Property="Background"
                        Value="{StaticResource Select}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Body}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="14" Height="14" CornerRadius="2"
                      Background="#1C1C1F" BorderBrush="#3E3E42"
                      BorderThickness="1" VerticalAlignment="Center"
                      Margin="0,0,8,0">
                <TextBlock x:Name="tick" Text="&#x2713;" FontSize="10"
                           Foreground="White" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background"
                        Value="{StaticResource Blue}"/>
                <Setter TargetName="box" Property="BorderBrush"
                        Value="{StaticResource Blue}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Tick" TargetType="Border">
      <Setter Property="Width" Value="4"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="CornerRadius" Value="2"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <Border Background="{StaticResource Shell}" CornerRadius="6"
          BorderBrush="#4A4A50" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{StaticResource Bar}"
              CornerRadius="6,6,0,0" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderIcon" Grid.Column="0" Width="30" Height="30"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource Blue}"/>
            <TextBlock Text="Service Spacing Settings" FontSize="15"
                       Foreground="{StaticResource Orange}" Margin="0,-2,0,0"/>
          </StackPanel>
          <TextBlock x:Name="VersionText" Grid.Column="2" FontSize="11"
                     Foreground="{StaticResource Muted}"
                     VerticalAlignment="Top" Margin="0,2,10,0"/>
          <Button x:Name="CloseBtn" Grid.Column="3" Content="&#x2715;"
                  Style="{StaticResource CloseButton}" VerticalAlignment="Top"/>
        </Grid>
      </Border>

      <!-- body, two columns so it fits without scrolling -->
      <Grid Grid.Row="1" Margin="14,12,14,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- left -->
        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource Tick}" Background="{StaticResource Blue}"/>
            <TextBlock Text="The spacing rule" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>

          <Border Background="{StaticResource Card}" CornerRadius="4"
                  BorderBrush="{StaticResource Edge}" BorderThickness="1"
                  Padding="12,10">
            <StackPanel>
              <TextBlock Text="Centre to centre = half width + half width + clear gap, rounded up.  The gap is a clear edge-to-edge distance."
                         Foreground="{StaticResource Muted}" FontSize="11"
                         TextWrapping="Wrap" Margin="0,0,0,8"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Clear gap, service to service (mm)"/>
                <TextBox x:Name="GapServices" Grid.Row="0" Grid.Column="1"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Clear gap, cable tray edge to edge (mm)"/>
                <TextBox x:Name="GapContainment" Grid.Row="1" Grid.Column="1"/>

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="Clear gap, trunking to anything (mm)"/>
                <TextBox x:Name="GapTrunking" Grid.Row="2" Grid.Column="1"/>

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="Round centre to centre up to (mm)"/>
                <TextBox x:Name="RoundTo" Grid.Row="3" Grid.Column="1"/>

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="Family name token that means trunking"/>
                <TextBox x:Name="TrunkingToken" Grid.Row="4" Grid.Column="1"/>
              </Grid>

              <CheckBox x:Name="TrunkingGapWins"
                        Content="Trunking gap beats the cable tray gap"/>

              <TextBlock Text="A service beside a cable tray" Margin="0,10,0,0"/>
              <ComboBox x:Name="MixedGap">
                <ComboBoxItem Content="Use the larger of the two gaps"/>
                <ComboBoxItem Content="Use the service gap"/>
                <ComboBoxItem Content="Use the cable tray gap"/>
              </ComboBox>

              <CheckBox x:Name="IncludeInsulation"
                        Content="Add insulation and lining thickness"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
            <Border Style="{StaticResource Tick}" Background="{StaticResource Orange}"/>
            <TextBlock Text="Reporting" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>

          <Border Background="{StaticResource Card}" CornerRadius="4"
                  BorderBrush="{StaticResource Edge}" BorderThickness="1"
                  Padding="12,10">
            <StackPanel>
              <TextBlock Text="Show results"/>
              <ComboBox x:Name="ShowResults">
                <ComboBoxItem Content="Only if something needs a look"/>
                <ComboBoxItem Content="Always"/>
                <ComboBoxItem Content="Never"/>
              </ComboBox>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- right -->
        <StackPanel Grid.Column="2">
          <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <Border Style="{StaticResource Tick}" Background="{StaticResource Blue}"/>
            <TextBlock Text="How the string is laid out" FontSize="13"
                       FontWeight="SemiBold"/>
          </StackPanel>

          <Border Background="{StaticResource Card}" CornerRadius="4"
                  BorderBrush="{StaticResource Edge}" BorderThickness="1"
                  Padding="12,10">
            <StackPanel>
              <TextBlock Text="Spread the services along"/>
              <ComboBox x:Name="SpacingAxis">
                <ComboBoxItem Content="Square to the run, in plan (auto)"/>
                <ComboBoxItem Content="Horizontally"/>
                <ComboBoxItem Content="Vertically, a stacked bank"/>
              </ComboBox>

              <TextBlock Text="The one that does not move" Margin="0,8,0,0"/>
              <ComboBox x:Name="Anchor">
                <ComboBoxItem Content="The first along the axis"/>
                <ComboBoxItem Content="The first selected"/>
                <ComboBoxItem Content="The widest"/>
              </ComboBox>

              <TextBlock Text="Order across the string" Margin="0,8,0,0"/>
              <ComboBox x:Name="Order">
                <ComboBoxItem Content="Keep where they already are"/>
                <ComboBoxItem Content="Selection order"/>
              </ComboBox>

              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Off-direction tolerance (degrees)"/>
                <TextBox x:Name="AngleTolerance" Grid.Column="1"/>
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
            <Border Style="{StaticResource Tick}" Background="{StaticResource Blue}"/>
            <TextBlock Text="Rows" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>

          <Border Background="{StaticResource Card}" CornerRadius="4"
                  BorderBrush="{StaticResource Edge}" BorderThickness="1"
                  Padding="12,10">
            <StackPanel>
              <CheckBox x:Name="RowSplit"
                        Content="Split the selection into rows by level"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" TextWrapping="Wrap"
                           Text="A new row past this, top edge to bottom edge (mm)"/>
                <TextBox x:Name="RowClear" Grid.Column="1"
                         VerticalAlignment="Center"/>
              </Grid>
              <CheckBox x:Name="SpaceRows"
                        Content="Also space the rows apart vertically"/>
            </StackPanel>
          </Border>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
            <Border Style="{StaticResource Tick}" Background="{StaticResource Orange}"/>
            <TextBlock Text="What travels" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>

          <Border Background="{StaticResource Card}" CornerRadius="4"
                  BorderBrush="{StaticResource Edge}" BorderThickness="1"
                  Padding="12,10">
            <StackPanel>
              <CheckBox x:Name="MoveRun"
                        Content="Carry connected fittings and inline runs"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Stop a run walk at"/>
                <TextBox x:Name="MaxRun" Grid.Column="1"/>
              </Grid>
              <CheckBox x:Name="Unpin"
                        Content="Unpin for the move, pin again after"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="2" Background="{StaticResource Bar}"
              CornerRadius="0,0,6,6" Padding="14,8">
        <Grid>
          <TextBlock x:Name="StatusText" HorizontalAlignment="Left"
                     VerticalAlignment="Center" FontSize="11"
                     Foreground="{StaticResource Muted}"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ShortcutsBtn" Content="Keyboard shortcuts"
                    Style="{StaticResource Quiet}"/>
            <Button x:Name="DefaultsBtn" Content="Defaults"
                    Style="{StaticResource Quiet}"/>
            <Button x:Name="ApplyBtn" Content="Apply"
                    Style="{StaticResource Action}"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

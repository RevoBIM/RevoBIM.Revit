<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM MEP System Manager Change Pipe Type"
        Width="920" Height="640" MinWidth="760" MinHeight="420" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5">
    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource WinEdge}"
            Background="{DynamicResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== header ==================== -->
            <Border x:Name="HeaderBar" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0" Padding="12,8,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v" Foreground="{DynamicResource Muted}" FontSize="11"
                                   Margin="10,0,8,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnShrink" Style="{DynamicResource BtnIcon}"
                                ToolTip="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)">
                            <Grid Width="14" Height="14">
                                <Path x:Name="ShrinkGlyph" Data="M7,1 L7,9 M3.5,5.5 L7,9 L10.5,5.5 M2,12.5 L12,12.5"
                                      Stroke="{DynamicResource Text}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path x:Name="ExpandGlyph" Data="M7,13 L7,2.5 M2.5,7 L7,2.5 L11.5,7" Visibility="Collapsed"
                                      Stroke="{DynamicResource Green}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Grid>
                        </Button>
                        <Button x:Name="BtnClose" Style="{DynamicResource BtnClose}" ToolTip="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Text}" StrokeThickness="1.6"/>
                        </Button>
                    </StackPanel>
                    <Border x:Name="LogoHost" Background="Transparent" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="Logo" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LogoText" Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Blue}"/>
                                <TextBlock x:Name="SubTitle" Text="Change Pipe Type" FontSize="15"
                                           Foreground="{DynamicResource Orange}" Margin="1,-4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ==================== body ==================== -->
            <DockPanel Grid.Row="1" Margin="16,12,16,6">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="SelText" Foreground="{DynamicResource Text}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Sort by" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <ComboBox x:Name="CmbSort" Width="150"/>
                        </StackPanel>
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Pick the size each current type and size goes to on the new pipe type. Each size has its own colour."/>
                    </DockPanel>
                    <!-- column headings; the rows below use the same widths -->
                    <Grid Margin="0,0,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="2.2*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Current type" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="Pipes" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="Changing to" Foreground="{DynamicResource Orange}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="From size (mm)" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="New size (mm)" Foreground="{DynamicResource Orange}" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
                <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                        BorderThickness="1" CornerRadius="4">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RowsHost" Margin="0,2,0,2"/>
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- ==================== footer ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource Bar}" CornerRadius="0,0,6,6" Padding="12,8,12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,8,0"/>
                        <Button x:Name="BtnApply" Style="{DynamicResource BtnGreen}" Content="Apply"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

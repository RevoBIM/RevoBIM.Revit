<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM MEP System Manager Settings"
        Width="900" Height="780" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5">
    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource WinEdge}"
            Background="{DynamicResource Bg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================== header ==================== -->
            <Border x:Name="HeaderBar" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0" Padding="12,8,8,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" Text="v" Foreground="{DynamicResource Muted}" FontSize="11"
                                   Margin="10,0,8,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnShrink" Style="{DynamicResource BtnIcon}"
                                ToolTip="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)">
                            <Grid Width="14" Height="14">
                                <Path x:Name="ShrinkGlyph" Data="M7,1 L7,9 M3.5,5.5 L7,9 L10.5,5.5 M2,12.5 L12,12.5"
                                      Stroke="{DynamicResource Text}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <Path x:Name="ExpandGlyph" Data="M7,13 L7,2.5 M2.5,7 L7,2.5 L11.5,7" Visibility="Collapsed"
                                      Stroke="{DynamicResource Green}" StrokeThickness="2.4"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Grid>
                        </Button>
                        <Button x:Name="BtnClose" Style="{DynamicResource BtnClose}" ToolTip="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{DynamicResource Text}" StrokeThickness="1.6"/>
                        </Button>
                    </StackPanel>
                    <Border x:Name="LogoHost" Background="Transparent" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="Logo" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="LogoText" Text="RevoBIM" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Blue}"/>
                                <TextBlock x:Name="SubTitle" Text="MEP System Manager Settings" FontSize="15"
                                           Foreground="{DynamicResource Orange}" Margin="1,-4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ==================== body: two columns, no scrolling ==================== -->
            <Grid Grid.Row="1" Margin="14,12,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Blue}" Margin="0,0,7,0"/>
                        <TextBlock Text="Grouping" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" x:Name="LblGroupBy" Text="Group services by" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbGroupBy" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Parameter" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbGroupParam" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="2" x:Name="LblSystemFrom" Text="System number from" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbSystemFrom" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="3" Text="Scope" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbSScope" Margin="0,0,0,6"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,14">
                        <TextBlock Text="Rows split by" Width="150" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkSSystem" Content="System No" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ChkSType" Content="Pipe Type" Margin="0,0,12,0"/>
                        <CheckBox x:Name="ChkSSize" Content="Size"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Orange}" Margin="0,0,7,0"/>
                        <TextBlock Text="Isolate in 3D" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Isolate" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="CmbIsolateWhat"/>
                    </Grid>
                    <CheckBox x:Name="ChkZoom" Content="Zoom to the isolated elements" Margin="150,4,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="150,0,0,6">
                        <CheckBox x:Name="ChkSectionBox" Content="Fit the section box in chosen 3D views too, margin"
                                  ToolTip="The default 3D view always has its section box fitted round what is isolated. Tick this to do the same in a 3D view picked from the list." VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtMargin" Width="60" Margin="8,0,6,0" Tag="mm"/>
                        <TextBlock Text="mm" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="ChkSelect" Content="Select them in Revit as well" Margin="150,0,0,14"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Blue}" Margin="0,0,7,0"/>
                        <TextBlock Text="Window" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Theme" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="CmbTheme" Margin="0,0,0,6"/>
                        <TextBlock Grid.Row="1" Text="Show results" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CmbResults"/>
                    </Grid>
                    <TextBlock Text="Fittings when changing type" Foreground="{DynamicResource Muted}"
                               Margin="0,10,0,4"/>
                    <ComboBox x:Name="CmbFittingMode"/>
                    <TextBlock Text="Accessory size parameters" Foreground="{DynamicResource Muted}"
                               Margin="0,10,0,4"/>
                    <TextBox x:Name="TxtAccessoryParams" Height="32" Tag="BGL_Diameter, Nominal Diameter"
                             ToolTip="Instance parameters on a pipe accessory that hold its size - set to the pipe's new size, in this order. Separate them with commas."/>
                    <CheckBox x:Name="ChkDisconnect" Content="Let Revit disconnect a family it cannot keep"
                              Margin="0,10,0,2"
                              ToolTip="Revit asks this when a family on the run cannot stay connected at the new size. Off: the pipe is left as it was. On: Revit disconnects, and everything it disconnects is listed so you can reconnect it."/>
                    <CheckBox x:Name="ChkLinked" Content="Look up linked elements" Margin="0,10,0,2"
                              ToolTip="Off: Pick System never takes anything from a linked model. On: clicking a linked model lets you pick inside it, reported read-only."/>
                    <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11.5" Margin="22,0,0,0"
                               Text="Off by default. Linked elements are never listed or changed either way."/>
                </StackPanel>

                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Width="4" Height="16" CornerRadius="2" Background="{DynamicResource Orange}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ChangeTitle" Text="Change type" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                        </StackPanel>
                        <CheckBox x:Name="ChkFittings" Content="Swap fittings to the new type" Margin="0,0,0,6"/>
                        <CheckBox x:Name="ChkKeepSize" Content="Keep each element's size" Margin="0,0,0,12"/>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="RetainCount" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Parameters to retain" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="BtnRetainNone" DockPanel.Dock="Right" Content="None" Margin="6,0,0,0"/>
                            <Button x:Name="BtnRetainAll" DockPanel.Dock="Right" Content="All" Margin="6,0,0,0"/>
                            <TextBox x:Name="TxtRetainSearch" Tag="Search parameters..."/>
                        </DockPanel>
                    </StackPanel>
                    <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Edge}"
                            BorderThickness="1" CornerRadius="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="RetainHost" Margin="8,6,8,6"/>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ==================== footer ==================== -->
            <Border Grid.Row="2" Background="{DynamicResource Bar}" CornerRadius="0,0,6,6" Padding="12,8,12,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Cancel" Margin="0,0,8,0"/>
                        <Button x:Name="BtnApply" Style="{DynamicResource BtnGreen}" Content="Apply"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                               Text="Saved to %APPDATA%\RevoBIM\mep_system_manager.txt"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>

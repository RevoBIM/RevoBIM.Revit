<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Adjust replacements"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SnapsToDevicePixels="True">

  <Border CornerRadius="6" Background="{DynamicResource BgWindow}"
          BorderBrush="{DynamicResource BrdWindow}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="AdjHeaderBar" Grid.Row="0" Background="{DynamicResource BgBar}"
              CornerRadius="5,5,0,0" Padding="14,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="AdjIconImage" Grid.Column="0" Width="26" Height="26"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" Style="{DynamicResource Wordmark}"/>
            <TextBlock Text="Adjust replacements" Style="{DynamicResource ToolName}"
                       Margin="9,0,0,1" VerticalAlignment="Bottom"/>
          </StackPanel>

          <TextBlock x:Name="AdjVersionText" Grid.Column="3" Text="v1.0.0"
                     Style="{DynamicResource VersionLabel}"
                     VerticalAlignment="Center" Margin="0,0,10,0"/>

          <Button x:Name="AdjShrinkBtn" Grid.Column="4"
                  Style="{DynamicResource BtnShrink}"/>

          <Button x:Name="AdjCloseBtn" Grid.Column="5" Content="&#x2715;"
                  Style="{DynamicResource BtnClose}"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="12,10,12,6">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{DynamicResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{DynamicResource TickBlue}"/>
              <TextBlock Text="Rotation" Style="{DynamicResource SectionHeading}"/>
            </StackPanel>

            <TextBlock x:Name="AdjCountText" Margin="0,8,0,0" TextWrapping="Wrap"
                       Style="{DynamicResource Muted}"
                       Text="Each replacement turns about its own insertion point."/>

            <UniformGrid Rows="1" Columns="5" Margin="0,10,0,0">
              <RadioButton x:Name="Rot0" GroupName="Rot" Content="0&#x00B0;"
                           IsChecked="True" Style="{DynamicResource ModeTab}"
                           Margin="0,0,3,0"/>
              <RadioButton x:Name="Rot90" GroupName="Rot" Content="90&#x00B0;"
                           Style="{DynamicResource ModeTab}" Margin="3,0,3,0"/>
              <RadioButton x:Name="Rot180" GroupName="Rot" Content="180&#x00B0;"
                           Style="{DynamicResource ModeTab}" Margin="3,0,3,0"/>
              <RadioButton x:Name="Rot270" GroupName="Rot" Content="270&#x00B0;"
                           Style="{DynamicResource ModeTab}" Margin="3,0,3,0"/>
              <RadioButton x:Name="RotCustom" GroupName="Rot" Content="Custom"
                           Style="{DynamicResource ModeTab}" Margin="3,0,0,0"/>
            </UniformGrid>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Custom angle, degrees"
                         VerticalAlignment="Center" Style="{DynamicResource Muted}"
                         Margin="0,0,10,0"/>
              <TextBox x:Name="RotCustomBox" Grid.Column="1" Text="0"
                       IsEnabled="False"/>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Collapsed for detail items from a drafting view, which has no
             depth to offset into. -->
        <Border x:Name="AdjHeightCard" Grid.Row="1" Style="{DynamicResource Card}">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{DynamicResource TickOrange}"/>
              <TextBlock Text="Height" Style="{DynamicResource SectionHeading}"/>
            </StackPanel>

            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Z offset, mm"
                         VerticalAlignment="Center" Style="{DynamicResource Muted}"
                         Margin="0,0,10,0"/>
              <TextBox x:Name="ZOffsetBox" Grid.Column="1" Text="0"/>
            </Grid>

            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap"
                       Style="{DynamicResource Muted}"
                       Text="Both numbers are absolute, measured from where the replacements landed. Apply as often as you like - only the difference is written to the model."/>
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource BgBar}"
              CornerRadius="0,0,5,5" Padding="14,9">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Button x:Name="AdjSelectBtn" Grid.Column="0" Content="Select in model"
                  Style="{DynamicResource BtnOrange}"/>

          <TextBlock x:Name="AdjStatusText" Grid.Column="1" Margin="14,0,14,0"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Style="{DynamicResource Muted}" Text=""/>

          <Button x:Name="AdjResetBtn" Grid.Column="2" Content="Reset"
                  Style="{DynamicResource BtnGhost}" Margin="0,0,8,0"/>

          <Button x:Name="AdjApplyBtn" Grid.Column="3" Content="Apply"
                  Style="{DynamicResource BtnGreen}"/>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>

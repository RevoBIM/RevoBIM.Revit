<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ================= palette : RevoBIM PY house theme ================= -->
  <SolidColorBrush x:Key="BgWindow"    Color="#232326"/>
  <SolidColorBrush x:Key="BgCard"      Color="#2B2B2E"/>
  <SolidColorBrush x:Key="BgField"     Color="#1C1C1F"/>
  <SolidColorBrush x:Key="BgBar"       Color="#1C1C1F"/>
  <SolidColorBrush x:Key="BgHover"     Color="#35353A"/>
  <SolidColorBrush x:Key="BgPressed"   Color="#3E3E45"/>
  <SolidColorBrush x:Key="BrdEdge"     Color="#3E3E42"/>
  <SolidColorBrush x:Key="BrdWindow"   Color="#4A4A50"/>
  <SolidColorBrush x:Key="FgBody"      Color="#E4E4E4"/>
  <SolidColorBrush x:Key="FgMuted"     Color="#9A9A9E"/>
  <SolidColorBrush x:Key="FgDisabled"  Color="#6A6A70"/>
  <SolidColorBrush x:Key="AccBlue"     Color="#4FA3E3"/>
  <SolidColorBrush x:Key="AccBlueDim"  Color="#2F6C99"/>
  <SolidColorBrush x:Key="AccOrange"   Color="#E8912D"/>
  <SolidColorBrush x:Key="AccOrangeDim" Color="#9A6120"/>
  <SolidColorBrush x:Key="FgOnAccent"  Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccGreen"    Color="#3FA75A"/>
  <SolidColorBrush x:Key="AccGreenHi"  Color="#4EC06D"/>
  <SolidColorBrush x:Key="AccRed"      Color="#D9534F"/>
  <SolidColorBrush x:Key="AccRedHi"    Color="#E4706C"/>
  <SolidColorBrush x:Key="SelHi"       Color="#2B5473"/>
  <SolidColorBrush x:Key="Clear"       Color="#00000000"/>

  <!-- ================= text ================= -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style x:Key="Wordmark" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccBlue}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style x:Key="ToolName" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccOrange}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="15"/>
  </Style>

  <Style x:Key="VersionLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style x:Key="Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Margin" Value="0,6,0,3"/>
  </Style>

  <Style x:Key="SectionHeading" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- 4px coloured tick to the left of a section label -->
  <Style x:Key="TickBlue" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource AccBlue}"/>
    <Setter Property="Width" Value="4"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TickOrange" TargetType="Border" BasedOn="{StaticResource TickBlue}">
    <Setter Property="Background" Value="{StaticResource AccOrange}"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrdEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="10"/>
  </Style>

  <!-- ================= scrollbar ================= -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" Background="#4A4A50" CornerRadius="3" Margin="3,2,3,2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#5E5E66"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollLine" TargetType="RepeatButton">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollLine}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollLine}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <!-- ================= text box ================= -->
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="Background" Value="{StaticResource BgField}"/>
    <Setter Property="CaretBrush" Value="{StaticResource FgBody}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource SelHi}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrdEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource FgDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= check box ================= -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="Background" Value="{StaticResource BgField}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Grid.Column="0" Width="14" Height="14"
                    CornerRadius="2" VerticalAlignment="Center"
                    Background="{StaticResource BgField}"
                    BorderBrush="{StaticResource BrdEdge}" BorderThickness="1">
              <Path x:Name="Tick" Visibility="Collapsed" Stretch="Uniform"
                    Margin="2.5" Stroke="#232326" StrokeThickness="2"
                    Data="M 0,4 L 3,7 L 9,0"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="7,0,0,0"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource AccBlue}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccBlue}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource FgDisabled}"/>
              <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= radio button, drawn as a segmented tab ================= -->
  <Style x:Key="ModeTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Bd" Background="{StaticResource BgField}"
                  BorderBrush="{StaticResource BrdEdge}" BorderThickness="1"
                  CornerRadius="3" Padding="10,5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelHi}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccBlue}"/>
              <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccBlue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StepTab" TargetType="RadioButton" BasedOn="{StaticResource ModeTab}"/>

  <!-- ================= combo box ================= -->
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="8,5">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelHi}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Background="{StaticResource BgField}"
                  BorderBrush="{StaticResource BrdEdge}" BorderThickness="1"
                  CornerRadius="3">
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,9,0" Fill="{StaticResource FgMuted}"
                  Data="M 0,0 L 8,0 L 4,5 Z"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource FgDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="Background" Value="{StaticResource BgField}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="Sel" Margin="8,0,24,0"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"/>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Focusable="False" PopupAnimation="None">
              <Border Background="{StaticResource BgCard}"
                      BorderBrush="{StaticResource BrdEdge}" BorderThickness="1"
                      CornerRadius="3"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="300">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource FgDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= lists ================= -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="7,4" CornerRadius="2">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelHi}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{StaticResource BgField}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrdEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3">
            <ScrollViewer Focusable="False" Padding="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= buttons ================= -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="Background" Value="{StaticResource BgHover}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrdEdge}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Height" Value="27"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="3"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              <Setter Property="Foreground" Value="{StaticResource FgDisabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource BgField}"/>
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
  </Style>

  <Style x:Key="BtnBlue" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource AccBlue}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccBlue}"/>
    <Setter Property="Foreground" Value="#101216"/>
  </Style>

  <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource Clear}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccOrange}"/>
    <Setter Property="Foreground" Value="{StaticResource AccOrange}"/>
  </Style>

  <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource AccGreen}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccGreen}"/>
    <Setter Property="Foreground" Value="#0F1A12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="20,0"/>
  </Style>

  <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Height" Value="22"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="Background" Value="{StaticResource BgField}"/>
  </Style>

  <!-- colours set from code so the state can change at runtime -->
  <Style x:Key="BtnStatus" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{StaticResource Clear}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BrdEdge}"/>
    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Padding" Value="10,0"/>
  </Style>

  <Style x:Key="BtnClose" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccRed}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ======================= shrink to taskbar ======================= -->
  <!-- Beside close in every window's header. The glyphs are paths, not font
       characters, so they cannot come out as empty boxes on a machine
       without the font: an arrow down onto a bar to shrink, and a green arrow
       up from a bar to open again. ffr_drawer sets Tag="shrunk" while the
       window is parked, which is what swaps one for the other. Focusable off,
       so the button never holds the Enter key a prompt is waiting for. -->
  <Style x:Key="BtnShrink" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource FgMuted}"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Margin" Value="0,0,4,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
            <Grid Width="12" Height="12" HorizontalAlignment="Center"
                  VerticalAlignment="Center">
              <Path x:Name="DownGlyph" Stroke="{TemplateBinding Foreground}"
                    StrokeThickness="1.6" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 6,1 L 6,8 M 2.5,4.5 L 6,8 L 9.5,4.5 M 1.5,11 L 10.5,11"/>
              <Path x:Name="UpGlyph" Visibility="Collapsed"
                    Stroke="{StaticResource AccGreen}"
                    StrokeThickness="2" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Data="M 1.5,1 L 10.5,1 M 6,11 L 6,4 M 2.5,7.5 L 6,4 L 9.5,7.5"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
              <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
            </Trigger>
            <Trigger Property="Tag" Value="shrunk">
              <Setter TargetName="DownGlyph" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="UpGlyph" Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Tag" Value="shrunk"/>
                <Condition Property="IsMouseOver" Value="True"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="UpGlyph" Property="Stroke" Value="{StaticResource AccGreenHi}"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= tooltip ================= -->
  <!-- ========================== RESIZE EDGES ========================= -->
  <!-- Transparent, not null: a null Background is not hit-testable in WPF, so
       the thumb would never see the drag at all. -->
  <Style x:Key="ResizeThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{StaticResource FgBody}"/>
    <Setter Property="Background" Value="{StaticResource BgCard}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource BgCard}"
                  BorderBrush="{StaticResource BrdEdge}" BorderThickness="1"
                  CornerRadius="3" Padding="8,5">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

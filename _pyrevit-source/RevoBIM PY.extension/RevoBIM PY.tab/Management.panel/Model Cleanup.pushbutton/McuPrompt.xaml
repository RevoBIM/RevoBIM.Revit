<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model Cleanup"
        Width="520" SizeToContent="Height" MinHeight="180"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        FontFamily="Segoe UI" FontSize="12.5">
    <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
            Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource WindowEdgeBrush}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBar" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="HeaderIcon" Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LogoText" Text="RevoBIM" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource BlueBrush}"/>
                        <TextBlock x:Name="PromptTitle" Text="Model Cleanup" FontSize="13" Margin="1,-3,0,0"
                                   Foreground="{DynamicResource OrangeBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="3" Text="v0.0.0" FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <Button x:Name="ShrinkButton" Grid.Column="4" Style="{DynamicResource ShrinkButton}"
                            ToolTip="Shrink to a bar so Revit can be seen (Ctrl+Shift+H)"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="16,14,16,10">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="18"/>
                <TextBox x:Name="InputBox" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <Border Grid.Row="2" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="14,8">
                <StackPanel x:Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right"/>
            </Border>
        </Grid>
    </Border>
</Window>

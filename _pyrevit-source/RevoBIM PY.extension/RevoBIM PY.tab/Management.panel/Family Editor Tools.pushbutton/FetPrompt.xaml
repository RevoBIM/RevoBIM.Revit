<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM" SizeToContent="Height"
        Width="480" MinHeight="170"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="5,5,0,0">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Grid.Column="0"
                               Foreground="{DynamicResource BlueBrush}"
                               FontSize="13.5" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button x:Name="CloseButton" Grid.Column="1"
                            Style="{DynamicResource CloseButton}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{DynamicResource MutedBrush}"
                              StrokeThickness="1.4"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="16,14,16,10"
                          VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,5,5" Padding="12,9,12,9">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton" Content="Cancel" Margin="0,0,8,0"
                            MinWidth="90"/>
                    <Button x:Name="YesButton"
                            Style="{DynamicResource GreenButton}"
                            Content="Yes" MinWidth="90"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

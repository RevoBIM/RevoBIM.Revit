<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Shared Parameters"
        Width="900" Height="640" MinWidth="720" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="5,5,0,0">
                <Grid Margin="12,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM"
                                   Foreground="{DynamicResource BlueBrush}"
                                   FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Shared parameters"
                                   Foreground="{DynamicResource OrangeBrush}"
                                   FontSize="13" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2"
                               Style="{DynamicResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="CloseButton" Grid.Column="3"
                            Style="{DynamicResource CloseButton}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{DynamicResource MutedBrush}"
                              StrokeThickness="1.4"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="12,12,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PathBox" Grid.Column="0" Margin="0,0,6,0"
                             Tag="Pick a shared parameter file"/>
                    <Button x:Name="BrowseButton" Grid.Column="1"
                            Content="Browse"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Margin="0,0,6,0"
                             Tag="Search - every word typed has to appear"/>
                    <ComboBox x:Name="GroupFilterCombo" Grid.Column="1"
                              Width="190" Margin="0,0,6,0"/>
                    <Button x:Name="AllButton" Grid.Column="2"
                            Content="All" Margin="0,0,6,0"/>
                    <Button x:Name="NoneButton" Grid.Column="3"
                            Content="None"/>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Margin="12,0,12,0"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="3">
                <Grid>
                    <ListBox x:Name="ParamList" Background="Transparent"
                             BorderThickness="0" Margin="2"/>
                    <TextBlock x:Name="EmptyText"
                               Style="{DynamicResource MutedText}"
                               Text="Choose a shared parameter file to see what is in it."
                               Margin="16" VerticalAlignment="Top"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,5,5" Margin="0,12,0,0" Padding="12,9,12,9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ticked parameters go in as"
                                   Style="{DynamicResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="TypeRadio" Grid.Column="1"
                                     GroupName="Binding" Content="Type"
                                     VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton x:Name="InstanceRadio" Grid.Column="2"
                                     GroupName="Binding" Content="Instance"
                                     VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Grid.Column="3" Text="under"
                                   Style="{DynamicResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="GroupCombo" Grid.Column="4"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TemplateNameBox" Grid.Column="0"
                                 Margin="0,0,6,0"
                                 Tag="Name this selection to save it as a template"/>
                        <Button x:Name="SaveTemplateButton" Grid.Column="1"
                                Style="{DynamicResource OrangeButton}"
                                Content="Save as template" Margin="0,0,10,0"/>
                        <TextBlock x:Name="StatusText" Grid.Column="2"
                                   Style="{DynamicResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="StageButton" Grid.Column="3"
                                Style="{DynamicResource GreenButton}"
                                Content="Use these"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="GripHost" Grid.RowSpan="4"/>
        </Grid>
    </Border>
</Window>

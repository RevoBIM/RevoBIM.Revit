<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Family Editor Tools Settings"
        Width="800" Height="660" MinWidth="680" MinHeight="540"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="#4A4A50" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar" Grid.Row="0"
                    Background="{DynamicResource BarBg}"
                    CornerRadius="5,5,0,0">
                <Grid Margin="12,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM"
                                   Foreground="{DynamicResource BlueBrush}"
                                   FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Settings"
                                   Foreground="{DynamicResource OrangeBrush}"
                                   FontSize="13" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2"
                               Style="{DynamicResource MutedText}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="CloseButton" Grid.Column="3"
                            Style="{DynamicResource CloseButton}">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{DynamicResource MutedBrush}"
                              StrokeThickness="1.4"/>
                    </Button>
                </Grid>
            </Border>

            <TabControl x:Name="SettingsTabs" Grid.Row="1"
                        Margin="12,10,12,0" Background="Transparent">

                <!-- ===== General ===== -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,8">
                                    <Border Width="4" Height="14"
                                            Background="{DynamicResource BlueBrush}"
                                            Margin="0,0,7,0"/>
                                    <TextBlock Text="Parameters"
                                               Style="{DynamicResource SectionHeading}"
                                               Margin="0"/>
                                </StackPanel>

                                <TextBlock Text="Theme"
                                           Style="{DynamicResource MutedText}"/>
                                <ComboBox x:Name="ThemeCombo" Margin="0,2,0,8"/>

                                <TextBlock Text="New parameters default to"
                                           Style="{DynamicResource MutedText}"/>
                                <ComboBox x:Name="BindingCombo" Margin="0,2,0,8"/>

                                <TextBlock Text="Default parameter group"
                                           Style="{DynamicResource MutedText}"/>
                                <ComboBox x:Name="GroupCombo" Margin="0,2,0,8"/>

                                <CheckBox x:Name="GroupBySpfCheck" Margin="0,4,0,4"
                                          Content="Group the file's parameters by their own group"/>
                                <CheckBox x:Name="OverwriteCheck" Margin="0,4,0,4"
                                          Content="Replace a preset already in the family"/>
                                <CheckBox x:Name="DebugCheck" Margin="0,4,0,4"
                                          Content="Write a diagnostic trace on every material load"/>

                                <TextBlock Text="Show results"
                                           Style="{DynamicResource MutedText}"
                                           Margin="0,8,0,0"/>
                                <ComboBox x:Name="ResultsCombo" Margin="0,2,0,4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,8">
                                    <Border Width="4" Height="14"
                                            Background="{DynamicResource OrangeBrush}"
                                            Margin="0,0,7,0"/>
                                    <TextBlock Text="Standard planes"
                                               Style="{DynamicResource SectionHeading}"
                                               Margin="0"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Plane extent mm"
                                                   Style="{DynamicResource MutedText}"/>
                                        <TextBox x:Name="ExtentBox" Tag="1500"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Dimension offset mm"
                                                   Style="{DynamicResource MutedText}"/>
                                        <TextBox x:Name="DimOffsetBox" Tag="250"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Dimension row spacing mm"
                                           Style="{DynamicResource MutedText}"/>
                                <TextBox x:Name="DimStepBox" Tag="150"
                                         Margin="0,2,0,8"/>

                                <TextBlock Text="Parameter names"
                                           Style="{DynamicResource MutedText}"
                                           TextWrapping="Wrap"/>
                                <Grid Margin="0,2,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ParamWidthBox" Grid.Column="0"
                                             Tag="Width"/>
                                    <TextBox x:Name="ParamDepthBox" Grid.Column="2"
                                             Tag="Depth"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ParamHeightBox" Grid.Column="0"
                                             Tag="Height"/>
                                    <TextBox x:Name="ParamClearanceBox"
                                             Grid.Column="2" Tag="Clearance"/>
                                </Grid>
                                <TextBox x:Name="ParamRadiusBox" Tag="Radius"
                                         Margin="0,0,0,6"/>

                                <CheckBox x:Name="CreateParamsCheck"
                                          Margin="0,4,0,4"
                                          Content="Create the parameters the layout drives"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Family icon appearance ===== -->
                <TabItem x:Name="IconAppearanceTab" Header="Icon appearance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <Border Width="4" Height="14"
                                        Background="{DynamicResource BlueBrush}"
                                        Margin="0,0,7,0"/>
                                <TextBlock Text="Default appearance"
                                           Style="{DynamicResource SectionHeading}"
                                           Margin="0"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="3D families"
                                           Style="{DynamicResource SectionHeading}"
                                           TextAlignment="Center"/>
                                <TextBlock Grid.Row="0" Grid.Column="3"
                                           Text="2D families"
                                           Style="{DynamicResource SectionHeading}"
                                           TextAlignment="Center"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Display style"
                                           Style="{DynamicResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="Style3DCombo" Grid.Row="1"
                                          Grid.Column="1" Margin="0,3,0,3"/>
                                <ComboBox x:Name="Style2DCombo" Grid.Row="1"
                                          Grid.Column="3" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Detail level"
                                           Style="{DynamicResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="Detail3DCombo" Grid.Row="2"
                                          Grid.Column="1" Margin="0,3,0,3"/>
                                <ComboBox x:Name="Detail2DCombo" Grid.Row="2"
                                          Grid.Column="3" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="View scale"
                                           Style="{DynamicResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="Scale3DCombo" Grid.Row="3"
                                          Grid.Column="1" Margin="0,3,0,3"/>
                                <ComboBox x:Name="Scale2DCombo" Grid.Row="3"
                                          Grid.Column="3" Margin="0,3,0,3"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                           Text="View type"
                                           Style="{DynamicResource MutedText}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="ViewTypeCombo" Grid.Row="4"
                                          Grid.Column="1" Grid.ColumnSpan="3"
                                          Margin="0,3,0,3"/>
                            </Grid>

                            <TextBlock Style="{DynamicResource MutedText}"
                                       TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="The 2D column is read when the family has no 3D geometry to show. Overrides per category are not built yet."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Family icon options ===== -->
                <TabItem Header="Icon options">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Margin="0,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,8">
                                <Border Width="4" Height="14"
                                        Background="{DynamicResource BlueBrush}"
                                        Margin="0,0,7,0"/>
                                <TextBlock Text="View general options"
                                           Style="{DynamicResource SectionHeading}"
                                           Margin="0"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Thumbnail view name"
                                           Style="{DynamicResource MutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <TextBox x:Name="ViewNameBox" Grid.Column="1"
                                         Tag="Thumbnail View"/>
                            </Grid>

                            <StackPanel x:Name="TickHost"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== Family naming ===== -->
                <TabItem Header="Family naming">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Style="{DynamicResource MutedText}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="One abbreviation per line, CODE = what it means. They become the dropdowns on the Family name panel, and the name is built as Company_Type_Discipline_Name."/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Company"
                                       Style="{DynamicResource SectionHeading}"/>
                            <TextBox x:Name="CompanyListBox" Grid.Row="1"
                                     Grid.Column="0" AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Tag="BGL = Building Group"/>

                            <TextBlock Grid.Row="0" Grid.Column="2"
                                       Text="Family type"
                                       Style="{DynamicResource SectionHeading}"/>
                            <TextBox x:Name="TypeListBox" Grid.Row="1"
                                     Grid.Column="2" AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Tag="PFX = Pipe fitting"/>

                            <TextBlock Grid.Row="0" Grid.Column="4"
                                       Text="Discipline"
                                       Style="{DynamicResource SectionHeading}"/>
                            <TextBox x:Name="DisciplineListBox" Grid.Row="1"
                                     Grid.Column="4" AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Tag="DOM = Domestic"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2" Background="{DynamicResource BarBg}"
                    CornerRadius="0,0,5,5" Padding="12,9,12,9" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ShortcutsButton" Grid.Column="0"
                            Style="{DynamicResource OrangeButton}"
                            Content="Keyboard shortcuts"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1"
                               Style="{DynamicResource MutedText}"
                               VerticalAlignment="Center" TextAlignment="Center"/>
                    <Button x:Name="ApplyButton" Grid.Column="2"
                            Style="{DynamicResource GreenButton}"
                            Content="Apply" MinWidth="100"/>
                </Grid>
            </Border>

            <Grid x:Name="GripHost" Grid.RowSpan="3"/>
        </Grid>
    </Border>
</Window>

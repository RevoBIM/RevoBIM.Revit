<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM"
        Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Border x:Name="PromptRoot" CornerRadius="6" BorderThickness="1"
          Background="{DynamicResource WindowBg}"
          BorderBrush="{DynamicResource ChromeEdge}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="PromptHeader" Grid.Row="0" CornerRadius="6,6,0,0"
              Background="{DynamicResource BarBg}" Padding="14,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="RevoBIM" FontSize="16" FontWeight="Bold"
                     VerticalAlignment="Center"
                     FontFamily="{DynamicResource UiFont}"
                     Foreground="{DynamicResource AccentBlue}"/>
          <TextBlock x:Name="PromptVersion" Grid.Column="2" Text="v2.0.2"
                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                     FontFamily="{DynamicResource UiFont}"
                     Foreground="{DynamicResource FgMuted}"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PromptShrink" Content="" Style="{DynamicResource ShrinkBtn}"/>
          <Button x:Name="PromptClose" Style="{DynamicResource CloseBtn}">
            <Path Width="10" Height="10" StrokeThickness="1.5"
                  Stroke="{DynamicResource FgMuted}"
                  Data="M 0 0 L 10 10 M 10 0 L 0 10"/>
          </Button>
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="1" Margin="18,14,18,14">
        <TextBlock x:Name="PromptTitle" FontSize="14" FontWeight="SemiBold"
                   TextWrapping="Wrap" Margin="0,0,0,8"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource AccentOrange}"/>
        <TextBlock x:Name="PromptBody" FontSize="12.5" TextWrapping="Wrap"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource FgBody}"/>
      </StackPanel>

      <Border Grid.Row="2" CornerRadius="0,0,6,6"
              Background="{DynamicResource BarBg}" Padding="14,10,14,10">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="PromptCancel" Content="Cancel" MinWidth="100"
                  Style="{DynamicResource BtnGhost}"/>
          <Button x:Name="PromptOk" Content="OK" MinWidth="110" Margin="8,0,0,0"
                  Style="{DynamicResource BtnGreen}"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>

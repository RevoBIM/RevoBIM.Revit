<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Batch Rename"
        Width="860" Height="620" MinWidth="620" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True">

  <Border x:Name="BatchRoot" CornerRadius="6" BorderThickness="1"
          Background="{DynamicResource WindowBg}"
          BorderBrush="{DynamicResource ChromeEdge}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- =============================================================
           Header
           ============================================================= -->
      <Border x:Name="BatchHeader" Grid.Row="0" CornerRadius="6,6,0,0"
              Background="{DynamicResource BarBg}" Padding="12,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource AccentBlue}"/>
            <TextBlock Text="Batch Rename" FontSize="14" Margin="1,-3,0,0"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource AccentOrange}"/>
          </StackPanel>

          <TextBlock x:Name="BatchVersion" Grid.Column="2" Text="v2.0.2"
                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                     FontFamily="{DynamicResource UiFont}"
                     Foreground="{DynamicResource FgMuted}"/>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BatchShrink" Content="" Style="{DynamicResource ShrinkBtn}"/>
            <Button x:Name="BatchFull" Style="{DynamicResource IconBtn}"
                    ToolTip="Full screen  (F11)">
              <Border Width="12" Height="10" BorderThickness="1.4" CornerRadius="1"
                      BorderBrush="{DynamicResource FgMuted}"/>
            </Button>
            <Button x:Name="BatchClose" Style="{DynamicResource CloseBtn}"
                    ToolTip="Close">
              <Path Width="10" Height="10" StrokeThickness="1.5"
                    Stroke="{DynamicResource FgMuted}"
                    Data="M 0 0 L 10 10 M 10 0 L 0 10"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- =============================================================
           The tools
           ============================================================= -->
      <Border Grid.Row="1" Background="{DynamicResource CardBg}"
              BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,1"
              Padding="14,10,14,12">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Border Style="{DynamicResource TickBlueBar}" Height="17"/>
            <TextBlock Text="Rename tools" Style="{DynamicResource SectionHeading}"/>
          </StackPanel>

          <WrapPanel Orientation="Horizontal">

            <!-- Find and replace, behind one button -->
            <Grid Margin="0,0,10,0" VerticalAlignment="Center">
              <ToggleButton x:Name="FindToggle" Content="Find and replace"
                            Style="{DynamicResource ChipToggle}" MinWidth="150"/>
              <Popup x:Name="FindPopup" AllowsTransparency="True" StaysOpen="False"
                     Placement="Bottom" PlacementTarget="{Binding ElementName=FindToggle}">
                <Border Background="{DynamicResource PopupBg}"
                        BorderBrush="{DynamicResource ChromeEdge}"
                        BorderThickness="1" CornerRadius="4" Padding="10" MinWidth="330">
                  <StackPanel>
                    <TextBlock Text="Find" Style="{DynamicResource SectionHeading}"
                               Margin="2,0,0,5"/>
                    <TextBox x:Name="BatchFind" Style="{DynamicResource ThemedTextBox}"
                             Tag="text to look for"/>
                    <TextBlock Text="Replace with" Margin="2,9,0,5"
                               Style="{DynamicResource SectionHeading}"/>
                    <TextBox x:Name="BatchReplace" Style="{DynamicResource ThemedTextBox}"
                             Tag="leave blank to delete it"/>
                    <CheckBox x:Name="BatchCase" Margin="2,9,0,0"
                              Content="Match case"
                              Style="{DynamicResource ThemedCheck}"/>
                  </StackPanel>
                </Border>
              </Popup>
            </Grid>

            <TextBlock Text="Prefix" VerticalAlignment="Center"
                       Margin="0,0,8,0" Style="{DynamicResource BodyText}"/>
            <TextBox x:Name="BatchPrefix" Width="150" Margin="0,0,12,0"
                     Style="{DynamicResource ThemedTextBox}"
                     Tag="goes on the front"/>
            <TextBlock Text="Suffix" VerticalAlignment="Center"
                       Margin="0,0,8,0" Style="{DynamicResource BodyText}"/>
            <TextBox x:Name="BatchSuffix" Width="150" Margin="0,0,12,0"
                     Style="{DynamicResource ThemedTextBox}"
                     Tag="goes on the end"/>
            <Button x:Name="BatchReset" Content="Clear tools"
                    Style="{DynamicResource BtnSmall}" VerticalAlignment="Center"/>
          </WrapPanel>

          <TextBlock x:Name="BatchOrder" Margin="0,9,0,0" FontSize="11"
                     TextWrapping="Wrap"
                     FontFamily="{DynamicResource UiFont}"
                     Foreground="{DynamicResource FgMuted}"
                     Text="Applied in order: find and replace first, then the prefix, then the suffix. Pick cells to narrow what the tools touch - click one, ctrl click to add more, shift click for a run; with nothing picked they apply to every name. Ctrl+C and Ctrl+V copy and paste between cells, and dragging the small square at a cell's bottom right fills downwards - repeating the value, or counting on from a number at the end of it."/>
        </StackPanel>
      </Border>

      <!-- =============================================================
           The preview
           ============================================================= -->
      <Grid Grid.Row="2" Margin="14,10,14,10">
        <DataGrid x:Name="BatchGrid" Style="{DynamicResource ThemedGrid}"
                  HorizontalScrollBarVisibility="Auto"
                  CanUserResizeColumns="True"
                  SelectionMode="Extended" SelectionUnit="Cell"/>
      </Grid>

      <!-- =============================================================
           Footer
           ============================================================= -->
      <Border Grid.Row="3" CornerRadius="0,0,6,6"
              Background="{DynamicResource BarBg}" Padding="14,10,14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock x:Name="BatchStatus" Grid.Column="0" VerticalAlignment="Center"
                     FontSize="12" TextTrimming="CharacterEllipsis"
                     FontFamily="{DynamicResource UiFont}"
                     Foreground="{DynamicResource FgBody}"/>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="BatchClear" Content="Clear picked cells"
                    Style="{DynamicResource BtnSmall}" Margin="0,0,8,0"/>
            <Button x:Name="BatchCancel" Content="Cancel"
                    Style="{DynamicResource BtnGhost}" MinWidth="90"/>
            <Button x:Name="BatchApply" Content="Apply" MinWidth="130"
                    Margin="8,0,0,0" Style="{DynamicResource BtnGreen}"/>
          </StackPanel>
        </Grid>
      </Border>
      <!-- resize grips, added in code.  No Background, so everything
           underneath stays clickable. -->
      <Grid x:Name="BatchResizeLayer" Grid.RowSpan="4"/>
    </Grid>
  </Border>
</Window>

<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      x:Name="BodyRoot" Background="{DynamicResource WindowBg}">
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- ===============================================================
       Dock header.  Collapsed when the body sits in the floating
       window, which carries its own header; shown when it sits in the
       Revit dockable pane, where Revit draws the title bar and there
       is nowhere else for the wordmark, the palette chip, the gear and
       the version to go.
       =============================================================== -->
  <Border x:Name="DockHeader" Grid.Row="0" Visibility="Collapsed"
          Background="{DynamicResource BarBg}" Padding="10,6,6,6">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <Image x:Name="DockIcon" Grid.Column="0" Width="24" Height="24"
             Margin="0,0,8,0" VerticalAlignment="Center"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="RevoBIM" FontSize="15" FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource AccentBlue}"/>
        <TextBlock Text="Family Viewer" FontSize="13" Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource AccentOrange}"/>
      </StackPanel>

      <Button x:Name="DockThemeChip" Grid.Column="3" Content="Light"
              Style="{DynamicResource ChipBtn}" Margin="0,0,6,0"
              VerticalAlignment="Center" ToolTip="Switch the palette"/>

      <Button x:Name="DockSettingsChip" Grid.Column="4"
              Style="{DynamicResource ChipBtn}" Margin="0,0,8,0"
              VerticalAlignment="Center" ToolTip="Settings">
        <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
              Fill="{DynamicResource FgMuted}"
              Data="M 9 6 A 3 3 0 1 0 9 12 A 3 3 0 1 0 9 6 Z M 8 0 L 10 0 L 10.4 2.2 L 12.3 3 L 14 1.6 L 15.4 3 L 14 4.7 L 14.8 6.6 L 17 7 L 17 9 L 14.8 9.4 L 14 11.3 L 15.4 13 L 14 14.4 L 12.3 13 L 10.4 13.8 L 10 16 L 8 16 L 7.6 13.8 L 5.7 13 L 4 14.4 L 2.6 13 L 4 11.3 L 3.2 9.4 L 1 9 L 1 7 L 3.2 6.6 L 4 4.7 L 2.6 3 L 4 1.6 L 5.7 3 L 7.6 2.2 Z"/>
      </Button>

      <TextBlock x:Name="DockVersion" Grid.Column="5" Text="v2.0.2"
                 VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11"
                 FontFamily="{DynamicResource UiFont}"
                 Foreground="{DynamicResource FgMuted}"/>
    </Grid>
  </Border>

  <ProgressBar x:Name="Progress" Grid.Row="1" Style="{DynamicResource ThemedProgress}"
               Minimum="0" Maximum="1" Value="0" Visibility="Collapsed"/>

  <!-- ===============================================================
       Toolbar.  A WrapPanel, not a row of columns: the tool has to
       work squeezed into a Revit dock, so the groups wrap onto another
       line rather than clipping off the right hand edge.
       =============================================================== -->
  <Border Grid.Row="2" Background="{DynamicResource CardBg}"
          BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,1"
          Padding="10,8,10,8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <WrapPanel x:Name="ToolbarWrap" Grid.Row="0" Orientation="Horizontal">

        <!-- Category.  A square icon that opens the list, rather than a wide
             chip: four of these fit where one chip used to, which is what
             makes the tool usable squeezed into a Revit dock. -->
        <Grid Margin="0,0,6,4" VerticalAlignment="Center">
          <ToggleButton x:Name="CatToggle" Style="{DynamicResource IconToggle}"
                        ToolTip="Categories">
            <Path x:Name="CatGlyph" Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 0 0 L 6 0 L 6 6 L 0 6 Z M 9 0 L 15 0 L 15 6 L 9 6 Z M 0 9 L 6 9 L 6 15 L 0 15 Z M 9 9 L 15 9 L 15 15 L 9 15 Z"/>
          </ToggleButton>
          <Popup x:Name="CatPopup" AllowsTransparency="True" StaysOpen="False"
                 Placement="Bottom" PlacementTarget="{Binding ElementName=CatToggle}">
            <Border Background="{DynamicResource PopupBg}"
                    BorderBrush="{DynamicResource ChromeEdge}"
                    BorderThickness="1" CornerRadius="4" Padding="9" MinWidth="300">
              <StackPanel>
                <TextBlock Text="Categories" Style="{DynamicResource SectionHeading}"
                           Margin="2,0,0,7"/>
                <Button x:Name="CatFromView" Content="Select categories from active view"
                        Margin="0,0,0,8" HorizontalContentAlignment="Left"
                        Style="{DynamicResource BtnGhost}"
                        ToolTip="Tick exactly the categories that have something in the view on screen, and untick the rest"/>
                <TextBox x:Name="CatSearch" Style="{DynamicResource SearchBox}"
                         Tag="search categories"/>
                <StackPanel Orientation="Horizontal" Margin="0,7,0,7">
                  <Button x:Name="CatAll" Content="All" Style="{DynamicResource BtnSmall}"/>
                  <Button x:Name="CatNone" Content="None" Margin="6,0,0,0"
                          Style="{DynamicResource BtnSmall}"/>
                  <TextBlock x:Name="CatCount" Margin="10,0,0,0" VerticalAlignment="Center"
                             FontSize="11" FontFamily="{DynamicResource UiFont}"
                             Foreground="{DynamicResource FgMuted}"/>
                </StackPanel>
                <ListBox x:Name="CatList" Style="{DynamicResource ThemedList}"
                         MaxHeight="360"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <!-- Scope.  Same shape as Phase: an icon that opens a list, one
             pick, list closes and the model is re-read. -->
        <Grid Margin="0,0,6,4" VerticalAlignment="Center">
          <ToggleButton x:Name="ScopeToggle" Style="{DynamicResource IconToggle}"
                        ToolTip="Scope">
            <Path x:Name="ScopeGlyph" Width="17" Height="17" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 8 1.5 C 3.4 1.5 0.6 5.6 0 7 C 0.6 8.4 3.4 12.5 8 12.5 C 12.6 12.5 15.4 8.4 16 7 C 15.4 5.6 12.6 1.5 8 1.5 Z M 8 3.4 C 10 3.4 11.6 5 11.6 7 C 11.6 9 10 10.6 8 10.6 C 6 10.6 4.4 9 4.4 7 C 4.4 5 6 3.4 8 3.4 Z M 8 5.2 C 7 5.2 6.2 6 6.2 7 C 6.2 8 7 8.8 8 8.8 C 9 8.8 9.8 8 9.8 7 C 9.8 6 9 5.2 8 5.2 Z"/>
          </ToggleButton>
          <Popup x:Name="ScopePopup" AllowsTransparency="True" StaysOpen="False"
                 Placement="Bottom" PlacementTarget="{Binding ElementName=ScopeToggle}">
            <Border Background="{DynamicResource PopupBg}"
                    BorderBrush="{DynamicResource ChromeEdge}"
                    BorderThickness="1" CornerRadius="4" Padding="9" MinWidth="290">
              <StackPanel>
                <TextBlock Text="Scope" Style="{DynamicResource SectionHeading}"
                           Margin="2,0,0,7"/>
                <ListBox x:Name="ScopeList" Style="{DynamicResource ThemedList}"/>
                <TextBlock Margin="2,8,2,0" FontSize="11" TextWrapping="Wrap"
                           MaxWidth="270" HorizontalAlignment="Left"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource FgMuted}"
                           Text="Entire project and Active view list only types that have elements placed. All families lists every type loaded, placed or not. All three follow the category and phase filters."/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <!-- Phase -->
        <Grid Margin="0,0,6,4" VerticalAlignment="Center">
          <ToggleButton x:Name="PhaseToggle" Style="{DynamicResource IconToggle}"
                        ToolTip="Phase">
            <Path x:Name="PhaseGlyph" Width="16" Height="16" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 8 0 A 8 8 0 1 1 7.99 0 Z M 8 2 A 6 6 0 1 0 8 14 Z"/>
          </ToggleButton>
          <Popup x:Name="PhasePopup" AllowsTransparency="True" StaysOpen="False"
                 Placement="Bottom" PlacementTarget="{Binding ElementName=PhaseToggle}">
            <Border Background="{DynamicResource PopupBg}"
                    BorderBrush="{DynamicResource ChromeEdge}"
                    BorderThickness="1" CornerRadius="4" Padding="9" MinWidth="260">
              <StackPanel>
                <TextBlock Text="Phase" Style="{DynamicResource SectionHeading}"
                           Margin="2,0,0,7"/>
                <ListBox x:Name="PhaseList" Style="{DynamicResource ThemedList}"
                         MaxHeight="300"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>

        <!-- Search: the icon expands out into the box -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="0,0,10,4">
          <ToggleButton x:Name="SearchToggle" Style="{DynamicResource IconToggle}"
                        ToolTip="Search">
            <Path Width="15" Height="15" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 6.5 0 A 6.5 6.5 0 1 1 6.49 0 Z M 6.5 2 A 4.5 4.5 0 1 0 6.5 11 A 4.5 4.5 0 1 0 6.5 2 Z M 10.6 9.4 L 12 8 L 16 12 L 14.6 13.4 Z"/>
          </ToggleButton>
          <TextBox x:Name="GlobalSearch" Height="30" MinHeight="30" Width="230"
                   Margin="6,0,0,0" Visibility="Collapsed"
                   Style="{DynamicResource MiniSearchBox}"
                   Tag="family, type, category or any column"/>
        </StackPanel>

        <StackPanel x:Name="ToolbarButtons" Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,0,4">

          <!-- expand and collapse, one button that flips -->
          <Button x:Name="FoldBtn" Style="{DynamicResource IconAction}"
                  ToolTip="Expand all">
            <Path x:Name="FoldGlyph" Width="14" Height="14" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 0 1 L 14 1 L 14 3 L 0 3 Z M 4 6 L 14 6 L 14 8 L 4 8 Z M 4 11 L 14 11 L 14 13 L 4 13 Z"/>
          </Button>

          <!-- family images on or off -->
          <ToggleButton x:Name="ImagesToggle" Margin="0,0,6,0"
                        Style="{DynamicResource IconToggle}"
                        ToolTip="Hide the family images">
            <Path Width="15" Height="15" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 1 2 L 15 2 L 15 14 L 1 14 Z M 2.6 3.6 L 2.6 10.2 L 5.6 7 L 8.6 10.4 L 10.6 8.4 L 13.4 11.4 L 13.4 3.6 Z M 10.6 5 A 1.4 1.4 0 1 1 10.59 5 Z"/>
          </ToggleButton>

          <!-- expand down to the instances under every type -->
          <Button x:Name="InstancesBtn" Margin="6,0,0,0"
                  Style="{DynamicResource IconAction}"
                  ToolTip="Show every placed element under its type">
            <Path x:Name="InstancesGlyph" Width="14" Height="14" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 0 1 L 14 1 L 14 3 L 0 3 Z M 3 6 L 14 6 L 14 8 L 3 8 Z M 6 11 L 14 11 L 14 13 L 6 13 Z"/>
          </Button>

          <!-- group the instances by whatever column the list is sorted on -->
          <Button x:Name="GroupBtn" Margin="6,0,0,0" IsEnabled="False"
                  Style="{DynamicResource IconAction}"
                  ToolTip="Sort by a parameter column first, then group the elements by it">
            <Path x:Name="GroupGlyph" Width="14" Height="14" Stretch="Uniform"
                  Fill="{DynamicResource FgMuted}"
                  Data="M 0 0 L 14 0 L 14 2.4 L 0 2.4 Z M 2.5 4.6 L 14 4.6 L 14 6.6 L 2.5 6.6 Z M 2.5 7.8 L 14 7.8 L 14 9.8 L 2.5 9.8 Z M 0 12 L 14 12 L 14 14 L 0 14 Z"/>
          </Button>

          <!-- Batch rename the picked names.  Greys out with nothing picked
               and lights green as soon as there is something to rename. -->
          <Grid Margin="6,0,0,0">
            <ToggleButton x:Name="RenameToggle" Style="{DynamicResource IconArmed}"
                          IsEnabled="False"
                          ToolTip="Batch rename - pick families or types in the list first">
              <Grid Width="18" Height="15">
                <TextBlock Text="ab" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Top" HorizontalAlignment="Left"
                           Margin="0,-2,0,0"
                           FontFamily="{DynamicResource UiFont}"
                           Foreground="{DynamicResource FgMuted}"/>
                <Path Width="18" Height="15" Stretch="None"
                      Fill="{DynamicResource AccentGreen}"
                      Data="M 0 12.6 L 11 12.6 L 11 14.4 L 0 14.4 Z M 12.4 11.8 L 17 4.6 L 18 5.4 L 13.4 12.6 L 12.2 13.2 Z"/>
              </Grid>
            </ToggleButton>
            <Popup x:Name="RenamePopup" AllowsTransparency="True" StaysOpen="False"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=RenameToggle}">
              <Border Background="{DynamicResource PopupBg}"
                      BorderBrush="{DynamicResource AccentGreen}"
                      BorderThickness="1" CornerRadius="4" Padding="11" Width="330">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Style="{DynamicResource TickBlueBar}" Height="17"/>
                    <TextBlock x:Name="QuickTitle" Text="Batch rename"
                               Style="{DynamicResource SectionHeading}"/>
                  </StackPanel>

                  <TextBlock Text="Find" Style="{DynamicResource SectionHeading}"
                             Margin="2,0,0,4"/>
                  <TextBox x:Name="QuickFind" Style="{DynamicResource ThemedTextBox}"
                           Tag="text to look for"/>
                  <TextBlock Text="Replace with" Margin="2,8,0,4"
                             Style="{DynamicResource SectionHeading}"/>
                  <TextBox x:Name="QuickReplace" Style="{DynamicResource ThemedTextBox}"
                           Tag="leave blank to delete it"/>
                  <CheckBox x:Name="QuickCase" Margin="2,7,0,0" Content="Match case"
                            Style="{DynamicResource ThemedCheck}"/>

                  <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="8"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="Add prefix" Style="{DynamicResource SectionHeading}"
                                 Margin="2,0,0,4"/>
                      <TextBox x:Name="QuickPrefix" Style="{DynamicResource ThemedTextBox}"
                               Tag="goes on the front"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Add suffix" Style="{DynamicResource SectionHeading}"
                                 Margin="2,0,0,4"/>
                      <TextBox x:Name="QuickSuffix" Style="{DynamicResource ThemedTextBox}"
                               Tag="goes on the end"/>
                    </StackPanel>
                  </Grid>

                  <TextBlock x:Name="QuickPreview" Margin="2,10,2,0" FontSize="11"
                             TextWrapping="Wrap"
                             FontFamily="{DynamicResource UiFont}"
                             Foreground="{DynamicResource FgMuted}"/>
                  <TextBlock x:Name="QuickSample" Margin="2,4,2,0" FontSize="11"
                             TextWrapping="Wrap"
                             FontFamily="{DynamicResource UiFont}"
                             Foreground="{DynamicResource AccentGreen}"/>

                  <Grid Margin="0,11,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="QuickMore" Grid.Column="0" Content="Full editor..."
                            Style="{DynamicResource BtnSmall}"
                            ToolTip="The batch rename window: pick cells, edit parameters, copy, paste and fill"/>
                    <Button x:Name="QuickApply" Grid.Column="2" Content="Apply to selected"
                            MinWidth="130" IsEnabled="False"
                            Style="{DynamicResource BtnGreen}"
                            ToolTip="Stages the new names in green. Nothing is written until Apply."/>
                  </Grid>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <!-- Excel, export or import -->
          <Grid Margin="6,0,0,0">
            <ToggleButton x:Name="ExcelToggle" Style="{DynamicResource IconToggle}"
                          ToolTip="Excel">
              <Path Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource AccentGreen}"
                    Data="M 0 2.2 L 9 0.6 L 9 15.4 L 0 13.8 Z M 10 3 L 16 3 L 16 13 L 10 13 Z M 1.9 5 L 3.3 5 L 4.5 7.1 L 5.7 5 L 7.1 5 L 5.3 8 L 7.2 11 L 5.8 11 L 4.5 8.8 L 3.2 11 L 1.8 11 L 3.7 8 Z"/>
            </ToggleButton>
            <Popup x:Name="ExcelPopup" AllowsTransparency="True" StaysOpen="False"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=ExcelToggle}">
              <Border Background="{DynamicResource PopupBg}"
                      BorderBrush="{DynamicResource ChromeEdge}"
                      BorderThickness="1" CornerRadius="4" Padding="9" MinWidth="250">
                <StackPanel>
                  <TextBlock Text="Excel" Style="{DynamicResource SectionHeading}"
                             Margin="2,0,0,7"/>
                  <Button x:Name="ExportBtn" Content="Export the list..."
                          HorizontalContentAlignment="Left"
                          Style="{DynamicResource BtnGhost}"
                          ToolTip="Write every row to a workbook, including any past the ones drawn"/>
                  <Button x:Name="ImportBtn" Content="Import a workbook..."
                          Margin="0,6,0,0" HorizontalContentAlignment="Left"
                          Style="{DynamicResource BtnGhost}"
                          ToolTip="Read an exported workbook back in and stage what changed"/>
                  <TextBlock Margin="2,8,2,0" FontSize="11" TextWrapping="Wrap"
                             MaxWidth="230" HorizontalAlignment="Left"
                             FontFamily="{DynamicResource UiFont}"
                             Foreground="{DynamicResource FgMuted}"
                             Text="Orange cells in the workbook are editable. Importing stages the changes; Apply still writes them."/>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <Button x:Name="RefreshBtn" Margin="6,0,0,0"
                  Style="{DynamicResource IconAction}"
                  ToolTip="Re-read the model  (F5)">
            <Grid>
              <Path x:Name="RefreshGlyph" Width="15" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource FgMuted}"
                    Data="M 8 0 A 8 8 0 1 0 16 8 L 14 8 A 6 6 0 1 1 8 2 L 8 5 L 13 2.5 L 8 0 Z"/>
              <Ellipse x:Name="RefreshDot" Width="6" Height="6"
                       Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,-2,-2,0"
                       Fill="{DynamicResource AccentOrange}"/>
            </Grid>
          </Button>
        </StackPanel>
      </WrapPanel>

      <TextBlock x:Name="ScopeNote" Grid.Row="1"
                 Margin="0,5,0,0" FontSize="11"
                 FontFamily="{DynamicResource UiFont}"
                 Foreground="{DynamicResource FgMuted}"
                 TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Border>

  <!-- ===============================================================
       The list.  The first column is frozen and the rest are sized in
       pixels, so a narrow window scrolls sideways with Family and type
       staying put rather than squeezing every column into nothing.
       =============================================================== -->
  <Grid Grid.Row="3" Margin="10,8,10,8">
    <DataGrid x:Name="FamilyGrid" Style="{DynamicResource ThemedGrid}"
              FrozenColumnCount="1"
              CanUserResizeColumns="True"
              HorizontalScrollBarVisibility="Auto"/>
    <TextBlock x:Name="EmptyNote" Visibility="Collapsed"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="13" FontFamily="{DynamicResource UiFont}"
               Foreground="{DynamicResource FgMuted}"
               TextWrapping="Wrap" Margin="16,0,16,0"
               TextAlignment="Center"/>
  </Grid>

  <!-- ===============================================================
       Pending edits.  Nothing is written until Apply, and Apply says
       what it is about to do first.
       =============================================================== -->
  <Border x:Name="EditBar" Grid.Row="4" Visibility="Collapsed"
          Background="{DynamicResource CardBg}"
          BorderBrush="{DynamicResource AccentOrange}" BorderThickness="0,2,0,0"
          Padding="10,7,10,7">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{DynamicResource TickOrangeBar}" Height="20"/>
      <TextBlock x:Name="EditNote" Grid.Column="1" VerticalAlignment="Center"
                 Margin="8,0,10,0" FontSize="12"
                 FontFamily="{DynamicResource UiFont}"
                 Foreground="{DynamicResource AccentOrange}"
                 TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="IsolateBtn" Content="Show everything"
                Style="{DynamicResource BtnSmall}" Visibility="Collapsed"
                Margin="0,0,8,0"
                ToolTip="The list is isolated to the rows that changed. This puts the filters back without losing the changes."/>
        <Button x:Name="DiscardBtn" Content="Discard changes"
                Style="{DynamicResource BtnSmall}"/>
        <Button x:Name="ApplyBtn" Content="Apply" MinWidth="110" Margin="8,0,0,0"
                Style="{DynamicResource BtnOrange}"/>
      </StackPanel>
    </Grid>
  </Border>

  <!-- ===============================================================
       Apply's progress.  Takes the edit bar's place while a write runs,
       so the percentage sits exactly where Apply was pressed.
       =============================================================== -->
  <Border x:Name="ApplyProgress" Grid.Row="4" Visibility="Collapsed"
          Background="{DynamicResource CardBg}"
          BorderBrush="{DynamicResource AccentGreen}" BorderThickness="0,2,0,0"
          Padding="12,8,12,9">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="ApplyProgressText" Grid.Row="0" Grid.Column="0"
                 FontSize="12" Margin="0,0,10,6"
                 TextTrimming="CharacterEllipsis"
                 FontFamily="{DynamicResource UiFont}"
                 Foreground="{DynamicResource FgBody}"
                 Text="Writing changes"/>
      <TextBlock x:Name="ApplyProgressPercent" Grid.Row="0" Grid.Column="1"
                 FontSize="12" FontWeight="Bold" Margin="0,0,0,6"
                 FontFamily="{DynamicResource UiFont}"
                 Foreground="{DynamicResource AccentGreen}"
                 Text="0%"/>
      <ProgressBar x:Name="ApplyProgressBar" Grid.Row="1" Grid.ColumnSpan="2"
                   Style="{DynamicResource ThemedMeter}" Value="0"/>
    </Grid>
  </Border>

  <!-- ===============================================================
       Footer
       =============================================================== -->
  <Border x:Name="FooterBar" Grid.Row="5" Background="{DynamicResource BarBg}"
          Padding="10,7,10,8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- The report sits on its own line ABOVE the buttons and across the
           whole width. Squeezed beside them it was trimmed to an ellipsis
           after a few words, which is no use for the one line that says what
           is picked. -->
      <StackPanel Grid.Row="0" Orientation="Vertical" Margin="1,0,1,7">
        <TextBlock x:Name="StatusText" FontSize="12"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource FgBody}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="SelInfo" FontSize="11" Margin="0,2,0,0"
                   FontFamily="{DynamicResource UiFont}"
                   Foreground="{DynamicResource FgMuted}"
                   TextWrapping="Wrap"/>
      </StackPanel>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="RestoreBtn" Grid.Column="0" Content="Restore Default"
                Style="{DynamicResource BtnDanger}" Padding="9,4,9,4"
                FontSize="11.5" VerticalAlignment="Center"
                ToolTip="Keep the categories, clear every filter, set the phase to every phase and the scope to all families in project"/>

        <Button x:Name="DebugBtn" Grid.Column="1" Content="Debug report"
                Style="{DynamicResource BtnSmall}" Padding="9,4,9,4"
                FontSize="11.5" HorizontalAlignment="Left" Margin="8,0,0,0"
                VerticalAlignment="Center"
                ToolTip="Write a report of what this tool just read, and what is actually in the view, so it can be sent on"/>

        <WrapPanel Grid.Column="2" Orientation="Horizontal"
                   VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock x:Name="SelectLabel" Text="Select all instances"
                     VerticalAlignment="Center"
                     Margin="0,0,10,0" FontSize="11.5"
                     FontFamily="{DynamicResource UiFont}"
                     Foreground="{DynamicResource FgMuted}"/>
          <Button x:Name="IsolateViewBtn" Content="Isolate in View" IsEnabled="False"
                  MinWidth="98" Padding="8,4,8,4" FontSize="11.5"
                  Margin="0,2,8,2" Style="{DynamicResource BtnGhost}"
                  ToolTip="Zoom to these elements in the active view, then isolate them"/>
          <Button x:Name="SelectProjectBtn" Content="Entire Project" IsEnabled="False"
                  MinWidth="96" Padding="8,4,8,4" FontSize="11.5"
                  Margin="0,2,0,2" Style="{DynamicResource BtnGreen}"/>
          <Button x:Name="SelectViewBtn" Content="Active View" IsEnabled="False"
                  MinWidth="88" Padding="8,4,8,4" FontSize="11.5"
                  Margin="8,2,0,2" Style="{DynamicResource BtnOrange}"/>
        </WrapPanel>
      </Grid>
    </Grid>
  </Border>
</Grid>

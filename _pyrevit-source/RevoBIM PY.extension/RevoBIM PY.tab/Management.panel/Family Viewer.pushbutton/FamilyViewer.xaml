<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Family Viewer"
        Width="1240" Height="780" MinWidth="360" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True">

  <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
          Background="{DynamicResource WindowBg}"
          BorderBrush="{DynamicResource ChromeEdge}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- =============================================================
           Header
           ============================================================= -->
      <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="6,6,0,0"
              Background="{DynamicResource BarBg}" Padding="12,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Image x:Name="AppIcon" Grid.Column="0" Width="30" Height="30"
                 Margin="0,0,10,0" VerticalAlignment="Center"/>

          <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock x:Name="WordMark" Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource AccentBlue}"/>
            <TextBlock x:Name="ToolName" Text="Family Viewer" FontSize="15"
                       FontFamily="{DynamicResource UiFont}"
                       Margin="1,-4,0,0"
                       Foreground="{DynamicResource AccentOrange}"/>
          </StackPanel>

          <!-- dock chips: where the window sits against Revit -->
          <StackPanel x:Name="DockChips" Grid.Column="3" Orientation="Horizontal"
                      VerticalAlignment="Center" Margin="0,0,10,0">
            <TextBlock Text="Dock" VerticalAlignment="Center" FontSize="11"
                       FontFamily="{DynamicResource UiFont}"
                       Foreground="{DynamicResource FgMuted}" Margin="0,0,6,0"/>
            <ToggleButton x:Name="DockLeftChip" Content="Left"
                          Style="{DynamicResource ChipToggle}"
                          ToolTip="Snap to the left edge of Revit"/>
            <ToggleButton x:Name="DockFloatChip" Content="Float" IsChecked="True"
                          Margin="4,0,0,0" Style="{DynamicResource ChipToggle}"
                          ToolTip="Float free of Revit"/>
            <ToggleButton x:Name="DockRightChip" Content="Right"
                          Margin="4,0,0,0" Style="{DynamicResource ChipToggle}"
                          ToolTip="Snap to the right edge of Revit"/>
            <Button x:Name="DockPaneBtn" Content="Revit pane" Margin="8,0,0,0"
                    Style="{DynamicResource ChipBtn}"
                    ToolTip="Move into Revit's own dockable pane, beside Project Browser"/>
          </StackPanel>

          <Button x:Name="ThemeChip" Grid.Column="4" Content="Light"
                  Style="{DynamicResource ChipBtn}" Margin="0,0,6,0"
                  VerticalAlignment="Center" ToolTip="Switch the palette"/>

          <Button x:Name="SettingsChip" Grid.Column="5" Style="{DynamicResource ChipBtn}"
                  Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Settings">
            <StackPanel Orientation="Horizontal">
              <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                    Fill="{DynamicResource FgMuted}"
                    Data="M 9 6 A 3 3 0 1 0 9 12 A 3 3 0 1 0 9 6 Z M 8 0 L 10 0 L 10.4 2.2 L 12.3 3 L 14 1.6 L 15.4 3 L 14 4.7 L 14.8 6.6 L 17 7 L 17 9 L 14.8 9.4 L 14 11.3 L 15.4 13 L 14 14.4 L 12.3 13 L 10.4 13.8 L 10 16 L 8 16 L 7.6 13.8 L 5.7 13 L 4 14.4 L 2.6 13 L 4 11.3 L 3.2 9.4 L 1 9 L 1 7 L 3.2 6.6 L 4 4.7 L 2.6 3 L 4 1.6 L 5.7 3 L 7.6 2.2 Z"/>
              <TextBlock Text="Settings" Margin="6,0,0,0" VerticalAlignment="Center"
                         FontFamily="{DynamicResource UiFont}" FontSize="11.5"
                         Foreground="{DynamicResource FgMuted}"/>
            </StackPanel>
          </Button>

          <TextBlock x:Name="VersionText" Grid.Column="6" Text="v2.0.2"
                     VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                     FontFamily="{DynamicResource UiFont}"
                     Foreground="{DynamicResource FgMuted}"/>

          <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ShrinkBtn" Content="" Style="{DynamicResource ShrinkBtn}"/>
            <Button x:Name="FullBtn" Style="{DynamicResource IconBtn}"
                    ToolTip="Full screen  (F11)">
              <Border Width="12" Height="10" BorderThickness="1.4" CornerRadius="1"
                      BorderBrush="{DynamicResource FgMuted}"/>
            </Button>
            <Button x:Name="CloseBtn" Style="{DynamicResource CloseBtn}" ToolTip="Close">
              <Path Width="10" Height="10" StrokeThickness="1.5"
                    Stroke="{DynamicResource FgMuted}"
                    Data="M 0 0 L 10 10 M 10 0 L 0 10"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- The list, the toolbar and the footer live in
           FamilyViewerBody.xaml, so exactly the same body can be put in
           Revit's own dockable pane where there is no window to load. -->
      <ContentControl x:Name="BodyHost" Grid.Row="1"/>

      <!-- resize grips, added in code.  No Background, so everything
           underneath stays clickable. -->
      <Grid x:Name="ResizeLayer" Grid.RowSpan="2"/>
    </Grid>
  </Border>
</Window>

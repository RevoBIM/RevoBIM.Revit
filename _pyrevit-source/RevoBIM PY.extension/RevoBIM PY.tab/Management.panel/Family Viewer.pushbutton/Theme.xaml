<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ===================================================================
       Fallback brushes.  The live palette is written onto window.Resources
       at runtime, which sits in front of a merged dictionary in WPF's
       lookup order, so these are only ever used if theme.apply did not run.
       =================================================================== -->
  <SolidColorBrush x:Key="WindowBg"         Color="#3C4454"/>
  <SolidColorBrush x:Key="CardBg"           Color="#323C48"/>
  <SolidColorBrush x:Key="FieldBg"          Color="#2D3441"/>
  <SolidColorBrush x:Key="BarBg"            Color="#222933"/>
  <SolidColorBrush x:Key="PopupBg"          Color="#323C48"/>
  <SolidColorBrush x:Key="EdgeBrush"        Color="#48525F"/>
  <SolidColorBrush x:Key="ChromeEdge"       Color="#515C6B"/>
  <SolidColorBrush x:Key="GridLine"         Color="#46505E"/>
  <SolidColorBrush x:Key="FgBody"           Color="#EEF0F4"/>
  <SolidColorBrush x:Key="FgMuted"          Color="#A4AAB1"/>
  <SolidColorBrush x:Key="FgOnAccent"       Color="#14181E"/>
  <SolidColorBrush x:Key="AccentBlue"       Color="#5AAEEB"/>
  <SolidColorBrush x:Key="AccentBlueDim"    Color="#3A7392"/>
  <SolidColorBrush x:Key="AccentOrange"     Color="#F0A045"/>
  <SolidColorBrush x:Key="AccentOrangeHover" Color="#F7B565"/>
  <SolidColorBrush x:Key="AccentGreen"      Color="#5CC97A"/>
  <SolidColorBrush x:Key="AccentGreenHover" Color="#72D68D"/>
  <SolidColorBrush x:Key="WarnRed"          Color="#FA928E"/>
  <SolidColorBrush x:Key="SelBg"            Color="#3A7392"/>
  <SolidColorBrush x:Key="FamilyRowBg"      Color="#323A48"/>
  <SolidColorBrush x:Key="AccentTeal"       Color="#52CCC4"/>
  <SolidColorBrush x:Key="ImportRowBg"      Color="#27434B"/>
  <SolidColorBrush x:Key="HoverBg"          Color="#444E5E"/>
  <SolidColorBrush x:Key="RowAlt"           Color="#404859"/>
  <SolidColorBrush x:Key="ScrollThumb"      Color="#5A6576"/>
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#6E7A8C"/>
  <SolidColorBrush x:Key="DisabledFg"       Color="#7F8896"/>
  <SolidColorBrush x:Key="DisabledBg"       Color="#353D4A"/>
  <SolidColorBrush x:Key="TickBlue"         Color="#5AAEEB"/>
  <SolidColorBrush x:Key="TickOrange"       Color="#F0A045"/>

  <sys:Double x:Key="FontBody">12.5</sys:Double>
  <FontFamily x:Key="UiFont">Segoe UI</FontFamily>

  <!-- ===================================================================
       Text
       =================================================================== -->
  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
  </Style>

  <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentOrange}"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
  </Style>

  <!-- a 4px coloured tick to the left of a section label -->
  <Style x:Key="TickBlueBar" TargetType="Border">
    <Setter Property="Width" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource TickBlue}"/>
  </Style>
  <Style x:Key="TickOrangeBar" TargetType="Border" BasedOn="{StaticResource TickBlueBar}">
    <Setter Property="Background" Value="{DynamicResource TickOrange}"/>
  </Style>

  <!-- ===================================================================
       Buttons
       =================================================================== -->
  <Style x:Key="BtnBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Padding" Value="12,5,12,5"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4">
            <ContentPresenter x:Name="body"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="body" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource DisabledBg}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource DisabledBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}"/>

  <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Padding" Value="8,2,8,2"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="11.5"/>
  </Style>

  <Style x:Key="BtnGreen" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="{DynamicResource AccentGreen}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
    <Setter Property="Foreground" Value="{DynamicResource FgOnAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentGreenHover}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentGreenHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource DisabledBg}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource DisabledBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnOrange" TargetType="Button" BasedOn="{StaticResource BtnGreen}">
    <Setter Property="Background" Value="{DynamicResource AccentOrange}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentOrange}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentOrangeHover}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentOrangeHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource DisabledBg}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource DisabledBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BtnStatus" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
    <Setter Property="Padding" Value="6,2,6,2"/>
    <Setter Property="MinHeight" Value="22"/>
    <Setter Property="FontSize" Value="11.5"/>
  </Style>

  <!-- header chip: settings gear, theme swatch -->
  <Style x:Key="ChipBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Padding" Value="8,3,8,3"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
  </Style>

  <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="26"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>

  <!-- ===================================================================
       Shrink to taskbar.  Two glyphs - down into a tray, and a green arrow
       back up - drawn as stroked Paths inside DataTemplates and swapped by a
       Tag="shrunk" trigger.  Never a symbol font (an empty box on a machine
       without it) and never a Path set as Content (one element cannot sit in
       the four windows that use this style).
       =================================================================== -->
  <DataTemplate x:Key="ShrinkGlyph">
    <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.6"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Stroke="{DynamicResource FgMuted}"
          Data="M 6 0.5 L 6 8 M 2.5 4.6 L 6 8.2 L 9.5 4.6 M 1 11.2 L 11 11.2"/>
  </DataTemplate>
  <DataTemplate x:Key="ExpandGlyph">
    <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.9"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
          Stroke="{DynamicResource AccentGreen}"
          Data="M 6 11.5 L 6 4 M 2.5 7.4 L 6 3.8 L 9.5 7.4 M 1 0.8 L 11 0.8"/>
  </DataTemplate>
  <Style x:Key="ShrinkBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
    <Setter Property="ContentTemplate" Value="{StaticResource ShrinkGlyph}"/>
    <Setter Property="ToolTip" Value="Shrink to the taskbar so Revit can be seen  (Ctrl+Shift+H)"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="shrunk">
        <Setter Property="ContentTemplate" Value="{StaticResource ExpandGlyph}"/>
        <Setter Property="ToolTip" Value="Open the window again  (Ctrl+Shift+H)"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell" Background="Transparent" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource WarnRed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       TextBox, with a placeholder driven by Tag so a bare search box says
       what it searches.  30px tall leaves 16px for a line of Segoe UI 12.5
       that needs about 17, so every search box clipped its own descenders:
       padding 3, minimum height 32.
       =================================================================== -->
  <Style x:Key="ThemedTextBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource FgBody}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelBg}"/>
    <Setter Property="Padding" Value="6,3,6,3"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="shell"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="4">
            <Grid>
              <TextBlock x:Name="placeholder"
                         Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource FgMuted}"
                         FontFamily="{DynamicResource UiFont}"
                         FontSize="12"
                         IsHitTestVisible="False"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"
                         Margin="7,0,6,0"/>
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource DisabledBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
    <Setter Property="Height" Value="32"/>
  </Style>

  <Style x:Key="MiniSearchBox" TargetType="TextBox" BasedOn="{StaticResource ThemedTextBox}">
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="4,1,4,1"/>
  </Style>

  <!-- ===================================================================
       ScrollBar and ScrollViewer
       =================================================================== -->
  <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="bar" Background="{DynamicResource ScrollThumb}"
                  CornerRadius="4" Margin="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bar" Property="Background" Value="{DynamicResource ScrollThumbHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollLineButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="11"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollLineButton}"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumbStyle}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollLineButton}"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto"/>
              <Setter Property="Height" Value="11"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedScroller" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                       Style="{StaticResource ThemedScrollBar}"
                       Orientation="Vertical"
                       Value="{TemplateBinding VerticalOffset}"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource ThemedScrollBar}"
                       Orientation="Horizontal"
                       Value="{TemplateBinding HorizontalOffset}"
                       Maximum="{TemplateBinding ScrollableWidth}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       ComboBox.  WPF's stock ComboBox cannot be themed by setting
       properties: its toggle, its popup and its items ignore Background and
       fall back to the system theme, which shows through as unreadable white
       boxes in dark mode.  Full control templates for both.
       =================================================================== -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="ClickMode" Value="Press"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="shell"
                  Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="4">
            <Path x:Name="arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,9,0" Data="M 0 0 L 8 0 L 4 5 Z"
                  Fill="{DynamicResource FgMuted}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedComboItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Padding" Value="8,5,8,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="shell" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource SelBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedCombo" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="8,3,24,3"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_Toggle"
                          Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter x:Name="face"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="{TemplateBinding Padding}"
                              IsHitTestVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   Placement="Bottom" PopupAnimation="None"
                   IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border Background="{DynamicResource PopupBg}"
                      BorderBrush="{DynamicResource ChromeEdge}"
                      BorderThickness="1" CornerRadius="4"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Margin="0,2,0,0">
                <ScrollViewer Style="{StaticResource ThemedScroller}" Margin="2">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MiniCombo" TargetType="ComboBox" BasedOn="{StaticResource ThemedCombo}">
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="6,1,20,1"/>
  </Style>

  <!-- ===================================================================
       CheckBox.  The tick is drawn from a Path, not set in a symbol font, so
       it cannot come out as an empty box on a machine without that font.
       =================================================================== -->
  <Style x:Key="ThemedCheck" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
              <Path x:Name="tick" Visibility="Collapsed"
                    Stretch="Uniform" Margin="3"
                    Stroke="{DynamicResource FgOnAccent}" StrokeThickness="2"
                    StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                    Data="M 0 4 L 3 7 L 9 0"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBlue}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
              <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBlueDim}"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBlueDim}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
              <Setter TargetName="box" Property="Background" Value="{DynamicResource DisabledBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedRadio" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="ring" Width="15" Height="15" CornerRadius="8"
                    VerticalAlignment="Center"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
              <Ellipse x:Name="dot" Width="7" Height="7" Visibility="Collapsed"
                       Fill="{DynamicResource AccentBlue}"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       ListBox and its items
       =================================================================== -->
  <Style x:Key="ThemedListItem" TargetType="ListBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Padding" Value="6,3,6,3"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="shell" Background="Transparent" CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource SelBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedList" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedListItem}"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <!-- ===================================================================
       ToolTip
       =================================================================== -->
  <Style x:Key="ThemedToolTip" TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource PopupBg}"
                  BorderBrush="{DynamicResource ChromeEdge}"
                  BorderThickness="1" CornerRadius="4" Padding="9,6,9,6">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Filter caret and the expand chevron
       =================================================================== -->
  <Style x:Key="CaretToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="shell" Background="Transparent" CornerRadius="3">
            <Path x:Name="glyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Data="M 0 0 L 7 0 L 3.5 4.5 Z" Fill="{DynamicResource FgMuted}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="glyph" Property="Fill" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ChevronToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="shell" Background="Transparent" CornerRadius="3">
            <Grid>
              <Path x:Name="shut" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Data="M 0 0 L 5 4 L 0 8 Z" Fill="{DynamicResource FgMuted}"/>
              <Path x:Name="open" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed"
                    Data="M 0 0 L 8 0 L 4 5 Z" Fill="{DynamicResource AccentBlue}"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="shut" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="open" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a chip that stays pressed, for Active view / Entire project -->
  <Style x:Key="ChipToggle" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="10,4,10,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="shell" CornerRadius="4" BorderThickness="1"
                  Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentBlue}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
              <Setter Property="Foreground" Value="{DynamicResource FgOnAccent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       DataGrid
       =================================================================== -->
  <Style x:Key="ThemedHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource BarBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="6,4,6,4"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border x:Name="shell" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource GridLine}"
                    BorderThickness="0,0,1,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Stretch"/>
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right"
                   Width="6" Cursor="SizeWE" Opacity="0">
              <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </Thumb.Template>
            </Thumb>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedCell" TargetType="DataGridCell">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border x:Name="shell" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource GridLine}"
                  BorderThickness="0,0,1,0">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <!-- A picked cell has to LOOK picked.  Without this the grid knew
                 perfectly well what was selected and nothing on screen said
                 so, because the cell template painted its own background and
                 never looked at IsSelected. -->
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource SelBg}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
              <Setter TargetName="shell" Property="BorderThickness" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Border x:Name="shell" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                  SnapsToDevicePixels="True">
            <DataGridCellsPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource SelBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedGrid" TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="CanUserReorderColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="EnableColumnVirtualization" Value="False"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource ThemedHeader}"/>
    <Setter Property="CellStyle" Value="{StaticResource ThemedCell}"/>
    <Setter Property="RowStyle" Value="{StaticResource ThemedRow}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGrid">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="4">
            <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <ScrollViewer.Template>
                <ControlTemplate TargetType="ScrollViewer">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter"
                                                    Grid.Row="0" Grid.Column="0"/>
                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                            Grid.Row="1" Grid.Column="0"
                                            CanContentScroll="True"/>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="1" Grid.Column="1"
                               Style="{StaticResource ThemedScrollBar}" Orientation="Vertical"
                               Value="{TemplateBinding VerticalOffset}"
                               Maximum="{TemplateBinding ScrollableHeight}"
                               ViewportSize="{TemplateBinding ViewportHeight}"
                               Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="2" Grid.Column="0"
                               Style="{StaticResource ThemedScrollBar}" Orientation="Horizontal"
                               Value="{TemplateBinding HorizontalOffset}"
                               Maximum="{TemplateBinding ScrollableWidth}"
                               ViewportSize="{TemplateBinding ViewportWidth}"
                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                  </Grid>
                </ControlTemplate>
              </ScrollViewer.Template>
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       GridSplitter and the resize grips
       =================================================================== -->
  <Style x:Key="ThemedSplitter" TargetType="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Width" Value="4"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="ShowsPreview" Value="False"/>
  </Style>

  <Style x:Key="GripThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Progress band across the top of the window
       =================================================================== -->
  <Style x:Key="ThemedProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="3"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBlue}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{TemplateBinding Background}"/>
            <Border x:Name="PART_Track"/>
            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                    Background="{TemplateBinding Foreground}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Square icon buttons for the toolbar, and the menus behind a right
       click.  Every glyph is drawn from Path or Border rather than set in
       a symbol font, so it cannot render as an empty box on a machine
       without that font.
       =================================================================== -->
  <Style x:Key="IconToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="shell" CornerRadius="4" BorderThickness="1"
                  Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentBlue}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The bar Apply fills while it writes: a rounded track in the field
       colour with the accent sliding along it. -->
  <Style x:Key="ThemedMeter" TargetType="ProgressBar">
    <Setter Property="Height" Value="8"/>
    <Setter Property="Minimum" Value="0"/>
    <Setter Property="Maximum" Value="100"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentGreen}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border x:Name="PART_Track" CornerRadius="4" BorderThickness="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"/>
            <Border x:Name="PART_Indicator" CornerRadius="4"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding Foreground}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- An icon toggle that lights up green while it has something to do:
       Tag="armed" from code.  Used by the batch rename button, which arms
       itself as soon as the list has names picked. -->
  <Style x:Key="IconArmed" TargetType="ToggleButton">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="shell" CornerRadius="4" BorderThickness="1"
                  Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="shell" Property="Opacity" Value="0.45"/>
            </Trigger>
            <Trigger Property="Tag" Value="armed">
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
              <Setter TargetName="shell" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentGreen}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="IconGreen" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell" CornerRadius="4" BorderThickness="1"
                  Background="{DynamicResource AccentGreen}"
                  BorderBrush="{DynamicResource AccentGreen}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentGreenHover}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentGreenHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="shell" Background="Transparent" CornerRadius="3"
                  Padding="10,5,14,5">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource SelBg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledFg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ThemedContextMenu" TargetType="ContextMenu">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource PopupBg}"
                  BorderBrush="{DynamicResource ChromeEdge}"
                  BorderThickness="1" CornerRadius="4" Padding="4">
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================================
       Editing in the cell itself.  The first version put a popup over the
       cell; a popup with StaysOpen false is closed by the very mouse-up
       that follows the double click that opened it, so it flashed up and
       went again.  The editor is now the cell.
       =================================================================== -->
  <Style x:Key="CellEditBox" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="FontSize" Value="{DynamicResource FontBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource AccentOrange}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelBg}"/>
    <Setter Property="Padding" Value="4,1,4,1"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource AccentOrange}"
                  BorderThickness="1" CornerRadius="3">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                          VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The place-instance button that sits in each type row.  Square with a
       soft radius so it reads as pressable without shouting over the row. -->
  <Style x:Key="RowIconBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell" CornerRadius="4" BorderThickness="1"
                  Background="Transparent"
                  BorderBrush="{DynamicResource EdgeBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentGreen}"/>
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource AccentGreenHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A square icon that acts rather than toggles: Refresh, Expand all. -->
  <Style x:Key="IconAction" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell" CornerRadius="4" BorderThickness="1"
                  Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A destructive action: outlined red rather than filled, so it reads as
       "careful" without shouting over the footer. -->
  <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
    <Setter Property="Foreground" Value="{DynamicResource WarnRed}"/>
    <Setter Property="Padding" Value="12,5,12,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="shell" CornerRadius="4" BorderThickness="1.4"
                  Background="Transparent"
                  BorderBrush="{DynamicResource WarnRed}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="shell" Property="Background" Value="{DynamicResource WarnRed}"/>
              <Setter Property="Foreground" Value="{DynamicResource FgBody}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>

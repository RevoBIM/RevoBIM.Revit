<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5" Foreground="{DynamicResource Text}" Width="720" Height="560" MinWidth="520" MinHeight="340">
<Border x:Name="Root" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="6">
<Grid x:Name="Body">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  @@HEADER@@
  <StackPanel Grid.Row="1" Margin="10,10,10,6">
    <DockPanel Margin="0,0,0,6">
      <Button x:Name="BrowseBtn" DockPanel.Dock="Right" Style="{DynamicResource ToolBtn}" Margin="8,0,0,0" Content="Choose file"/>
      <TextBox x:Name="PathBox" Height="32" IsReadOnly="True" Tag="Shared parameter file"/>
    </DockPanel>
    <TextBox x:Name="SearchBox" Height="32" Tag="Search"/>
  </StackPanel>
  <DataGrid x:Name="PickGrid" Grid.Row="2" Margin="10,0">
    <DataGrid.Columns>
      <DataGridTemplateColumn Width="34" CanUserSort="False">
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <CheckBox HorizontalAlignment="Center" IsChecked="{Binding tick, UpdateSourceTrigger=PropertyChanged}"/>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Parameter Name" Width="3*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" VerticalAlignment="Center" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Type" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ptype}" VerticalAlignment="Center" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Group" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding grp}" VerticalAlignment="Center" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="3" Margin="10">
    <Button x:Name="YesBtn" DockPanel.Dock="Right" Style="{DynamicResource GreenBtn}" Content="Add"/>
    <Button x:Name="NoBtn" DockPanel.Dock="Right" Style="{DynamicResource ToolBtn}" Content="Cancel"/>
    <TextBlock x:Name="CountText" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid x:Name="Grips" Grid.RowSpan="4"/>
</Grid>
</Border>
</Window>

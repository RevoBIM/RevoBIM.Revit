<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5" Foreground="{DynamicResource Text}" Width="420" SizeToContent="Height" MinHeight="120">
<Border x:Name="Root" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="6">
<Grid x:Name="Body">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  @@HEADER@@
  <StackPanel Grid.Row="1" Margin="14,14,14,4">
    <TextBlock x:Name="Label" Margin="0,0,0,6" TextWrapping="Wrap"/>
    <TextBox x:Name="Box" Height="30"/>
    <ComboBox x:Name="Pick" Height="30" Visibility="Collapsed"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
    <Button x:Name="NoBtn" Style="{DynamicResource ToolBtn}" Content="Cancel"/>
    <Button x:Name="YesBtn" Style="{DynamicResource GreenBtn}" Content="OK"/>
  </StackPanel>
  <Grid x:Name="Grips" Grid.RowSpan="3"/>
</Grid>
</Border>
</Window>

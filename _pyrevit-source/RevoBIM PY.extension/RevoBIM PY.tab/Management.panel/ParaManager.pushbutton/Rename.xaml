<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5" Foreground="{DynamicResource Text}" Width="680" Height="480" MinWidth="520" MinHeight="320">
<Border x:Name="Root" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="6">
<Grid x:Name="Body">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  @@HEADER@@
  <Grid Grid.Row="1" Margin="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0">
      <TextBlock Text="Find" Margin="0,0,0,3"/><TextBox x:Name="FindBox" Height="30" Margin="0,0,0,8"/>
      <TextBlock Text="Replace with" Margin="0,0,0,3"/><TextBox x:Name="ReplaceBox" Height="30" Margin="0,0,0,8"/>
      <TextBlock Text="Add prefix" Margin="0,0,0,3"/><TextBox x:Name="PrefixBox" Height="30" Margin="0,0,0,8"/>
      <TextBlock Text="Add suffix" Margin="0,0,0,3"/><TextBox x:Name="SuffixBox" Height="30"/>
    </StackPanel>
    <ListBox x:Name="Preview" Grid.Column="1"/>
  </Grid>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
    <Button x:Name="NoBtn" Style="{DynamicResource ToolBtn}" Content="Cancel"/>
    <Button x:Name="YesBtn" Style="{DynamicResource GreenBtn}" Content="Rename"/>
  </StackPanel>
  <Grid x:Name="Grips" Grid.RowSpan="3"/>
</Grid>
</Border>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Default brushes: Revit dark. The palette replaces them on the window. -->
  <SolidColorBrush x:Key="WindowBg" Color="#3C4454"/>
  <SolidColorBrush x:Key="TitleBg" Color="#222933"/>
  <SolidColorBrush x:Key="FieldBg" Color="#2D3441"/>
  <SolidColorBrush x:Key="StripBg" Color="#1B1F24"/>
  <SolidColorBrush x:Key="HeadBg" Color="#323C48"/>
  <SolidColorBrush x:Key="HoverBg" Color="#444E5E"/>
  <SolidColorBrush x:Key="SelBg" Color="#3A7392"/>
  <SolidColorBrush x:Key="Edge" Color="#515C6B"/>
  <SolidColorBrush x:Key="Text" Color="#EEF0F4"/>
  <SolidColorBrush x:Key="Muted" Color="#A4AAB1"/>
  <SolidColorBrush x:Key="Blue" Color="#5AAEEB"/>
  <SolidColorBrush x:Key="Orange" Color="#E8912D"/>
  <SolidColorBrush x:Key="Green" Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHover" Color="#4EC06D"/>
  <SolidColorBrush x:Key="Red" Color="#D9534F"/>
  <SolidColorBrush x:Key="DisabledBg" Color="#59616F"/>
  <SolidColorBrush x:Key="DisabledText" Color="#A4AAB1"/>
  <SolidColorBrush x:Key="NewRow" Color="#6E3B42"/>
  <SolidColorBrush x:Key="ModRow" Color="#5C4B30"/>
  <SolidColorBrush x:Key="DelRow" Color="#4A2B30"/>
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>

  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>

  <!-- Buttons -->
  <ControlTemplate x:Key="FlatBtn" TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBg}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="ToolBtn" TargetType="Button">
    <Setter Property="Template" Value="{DynamicResource FlatBtn}"/>
    <Setter Property="Background" Value="{DynamicResource HeadBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="GridBtn" TargetType="Button">
    <Setter Property="Template" Value="{DynamicResource FlatBtn}"/>
    <Setter Property="Background" Value="{DynamicResource HeadBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="2,1"/>
  </Style>
  <ControlTemplate x:Key="SolidBtn" TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource GreenHover}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Background" Value="{DynamicResource DisabledBg}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="GreenBtn" TargetType="Button">
    <Setter Property="Template" Value="{DynamicResource SolidBtn}"/>
    <Setter Property="Background" Value="{DynamicResource Green}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinWidth" Value="84"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="WinBtn" TargetType="Button">
    <Setter Property="Template" Value="{DynamicResource FlatBtn}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Margin" Value="2,0,0,0"/>
  </Style>
  <ControlTemplate x:Key="CloseTemplate" TargetType="Button">
    <Border x:Name="B" Background="Transparent" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Red}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="CloseBtn" TargetType="Button">
    <Setter Property="Template" Value="{DynamicResource CloseTemplate}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Margin" Value="2,0,0,0"/>
  </Style>
  <DataTemplate x:Key="ShrinkGlyph">
    <Path Data="M6,1 L6,9 M2,6 L6,10 L10,6 M1,13 L11,13" StrokeThickness="1.5" Stroke="{DynamicResource Text}"/>
  </DataTemplate>
  <DataTemplate x:Key="ExpandGlyph">
    <Path Data="M6,13 L6,4 M1,8 L6,3 L11,8" StrokeThickness="2.2" Stroke="{DynamicResource Green}"/>
  </DataTemplate>
  <Style x:Key="ShrinkBtn" TargetType="Button">
    <Setter Property="Template" Value="{DynamicResource FlatBtn}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="ContentTemplate" Value="{DynamicResource ShrinkGlyph}"/>
    <Setter Property="Content" Value="x"/>
    <Style.Triggers>
      <Trigger Property="Tag" Value="shrunk"><Setter Property="ContentTemplate" Value="{DynamicResource ExpandGlyph}"/></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ChipBtn" TargetType="Button">
    <Setter Property="Template" Value="{DynamicResource FlatBtn}"/>
    <Setter Property="Background" Value="{DynamicResource HeadBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="FontSize" Value="11"/>
  </Style>

  <!-- Tabs: radio buttons over panels, a retemplated TabControl throws -->
  <ControlTemplate x:Key="TabTemplate" TargetType="RadioButton">
    <Border x:Name="B" Background="{DynamicResource HeadBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="12,5" Margin="0,0,2,0">
      <ContentPresenter/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource WindowBg}"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBg}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="TabBtn" TargetType="RadioButton">
    <Setter Property="Template" Value="{DynamicResource TabTemplate}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="GroupName" Value="Tabs"/>
  </Style>

  <!-- Text box with a placeholder in Tag -->
  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="5,3"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
            <Grid>
              <TextBlock x:Name="Ph" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Muted}" Margin="7,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="Ph" Property="Visibility" Value="Visible"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="GridBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="3,0"/>
    <Setter Property="ContextMenu" Value="{x:Null}"/>
  </Style>
  <Style x:Key="ParamNameBox" TargetType="TextBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="3,0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding free}" Value="True">
        <Setter Property="IsReadOnly" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Combo -->
  <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="2">
      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,7,0" Data="M0,0 L4,4 L8,0" StrokeThickness="1.6" Stroke="{DynamicResource Text}"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Blue}"/></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="ComboTemplate" TargetType="ComboBox">
    <Grid>
      <ToggleButton x:Name="Tg" Template="{DynamicResource ComboToggle}" Background="{TemplateBinding Background}" Focusable="False" ClickMode="Press"
                    IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
      <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                        IsHitTestVisible="False" Margin="6,0,20,0" VerticalAlignment="Center"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
        <Border Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
                MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
          <ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
        </Border>
      </Popup>
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Tg" Property="Background" Value="{DynamicResource DisabledBg}"/>
        <Setter Property="Foreground" Value="{DynamicResource DisabledText}"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style TargetType="ComboBox">
    <Setter Property="Template" Value="{DynamicResource ComboTemplate}"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="B" Background="Transparent" Padding="6,3"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SelBg}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tick box -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="16" Height="16" Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="2">
              <Path x:Name="Tick" Data="M2.5,7.5 L6,11 L12.5,3.5" StrokeThickness="2" Stroke="{DynamicResource Blue}" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Blue}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="MixedMark" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Orange}"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding mixed}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Scroll bar -->
  <ControlTemplate x:Key="BarThumb" TargetType="Thumb"><Border Background="{DynamicResource Edge}" CornerRadius="3"/></ControlTemplate>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="{DynamicResource FieldBg}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb Template="{DynamicResource BarThumb}" Margin="2"/></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical"><Setter Property="Width" Value="11"/></Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="11"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="{DynamicResource FieldBg}">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                  <Track.Thumb><Thumb Template="{DynamicResource BarThumb}" Margin="2"/></Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource TitleBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
  </Style>

  <!-- Table -->
  <Style TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="RowBackground" Value="{DynamicResource FieldBg}"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="RowHeight" Value="27"/>
    <Setter Property="SelectionMode" Value="Extended"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource HeadBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="DataGridRow">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding state}" Value="mod"><Setter Property="Background" Value="{DynamicResource ModRow}"/></DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="new"><Setter Property="Background" Value="{DynamicResource NewRow}"/></DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="del"><Setter Property="Background" Value="{DynamicResource DelRow}"/></DataTrigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBg}"/></Trigger>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelBg}"/></Trigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="StateCell">
    <Border x:Name="B" Background="{DynamicResource Green}">
      <Path x:Name="P" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource OnAccent}" StrokeThickness="2" Data="M0,5 L4,9 L11,0"/>
    </Border>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding state}" Value="mod">
        <Setter TargetName="B" Property="Background" Value="{DynamicResource Orange}"/>
        <Setter TargetName="P" Property="Data" Value="M0,10 L2,10 L10,2 L8,0 L0,8 Z"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="new">
        <Setter TargetName="B" Property="Background" Value="Transparent"/>
        <Setter TargetName="P" Property="Stroke" Value="{DynamicResource Text}"/>
        <Setter TargetName="P" Property="Data" Value="M5,0 L5,10 M0,5 L10,5"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding state}" Value="del">
        <Setter TargetName="B" Property="Background" Value="{DynamicResource Red}"/>
        <Setter TargetName="P" Property="Data" Value="M0,0 L9,9 M9,0 L0,9"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Lists -->
  <Style TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Edge}"/>
  </Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="B" Background="Transparent" Padding="6,3"><ContentPresenter/></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource HoverBg}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SelBg}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Menus -->
  <Style x:Key="ThemedMenu" TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource FieldBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" Padding="2">
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ThemedMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="B" Background="Transparent" Padding="8,5" MinWidth="190">
            <DockPanel>
              <ContentPresenter ContentSource="Icon" Width="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource SelBg}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5" Foreground="{DynamicResource Text}" Width="500" Height="640" MinWidth="420" MinHeight="400">
<Border x:Name="Root" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="6">
<Grid x:Name="Body">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  @@HEADER@@
  <StackPanel Grid.Row="1" Margin="10,10,10,6">
    <DockPanel Margin="0,0,0,6">
      <Button x:Name="SaveGroupBtn" Style="{DynamicResource ToolBtn}" Content="Save" ToolTip="Save the ticked categories as a group"/>
      <Button x:Name="DeleteGroupBtn" DockPanel.Dock="Right" Style="{DynamicResource ToolBtn}" Margin="8,0,0,0" Content="Delete" ToolTip="Delete the chosen group" IsEnabled="False"/>
      <ComboBox x:Name="GroupCombo" Height="32"/>
    </DockPanel>
    <ComboBox x:Name="DisciplineCombo" Height="30" Margin="0,0,0,6"/>
    <TextBox x:Name="SearchBox" Height="32" Tag="Search" Margin="0,0,0,6"/>
    <StackPanel Orientation="Horizontal">
      <CheckBox x:Name="HideUnchecked" Content="Hide Un-checked categories" Margin="0,0,30,0"/>
      <CheckBox x:Name="ShowSub" Content="Show Sub-categories" IsChecked="True"/>
    </StackPanel>
  </StackPanel>
  <DataGrid x:Name="CatGrid" Grid.Row="2" Margin="10,0">
    <DataGrid.Columns>
      <DataGridTemplateColumn Width="34" CanUserSort="False">
        <DataGridTemplateColumn.Header><CheckBox x:Name="TickAll"/></DataGridTemplateColumn.Header>
        <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Grid HorizontalAlignment="Center" Width="16" Height="16">
            <CheckBox IsChecked="{Binding tick, UpdateSourceTrigger=PropertyChanged}"/>
            <Border Style="{DynamicResource MixedMark}" ToolTip="On some of the parameters only"/>
          </Grid>
        </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Category" Width="3*" SortMemberPath="name">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding name}" VerticalAlignment="Center" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Discipline" Width="1.4*" SortMemberPath="disc">
        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding disc}" VerticalAlignment="Center" Margin="4,0"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
    </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="3" Margin="10">
    <Button x:Name="YesBtn" DockPanel.Dock="Right" Style="{DynamicResource GreenBtn}" Content="OK"/>
    <TextBlock x:Name="CountText" VerticalAlignment="Center"/>
  </DockPanel>
  <Grid x:Name="Grips" Grid.RowSpan="4"/>
</Grid>
</Border>
</Window>

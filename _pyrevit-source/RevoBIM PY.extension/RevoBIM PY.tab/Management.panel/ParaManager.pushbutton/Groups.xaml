<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12.5" Foreground="{DynamicResource Text}" Width="420" Height="440" MinWidth="360" MinHeight="300">
<Border x:Name="Root" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="6">
<Grid x:Name="Body">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  @@HEADER@@
  <ListBox x:Name="GroupList" Grid.Row="1" Margin="10"/>
  <DockPanel Grid.Row="2" Margin="10,0,10,10">
    <Button x:Name="YesBtn" DockPanel.Dock="Right" Style="{DynamicResource GreenBtn}" Content="Done"/>
    <StackPanel Orientation="Horizontal">
      <Button x:Name="AddBtn" Style="{DynamicResource ToolBtn}" Content="Add"/>
      <Button x:Name="RenameBtn" Style="{DynamicResource ToolBtn}" Content="Rename"/>
      <Button x:Name="DeleteBtn" Style="{DynamicResource ToolBtn}" Content="Delete"/>
    </StackPanel>
  </DockPanel>
  <Grid x:Name="Grips" Grid.RowSpan="3"/>
</Grid>
</Border>
</Window>

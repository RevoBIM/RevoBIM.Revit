<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Express print" Width="340" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        FontFamily="Segoe UI" FontSize="12" TextOptions.TextFormattingMode="Display">

    <!-- ==========================================================
         Project Browser Pro - the express print progress strip. The
         only thing on screen during an express print: a title, the
         sheet count and percentage, and a bar. Closes itself when
         Pro Sheets says done; stays with a Close button on a failure.
         The bar is two star columns, not a ProgressBar, so there is no
         system template to show through.
         ========================================================== -->
    <Border Background="{DynamicResource CardBrush}" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource ChromeEdgeBrush}" Padding="12,9,10,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Path Grid.Column="0" Width="14" Height="12" Stretch="None" StrokeThickness="1.3"
                      VerticalAlignment="Center" Margin="0,0,7,0" Stroke="{DynamicResource OrangeBrush}"
                      Data="M3.5,4.5 L3.5,1 L10.5,1 L10.5,4.5 M1,4.5 L13,4.5 L13,9 L1,9 Z M3.5,7.5 L10.5,7.5 L10.5,11.5 L3.5,11.5 Z"/>
                <TextBlock Grid.Column="1" Text="Express print" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBlock x:Name="PercentText" Grid.Column="2" Text="0%" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource OrangeBrush}"/>
                <Button x:Name="CloseButton" Grid.Column="3" Style="{DynamicResource CloseButton}" Width="22"
                        Height="20" Margin="6,0,0,0" Visibility="Collapsed" ToolTip="Close">
                    <Path Data="M1,1 L8,8 M8,1 L1,8" StrokeThickness="1.4" Width="9" Height="9"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
            <!-- Track in DisabledBrush, not FieldBrush: on the light palette the
                 field and the card are both white and the track vanished. -->
            <Border Grid.Row="1" Height="6" Margin="0,8,0,6" CornerRadius="3"
                    Background="{DynamicResource DisabledBrush}">
                <Grid x:Name="BarGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DoneColumn" Width="0*"/>
                        <ColumnDefinition x:Name="LeftColumn" Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="BarFill" Grid.Column="0" CornerRadius="3"
                            Background="{DynamicResource OrangeBrush}"/>
                </Grid>
            </Border>
            <TextBlock x:Name="DetailText" Grid.Row="2" FontSize="11" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MutedBrush}" Text="Starting Pro Sheets..."/>
        </Grid>
    </Border>
</Window>

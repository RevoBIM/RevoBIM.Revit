<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" TextOptions.TextFormattingMode="Display">

    <!-- ==========================================================
         Project Browser Pro - themed message, question or name box.
         ========================================================== -->
    <Border Background="{DynamicResource BgBrush}" CornerRadius="6" BorderThickness="1"
            BorderBrush="{DynamicResource ChromeEdgeBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="Header" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="LogoImage" Width="22" Height="22" Margin="10,6,8,6"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
                        <TextBlock x:Name="TitleText" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource OrangeBrush}"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2" FontSize="11" Margin="0,0,6,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="CloseButton" Grid.Column="3" Style="{DynamicResource CloseButton}" Margin="0,0,6,0">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" StrokeThickness="1.5" Width="10" Height="10"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </Grid>
            </Border>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="16,14,16,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}"/>
            <TextBox x:Name="InputBox" Grid.Row="2" Margin="16,0,16,10" Height="28" Visibility="Collapsed"/>
            <Border Grid.Row="3" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="10,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{DynamicResource PlainButton}" Content="Cancel"/>
                    <Button x:Name="OkButton" Style="{DynamicResource GreenButton}" Padding="16,4"
                            Margin="6,0,0,0" Content="OK"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

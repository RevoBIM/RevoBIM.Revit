<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Root" Background="{DynamicResource BgBrush}" SnapsToDevicePixels="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextElement.FontFamily="Segoe UI" TextElement.FontSize="12" Focusable="True">

    <!-- ==========================================================
         Project Browser Pro - the browser. Used as is inside each
         dockable pane, and inside Window.xaml when the panes are not
         registered. Everything under Scaled zooms with Ctrl + wheel.
         The root is a Border, which has no font of its own: the font
         is set through the inherited TextElement attached properties.
         ========================================================== -->
    <Grid x:Name="Scaled">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== top bar (folds away) ==================== -->
        <!-- Title line and tool buttons. The chevron at the right of the tab
             row folds this whole block; tabs and search stay. -->
        <!-- One grey from top to list, as Revit's own palettes; the rows are
             told apart by a soft shadow under each, not by darker bands. -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource BgBrush}">
            <StackPanel>
                <Grid x:Name="Header">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="LogoImage" Grid.Column="0" Width="18" Height="18" Margin="7,4,6,4"
                           VerticalAlignment="Center" ToolTip="RevoBIM"/>
                    <!-- A DockPanel, not a horizontal StackPanel: a StackPanel gives its
                         children infinite width, so the title could never trim with an
                         ellipsis and would run under the theme chip instead. -->
                    <DockPanel Grid.Column="1" VerticalAlignment="Center" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="RevoBIM" FontSize="13.5" FontWeight="Bold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource BlueBrush}"/>
                        <TextBlock x:Name="TitleText" Text="Project Browser Pro" FontSize="11.5"
                                   Margin="6,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource OrangeBrush}"/>
                    </DockPanel>
                    <!-- Dock / Undock: a floating window goes into Revit's dock (and,
                         where the dock was never set up, sets it up); a docked
                         panel comes out as a floating window. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DockButton" Style="{DynamicResource ChipButton}"
                            VerticalAlignment="Center" Margin="4,0,0,0" Padding="6,1">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="DockGlyph" Width="12" Height="12" Stretch="None" StrokeThickness="1.3"
                                  Stroke="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="DockText" Text="Dock" FontSize="10.5" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeChip" Style="{DynamicResource ChipButton}"
                            VerticalAlignment="Center" Margin="4,0,5,0" Padding="6,1"
                            ToolTip="Theme: Auto follows Revit's canvas. Click to switch Auto / Dark / Light.">
                        <StackPanel Orientation="Horizontal">
                            <Path x:Name="ThemeGlyph" Width="12" Height="12" Stretch="None"
                                  Fill="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThemeText" Text="Auto" FontSize="10.5" Margin="4,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="3" Text="v1.0.0" FontSize="10.5"
                               Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                               Margin="0,0,7,0"/>
                    <StackPanel x:Name="WindowButtons" Grid.Column="4" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,3,0" Visibility="Collapsed">
                        <Button x:Name="FullButton" Style="{DynamicResource WinButton}" Height="22"
                                ToolTip="Full screen (F11)">
                            <Border Width="10" Height="10" BorderThickness="1.4"
                                    BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="CloseButton" Style="{DynamicResource CloseButton}" Height="22" ToolTip="Close">
                            <Path Data="M1,1 L9,9 M9,1 L1,9" StrokeThickness="1.5" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Height="4" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource RowShadowColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid x:Name="ToolBar" Margin="4,0,5,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <Button x:Name="CollapseButton" Style="{DynamicResource ToolButton}"
                                ToolTip="Collapse all / Expand all">
                            <Path x:Name="CollapseGlyph" Width="12" Height="12" Stretch="None" StrokeThickness="1.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <!-- Colour / Greyscale / Custom: each click the next. The three
                             dots show which (all coloured, all grey, grey and one). -->
                        <Button x:Name="ColourButton" Style="{DynamicResource ToolButton}"
                                ToolTip="Heading colours: Colour, Greyscale or Custom">
                            <Canvas Width="14" Height="12">
                                <Ellipse x:Name="ColourDot1" Canvas.Left="0" Canvas.Top="3" Width="6" Height="6"/>
                                <Ellipse x:Name="ColourDot2" Canvas.Left="4" Canvas.Top="0" Width="6" Height="6"/>
                                <Ellipse x:Name="ColourDot3" Canvas.Left="8" Canvas.Top="4" Width="6" Height="6"/>
                            </Canvas>
                        </Button>
                        <Button x:Name="OrgButton" Style="{DynamicResource ToolButton}"
                                ToolTip="Browser Organisation for this tab">
                            <Path Width="12" Height="12" Stretch="None" StrokeThickness="1.3"
                                  Data="M1.5,1.5 L5,1.5 M2.5,1.5 L2.5,10.5 M2.5,6 L5.5,6 M2.5,10.5 L5.5,10.5 M6.5,4.5 L11,4.5 L11,7.5 L6.5,7.5 Z M6.5,9 L11,9 L11,11.8 L6.5,11.8 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="SettingsButton" Style="{DynamicResource ToolButton}"
                                ToolTip="Settings: heading colours, highlights, your colours">
                            <Path Width="12" Height="12" Stretch="None" StrokeThickness="1.3"
                                  Data="M6,3.6 A2.4,2.4 0 1 0 6,8.4 A2.4,2.4 0 1 0 6,3.6 Z M6,0.6 L6,2.2 M6,9.8 L6,11.4 M0.6,6 L2.2,6 M9.8,6 L11.4,6 M2.2,2.2 L3.3,3.3 M8.7,8.7 L9.8,9.8 M2.2,9.8 L3.3,8.7 M8.7,3.3 L9.8,2.2"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="RefreshButton" Style="{DynamicResource ToolButton}"
                                ToolTip="Refresh from the model (F5)">
                            <Path Width="12" Height="12" Stretch="None" StrokeThickness="1.4"
                                  Data="M10,6.5 A4,4 0 1 1 8.6,3.2 M9.2,0.6 L9.2,3.6 L6.2,3.6"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button x:Name="PopOutButton" Style="{DynamicResource ToolButton}"
                                ToolTip="Open this tab as its own dockable window">
                            <Path Width="12" Height="12" Stretch="None" StrokeThickness="1.3"
                                  Data="M5.5,1.5 L10.5,1.5 L10.5,6.5 M10.5,1.5 L5.5,6.5 M8.5,8 L8.5,10.5 L1.5,10.5 L1.5,3.5 L4,3.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                    </WrapPanel>
                </Grid>
                <Border Height="4" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="{DynamicResource RowShadowColor}" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </StackPanel>
        </Border>

        <!-- ==================== tabs ==================== -->
        <!-- Icon-only tabs, one colour per type; names and counts are in the
             tooltips. Revit's own dock strip (bottom of a shared dock) is
             Revit's and cannot be moved or given icons. -->
        <Border Grid.Row="1" Background="{DynamicResource BgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <UniformGrid x:Name="TabStrip" Grid.Column="0" Rows="1" Margin="2,0,0,0">
                <RadioButton x:Name="TabAll" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="All">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconAll" Stretch="None" Fill="{DynamicResource AllBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="TabFavourites" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="Favourites">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconFavourites" Stretch="None" Fill="{DynamicResource FavBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="TabViews" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="Views">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconViews" Stretch="None" Fill="{DynamicResource BlueBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="TabLegends" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="Legends">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconLegends" Stretch="None" Fill="{DynamicResource LegendBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="TabSheets" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="Sheets">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconSheets" Stretch="None" Fill="{DynamicResource OrangeBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="TabSchedules" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="Schedules">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconSchedules" Stretch="None" Fill="{DynamicResource GreenBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="TabPanels" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="Panel schedules">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconPanels" Stretch="None" Fill="{DynamicResource PanelBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                <RadioButton x:Name="TabFamilies" GroupName="PbpTabs" Style="{DynamicResource IconTab}"
                             ToolTip="Families">
                    <Viewbox Width="22" Height="22">
                        <Grid Width="24" Height="24">
                            <Path x:Name="IconFamilies" Stretch="None" Fill="{DynamicResource FamilyBrush}"/>
                        </Grid>
                    </Viewbox>
                </RadioButton>
                </UniformGrid>
                <Button x:Name="BarToggle" Grid.Column="1" Style="{DynamicResource WinButton}" Width="22"
                        Height="22" Margin="2,0,3,0" VerticalAlignment="Center"
                        ToolTip="Hide the title and tool buttons">
                    <Path x:Name="BarToggleGlyph" Width="10" Height="10" Stretch="None" StrokeThickness="1.6"
                          Data="M1.5,7 L5,3.5 L8.5,7"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ==================== search ==================== -->
        <!-- Revit's search: a darker box with a magnifier at its left. -->
        <Grid Grid.Row="2" Margin="5,5,5,2">
            <Border Height="4" IsHitTestVisible="False" VerticalAlignment="Top" Margin="-5,-5,-5,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource RowShadowColor}" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!-- Typed text and the hint start just right of the magnifier, at
                 the left; the right padding keeps them clear of the clear button. -->
            <!-- An orange frame round the box, always - typing in it keeps it
                 orange (the box's own edge, which turns blue on focus, is off). -->
            <Border x:Name="SearchFrame" BorderBrush="{DynamicResource OrangeBrush}" BorderThickness="1"
                    CornerRadius="4" Background="{DynamicResource SearchBrush}">
                <TextBox x:Name="SearchBox" Tag="Search" Height="28" FontSize="12.5"
                         Background="{DynamicResource SearchBrush}" BorderThickness="0"
                         Padding="27,2,26,2" TextAlignment="Left" HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center" ToolTip="Search: every word must match"/>
            </Border>
            <Path Width="14" Height="14" Stretch="None" Margin="9,0,0,0" HorizontalAlignment="Left"
                  VerticalAlignment="Center" IsHitTestVisible="False" StrokeThickness="1.6"
                  Stroke="{DynamicResource MutedBrush}"
                  Data="M1.5,6 A4.5,4.5 0 1 0 10.5,6 A4.5,4.5 0 1 0 1.5,6 Z M9.3,9.3 L13,13"/>
            <Button x:Name="ClearSearch" Style="{DynamicResource WinButton}" Width="22" Height="20"
                    HorizontalAlignment="Right" Margin="0,0,2,0" Visibility="Collapsed"
                    ToolTip="Clear the search">
                <Path Data="M1,1 L7,7 M7,1 L1,7" StrokeThickness="1.4" Width="8" Height="8"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
        </Grid>

        <!-- ==================== sub tabs (Legends and Drafting Views) ==================== -->
        <!-- A grey segmented strip under the search box: the Legends tab
             shows its legends or its drafting views, one at a time. -->
        <Border x:Name="SubTabs" Grid.Row="3" Margin="5,1,5,4" Padding="2" CornerRadius="4"
                Background="{DynamicResource SubTabBrush}" Visibility="Collapsed">
            <UniformGrid Rows="1">
                <RadioButton x:Name="SubLegends" GroupName="PbpSubTabs" Style="{DynamicResource SubTab}"
                             ToolTip="Legends">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="SubLegendsIcon" Width="12" Height="12" Stretch="None"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock x:Name="SubLegendsText" Text="Legends" FontSize="11.5" Margin="6,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="SubDrafting" GroupName="PbpSubTabs" Style="{DynamicResource SubTab}"
                             ToolTip="Drafting views">
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="SubDraftingIcon" Width="12" Height="12" Stretch="None"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        <TextBlock x:Name="SubDraftingText" Text="Drafting Views" FontSize="11.5" Margin="6,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
        </Border>

        <!-- The Favourites tab's own row of the header tabs: every type, in
             the same icons and colours, each with how many favourites it
             holds. All shows them all under their type headings. -->
        <Border x:Name="FavTabs" Grid.Row="3" Margin="5,1,5,4" Padding="2" CornerRadius="4"
                Background="{DynamicResource SubTabBrush}" Visibility="Collapsed">
            <UniformGrid Rows="1">
                <RadioButton x:Name="FavSubAll" GroupName="PbpFavTabs" Style="{DynamicResource SubTab}"
                             Padding="3,4" ToolTip="All favourites">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path x:Name="FavSubIconAll" Stretch="None" Fill="{DynamicResource AllBrush}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="FavSubCountAll" Text="0" FontSize="11" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FavSubViews" GroupName="PbpFavTabs" Style="{DynamicResource SubTab}"
                             Padding="3,4" ToolTip="Views">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path x:Name="FavSubIconViews" Stretch="None" Fill="{DynamicResource BlueBrush}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="FavSubCountViews" Text="0" FontSize="11" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FavSubLegends" GroupName="PbpFavTabs" Style="{DynamicResource SubTab}"
                             Padding="3,4" ToolTip="Legends and drafting views">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path x:Name="FavSubIconLegends" Stretch="None" Fill="{DynamicResource LegendBrush}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="FavSubCountLegends" Text="0" FontSize="11" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FavSubSheets" GroupName="PbpFavTabs" Style="{DynamicResource SubTab}"
                             Padding="3,4" ToolTip="Sheets">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path x:Name="FavSubIconSheets" Stretch="None" Fill="{DynamicResource OrangeBrush}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="FavSubCountSheets" Text="0" FontSize="11" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FavSubSchedules" GroupName="PbpFavTabs" Style="{DynamicResource SubTab}"
                             Padding="3,4" ToolTip="Schedules">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path x:Name="FavSubIconSchedules" Stretch="None" Fill="{DynamicResource GreenBrush}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="FavSubCountSchedules" Text="0" FontSize="11" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FavSubPanels" GroupName="PbpFavTabs" Style="{DynamicResource SubTab}"
                             Padding="3,4" ToolTip="Panel schedules">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path x:Name="FavSubIconPanels" Stretch="None" Fill="{DynamicResource PanelBrush}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="FavSubCountPanels" Text="0" FontSize="11" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="FavSubFamilies" GroupName="PbpFavTabs" Style="{DynamicResource SubTab}"
                             Padding="3,4" ToolTip="Families and types">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="15" Height="15">
                            <Grid Width="24" Height="24">
                                <Path x:Name="FavSubIconFamilies" Stretch="None" Fill="{DynamicResource FamilyBrush}"/>
                            </Grid>
                        </Viewbox>
                        <TextBlock x:Name="FavSubCountFamilies" Text="0" FontSize="11" Margin="4,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </UniformGrid>
        </Border>

        <!-- ==================== organisation line ==================== -->
        <!-- The Sheets tab adds its sheet set filter at the right of it. -->
        <DockPanel Grid.Row="4" Margin="8,0,6,3" LastChildFill="True">
            <Button x:Name="SheetSetButton" DockPanel.Dock="Right" Style="{DynamicResource ChipButton}"
                    Padding="7,1" Margin="6,0,0,0" Visibility="Collapsed"
                    ToolTip="Show only the sheets in a sheet set (Print &gt; Sheet sets), or all sheets">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SheetSetText" Text="All sheets" FontSize="10.5"
                               MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                    <Path Data="M1,1.5 L4,4.5 L7,1.5" Width="8" Height="6" Margin="5,1,0,0"
                          StrokeThickness="1.3" Stretch="None" VerticalAlignment="Center"
                          Stroke="{DynamicResource MutedBrush}"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="OrgText" FontSize="10.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- ==================== the list ==================== -->
        <Grid Grid.Row="5">
            <ListBox x:Name="List" Style="{DynamicResource BrowserList}" SelectionMode="Extended"
                     ItemTemplate="{DynamicResource RowTemplate}"
                     ItemContainerStyle="{DynamicResource RowItem}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Border Height="4" IsHitTestVisible="False" VerticalAlignment="Top">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{DynamicResource RowShadowColor}" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <TextBlock x:Name="EmptyText" Margin="16" TextWrapping="Wrap" TextAlignment="Center"
                       VerticalAlignment="Top" Foreground="{DynamicResource MutedBrush}"
                       IsHitTestVisible="False" Text="Reading the model..."/>
            <!-- Print / Express: a floating bar under the search box, only
                 while sheets are selected (or a sheet heading) - on any tab. -->
            <Border x:Name="PrintBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,6,14,0" Padding="8,5" CornerRadius="6" Visibility="Collapsed"
                    Background="{DynamicResource CardBrush}" BorderThickness="1"
                    BorderBrush="{DynamicResource ChromeEdgeBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5"
                                      Color="{DynamicResource PillShadowColor}"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PrintBarText" FontSize="11" Margin="2,0,8,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"/>
                    <Button x:Name="OpenFolderButton" Style="{DynamicResource PlainButton}" Padding="7,3"
                            Visibility="Collapsed" ToolTip="Open the folder the express print went to">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="None" Fill="{DynamicResource OrangeBrush}"
                                  Data="M1,2.5 L4.5,2.5 L5.5,3.8 L11,3.8 L11,10 L1,10 Z" VerticalAlignment="Center"/>
                            <TextBlock Text="Open folder" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ExpressButton" Style="{DynamicResource ExpressButton}" IsEnabled="False"
                            ToolTip="Express print: the selected sheets go straight through Pro Sheets on its last settings - only a progress bar shows, then the folder opens">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="14" Height="12" Stretch="None" StrokeThickness="1.3" VerticalAlignment="Center"
                                  Data="M3.5,4.5 L3.5,1 L10.5,1 L10.5,4.5 M1,4.5 L13,4.5 L13,9 L1,9 Z M3.5,7.5 L10.5,7.5 L10.5,11.5 L3.5,11.5 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Express" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="PrintButton" Style="{DynamicResource GreenButton}" IsEnabled="False"
                            ToolTip="Open Pro Sheets with the selected sheets ready to print">
                        <Path Width="14" Height="12" Stretch="None" StrokeThickness="1.3" VerticalAlignment="Center"
                              Data="M3.5,4.5 L3.5,1 L10.5,1 L10.5,4.5 M1,4.5 L13,4.5 L13,9 L1,9 Z M3.5,7.5 L10.5,7.5 L10.5,11.5 L3.5,11.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Border>
            <!-- Rename in place: a slow second click (or F2) lays this box
                 over the row's text. Enter or clicking away keeps it, Esc
                 drops it. -->
            <Canvas x:Name="EditLayer" ClipToBounds="True">
                <TextBox x:Name="InlineEdit" Visibility="Collapsed" Padding="2,0" FontSize="12"
                         VerticalContentAlignment="Center"/>
            </Canvas>
        </Grid>

        <!-- ==================== footer ==================== -->
        <!-- Folds away with the title and tool rows (the header's arrow). -->
        <Grid x:Name="Footer" Grid.Row="6" Background="{DynamicResource BottomBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" Grid.Row="0" Margin="8,4,8,2" FontSize="11"
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <Grid Grid.Row="1" Margin="6,0,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <CheckBox x:Name="DebugTick" Content="Debug" FontSize="11" VerticalAlignment="Center"
                              ToolTip="Write a debug log while this tool is new"/>
                    <Button x:Name="CopyReportButton" Style="{DynamicResource ToolButton}" Margin="6,0,0,0"
                            ToolTip="Copy a debug report to paste into the chat with Claude">
                        <TextBlock Text="Copy report" FontSize="11"/>
                    </Button>
                    <Button x:Name="LogButton" Style="{DynamicResource ToolButton}"
                            ToolTip="Open the debug log">
                        <TextBlock Text="Log" FontSize="11"/>
                    </Button>
                </WrapPanel>
                <TextBlock x:Name="ZoomText" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}"
                           ToolTip="Ctrl + mouse wheel to zoom, Ctrl + 0 to reset"/>
            </Grid>
        </Grid>
    </Grid>
</Border>

<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="280" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Frame}" BorderThickness="1"
        CornerRadius="4" Padding="8" TextElement.FontFamily="Segoe UI" TextElement.FontSize="12">
    <!-- ==================== Excel style value list for one column ==================== -->
    <StackPanel>
        <TextBlock x:Name="ColTxt" Foreground="{DynamicResource Orange}" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TextBox x:Name="FindBox" Height="26" Tag="Search values..."/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
            <Button x:Name="AllBtn" Content="All" Height="24"/>
            <Button x:Name="NoneBtn" Content="None" Height="24"/>
        </StackPanel>
        <ListBox x:Name="ValueList" Height="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"/>
        <TextBlock x:Name="NoteTxt" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Height="28"/>
            <Button x:Name="OkBtn" Content="Apply" Style="{DynamicResource AccentButton}" Padding="14,4"/>
        </StackPanel>
    </StackPanel>
</Border>

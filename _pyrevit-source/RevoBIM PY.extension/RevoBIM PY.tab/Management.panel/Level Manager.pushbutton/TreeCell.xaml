<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ==================== the first column: indent, arrow, tick, name ==================== -->
    <StackPanel Orientation="Horizontal" Background="Transparent" Height="24">
        <Border Width="{Binding indent}"/>
        <Border Tag="arrow" Width="18" Height="22" Background="Transparent" Cursor="Hand" ToolTip="Expand / collapse">
            <Path Data="{Binding arrow}" Fill="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border Tag="tick" Width="14" Height="14" CornerRadius="2" BorderThickness="1" Margin="1,0,7,0"
                Cursor="Hand" VerticalAlignment="Center" Style="{DynamicResource TreeTick}">
            <Grid>
                <Path Data="M2.5,6.5 L5.5,9.5 L11,3.5" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.8"
                      Style="{DynamicResource TreeTickMark}"/>
                <Border Width="6" Height="2" Background="{DynamicResource Blue}" Style="{DynamicResource TreeTickDash}"/>
            </Grid>
        </Border>
        <TextBlock Text="{Binding name}" Style="{DynamicResource TreeName}"/>
    </StackPanel>
</DataTemplate>

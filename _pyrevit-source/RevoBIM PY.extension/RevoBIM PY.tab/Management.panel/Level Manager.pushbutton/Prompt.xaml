<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Level Manager" Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Frame}" Background="{DynamicResource Bg}">
        <StackPanel>
            <!-- ==================== header ==================== -->
            <Border x:Name="Header" Background="{DynamicResource Bar}" CornerRadius="6,6,0,0" Height="42">
                <DockPanel LastChildFill="False" Margin="12,0,6,0">
                    <Image x:Name="Logo" DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Blue}" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="TitleTxt" Text="Level Manager" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Orange}" Margin="8,0,0,1" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{DynamicResource CloseButton}" ToolTip="Cancel">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"/>
                    </Button>
                    <Button x:Name="ShrinkBtn" DockPanel.Dock="Right" Style="{DynamicResource WinButton}"
                            ToolTip="Shrink to the taskbar so Revit can be seen (Ctrl+Shift+H)">
                        <Grid Width="12" Height="12">
                            <Path x:Name="ShrinkGlyph" Data="M6,0.5 L6,7.6 M2.8,4.5 L6,7.7 L9.2,4.5 M1,11 L11,11"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                            <Path x:Name="ExpandGlyph" Data="M6,11.5 L6,1.6 M1.8,5.8 L6,1.6 L10.2,5.8"
                                  Stroke="{DynamicResource Green}" StrokeThickness="2" Visibility="Collapsed"/>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="VersionTxt" DockPanel.Dock="Right" Text="v0.0.0" Foreground="{DynamicResource Muted}"
                               FontSize="11" VerticalAlignment="Center" Margin="4,0,10,0"/>
                </DockPanel>
            </Border>
            <TextBlock x:Name="BodyTxt" Margin="16,14,16,14" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
            <Border Background="{DynamicResource Bar}" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,8">
                    <Button x:Name="NoBtn" Content="Cancel" Height="30" Margin="0,0,8,0"/>
                    <Button x:Name="YesBtn" Content="Continue" Style="{DynamicResource AccentButton}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>

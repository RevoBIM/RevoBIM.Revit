<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM" Width="620" Height="460" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display">

  <Border CornerRadius="6" BorderThickness="1"
          Background="{DynamicResource BrushWindow}"
          BorderBrush="{DynamicResource BrushEdge}">
    <DockPanel LastChildFill="True">

      <Border x:Name="HeaderBar" DockPanel.Dock="Top" Height="52"
              CornerRadius="5,5,0,0" Background="{DynamicResource BrushBar}"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1">
        <Grid Margin="12,0,6,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource BrushBlue}" Margin="0,-2,0,0"/>
            <TextBlock x:Name="TitleText" Text="" FontSize="15"
                       Foreground="{DynamicResource BrushOrange}" Margin="0,-3,0,0"/>
          </StackPanel>
          <TextBlock x:Name="VersionText" Grid.Column="2" Text="v1.3.1" FontSize="11"
                     Foreground="{DynamicResource BrushMuted}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="ShrinkButton" Style="{DynamicResource BtnShrink}"
                    VerticalAlignment="Center"/>
            <Button x:Name="CloseButton" Content="&#x2715;"
                    Style="{DynamicResource BtnClose}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
      </Border>

      <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushBar}"
              CornerRadius="0,0,5,5"
              BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
              Padding="12,9">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Content="Cancel" Style="{DynamicResource BtnBase}"
                  MinWidth="90" Margin="0,0,6,0"/>
          <Button x:Name="OkButton" Content="OK" Style="{DynamicResource BtnGreen}"
                  MinWidth="110"/>
        </StackPanel>
      </Border>

      <DockPanel Margin="14,12,14,12" LastChildFill="True">
        <Border DockPanel.Dock="Top" Margin="0,0,0,10">
          <StackPanel Orientation="Horizontal">
            <Border Width="4" Background="{DynamicResource BrushBlue}" CornerRadius="2"
                    Margin="0,0,8,0"/>
            <TextBlock x:Name="MessageText" Text="" FontSize="13" TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource BrushText}"/>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource BrushField}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                CornerRadius="3" Padding="8">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="DetailText" Text="" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrushMuted}"
                       FontFamily="Consolas, Courier New"/>
          </ScrollViewer>
        </Border>
      </DockPanel>

    </DockPanel>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM" Width="500" SizeToContent="Height" MaxHeight="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True">
    <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource FrameBrush}" Background="{DynamicResource BgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBar" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0">
                <DockPanel Margin="12,0,6,0" LastChildFill="False">
                    <TextBlock Text="RevoBIM" DockPanel.Dock="Left" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtTitle" DockPanel.Dock="Left" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                               Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Center"/>
                    <Button x:Name="BtnDrawer" DockPanel.Dock="Right" Style="{DynamicResource IconBtn}"
                            ToolTip="Shrink to the taskbar - drop the window down to just this bar so Revit can be seen">
                        <Grid Width="14" Height="14">
                            <Path x:Name="DrawerDown" Data="M2,2 L7,7 L12,2 M1,12 L13,12" StrokeThickness="1.7"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <Grid x:Name="DrawerUp" Visibility="Collapsed">
                            <Ellipse Fill="{DynamicResource GreenBrush}"/>
                            <Path Data="M3.5,8.5 L7,5 L10.5,8.5" StrokeThickness="2" Stroke="{DynamicResource OnAccentBrush}"/>
                            </Grid>
                        </Grid>
                        </Button>
                    <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Style="{DynamicResource Muted}" Margin="8,0,8,0"/>
                </DockPanel>
            </Border>
            <TextBlock x:Name="TxtMessage" Grid.Row="1" Margin="16,14,16,6" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextBrush}" LineHeight="18"/>
            <ListBox x:Name="LstChoices" Grid.Row="2" Margin="16,4,16,6" MaxHeight="380" Visibility="Collapsed"/>
            <TextBox x:Name="TxtInput" Grid.Row="3" Margin="16,4,16,8" Visibility="Collapsed"/>
            <Border Grid.Row="4" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6">
                <Grid>
                <Button x:Name="BtnCopy" Style="{DynamicResource BlueBtn}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"
                        Visibility="Collapsed" ToolTip="Copy the report to the clipboard">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,0 L11,0 L11,10 M0,3 L8,3 L8,13 L0,13 Z" StrokeThickness="1.4"
                              Stroke="{DynamicResource OnAccentBrush}" Width="12" Height="14" Margin="0,0,7,0"/>
                        <TextBlock x:Name="TxtCopy" Text="Copy"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="BtnCancel" Margin="0,0,8,0" MinWidth="80">
                        <TextBlock x:Name="TxtCancel" Text="Cancel"/>
                    </Button>
                    <Button x:Name="BtnAlt" Style="{DynamicResource OrangeBtn}" Margin="0,0,8,0" MinWidth="80" Visibility="Collapsed">
                        <TextBlock x:Name="TxtAlt" Text="No"/>
                    </Button>
                    <Button x:Name="BtnOk" Style="{DynamicResource GreenBtn}" MinWidth="90">
                        <TextBlock x:Name="TxtOk" Text="OK"/>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

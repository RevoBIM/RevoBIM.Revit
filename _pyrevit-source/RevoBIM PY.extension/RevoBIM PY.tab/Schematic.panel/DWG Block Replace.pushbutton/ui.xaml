<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - DWG Block Replace"
        Height="820" Width="440"
        MinHeight="600" MinWidth="410"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#1B1B1C"
        Foreground="#E6E6E6"
        FontFamily="Segoe UI"
        FontSize="12"
        PreviewKeyDown="on_key_down">

    <Window.Resources>

        <SolidColorBrush x:Key="BgDark"    Color="#1B1B1C"/>
        <SolidColorBrush x:Key="BgPanel"   Color="#232325"/>
        <SolidColorBrush x:Key="BgInput"   Color="#2D2D30"/>
        <SolidColorBrush x:Key="Line"      Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextMain"  Color="#E6E6E6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#9A9A9E"/>
        <SolidColorBrush x:Key="RevoBlue"  Color="#4FA3E3"/>
        <SolidColorBrush x:Key="RevoOrange" Color="#E8873C"/>

        <!-- ============================ Flat dark button -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3D"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E8873C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#454548"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#6A6A6E"/>
                                <Setter TargetName="Bd" Property="Background" Value="#262628"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Orange accent button -->
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Foreground" Value="#E8873C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ============================ Big red REPLACE button -->
        <Style x:Key="RedButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#B32828"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#D64545" BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D33333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#8F1F1F"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#4A2A2A"/>
                                <Setter Property="Foreground" Value="#9A8080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Dark text box -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="CaretBrush" Value="#E6E6E6"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ============================ Dark check box -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="14" Height="14" CornerRadius="2"
                                    Background="#2D2D30" BorderBrush="#5A5A60" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Stretch="Uniform" Margin="2"
                                      Data="M 0,4 L 3,7 L 9,0" Stroke="#E8873C" StrokeThickness="2"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#E8873C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#4FA3E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Dark radio button -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Margin" Value="0,3,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="14" Height="14" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Fill="#2D2D30" Stroke="#5A5A60" StrokeThickness="1"/>
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="#E8873C" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#E8873C"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#4FA3E3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================ Dark combo box -->
        <Style x:Key="ComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#37373B"/>
                                <Setter Property="Foreground" Value="#E8873C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F4A63"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="27"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid TextElement.Foreground="#E6E6E6">
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="#2D2D30" BorderBrush="#3F3F46"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Fill="#E8873C"
                                                  Data="M 0,0 L 9,0 L 4.5,5 Z"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4FA3E3"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="9,0,26,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup x:Name="Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#252527" BorderBrush="#3F3F46" BorderThickness="1"
                                        MaxHeight="260" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8873C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9A9E"/>
            <Setter Property="Margin" Value="0,7,0,3"/>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#3F3F46" BorderThickness="1" Background="{StaticResource BgDark}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ==================================================== HEADER -->
            <Border Grid.Row="0" Background="#232325" BorderBrush="#3F3F46" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="on_header_drag">
                <Grid Margin="12,10,8,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image x:Name="LogoImage" Grid.Column="0" Width="34" Height="34"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource RevoBlue}"/>
                        <TextBlock Text="DWG BLOCK REPLACE" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource RevoOrange}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="X" Width="26" Height="24" FontSize="11"
                            VerticalAlignment="Top" Style="{StaticResource DarkButton}"
                            Click="on_finish"/>
                </Grid>
            </Border>

            <!-- ==================================================== BODY -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel Margin="14,12,14,12">

                    <!-- ================================== step 1 : dwg block -->
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="3" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="STEP 1 : PICK THE DWG BLOCK" Style="{StaticResource SectionCaption}"/>

                            <Button x:Name="PickBlockButton" Content="Pick a DWG block in the view"
                                    Height="32" Style="{StaticResource OrangeButton}" Click="on_pick_block"/>

                            <Border Background="#1F1F21" BorderBrush="#3F3F46" BorderThickness="1"
                                    CornerRadius="2" Padding="8,6" Margin="0,8,0,0">
                                <TextBlock x:Name="BlockText" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMain}"
                                           Text="Nothing picked yet."/>
                            </Border>

                            <CheckBox x:Name="AllInViewChk" IsChecked="True"
                                      Content="Grab every instance of that block in this view"/>
                            <CheckBox x:Name="MatchSizeChk"
                                      Content="Also match block size (blocks sharing a name)"/>

                            <Button Content="Use my current Revit selection instead" Margin="0,10,0,0"
                                    Style="{StaticResource DarkButton}" Click="on_use_selection"/>
                        </StackPanel>
                    </Border>

                    <!-- ================================== step 2 : replacement -->
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="STEP 2 : PICK WHAT TO SWAP IT FOR" Style="{StaticResource SectionCaption}"/>

                            <Button x:Name="PickTargetButton" Content="Pick the replacement element in the view"
                                    Height="32" Style="{StaticResource OrangeButton}" Click="on_pick_replacement"/>

                            <Border Background="#1F1F21" BorderBrush="#3F3F46" BorderThickness="1"
                                    CornerRadius="2" Padding="8,6" Margin="0,8,0,0">
                                <TextBlock x:Name="TargetText" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMain}"
                                           Text="Nothing picked yet."/>
                            </Border>

                            <TextBlock Text="or choose it from the model" Margin="0,12,0,2"
                                       FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <Border Height="1" Background="#3F3F46" Margin="0,0,0,2"/>

                            <TextBlock Text="Category" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="CategoryCombo" SelectionChanged="on_category_changed"/>

                            <TextBlock Text="Search family" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SearchBox" TextChanged="on_search_changed"/>

                            <TextBlock Text="Family" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="FamilyCombo" SelectionChanged="on_family_changed"/>

                            <TextBlock Text="Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TypeCombo" SelectionChanged="on_type_changed"/>

                            <Button Content="Reload families from model" Margin="0,10,0,0"
                                    Style="{StaticResource DarkButton}" Click="on_reload_families"/>
                        </StackPanel>
                    </Border>

                    <!-- ================================== step 3 : placement -->
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="STEP 3 : PLACEMENT" Style="{StaticResource SectionCaption}"/>

                            <TextBlock Text="Insert new family at" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="PtCentreRadio" Content="Centre of block" IsChecked="True"/>
                                <RadioButton x:Name="PtOriginRadio" Content="Block insertion point"/>
                            </StackPanel>

                            <CheckBox x:Name="MatchRotChk" Content="Match DWG block rotation"
                                      IsChecked="True" Margin="0,10,0,0"/>
                            <CheckBox x:Name="DeleteChk" Content="Delete the DWG blocks after replacing"
                                      IsChecked="True"/>
                            <CheckBox x:Name="SelectNewChk" Content="Select the new elements when finished"
                                      IsChecked="False"/>
                        </StackPanel>
                    </Border>

                    <!-- ================================== replace -->
                    <Button x:Name="ReplaceButton" Content="REPLACE" Margin="0,14,0,0"
                            IsEnabled="False" Style="{StaticResource RedButton}" Click="on_replace"/>

                    <!-- ================================== step 4 : rotation -->
                    <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="STEP 4 : ROTATE PLACED ELEMENTS" Style="{StaticResource SectionCaption}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Rotate  90" Margin="0,0,4,0"
                                        Style="{StaticResource OrangeButton}" Click="on_rot_minus90"/>
                                <Button Grid.Column="1" Content="Rotate + 90" Margin="4,0,0,0"
                                        Style="{StaticResource OrangeButton}" Click="on_rot_plus90"/>
                            </Grid>

                            <TextBlock Text="Specified amount (degrees, anticlockwise)"
                                       Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="AngleBox" Grid.Column="0" Text="45" Margin="0,0,6,0"/>
                                <Button Grid.Column="1" Content="Apply" Width="72"
                                        Style="{StaticResource OrangeButton}" Click="on_rot_custom"/>
                            </Grid>

                            <CheckBox x:Name="LastBatchChk" IsChecked="True"
                                      Content="Last batch only (untick for all placed this session)"/>
                            <CheckBox x:Name="UseSelectionChk" IsChecked="False"
                                      Content="Rotate my current Revit selection instead"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="2,12,0,0" TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               Text="Pick the DWG block, then pick an element that is already the family you want. Revit stays live throughout. ESC cancels a pick; ESC with this window focused finishes the tool."/>

                </StackPanel>
            </ScrollViewer>

            <!-- ==================================================== FOOTER -->
            <Border Grid.Row="2" Background="#232325" BorderBrush="#3F3F46" BorderThickness="0,1,0,0">
                <Grid Margin="12,8,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{StaticResource RevoBlue}" Text="Ready."/>
                    <Button Grid.Column="1" Content="Finish (Esc)" Width="92" Margin="8,0,10,0"
                            Style="{StaticResource DarkButton}" Click="on_finish"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Schematic Builder Settings" Width="900" Height="660"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize">
  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource ShellBg}" BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="36"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
              <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"
                         VerticalAlignment="Bottom"/>
              <TextBlock Text="Schematic Builder Settings" FontSize="14" Margin="10,0,0,2"
                         Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Bottom"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0">
              <TextBlock x:Name="TxtVersion" Text="v0.0.0" Style="{DynamicResource Dim}"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="BtnShrink" Style="{DynamicResource BtnShrink}"
                      ToolTip="Shrink to the bottom of the screen (Ctrl+Shift+H)"/>
              <Button x:Name="BtnFull" Style="{DynamicResource BtnHeader}" ToolTip="Full screen (F11)">
                <Border Width="11" Height="11" BorderBrush="{DynamicResource DimBrush}" BorderThickness="1.5"/>
              </Button>
              <Button x:Name="BtnClose" Style="{DynamicResource BtnClose}" Content="&#10005;"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===================== tabs ===================== -->
        <Border Grid.Row="1" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
          <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Bottom">
            <Button x:Name="SetTabGeneral" Style="{DynamicResource Tab}" Content="General" Height="32"/>
            <Button x:Name="SetTabViews" Style="{DynamicResource Tab}" Content="View names" Height="32"/>
            <Button x:Name="SetTabRooms" Style="{DynamicResource Tab}" Content="Rooms" Height="32"/>
            <Button x:Name="SetTabStandards" Style="{DynamicResource Tab}" Content="Styles" Height="32"/>
            <Button x:Name="SetTabLevels" Style="{DynamicResource Tab}" Content="Levels" Height="32"/>
            <Button x:Name="SetTabSpacing" Style="{DynamicResource Tab}" Content="Spacing" Height="32"/>
            <Button x:Name="SetTabParams" Style="{DynamicResource Tab}" Content="Parameters" Height="32"/>
            <Button x:Name="SetTabLv" Style="{DynamicResource Tab}" Content="LV" Height="32"/>
          </StackPanel>
        </Border>

        <!-- ===================== pages ===================== -->
        <Grid Grid.Row="2" Margin="12,12,12,4">

          <!-- ============ General ============ -->
          <Grid x:Name="SetPageGeneral">
            <Border Style="{DynamicResource Card}" Padding="14,12" VerticalAlignment="Top">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Style="{DynamicResource TickBlue}"/>
                  <TextBlock Text="The drafting view" Style="{DynamicResource Heading}"/>
                </StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="View scale  1 :" VerticalAlignment="Center"/>
                  <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="TxtScale" Style="{DynamicResource Field}" Width="70"/>
                    <TextBlock Text="Sheet size" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <ComboBox x:Name="CmbSheet" Style="{DynamicResource Combo}" Width="90"/>
                    <TextBlock Text="Margin" VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <TextBox x:Name="TxtMargin" Style="{DynamicResource Field}" Width="60"/>
                    <TextBlock Text="mm" Style="{DynamicResource Dim}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="After Create" VerticalAlignment="Center"/>
                  <CheckBox x:Name="ChkOpenView" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Check}"
                            Content="Open the new drafting view and zoom to fit"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Show results" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbResults" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Combo}"
                            Width="300" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Theme" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbTheme" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Combo}"
                            Width="140" HorizontalAlignment="Left"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ============ View names ============ -->
          <Grid x:Name="SetPageViews" Visibility="Collapsed">
            <Border Style="{DynamicResource Card}" Padding="14,12" VerticalAlignment="Top">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Style="{DynamicResource TickBlue}"/>
                  <TextBlock Text="Drafting view names" Style="{DynamicResource Heading}"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource Dim}" Margin="12,0,0,10"
                           Text="A number is added and the first free one is used: 'SCH_M_Ventilation Schematic 1', then 2, then 3."/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Ventilation" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtNameVentilation" Grid.Row="0" Grid.Column="1" Style="{DynamicResource Field}" Margin="0,3"/>
                  <TextBlock Grid.Row="1" Text="LV" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtNameLv" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Field}" Margin="0,3"/>
                  <TextBlock Grid.Row="2" Text="Drainage" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtNameDrainage" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Field}" Margin="0,3"/>
                  <TextBlock Grid.Row="3" Text="Rainwater" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtNameRainwater" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Field}" Margin="0,3"/>
                  <TextBlock Grid.Row="4" Text="Water Services" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtNameWater" Grid.Row="4" Grid.Column="1" Style="{DynamicResource Field}" Margin="0,3"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ============ Rooms ============ -->
          <Grid x:Name="SetPageRooms" Visibility="Collapsed">
            <Border Style="{DynamicResource Card}" Padding="14,12" VerticalAlignment="Top">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Style="{DynamicResource TickBlue}"/>
                  <TextBlock Text="Where the room name comes from" Style="{DynamicResource Heading}"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource Dim}" Margin="12,0,0,10" TextWrapping="Wrap"
                           Text="Equipment whose room name reads the same shares one room box. Anything with no room name is drawn on its own, without a box."/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Read the room from" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbRoomSource" Grid.Row="0" Grid.Column="1" Style="{DynamicResource Combo}"
                            Width="330" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Room parameter" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbRoomParam" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Combo}"
                            IsEditable="True" Width="330" HorizontalAlignment="Left" Tag="e.g. Name"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Element parameter" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbRoomElementParam" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Combo}"
                            IsEditable="True" Width="330" HorizontalAlignment="Left"
                            Tag="parameter on the equipment holding the room name"/>
                  <TextBlock x:Name="TxtRoomHint" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Dim}"
                             Margin="0,6,0,0" TextWrapping="Wrap"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ============ Styles ============ -->
          <Grid x:Name="SetPageStandards" Visibility="Collapsed">
            <Border Style="{DynamicResource Card}" Padding="14,12" VerticalAlignment="Top">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Border Style="{DynamicResource TickBlue}"/>
                  <TextBlock Text="Line styles and text types" Style="{DynamicResource Heading}"/>
                </StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Level line style" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbLevelLine" Grid.Row="0" Grid.Column="1" Style="{DynamicResource Combo}" Margin="0,3,14,3"/>
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="Room line style" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbRoomLine" Grid.Row="0" Grid.Column="3" Style="{DynamicResource Combo}" Margin="0,3"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Level text type" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbLevelText" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Combo}" Margin="0,3,14,3"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="Room text type" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbRoomText" Grid.Row="1" Grid.Column="3" Style="{DynamicResource Combo}" Margin="0,3"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Level label reads" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbLevelLabel" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Combo}"
                            IsEditable="True" Margin="0,3,14,3" Tag="{}{name}  or  {abbr} - {name}"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ============ Levels ============ -->
          <Grid x:Name="SetPageLevels" Visibility="Collapsed">
            <Border Style="{DynamicResource Card}" Padding="14,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="22"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{DynamicResource TickBlue}"/>
                    <TextBlock Text="Levels" Style="{DynamicResource Heading}"/>
                    <TextBlock Text="an unticked level is left off the schematic, and so is the equipment on it"
                               Style="{DynamicResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnLevelsAll" Style="{DynamicResource Btn}" Content="All" Height="22" Margin="0,0,6,0"/>
                    <Button x:Name="BtnLevelsNone" Style="{DynamicResource Btn}" Content="None" Height="22" Margin="0,0,6,0"/>
                    <Button x:Name="BtnLevelsAuto" Style="{DynamicResource Btn}" Content="Auto abbreviate" Height="22"/>
                  </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1,1,1,0">
                  <Grid Margin="6,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="130"/>
                      <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="LEVEL" Style="{DynamicResource Dim}" FontSize="10"/>
                    <TextBlock Grid.Column="2" Text="ELEVATION" Style="{DynamicResource Dim}" FontSize="10"/>
                    <TextBlock Grid.Column="3" Text="ABBREVIATION" Style="{DynamicResource Dim}" FontSize="10"/>
                  </Grid>
                </Border>
                <ListBox x:Name="LstLevels" Grid.Row="2" Style="{DynamicResource List}"/>
              </Grid>
            </Border>
          </Grid>

          <!-- ============ Spacing ============ -->
          <Grid x:Name="SetPageSpacing" Visibility="Collapsed">
            <Border Style="{DynamicResource Card}" Padding="14,12" VerticalAlignment="Top">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Style="{DynamicResource TickBlue}"/>
                  <TextBlock Text="Spacing" Style="{DynamicResource Heading}"/>
                  <TextBlock Text="paper millimetres - multiplied by the view scale when it is drawn"
                             Style="{DynamicResource Dim}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource Dim}" Margin="12,0,0,12" TextWrapping="Wrap"
                           Text="Rooms grow to fit their equipment, levels grow to fit their rooms. These are the clearances that sizing works from."/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Room line offset around the equipment" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtRoomOffset" Grid.Row="0" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="1" Text="Room name in from the left edge" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtRoomTextDx" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="2" Text="Room name down from the top edge" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtRoomTextDy" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="3" Text="Gap between equipment in a room" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtItemGap" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="4" Text="Gap between rooms" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtRoomGap" Grid.Row="4" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="5" Text="Clear above the level line" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLevelClear" Grid.Row="5" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="6" Text="Gap under a label" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtTextGap" Grid.Row="6" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ============ LV ============ -->
          <Grid x:Name="SetPageLv" Visibility="Collapsed">
            <Border Style="{DynamicResource Card}" Padding="14,12" VerticalAlignment="Top">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <Border Style="{DynamicResource TickBlue}"/>
                  <TextBlock Text="LV schematic" Style="{DynamicResource Heading}"/>
                </StackPanel>
                <TextBlock Style="{DynamicResource Dim}" Margin="12,0,0,12" TextWrapping="Wrap"
                           Text="Feeders leave the top of the supplying panel in their own lanes, run across under the fed panel's level, and rise into its bottom. Panels are moved clear of feeders rising through their level and the drawing grows wider rather than wrapping."/>
                <CheckBox x:Name="ChkLvPanelsOnly" Style="{DynamicResource Check}" Margin="0,0,0,12"
                          Content="Only place equipment that has a panel schedule (also on the LV tab)"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="34"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Text="Circuit line style" VerticalAlignment="Center"/>
                  <ComboBox x:Name="CmbCircuitLine" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                            Style="{DynamicResource Combo}" Width="300" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="1" Text="Gap between feeders leaving a panel" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLvGap" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="mm - 18 by default" Style="{DynamicResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="2" Text="Panels above their level line" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLvLevelClear" Grid.Row="2" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="mm - room for the jogs; grows when they need more" Style="{DynamicResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <TextBlock Grid.Row="3" Text="First jog above the level line" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLvJog" Grid.Row="3" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="4" Text="Between staggered jogs" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLvJogStep" Grid.Row="4" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="5" Text="Panel clearance from a rising feeder" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLvLaneClear" Grid.Row="5" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="6" Text="Between rows of boards on one floor" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLvRowGap" Grid.Row="6" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <TextBlock Grid.Row="7" Text="Stretch past the last circuit, each end" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtLvStretchOver" Grid.Row="7" Grid.Column="1" Style="{DynamicResource Field}" Width="70" HorizontalAlignment="Left" Margin="0,3"/>
                  <CheckBox x:Name="ChkLvStretchMain" Grid.Row="8" Grid.ColumnSpan="3" Style="{DynamicResource Check}"
                            Content="Stretch the Main LV symbol across its outgoing ways (line based detail items only)"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <!-- ============ Parameters ============ -->
          <Grid x:Name="SetPageParams" Visibility="Collapsed">
            <Border Style="{DynamicResource Card}" Padding="14,12">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Border Style="{DynamicResource TickGreen}"/>
                    <TextBlock Text="Linked element ID parameter" Style="{DynamicResource Heading}"
                               VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtLinkParam" Style="{DynamicResource Field}" Width="300" Margin="12,0,0,0"
                             Tag="text instance parameter on the detail items"/>
                  </StackPanel>
                  <TextBlock Style="{DynamicResource Dim}" Margin="12,0,0,14" TextWrapping="Wrap"
                             Text="Every detail item placed by Create gets its model element's id written into this parameter. The Married Element List tab finds the pairs again through it, and so will later tools."/>
                  <StackPanel Orientation="Horizontal">
                    <Border Style="{DynamicResource TickOrange}"/>
                    <TextBlock Text="The shared parameter transfer list" Style="{DynamicResource Heading}"/>
                    <TextBlock Text="model element  =>  detail item, one per line" Style="{DynamicResource Dim}"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock Style="{DynamicResource Dim}" Margin="12,6,0,0" TextWrapping="Wrap"
                             Text="The source is a parameter on the model element (instance, then type), or one of {level} {level_abbr} {room} {mark} {type_mark} {equipment} {family} {type}. The target must be an instance parameter on the detail item. Any equipment row can override this list, or skip it, from the Equipment table."/>
                </StackPanel>
                <TextBox x:Name="TxtTransfer" Grid.Row="1" Style="{DynamicResource FieldMulti}" FontFamily="Consolas"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ===================== footer ===================== -->
        <Border Grid.Row="3" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
          <Grid Margin="14,0">
            <TextBlock x:Name="TxtSettingsPath" Style="{DynamicResource Dim}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,260,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="BtnCancel" Style="{DynamicResource Btn}" Content="Cancel" Width="90" Margin="0,0,8,0"/>
              <Button x:Name="BtnApply" Style="{DynamicResource BtnGreen}" Content="Apply" Width="120" Height="28"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid>
      <Thumb x:Name="GripN" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripS" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripW" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripE" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripNW" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
      <Thumb x:Name="GripNE" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
      <Thumb x:Name="GripSW" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
      <Thumb x:Name="GripSE" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

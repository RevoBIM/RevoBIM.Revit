<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Pick" Width="820" Height="600" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize">
  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource ShellBg}" BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
              <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"
                         VerticalAlignment="Bottom"/>
              <TextBlock x:Name="TxtTitle" Text="Pick" FontSize="14" Margin="10,0,0,2"
                         Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Bottom"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0">
              <TextBlock x:Name="TxtVersion" Text="v0.0.0" Style="{DynamicResource Dim}"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="BtnShrink" Style="{DynamicResource BtnShrink}"
                      ToolTip="Shrink to the bottom of the screen (Ctrl+Shift+H)"/>
              <Button x:Name="BtnFull" Style="{DynamicResource BtnHeader}" ToolTip="Full screen (F11)">
                <Border Width="11" Height="11" BorderBrush="{DynamicResource DimBrush}" BorderThickness="1.5"/>
              </Button>
              <Button x:Name="BtnClose" Style="{DynamicResource BtnClose}" Content="&#10005;"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="12,10" Margin="12,12,12,4">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="22"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
              <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox x:Name="CmbCategory" Style="{DynamicResource Combo}" Width="220"/>
              <TextBox x:Name="TxtSearch" Style="{DynamicResource Field}" Width="260" Margin="14,0,0,0"
                       Tag="keyword search - family or type"/>
              <CheckBox x:Name="ChkUsed" Style="{DynamicResource Check}" Content="Used in the model only"
                        Margin="14,0,0,0"/>
              <CheckBox x:Name="ChkTypes" Style="{DynamicResource Check}" Content="Split by type" Margin="14,0,0,0"/>
              <Button x:Name="BtnAll" Style="{DynamicResource Btn}" Content="Tick all shown" Height="22"
                      Margin="14,0,6,0"/>
              <Button x:Name="BtnNone" Style="{DynamicResource Btn}" Content="None" Height="22"/>
            </StackPanel>
            <Border Grid.Row="1" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1,1,1,0">
              <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="200"/>
                  <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="CATEGORY" Style="{DynamicResource Dim}" FontSize="10"/>
                <TextBlock Grid.Column="2" Text="FAMILY" Style="{DynamicResource Dim}" FontSize="10"/>
                <TextBlock Grid.Column="3" Text="TYPE" Style="{DynamicResource Dim}" FontSize="10"/>
                <TextBlock Grid.Column="4" Text="QTY" Style="{DynamicResource Dim}" FontSize="10" HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <ListBox x:Name="LstRows" Grid.Row="2" Style="{DynamicResource List}"/>
            <TextBlock x:Name="TxtInfo" Grid.Row="3" Style="{DynamicResource Dim}" Margin="0,6,0,0"/>
          </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
          <Grid Margin="14,0">
            <TextBlock x:Name="TxtHint" Text="double-click a row to pick it" Style="{DynamicResource Dim}"
                       VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="BtnClear" Style="{DynamicResource Btn}" Content="Clear" Width="80" Margin="0,0,8,0"/>
              <Button x:Name="BtnCancel" Style="{DynamicResource Btn}" Content="Cancel" Width="90" Margin="0,0,8,0"/>
              <Button x:Name="BtnOk" Style="{DynamicResource BtnGreen}" Content="Pick" Width="120" Height="28"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Grid>
      <Thumb x:Name="GripN" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripS" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripW" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripE" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripNW" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
      <Thumb x:Name="GripNE" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
      <Thumb x:Name="GripSW" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
      <Thumb x:Name="GripSE" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

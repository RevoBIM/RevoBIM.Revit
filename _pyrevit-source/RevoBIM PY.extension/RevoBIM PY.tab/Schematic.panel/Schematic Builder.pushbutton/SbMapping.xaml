<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM PY - Parameters" Width="1180" Height="680" MinWidth="960" MinHeight="480"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize">
  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource ShellBg}" BorderBrush="{DynamicResource EdgeBrush}"
            BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="6,6,0,0">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
              <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"
                         VerticalAlignment="Bottom"/>
              <TextBlock x:Name="TxtTitle" Text="Parameters" FontSize="14" Margin="10,0,0,2"
                         Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Bottom"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0">
              <TextBlock x:Name="TxtVersion" Text="v0.0.0" Style="{DynamicResource Dim}"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="BtnShrink" Style="{DynamicResource BtnShrink}"
                      ToolTip="Shrink to the bottom of the screen (Ctrl+Shift+H)"/>
              <Button x:Name="BtnFull" Style="{DynamicResource BtnHeader}" ToolTip="Full screen (F11)">
                <Border Width="11" Height="11" BorderBrush="{DynamicResource DimBrush}" BorderThickness="1.5"/>
              </Button>
              <Button x:Name="BtnClose" Style="{DynamicResource BtnClose}" Content="&#10005;"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="12,10" Margin="12,12,12,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border Style="{DynamicResource TickBlue}"/>
              <TextBlock Text="For this equipment, write" Style="{DynamicResource Heading}"
                         VerticalAlignment="Center"/>
              <ComboBox x:Name="CmbMode" Style="{DynamicResource Combo}" Width="330" Margin="10,0,0,0"/>
              <TextBlock x:Name="TxtEquipment" Style="{DynamicResource Dim}" Margin="14,0,0,0"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="TxtSources" Style="{DynamicResource Dim}" Margin="12,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Grid Grid.Row="2" Margin="12,10,12,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="12,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Border Style="{DynamicResource TickGreen}"/>
                <TextBlock Text="Templates" Style="{DynamicResource Heading}"/>
              </StackPanel>
              <ListBox x:Name="LstTemplates" Grid.Row="1" Style="{DynamicResource List}"/>
              <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBox x:Name="TxtTemplateName" Style="{DynamicResource Field}" Margin="0,0,0,6"
                         Tag="template name"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="BtnNew" Style="{DynamicResource Btn}" Content="New" Width="52" Height="24" Margin="0,0,4,0"/>
                  <Button x:Name="BtnSave" Style="{DynamicResource BtnGreen}" Content="Save" Width="60" Height="24" Margin="0,0,4,0"/>
                  <Button x:Name="BtnSaveAs" Style="{DynamicResource Btn}" Content="Save as" Width="70" Height="24" Margin="0,0,4,0"/>
                  <Button x:Name="BtnDelete" Style="{DynamicResource Btn}" Content="Delete" Width="62" Height="24"/>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{DynamicResource Card}" Padding="12,10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                  <Border Style="{DynamicResource TickOrange}"/>
                  <TextBlock Text="Read from the model element, write onto the detail item"
                             Style="{DynamicResource Heading}"/>
                </StackPanel>
                <Button x:Name="BtnAddRow" Style="{DynamicResource BtnGreen}" Content="+ Add row" Height="24"
                        HorizontalAlignment="Right" Width="110"/>
              </Grid>
              <Border Grid.Row="1" Background="{DynamicResource BarBg}" BorderBrush="{DynamicResource LineBrush}"
                      BorderThickness="1,1,1,0">
                <Grid Margin="6,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="32"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="CATEGORY" Style="{DynamicResource Dim}" FontSize="10"/>
                  <TextBlock Grid.Column="1" Text="FROM - PARAMETER ON THE MODEL ELEMENT"
                             Style="{DynamicResource Dim}" FontSize="10"/>
                  <TextBlock Grid.Column="3" Text="TO - INSTANCE PARAMETER ON THE DETAIL ITEM"
                             Style="{DynamicResource Dim}" FontSize="10"/>
                </Grid>
              </Border>
              <ListBox x:Name="LstRows" Grid.Row="2" Style="{DynamicResource List}"/>
              <TextBlock x:Name="TxtInfo" Grid.Row="3" Style="{DynamicResource Dim}" Margin="0,6,0,0"
                         TextWrapping="Wrap"/>
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6">
          <Grid Margin="14,0">
            <TextBlock x:Name="TxtStatus" Style="{DynamicResource Dim}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,240,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="BtnCancel" Style="{DynamicResource Btn}" Content="Cancel" Width="90" Margin="0,0,8,0"/>
              <Button x:Name="BtnOk" Style="{DynamicResource BtnGreen}" Content="OK" Width="120" Height="28"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
    <Grid>
      <Thumb x:Name="GripN" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripS" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripW" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Left" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripE" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripNW" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
      <Thumb x:Name="GripNE" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
      <Thumb x:Name="GripSW" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
      <Thumb x:Name="GripSE" Style="{DynamicResource Grip}" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

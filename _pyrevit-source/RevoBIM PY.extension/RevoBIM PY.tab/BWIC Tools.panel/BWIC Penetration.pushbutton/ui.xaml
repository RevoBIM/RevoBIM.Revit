            </TabControl>

            <!-- actions, pinned below the tabs so they are always reachable,
                 with the step card under them while a placement runs -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <Grid>
                <StackPanel x:Name="wall_actions">
                    <Button x:Name="place_btn" Style="{StaticResource FlatButton}"
                    Content="Place BWIC" Click="place_click"
                    ToolTip="Select the services you want a BWIC around, click Place BWIC below, then press Return to finish the selection and click the wall you are intersecting with. Press escape to complete"/>
                    <Button x:Name="resize_btn" Style="{StaticResource OrangeButton}"
                    Content="Resize existing BWIC from selection"
                    Click="resize_click" Margin="0,8,0,0" ToolTip="Pick an existing BWIC, then the services passing through it, then the wall. It is resized and repositioned in X, Y and Z to the same rules. Press escape to complete"/>
                </StackPanel>
                <StackPanel x:Name="global_actions" Visibility="Collapsed">
                    <Button x:Name="g_run_btn" Style="{StaticResource FlatButton}"
                    Content="Run Global Placement" Click="global_run_click"
                    ToolTip="Sweep the active view and place a BWIC around every group of pipes and cable trays passing through a fire rated or blockwork wall"/>
                </StackPanel>
                <StackPanel x:Name="slab_actions" Visibility="Collapsed">
                    <Button x:Name="slab_place_btn" Style="{StaticResource FlatButton}"
                    Content="Place Slab Penetration" Click="slab_place_click"
                    ToolTip="Select the services passing through the floor, press Return to finish the selection, then click the floor. Press escape to complete"/>
                    <Button x:Name="slab_resize_btn" Style="{StaticResource OrangeButton}"
                    Content="Resize existing BWIC from selection"
                    Click="slab_resize_click" Margin="0,8,0,0"
                    ToolTip="Pick an existing slab opening, then the services passing through it, then the floor. It is resized, turned and re-centred to the same rules as a new placement. Press escape to complete"/>
                </StackPanel>
            </Grid>

            <!-- the step card: what to pick next, then BWIC placed. While the
                 window is parked on the taskbar it floats over Revit instead -->
            <Border x:Name="pr_bd" Visibility="Collapsed" Margin="0,10,0,0"
                    Background="{StaticResource BgField}"
                    BorderBrush="{StaticResource Blue}" BorderThickness="1.5"
                    CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="pr_accent_bd" Grid.Column="0" CornerRadius="3,0,0,3"
                            Background="{StaticResource Blue}"/>
                    <StackPanel Grid.Column="1" Margin="11,8,12,9">
                        <Grid>
                            <TextBlock x:Name="pr_eyebrow_tb" Text="STEP 1 OF 2"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource Blue}"/>
                            <TextBlock x:Name="pr_dots_tb" Text="" FontSize="9.5"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource TextDim}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="pr_icon_tb" Text="" FontSize="15"
                                       FontWeight="Bold" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Green}"/>
                            <TextBlock x:Name="pr_title_tb" Text="" FontSize="14"
                                       FontWeight="SemiBold" TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextMain}"/>
                        </StackPanel>
                        <TextBlock x:Name="pr_detail_tb" TextWrapping="Wrap" FontSize="11.5"
                                   Margin="0,3,0,0" Foreground="{StaticResource TextDim}"
                                   Text=""/>
                        <Border x:Name="pr_hint_bd" Background="{StaticResource BgShell}"
                                CornerRadius="3" Padding="7,3" Margin="0,7,0,0"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="pr_hint_tb" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMain}" Text=""/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- finishes the selection as Return or the Options Bar's Finish
                 would; lights up only while a step is waiting on it -->
            <Button x:Name="finish_btn" Style="{StaticResource FinishButton}"
                    Margin="0,10,0,0" IsEnabled="False" Click="finish_click"
                    ToolTip="Finish the selection - the same as Finish on the Options Bar or Return. Lights up when the step is waiting on it.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x2713;" FontWeight="Bold" Margin="0,0,7,0"/>
                    <TextBlock Text="Finish Selection"/>
                </StackPanel>
            </Button>
            </StackPanel>



        </Grid>

        <!-- A borderless AllowsTransparency window has nothing hit testable
             in its frame, so WPF cannot resize it however ResizeMode is set.
             These eight thumbs are the frame. The overlay has no Background,
             so everything underneath stays clickable. -->
        <Grid x:Name="grips_grid">
            <Thumb Height="5" VerticalAlignment="Top"
                   Margin="6,0" Cursor="SizeNS"
                   Style="{StaticResource GripStyle}" DragDelta="grip_n_drag"/>
            <Thumb Height="5" VerticalAlignment="Bottom"
                   Margin="6,0" Cursor="SizeNS"
                   Style="{StaticResource GripStyle}" DragDelta="grip_s_drag"/>
            <Thumb Width="5" HorizontalAlignment="Left"
                   Margin="0,6" Cursor="SizeWE"
                   Style="{StaticResource GripStyle}" DragDelta="grip_w_drag"/>
            <Thumb Width="5" HorizontalAlignment="Right"
                   Margin="0,6" Cursor="SizeWE"
                   Style="{StaticResource GripStyle}" DragDelta="grip_e_drag"/>
            <Thumb Width="8" Height="8"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Cursor="SizeNWSE" Style="{StaticResource GripStyle}"
                   DragDelta="grip_nw_drag"/>
            <Thumb Width="8" Height="8"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Cursor="SizeNESW" Style="{StaticResource GripStyle}"
                   DragDelta="grip_ne_drag"/>
            <Thumb Width="8" Height="8"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Cursor="SizeNESW" Style="{StaticResource GripStyle}"
                   DragDelta="grip_sw_drag"/>
            <Thumb Width="8" Height="8"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE" Style="{StaticResource GripStyle}"
                   DragDelta="grip_se_drag"/>
        </Grid>
        </Grid>
    </Border>
</Window>

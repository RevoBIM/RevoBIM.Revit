<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM BWIC Penetration"
        Width="430"
        SizeToContent="Height"
        MinHeight="380" MinWidth="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="Transparent"
        Foreground="#FFEEF1F5"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Revit dark theme palette, sampled from Revit 2024's own
             Project Browser: blue-grey, not neutral grey -->
        <SolidColorBrush x:Key="BgShell"  Color="#FF3C4454"/>
        <SolidColorBrush x:Key="BgPanel"  Color="#FF323C48"/>
        <SolidColorBrush x:Key="BgField"  Color="#FF2D3441"/>
        <SolidColorBrush x:Key="BgCanvas" Color="#FF2D3441"/>
        <SolidColorBrush x:Key="Line"     Color="#FF505968"/>
        <SolidColorBrush x:Key="LineSoft" Color="#FF404353"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFEEF1F5"/>
        <SolidColorBrush x:Key="TextDim"  Color="#FF9DA4B2"/>
        <SolidColorBrush x:Key="Blue"     Color="#FF4A9EDB"/>
        <SolidColorBrush x:Key="Orange"   Color="#FFE8862A"/>
        <SolidColorBrush x:Key="Green"    Color="#FF3FA75A"/>
        <SolidColorBrush x:Key="Red"      Color="#FFC0392B"/>
        <SolidColorBrush x:Key="RedHover" Color="#FFD9483A"/>
        <SolidColorBrush x:Key="RedDown"  Color="#FF992D22"/>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgField}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Blue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Red}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource RedHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource RedDown}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background"
                                        Value="#FF465062"/>
                                <Setter Property="Foreground" Value="#FF7B8290"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="{StaticResource Orange}"/>
        </Style>

        <!-- Finish Selection: dim until the run is waiting on a selection,
             then green with a glow (Tag = ready) -->
        <Style x:Key="FinishButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Green}"
                                CornerRadius="2" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="10,8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="ready">
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FF3FA75A" BlurRadius="14"
                                                          ShadowDepth="0" Opacity="0.9"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF4CBF68"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2F8546"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF465062"/>
                                <Setter Property="Foreground" Value="#FF7B8290"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Background" Value="#FF4A5366"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- window chrome close button -->
        <Style x:Key="ChromeClose" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Red}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- shrink to the taskbar: the glyph is a template, swapped to a
             green up arrow by Tag="shrunk" -->
        <Style x:Key="ChromeShrink" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Tag" Value=""/>
            <Setter Property="ToolTip" Value="Shrink to the taskbar  (Ctrl+Shift+H)"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="&#x2913;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Line}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMain}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Tag" Value="shrunk">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <TextBlock Text="&#x2912;" FontWeight="Bold"
                                           Foreground="{StaticResource Green}"/>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="tbd"
                                                Background="{StaticResource BgField}"
                                                BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Data="M 0 0 L 9 0 L 4.5 5 Z"
                                                  Fill="{StaticResource TextDim}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="tbd" Property="BorderBrush"
                                                        Value="{StaticResource Blue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,0,26,0" VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{StaticResource BgPanel}"
                                        BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DimCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <!-- tabs -->
        <!-- tab icons: line drawings in the tab's own text colour, so they
             brighten with the label when the tab is selected or hovered -->
        <Style x:Key="TabIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="None"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}"/>
        </Style>

        <!-- a collapsible group: click the header to fold it away. The tick
             is blue for the main groups; set Tag to another brush for others -->
        <Style x:Key="Group" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Tag" Value="{StaticResource Blue}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{StaticResource BgPanel}"
                                BorderBrush="{StaticResource LineSoft}"
                                BorderThickness="1" CornerRadius="3">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top" Focusable="False"
                                              Cursor="Hand" FontSize="13"
                                              FontWeight="SemiBold"
                                              Foreground="{StaticResource TextMain}"
                                              Content="{TemplateBinding Header}"
                                              Tag="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="hb" Background="Transparent"
                                                    CornerRadius="3" Padding="10,7">
                                                <DockPanel>
                                                    <Path x:Name="chev" DockPanel.Dock="Right"
                                                          Data="M0,0 L4.5,4.5 L9,0"
                                                          Stroke="{StaticResource TextDim}"
                                                          StrokeThickness="1.6"
                                                          Width="9" Height="5"
                                                          VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0"/>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                    <Border Width="4" Height="14" CornerRadius="1"
                                                            Margin="0,0,9,0"
                                                            VerticalAlignment="Center"
                                                            Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="False">
                                                    <Setter TargetName="chev" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="-90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="hb" Property="Background"
                                                            Value="{StaticResource BgField}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="body" Margin="11,0,11,11"
                                                  Visibility="Collapsed"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="body" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- sub tabs: a segmented strip inside a tab, for the family shape -->
        <Style x:Key="SubTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource BgField}"
                                    BorderBrush="{StaticResource LineSoft}" BorderThickness="1"
                                    CornerRadius="4" Padding="3" HorizontalAlignment="Stretch">
                                <UniformGrid Rows="1" IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent"
                                              Margin="0,10,0,0"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="seg" Background="Transparent" CornerRadius="3"
                                Padding="8,5" Margin="1,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="seg" Property="Background"
                                        Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tab" Background="{StaticResource BgField}"
                                BorderBrush="{StaticResource Line}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="2,2,0,0" Margin="0,0,3,0"
                                Padding="12,7">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tab" Property="Background"
                                        Value="{StaticResource BgPanel}"/>
                                <Setter TargetName="tab" Property="BorderBrush"
                                        Value="{StaticResource Blue}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMain}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Foreground"
                                        Value="{StaticResource TextMain}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True"
                                      Panel.ZIndex="1"/>
                            <Border Grid.Row="1"
                                    Background="{StaticResource BgPanel}"
                                    BorderBrush="{StaticResource Line}"
                                    BorderThickness="1" CornerRadius="0,2,2,2">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- small header glyph button, e.g. the settings gear -->
        <Style x:Key="ChromeGlyph" TargetType="Button" BasedOn="{StaticResource ChromeClose}">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <Style x:Key="GripStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgShell}"
            BorderBrush="#FF212932" BorderThickness="1"
            CornerRadius="6">
        <Grid>
        <Grid Margin="16,12,16,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="110"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- heading, doubles as the drag bar -->
            <StackPanel x:Name="header_pnl" Grid.Row="0" Background="Transparent"
                        MouseLeftButtonDown="drag_window">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="logo_img" Width="38" Height="38"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               SnapsToDevicePixels="True"/>
                        <TextBlock TextWrapping="NoWrap" VerticalAlignment="Center">
                            <Run Text="RevoBIM" FontSize="23" FontWeight="Bold"
                                 Foreground="{StaticResource Blue}"/>
                            <Run Text=" BWIC Penetration" FontSize="16"
                                 Foreground="{StaticResource TextMain}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-4,-6,0">
                        <TextBlock x:Name="version_tb" Text="v0.0.0" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{StaticResource TextDim}"/>
                        <Button x:Name="settings_btn" Style="{StaticResource ChromeGlyph}"
                                Content="&#x2699;" Click="settings_click"
                                ToolTip="Settings"/>
                        <Button x:Name="shrink_btn" Style="{StaticResource ChromeShrink}"
                                Click="shrink_click"/>
                        <Button Style="{StaticResource ChromeClose}" Content="&#x2715;"
                                Click="close_click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="{StaticResource Orange}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- tabs: the bodies scroll, so they can never push anything off -->
            <TabControl x:Name="tabs" Grid.Row="1" Margin="0,14,0,0"
                        Style="{StaticResource DarkTabControl}"
                        ItemContainerStyle="{StaticResource DarkTabItem}">

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TabIcon}"
                                  Data="M1.5,3 H14.5 V13 H1.5 Z M1.5,6.3 H14.5 M1.5,9.7 H14.5 M6,3 V6.3 M10.5,6.3 V9.7 M5,9.7 V13 M11,9.7 V13"/>
                            <TextBlock Text="Wall" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,4,0">
                    <StackPanel Margin="10,10,10,8">
                        <TabControl x:Name="wall_shape_tabs" Style="{StaticResource SubTabControl}"
                                    ItemContainerStyle="{StaticResource SubTabItem}"
                                    SelectionChanged="wall_shape_changed">
                            <TabItem>
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource TabIcon}" Margin="0,0,6,0"
                                              Data="M2.5,4 H13.5 V12 H2.5 Z"/>
                                        <TextBlock Text="Rectangular" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </TabItem.Header>
                                <StackPanel>
                                    <Expander x:Name="grp_wr_family" Style="{StaticResource Group}" Header="Family">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <!-- the selected family's own preview image -->
                                                <Border Grid.Row="0" Grid.Column="0" Width="62" Height="62"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Background="#FFEEF1F5" BorderBrush="{StaticResource LineSoft}"
                                                        BorderThickness="1" CornerRadius="3">
                                                    <Grid>
                                                        <TextBlock x:Name="wr_noprev_tb" Text="No preview" FontSize="9.5"
                                                                   Foreground="#FF7B8290" TextAlignment="Center"
                                                                   TextWrapping="Wrap" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                        <Image x:Name="wr_preview_img" Stretch="Uniform" Margin="3"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                    <ComboBox x:Name="wr_family_cb" Style="{StaticResource DarkCombo}"
                                                              ToolTip="Generic model families loaded in this project"/>
                                                    <ComboBox x:Name="wr_type_cb" Style="{StaticResource DarkCombo}"
                                                              Margin="0,4,0,0" ToolTip="Default type. Blockwork and fire rated walls take the types named in Settings"/>
                                                </StackPanel>
                                                <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="wr_famsum_tb" Grid.Column="0" FontSize="10.5"
                                                               Foreground="{StaticResource TextDim}" TextWrapping="Wrap"

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Dimension views"
        Width="720" Height="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="6">
    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource EdgeStrongBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================ header ================ -->
        <Border x:Name="DvHeader" Grid.Row="0" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock x:Name="DvTitleTxt" Text="Dimension views" FontSize="13" Foreground="{DynamicResource OrangeBrush}" Margin="0,-2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="DvVerTxt" Text="v1.0.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="DvShrinkBtn" Style="{DynamicResource WinBtn}" ToolTip="Shrink to the taskbar - see Revit (Ctrl+Shift+H)">
                <Grid Width="12" Height="12">
                  <Path x:Name="DvShrinkIcon" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,3 L6,7 L10,3 M1,11 L11,11"/>
                  <Path x:Name="DvExpandIcon" Visibility="Collapsed" Stroke="{DynamicResource GreenBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,1.5 L11,1.5 M6,11 L6,4.5 M2.5,8 L6,4.5 L9.5,8"/>
                </Grid>
              </Button>
              <Button x:Name="DvCloseBtn" Style="{DynamicResource CloseBtn}" Content="&#x2715;" ToolTip="Close"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================ tabs ================ -->
        <Border x:Name="DvTabsBar" Grid.Row="1" Background="{DynamicResource BarBrush}" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,1" Padding="10,0,10,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="TabDvViews" Style="{DynamicResource TabActive}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource BlueBrush}" StrokeThickness="2" StrokeLineJoin="Round" Data="M2,4 L22,4 L22,20 L2,20 Z M2,12 L22,12 M12,4 L12,20"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Name="TabDvViewsTxt" Text="Views" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="TabDvSheets" Style="{DynamicResource Tab}">
                <StackPanel Orientation="Horizontal">
                  <Viewbox Width="16" Height="16" Margin="0,0,7,0">
                    <Canvas Width="24" Height="24">
                      <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="2" StrokeLineJoin="Round" Data="M3,2 L21,2 L21,22 L3,22 Z M6,17 L18,17 M14,17 L14,22"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock x:Name="TabDvSheetsTxt" Text="Sheets" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <TextBlock x:Name="DvIntroTxt" Grid.Column="1" Text="Floor plans and sections the run dimensions go in - tick as many as you like" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
          </Grid>
        </Border>

        <!-- ================ sheets ================ -->
        <Grid x:Name="SheetsPanel" Grid.Row="2" Visibility="Collapsed" Margin="14,10,14,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtSheetsSearch" Grid.Column="0" Tag="Search sheets - number or name" ToolTip="Every word must match, in any order"/>
          </Grid>
          <ListBox x:Name="LstSheets" Grid.Row="1" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="Click, Shift+click or Ctrl+click to highlight rows; ticking a highlighted row ticks them all"/>
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnSheetsTickShown" Grid.Column="0" Style="{DynamicResource Chip}" Padding="10,4" Margin="0,0,6,0" Content="Tick shown"/>
            <Button x:Name="BtnSheetsUntickShown" Grid.Column="1" Style="{DynamicResource Chip}" Padding="10,4" Content="Untick shown"/>
            <TextBlock x:Name="SheetsCountTxt" Grid.Column="2" Text="" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Grid>

        <!-- ================ views ================ -->
        <Grid x:Name="ViewsPanel" Grid.Row="2" Margin="14,10,14,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtViewsSearch" Grid.Column="0" Tag="Search views - name, type or scale" ToolTip="Every word must match, in any order"/>
            <ComboBox x:Name="CmbViewsKind" Grid.Column="1" Width="190" Margin="8,0,0,0" ToolTip="Which kind of view to list"/>
          </Grid>
          <ListBox x:Name="LstViews" Grid.Row="1" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ToolTip="Click, Shift+click or Ctrl+click to highlight rows; ticking a highlighted row ticks them all"/>
          <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnViewsTickShown" Grid.Column="0" Style="{DynamicResource Chip}" Padding="10,4" Margin="0,0,6,0" Content="Tick shown"/>
            <Button x:Name="BtnViewsUntickShown" Grid.Column="1" Style="{DynamicResource Chip}" Padding="10,4" Content="Untick shown"/>
            <TextBlock x:Name="ViewsCountTxt" Grid.Column="2" Text="" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
        </Grid>

        <!-- ================ footer ================ -->
        <Border x:Name="DvFooter" Grid.Row="3" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DvStatusTxt" Grid.Column="0" Text="Nothing ticked" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="DvSkip" Content="Skip dimensions" Margin="0,0,8,0" ToolTip="Place the hangers without dimensions"/>
              <Button x:Name="DvApply" Style="{DynamicResource Primary}" Content="Apply" ToolTip="Close this and place the hangers, dimensioned in the ticked views"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

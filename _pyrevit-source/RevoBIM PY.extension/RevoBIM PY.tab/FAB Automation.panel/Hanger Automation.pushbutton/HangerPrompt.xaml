<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM - Hanger Automation"
        Width="460" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" FontFamily="Segoe UI" FontSize="12">
  <Grid Margin="6">
    <Border Background="{DynamicResource WinBgBrush}" BorderBrush="{DynamicResource EdgeStrongBrush}" BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ================ header ================ -->
        <Border x:Name="PromptHeader" Grid.Row="0" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="RevoBIM" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock x:Name="PromptTitleTxt" Text="Hanger Automation" FontSize="13" Foreground="{DynamicResource OrangeBrush}" Margin="0,-2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="PromptVerTxt" Text="v1.0.0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="PromptShrinkBtn" Style="{DynamicResource WinBtn}" ToolTip="Shrink to the taskbar - see Revit (Ctrl+Shift+H)">
                <Grid Width="12" Height="12">
                  <Path x:Name="PromptShrinkIcon" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,3 L6,7 L10,3 M1,11 L11,11"/>
                  <Path x:Name="PromptExpandIcon" Visibility="Collapsed" Stroke="{DynamicResource GreenBrush}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,1.5 L11,1.5 M6,11 L6,4.5 M2.5,8 L6,4.5 L9.5,8"/>
                </Grid>
              </Button>
              <Button x:Name="PromptCloseBtn" Style="{DynamicResource CloseBtn}" Content="&#x2715;" ToolTip="Close"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ================ message ================ -->
        <StackPanel x:Name="PromptBody" Grid.Row="1" Margin="16,14,16,14">
          <TextBlock x:Name="PromptHeading" Text="" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <TextBlock x:Name="PromptText" Text="" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>

        <!-- ================ buttons ================ -->
        <Border x:Name="PromptFooter" Grid.Row="2" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="12,8">
          <StackPanel x:Name="PromptButtons" Orientation="Horizontal" HorizontalAlignment="Right"/>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Smart Dimensions"
        Height="420" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False">
  <Window.Resources>

    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#9A9A9E"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#D9534F"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GreenButton" TargetType="Button">
      <Setter Property="Background" Value="#3FA75A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="16,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#4EC06D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <Border Background="#232326" CornerRadius="6" BorderBrush="#4A4A50" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <Border x:Name="header_bar" Grid.Row="0" Background="#1C1C1F"
              CornerRadius="6,6,0,0" Padding="14,10" MouseLeftButtonDown="header_drag">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Image x:Name="header_icon" Grid.Column="0" Width="34" Height="34"
                 Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" Foreground="#4FA3E3" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="tool_name" Text="Smart Dimensions" Foreground="#E8912D"
                       FontSize="15" Margin="1,-2,0,0"/>
          </StackPanel>
          <TextBlock x:Name="version_text" Grid.Column="3" Text="v1.0.0" Foreground="#9A9A9E"
                     FontSize="11" VerticalAlignment="Top" Margin="0,2,10,0"/>
          <Button x:Name="close_button" Grid.Column="4" Content="&#x2715;"
                  Style="{StaticResource CloseButton}" VerticalAlignment="Top"
                  Click="close_click"/>
        </Grid>
      </Border>

      <!-- body -->
      <Grid Grid.Row="1" Margin="14,12,14,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <Border x:Name="section_tick" Width="4" Height="16" Background="#4FA3E3"
                  CornerRadius="2" Margin="0,0,8,0"/>
          <TextBlock x:Name="section_title" Text="Result" Foreground="#E4E4E4"
                     FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1C1C1F" BorderBrush="#3E3E42" BorderThickness="1"
                CornerRadius="4">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
            <TextBox x:Name="body_text" Background="Transparent" Foreground="#E4E4E4"
                     BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                     FontSize="12" FontFamily="Segoe UI" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Disabled"
                     HorizontalScrollBarVisibility="Disabled"/>
          </ScrollViewer>
        </Border>
      </Grid>

      <!-- footer -->
      <Border Grid.Row="2" Background="#1C1C1F" CornerRadius="0,0,6,6" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="status_text" Grid.Column="0" Text="" Foreground="#9A9A9E"
                     FontSize="11" VerticalAlignment="Center"/>
          <Button Grid.Column="1" Content="Close" Style="{StaticResource GreenButton}"
                  Click="close_click"/>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Tag Tidy Settings"
        Width="900" Height="790" MinWidth="720" MinHeight="420" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

  <Border x:Name="RootBorder" CornerRadius="6" BorderThickness="1"
          BorderBrush="{DynamicResource EdgeBrush}" Background="{DynamicResource WindowBackBrush}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ====================== header ====================== -->
      <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="6,6,0,0"
              Background="{DynamicResource BarBrush}" Padding="14,8,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- the mark: three tags tidied into a column, each with a level
               shoulder and a 45 degree leg onto one target -->
          <Canvas Grid.Column="0" Width="28" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
            <Rectangle Canvas.Left="14" Canvas.Top="1" Width="13" Height="6" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource BlueBrush}"/>
            <Rectangle Canvas.Left="14" Canvas.Top="10" Width="13" Height="6" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource BlueBrush}"/>
            <Rectangle Canvas.Left="14" Canvas.Top="19" Width="13" Height="6" RadiusX="1.5" RadiusY="1.5"
                       Fill="{DynamicResource BlueBrush}"/>
            <Path Stroke="{DynamicResource OrangeBrush}" StrokeThickness="1.6"
                  Data="M 14,4 L 9,4 L 3,10 M 14,13 L 3,13 M 14,22 L 9,22 L 3,16"/>
            <Ellipse Canvas.Left="1" Canvas.Top="11" Width="4" Height="4"
                     Fill="{DynamicResource OrangeBrush}"/>
          </Canvas>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" Style="{DynamicResource TitleText}"/>
            <TextBlock Text="Tag Tidy settings" Style="{DynamicResource ToolTitle}" Margin="1,-3,0,0"/>
          </StackPanel>

          <!-- light / dark / auto: follows Revit's canvas until told otherwise -->
          <Button x:Name="ThemeChip" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0"
                  Style="{DynamicResource ThemeChipButton}"
                  ToolTip="Theme: Auto follows Revit's canvas. Click for Dark, Light, then Auto.">
            <StackPanel Orientation="Horizontal">
              <Grid Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center">
                <Ellipse Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.3"/>
                <Path Fill="{DynamicResource MutedBrush}" Data="M 6,0.6 A 5.4,5.4 0 0 1 6,11.4 Z"/>
              </Grid>
              <TextBlock x:Name="ThemeLabel" Text="Auto" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <TextBlock x:Name="VersionText" Grid.Column="4" Text="v1.0.0" VerticalAlignment="Center"
                     Margin="0,0,8,0" Style="{DynamicResource VersionText}"/>

          <Button x:Name="ShrinkBtn" Grid.Column="5" VerticalAlignment="Center"
                  Style="{DynamicResource ShrinkButton}"/>

          <Button x:Name="FullBtn" Grid.Column="6" VerticalAlignment="Center"
                  Style="{DynamicResource WindowButton}" ToolTip="Full screen (F11)">
            <Border Width="11" Height="9" BorderThickness="1.4"
                    BorderBrush="{DynamicResource MutedBrush}"/>
          </Button>

          <Button x:Name="CloseBtn" Grid.Column="7" Content="&#x2715;" VerticalAlignment="Center"
                  Style="{DynamicResource CloseButton}"/>
        </Grid>
      </Border>

      <!-- ====================== body ====================== -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,14,16,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- ============ left: the column, and avoiding clashes ============ -->
          <StackPanel Grid.Column="0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                      Background="{DynamicResource BlueBrush}"/>
              <TextBlock Text="The column" Style="{DynamicResource SectionHead}"/>
            </StackPanel>

            <TextBlock Text="Where the column goes" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="SideCombo" Margin="12,0,0,4" Style="{DynamicResource ThemedCombo}"/>
            <TextBlock x:Name="SideNote" Style="{DynamicResource Muted}" Margin="12,0,0,12"/>

            <TextBlock Text="Line the tags up on" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="AlignCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

            <TextBlock Text="Leader leg angle" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="AngleCombo" Margin="12,0,0,4" Style="{DynamicResource ThemedCombo}"/>
            <TextBlock x:Name="AngleNote" Style="{DynamicResource Muted}" Margin="12,0,0,12"/>

            <Grid Margin="12,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Gap between tags, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="GapBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Shortest shoulder, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="ShoulderBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
            </Grid>

            <Grid Margin="12,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Clear of the targets, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="ColumnClearBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Separate columns past, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="ClusterBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
            </Grid>
            <TextBlock Style="{DynamicResource Muted}" Margin="12,0,0,12"
                       Text="All distances are on the sheet, so they hold at every view scale. Tags whose targets are further apart than the last figure get a column each."/>

            <Grid Margin="12,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Longest level leader run, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="ReachBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
            </Grid>
            <TextBlock Style="{DynamicResource Muted}" Margin="12,0,0,8"
                       Text="How far a tag may be pulled sideways to line up with others. Tags further apart than this across the view get their own alignment line instead of one long leader."/>
            <CheckBox x:Name="KeepChk" Margin="12,0,0,4" Style="{DynamicResource ThemedCheck}"
                      Content="Leave a tag on its own where it is if it is already clear"/>
            <TextBlock Style="{DynamicResource Muted}" Margin="34,0,0,18"
                       Text="A tag with nothing to line up with, already beside its target and clashing with nothing, is not moved."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                      Background="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Finding a clear position" Style="{DynamicResource SectionHead}"/>
            </StackPanel>

            <Grid Margin="12,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Clearance round each tag, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="ClearanceBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Slots a tag may move" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="SlotBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
            </Grid>

            <Grid Margin="12,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Column step, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="StepBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Furthest the column moves out, mm" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="ShiftBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
            </Grid>

            <Grid Margin="12,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Search time per view, seconds" Style="{DynamicResource Muted}" Margin="0,0,0,4"/>
                <TextBox x:Name="BudgetBox" Style="{DynamicResource ThemedBox}"/>
              </StackPanel>
            </Grid>

            <CheckBox x:Name="SecondChk" Margin="12,2,0,4" Style="{DynamicResource ThemedCheck}"
                      Content="Split into a second column when one will not fit"/>
            <TextBlock Style="{DynamicResource Muted}" Margin="34,0,0,4"
                       Text="The second column goes on the other side of the targets."/>
          </StackPanel>

          <!-- ============ right: obstacles, running it ============ -->
          <StackPanel Grid.Column="2">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                      Background="{DynamicResource OrangeBrush}"/>
              <TextBlock Text="What counts as in the way" Style="{DynamicResource SectionHead}"/>
            </StackPanel>

            <CheckBox x:Name="ObsAnnotationChk" Margin="12,0,0,4" Style="{DynamicResource ThemedCheck}"
                      Content="Annotation: other tags, text, dimensions, detail items"/>
            <TextBlock Style="{DynamicResource Muted}" Margin="34,0,0,9"
                       Text="Never covered. Detail lines and filled regions may be crossed."/>
            <CheckBox x:Name="ObsPipesChk" Margin="12,0,0,7" Style="{DynamicResource ThemedCheck}"
                      Content="Pipes, fittings and accessories"/>
            <CheckBox x:Name="ObsDuctsChk" Margin="12,0,0,7" Style="{DynamicResource ThemedCheck}"
                      Content="Ducts, fittings and terminals"/>
            <CheckBox x:Name="ObsTraysChk" Margin="12,0,0,7" Style="{DynamicResource ThemedCheck}"
                      Content="Cable trays"/>
            <CheckBox x:Name="ObsConduitChk" Margin="12,0,0,7" Style="{DynamicResource ThemedCheck}"
                      Content="Conduit"/>
            <CheckBox x:Name="ObsWallsChk" Margin="12,0,0,7" Style="{DynamicResource ThemedCheck}"
                      Content="Walls"/>
            <CheckBox x:Name="ObsGridsChk" Margin="12,0,0,7" Style="{DynamicResource ThemedCheck}"
                      Content="Grids"/>
            <CheckBox x:Name="ObsOtherChk" Margin="12,0,0,7" Style="{DynamicResource ThemedCheck}"
                      Content="Every other model element visible in the view"/>
            <CheckBox x:Name="ObsLinksChk" Margin="12,0,0,4" Style="{DynamicResource ThemedCheck}"
                      Content="Elements in linked models"/>
            <TextBlock Style="{DynamicResource Muted}" Margin="34,0,0,18"
                       Text="Model elements are avoided where possible; a leader may still cross one if there is no clear route. Linked elements count even when the view hides them."/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <Border Width="4" Height="15" CornerRadius="2" Margin="0,0,8,0"
                      Background="{DynamicResource OrangeBrush}"/>
              <TextBlock Text="Running it" Style="{DynamicResource SectionHead}"/>
            </StackPanel>

            <CheckBox x:Name="PromptChk" Margin="12,0,0,9" Style="{DynamicResource ThemedCheck}"
                      Content="Ask me to pick tags when nothing is selected"/>
            <CheckBox x:Name="SpatialChk" Margin="12,0,0,9" Style="{DynamicResource ThemedCheck}"
                      Content="Include room and space tags"/>
            <CheckBox x:Name="DebugChk" Margin="12,0,0,4" Style="{DynamicResource ThemedCheck}"
                      Content="Write a debug report after every run"/>
            <TextBlock Style="{DynamicResource Muted}" Margin="34,0,0,12"
                       Text="Saved to %APPDATA%\RevoBIM\tag_tidy_debug.txt, ready to send back when a layout looks wrong."/>

            <TextBlock Text="Tags with no leader" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="NoLeaderCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

            <TextBlock Text="Pinned tags" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="PinnedCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

            <TextBlock Text="Leaders attached to their element" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="EndCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

            <TextBlock Text="Preview before keeping" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="PreviewCombo" Margin="12,0,0,12" Style="{DynamicResource ThemedCombo}"/>

            <TextBlock Text="Theme (also the chip top right)" Style="{DynamicResource Muted}" Margin="12,0,0,4"/>
            <ComboBox x:Name="ThemeCombo" Margin="12,0,0,14" Style="{DynamicResource ThemedCombo}"/>

            <Button x:Name="ShortcutBtn" HorizontalAlignment="Left" Margin="12,0,0,0"
                    Style="{DynamicResource GhostButton}"
                    Content="Open Revit's Keyboard Shortcuts"/>
            <TextBlock Style="{DynamicResource Muted}" Margin="12,7,0,4"
                       Text="Search for RevoBIM Tag Tidy to bind keys to it."/>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- ====================== footer ====================== -->
      <Border Grid.Row="2" CornerRadius="0,0,6,6" Padding="16,10,16,10"
              Background="{DynamicResource BarBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                     Style="{DynamicResource Muted}"/>
          <Button x:Name="DefaultsBtn" Grid.Column="1" Content="Defaults" Margin="0,0,10,0"
                  Style="{DynamicResource GhostButton}" MinWidth="90"/>
          <Button x:Name="CancelBtn" Grid.Column="2" Content="Cancel" Margin="0,0,10,0"
                  Style="{DynamicResource GhostButton}" MinWidth="90"/>
          <Button x:Name="ApplyBtn" Grid.Column="3" Content="Apply"
                  Style="{DynamicResource PrimaryButton}" MinWidth="110"/>
        </Grid>
      </Border>

      <!-- ====================== resize grips ====================== -->
      <!-- A borderless AllowsTransparency window has nothing hit testable in
           its frame, so it carries its own grips.  No Background on the grid
           so everything underneath stays clickable.  The drawer collapses
           GripLayer while the window is parked.                             -->
      <Grid x:Name="GripLayer" Grid.RowSpan="3">
        <Thumb x:Name="GripL" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
               Cursor="SizeWE" Opacity="0"/>
        <Thumb x:Name="GripR" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" Opacity="0"/>
        <Thumb x:Name="GripT" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Top"
               Cursor="SizeNS" Opacity="0"/>
        <Thumb x:Name="GripB" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Cursor="SizeNS" Opacity="0"/>
        <Thumb x:Name="GripTL" Width="8" Height="8" HorizontalAlignment="Left"
               VerticalAlignment="Top" Cursor="SizeNWSE" Opacity="0"/>
        <Thumb x:Name="GripTR" Width="8" Height="8" HorizontalAlignment="Right"
               VerticalAlignment="Top" Cursor="SizeNESW" Opacity="0"/>
        <Thumb x:Name="GripBL" Width="8" Height="8" HorizontalAlignment="Left"
               VerticalAlignment="Bottom" Cursor="SizeNESW" Opacity="0"/>
        <Thumb x:Name="GripBR" Width="8" Height="8" HorizontalAlignment="Right"
               VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0"/>
      </Grid>

    </Grid>
  </Border>
</Window>

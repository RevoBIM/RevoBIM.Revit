<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Tag All - results"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="720" Height="480" MinWidth="480" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12.5"
        Foreground="{DynamicResource TextBrush}">
    <Grid>
        <Border Background="{DynamicResource WindowBrush}"
                BorderBrush="{DynamicResource ChromeEdgeBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border x:Name="HeaderBar" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LogoHost" Width="30" Height="30" Margin="0,0,10,0" Background="Transparent" Cursor="Hand">
                            <Image x:Name="LogoImage" Width="26" Height="26" Stretch="Uniform"/>
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ToolTitle" Text="Tag All results" FontSize="14" Foreground="{DynamicResource OrangeBrush}" Margin="8,0,0,1" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock x:Name="VersionText" Grid.Column="2" Text="v" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="ShrinkButton" Grid.Column="3" Style="{DynamicResource HeaderButton}" ToolTip="Shrink to the taskbar, to see the model (Ctrl+Shift+H)"/>
                        <Button x:Name="CloseButton" Grid.Column="4" Style="{DynamicResource CloseButton}" Content="&#x2715;"/>
                    </Grid>
                </Border>
                <TextBlock x:Name="SummaryText" Grid.Row="1" Style="{DynamicResource Body}" Margin="14,10,14,6" TextWrapping="Wrap" FontWeight="SemiBold"/>
                <Border Grid.Row="2" Style="{DynamicResource Field}" Margin="14,0,14,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Lines" Margin="8,6"/>
                    </ScrollViewer>
                </Border>
                <Border Grid.Row="3" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Style="{DynamicResource Muted}" FontSize="12"/>
                        <Button x:Name="CopyButton" Grid.Column="1" Content="Copy" Margin="0,0,8,0"/>
                        <Button x:Name="OkButton" Grid.Column="2" Style="{DynamicResource ActionButton}" Content="OK" MinWidth="90"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
        <Grid>
            <Thumb x:Name="GripSE" Style="{DynamicResource Grip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
            <Thumb x:Name="GripE" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right" Margin="0,8" Cursor="SizeWE"/>
            <Thumb x:Name="GripS" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom" Margin="8,0" Cursor="SizeNS"/>
        </Grid>
    </Grid>
</Window>

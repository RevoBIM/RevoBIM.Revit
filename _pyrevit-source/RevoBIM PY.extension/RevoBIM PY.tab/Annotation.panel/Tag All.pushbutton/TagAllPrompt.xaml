<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Tag All"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="520" SizeToContent="Height"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12.5"
        Foreground="{DynamicResource TextBrush}">
    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource ChromeEdgeBrush}" BorderThickness="1" CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBar" Background="{DynamicResource BarBrush}" CornerRadius="6,6,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="LogoHost" Width="30" Height="30" Margin="0,0,10,0" Background="Transparent" Cursor="Hand">
                        <Image x:Name="LogoImage" Width="26" Height="26" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="ToolTitle" Text="Tag All" FontSize="14" Foreground="{DynamicResource OrangeBrush}" Margin="8,0,0,1" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <TextBlock x:Name="VersionText" Grid.Column="2" Text="v" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="ShrinkButton" Grid.Column="3" Style="{DynamicResource HeaderButton}" ToolTip="Shrink to the taskbar, to see the model (Ctrl+Shift+H)"/>
                </Grid>
            </Border>
            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{DynamicResource Body}" Margin="16,14" TextWrapping="Wrap"/>
            <Border Grid.Row="2" Background="{DynamicResource BarBrush}" CornerRadius="0,0,6,6" Padding="12,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton" Content="Cancel" MinWidth="90" Margin="0,0,8,0"/>
                    <Button x:Name="YesButton" Style="{DynamicResource ActionButton}" Content="Continue" MinWidth="110"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>

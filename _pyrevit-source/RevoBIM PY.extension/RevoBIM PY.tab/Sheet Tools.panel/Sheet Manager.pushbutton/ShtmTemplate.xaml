<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Sheet Manager - Edit view template"
        Width="700" Height="820" MinWidth="560" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ====================== header ====================== -->
        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}"
                CornerRadius="6,6,0,0" Padding="12,8,8,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Border x:Name="LogoHost" Width="34" Height="34" CornerRadius="4"
                      Background="Transparent" Cursor="Hand" Margin="0,0,10,0">
                <Image x:Name="LogoImage" Width="30" Height="30" Stretch="Uniform"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="SubTitle" Text="Edit view template"
                           Foreground="{DynamicResource OrangeBrush}"
                           FontFamily="Segoe UI" FontSize="15" Margin="1,-3,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="ThemeChip" Style="{DynamicResource Btn.Chip}" Content="Theme: Auto"
                      Margin="0,0,10,0" ToolTip="Auto follows Revit's canvas; click for Dark, then Light"/>
              <TextBlock x:Name="VersionText" Style="{DynamicResource Lbl.Muted}" Text="v1.0.0"
                         Margin="0,0,10,0"/>
              <Button x:Name="ShrinkBtn" Style="{DynamicResource Btn.Shrink}" Margin="0,0,2,0"/>
              <Button x:Name="FullBtn" Style="{DynamicResource Btn.Glyph}" ToolTip="Full screen (F11)">
                <Border Width="12" Height="10" BorderBrush="{DynamicResource MutedBrush}"
                        BorderThickness="1.4" CornerRadius="1"/>
              </Button>
              <Button x:Name="CloseBtn" Style="{DynamicResource Btn.Close}" Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ====================== name and search ====================== -->
        <Border Grid.Row="1" Background="{DynamicResource CardBg}" Padding="14,10,14,10"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Name" Style="{DynamicResource Lbl.Body}" Margin="0,0,12,0"/>
            <TextBox x:Name="TemplateName" Grid.Row="0" Grid.Column="1" Style="{DynamicResource Txt.Field}"
                     Tag="view template name"/>
            <TextBlock x:Name="UsingText" Grid.Row="1" Grid.ColumnSpan="2" Style="{DynamicResource Lbl.Muted}"
                       HorizontalAlignment="Right" Margin="0,8,0,8"/>
            <Grid Grid.Row="2" Grid.ColumnSpan="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <!-- every part of the template, a tab each -->
              <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="TabProps" Style="{DynamicResource Btn.Tab}" Content="Properties"/>
                <Button x:Name="TabModel" Style="{DynamicResource Btn.Tab}" Content="V/G Model"/>
                <Button x:Name="TabAnnotation" Style="{DynamicResource Btn.Tab}" Content="V/G Annotation"/>
                <Button x:Name="TabFilters" Style="{DynamicResource Btn.Tab}" Content="V/G Filters"/>
                <Button x:Name="TabRange" Style="{DynamicResource Btn.Tab}" Content="View Range"/>
              </StackPanel>
              <TextBox x:Name="ParamSearch" Grid.Row="1" Grid.Column="0" Style="{DynamicResource Txt.Small}"
                       Tag="search this tab"/>
              <Button x:Name="IncludeAllBtn" Grid.Row="1" Grid.Column="1" Style="{DynamicResource Btn.Flat}"
                      Content="Include all" Margin="8,0,5,0"/>
              <Button x:Name="IncludeNoneBtn" Grid.Row="1" Grid.Column="2" Style="{DynamicResource Btn.Flat}"
                      Content="Include none"/>
            </Grid>
          </Grid>
        </Border>

        <!-- ====================== the properties ====================== -->
        <Grid x:Name="PropsPane" Grid.Row="2" Margin="14,10,14,8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" CornerRadius="3,3,0,0"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,1,1,0" Padding="8,5,8,5">
            <Grid Margin="0,0,16,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Parameter" Style="{DynamicResource Lbl.Section}"/>
              <TextBlock Grid.Column="1" Text="Value" Style="{DynamicResource Lbl.Section}"/>
              <TextBlock Grid.Column="2" Text="Include" Style="{DynamicResource Lbl.Section}"
                         HorizontalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="RowsHost"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ============ a list tab: categories, filters, view range ============ -->
        <Grid x:Name="ListPane" Grid.Row="2" Margin="14,10,14,8" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel x:Name="ListTools" Grid.Row="0" Margin="0,0,0,8"/>
          <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" CornerRadius="3,3,0,0"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1,1,1,0" Padding="8,5,8,5">
            <Grid x:Name="ListHeader" Margin="0,0,16,0"/>
          </Border>
          <Border Grid.Row="2" Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
              <StackPanel x:Name="ListHost"/>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- ====================== footer ====================== -->
        <Border Grid.Row="3" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6"
                Padding="12,8,12,8" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{DynamicResource Lbl.Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                       Text="Changed rows show orange; nothing is written until Apply."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CloseBtnFooter" Style="{DynamicResource Btn.Flat}" Content="Close"
                      Margin="0,0,8,0"/>
              <Button x:Name="ApplyBtn" Style="{DynamicResource Btn.Flat}" Content="Apply"
                      IsEnabled="False"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="GripLayer">
      <Thumb x:Name="GripL" Style="{DynamicResource Grip}" HorizontalAlignment="Left" Width="5" Cursor="SizeWE"/>
      <Thumb x:Name="GripR" Style="{DynamicResource Grip}" HorizontalAlignment="Right" Width="5" Cursor="SizeWE"/>
      <Thumb x:Name="GripT" Style="{DynamicResource Grip}" VerticalAlignment="Top" Height="5" Cursor="SizeNS"/>
      <Thumb x:Name="GripB" Style="{DynamicResource Grip}" VerticalAlignment="Bottom" Height="5" Cursor="SizeNS"/>
      <Thumb x:Name="GripTL" Style="{DynamicResource Grip}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="8" Height="8" Cursor="SizeNWSE"/>
      <Thumb x:Name="GripTR" Style="{DynamicResource Grip}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="8" Height="8" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBL" Style="{DynamicResource Grip}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="8" Height="8" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="8" Height="8" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

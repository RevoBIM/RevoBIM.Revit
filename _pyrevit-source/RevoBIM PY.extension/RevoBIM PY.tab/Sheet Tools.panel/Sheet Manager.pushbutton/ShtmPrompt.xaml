<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Sheet Manager"
        Width="720" Height="480" MinWidth="420" MinHeight="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}"
                CornerRadius="6,6,0,0" Padding="12,8,8,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Border x:Name="LogoHost" Width="30" Height="30" CornerRadius="4"
                      Background="Transparent" Cursor="Hand" Margin="0,0,10,0">
                <Image x:Name="LogoImage" Width="26" Height="26" Stretch="Uniform"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                           FontFamily="Segoe UI" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="SubTitle" Text="Sheet Manager"
                           Foreground="{DynamicResource OrangeBrush}"
                           FontFamily="Segoe UI" FontSize="13" Margin="1,-2,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" Style="{DynamicResource Lbl.Muted}" Text="v1.0.0"
                         Margin="0,0,10,0"/>
              <Button x:Name="ShrinkBtn" Style="{DynamicResource Btn.Shrink}" Margin="0,0,2,0"/>
              <Button x:Name="CloseBtn" Style="{DynamicResource Btn.Close}" Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,14,16,14">
          <StackPanel>
            <TextBlock x:Name="BodyText" Style="{DynamicResource Lbl.Body}" TextWrapping="Wrap" Text=""/>
            <!-- a typed answer, when the prompt asks for one -->
            <TextBox x:Name="InputBox" Style="{DynamicResource Txt.Field}" Margin="0,12,0,0"
                     Visibility="Collapsed"/>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6"
                Padding="12,8,12,8" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ThirdBtn" Style="{DynamicResource Btn.Flat}" Content=""
                    Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="SecondBtn" Style="{DynamicResource Btn.Flat}" Content=""
                    Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="FirstBtn" Style="{DynamicResource Btn.Green}" Content="OK"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="GripLayer">
      <Thumb x:Name="GripT" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top"
             HorizontalAlignment="Stretch" Cursor="SizeNS"/>
      <Thumb x:Name="GripR" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right"
             VerticalAlignment="Stretch" Cursor="SizeWE"/>
      <Thumb x:Name="GripB" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom"
             HorizontalAlignment="Stretch" Cursor="SizeNS"/>
      <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" Width="9" Height="9"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

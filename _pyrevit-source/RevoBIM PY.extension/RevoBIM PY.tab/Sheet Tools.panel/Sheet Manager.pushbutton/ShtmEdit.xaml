<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Edit Sheets" Width="760" Height="640" MinWidth="620" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource EdgeBrush}"
          BorderThickness="1" CornerRadius="6">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- ============================ header ============================ -->
      <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource HeaderBg}"
              CornerRadius="6,6,0,0" Padding="12,8,12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Border x:Name="LogoHost" Grid.Column="0" Width="34" Height="34" Margin="0,0,10,0"
                  Background="Transparent">
            <Image x:Name="LogoImage" Stretch="Uniform"/>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource BlueBrush}"/>
            <TextBlock Text="Edit sheets" FontSize="15"
                       Foreground="{DynamicResource OrangeBrush}" Margin="0,-3,0,0"/>
          </StackPanel>
          <TextBlock x:Name="VersionText" Grid.Column="2" Style="{DynamicResource Lbl.Muted}"
                     FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
          <Button x:Name="ShrinkBtn" Grid.Column="3" Style="{DynamicResource Btn.Shrink}"
                  Margin="0,0,2,0" VerticalAlignment="Center"/>
          <Button x:Name="CloseBtn" Grid.Column="4" Style="{DynamicResource Btn.Close}"
                  Content="&#x2715;" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <!-- ============================ tabs ============================ -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,10,14,4">
        <Button x:Name="TabReplace" Style="{DynamicResource Btn.Tab}" Content="Find and replace" Margin="0,0,6,0"/>
        <Button x:Name="TabAffix" Style="{DynamicResource Btn.Tab}" Content="Prefix and suffix" Margin="0,0,6,0"/>
        <Button x:Name="TabFill" Style="{DynamicResource Btn.Tab}" Content="Fill down"/>
      </StackPanel>

      <!-- ============================ body ============================ -->
      <Grid Grid.Row="2" Margin="14,4,14,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="240"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="1.3*" MinWidth="280"/>
        </Grid.ColumnDefinitions>

        <!-- scope and columns -->
        <Border Grid.Column="0" Background="{DynamicResource CardBg}" CornerRadius="4" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Which sheets" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <RadioButton x:Name="ScopeSelected" Grid.Row="1" Style="{DynamicResource Rad.Flat}"
                         Content="The selected rows" GroupName="scope" Margin="0,0,0,4"/>
            <RadioButton x:Name="ScopeShown" Grid.Row="2" Style="{DynamicResource Rad.Flat}"
                         Content="Every row shown" GroupName="scope" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
              <Border Width="4" Height="16" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Which columns" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <TextBox x:Name="ColumnSearch" Grid.Row="4" Style="{DynamicResource Txt.Small}"
                     Tag="search the columns" Margin="0,0,0,6"/>
            <ListBox x:Name="ColumnList" Grid.Row="5" Style="{DynamicResource Lst.Flat}"/>
          </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="6" Style="{DynamicResource Split.Flat}"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

        <!-- the rule -->
        <Border Grid.Column="2" Background="{DynamicResource CardBg}" CornerRadius="4" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- find and replace -->
            <StackPanel x:Name="ReplacePane" Grid.Row="0">
              <TextBlock Text="Find" Style="{DynamicResource Lbl.Body}" Margin="0,0,0,3"/>
              <TextBox x:Name="FindBox" Style="{DynamicResource Txt.Field}" Tag="text to look for" Margin="0,0,0,8"/>
              <TextBlock Text="Replace with" Style="{DynamicResource Lbl.Body}" Margin="0,0,0,3"/>
              <TextBox x:Name="ReplaceBox" Style="{DynamicResource Txt.Field}" Tag="leave blank to delete it" Margin="0,0,0,8"/>
              <CheckBox x:Name="MatchCase" Style="{DynamicResource Chk.Flat}" Content="Match case" Margin="0,0,0,4"/>
            </StackPanel>

            <!-- prefix and suffix -->
            <StackPanel x:Name="AffixPane" Grid.Row="0" Visibility="Collapsed">
              <TextBlock Text="Prefix" Style="{DynamicResource Lbl.Body}" Margin="0,0,0,3"/>
              <TextBox x:Name="PrefixBox" Style="{DynamicResource Txt.Field}" Tag="goes on the front" Margin="0,0,0,8"/>
              <TextBlock Text="Suffix" Style="{DynamicResource Lbl.Body}" Margin="0,0,0,3"/>
              <TextBox x:Name="SuffixBox" Style="{DynamicResource Txt.Field}" Tag="goes on the end" Margin="0,0,0,8"/>
            </StackPanel>

            <!-- fill down -->
            <StackPanel x:Name="FillPane" Grid.Row="0" Visibility="Collapsed">
              <TextBlock Text="Value" Style="{DynamicResource Lbl.Body}" Margin="0,0,0,3"/>
              <TextBox x:Name="FillBox" Style="{DynamicResource Txt.Field}"
                       Tag="written into every chosen cell" Margin="0,0,0,8"/>
              <TextBlock Style="{DynamicResource Lbl.Muted}" TextWrapping="Wrap"
                         Text="One value into the ticked column(s) of every chosen sheet - Excel's fill down, without the rows having to be next to each other."/>
            </StackPanel>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,6">
              <Border Width="4" Height="16" Background="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="What it would do" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="PreviewText" Style="{DynamicResource Lbl.Body}" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="12"/>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ============================ footer ============================ -->
      <Border Grid.Row="3" Background="{DynamicResource HeaderBg}" CornerRadius="0,0,6,6" Padding="12,8,12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Grid.Column="0" Style="{DynamicResource Lbl.Muted}"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button x:Name="CancelBtn" Style="{DynamicResource Btn.Flat}" Content="Cancel" Margin="0,0,8,0"/>
            <Button x:Name="AddBtn" Style="{DynamicResource Btn.Green}" Content="Add to pending edits"
                    IsEnabled="False"/>
          </StackPanel>
        </Grid>
      </Border>

      <Thumb x:Name="GripL" Style="{DynamicResource Grip}" HorizontalAlignment="Left" Width="5" Cursor="SizeWE" Grid.RowSpan="4"/>
      <Thumb x:Name="GripR" Style="{DynamicResource Grip}" HorizontalAlignment="Right" Width="5" Cursor="SizeWE" Grid.RowSpan="4"/>
      <Thumb x:Name="GripT" Style="{DynamicResource Grip}" VerticalAlignment="Top" Height="5" Cursor="SizeNS" Grid.RowSpan="4"/>
      <Thumb x:Name="GripB" Style="{DynamicResource Grip}" VerticalAlignment="Bottom" Height="5" Cursor="SizeNS" Grid.RowSpan="4"/>
      <Thumb x:Name="GripTL" Style="{DynamicResource Grip}" HorizontalAlignment="Left" VerticalAlignment="Top" Width="8" Height="8" Cursor="SizeNWSE" Grid.RowSpan="4"/>
      <Thumb x:Name="GripTR" Style="{DynamicResource Grip}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="8" Height="8" Cursor="SizeNESW" Grid.RowSpan="4"/>
      <Thumb x:Name="GripBL" Style="{DynamicResource Grip}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="8" Height="8" Cursor="SizeNESW" Grid.RowSpan="4"/>
      <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="8" Height="8" Cursor="SizeNWSE" Grid.RowSpan="4"/>
    </Grid>
  </Border>
</Window>

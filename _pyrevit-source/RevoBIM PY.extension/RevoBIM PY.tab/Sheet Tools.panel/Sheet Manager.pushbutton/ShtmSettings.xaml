<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Sheet Manager - Settings"
        Width="860" Height="780" MinWidth="640" MinHeight="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">

  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0" Background="{DynamicResource BarBg}"
                CornerRadius="6,6,0,0" Padding="12,8,8,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
              <Border x:Name="LogoHost" Width="34" Height="34" CornerRadius="4"
                      Background="Transparent" Cursor="Hand" Margin="0,0,10,0">
                <Image x:Name="LogoImage" Width="30" Height="30" Stretch="Uniform"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RevoBIM" Foreground="{DynamicResource BlueBrush}"
                           FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Sheet Manager Settings" Foreground="{DynamicResource OrangeBrush}"
                           FontFamily="Segoe UI" FontSize="15" Margin="1,-3,0,0"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" Style="{DynamicResource Lbl.Muted}" Text="v1.0.0"
                         Margin="0,0,10,0"/>
              <Button x:Name="ShrinkBtn" Style="{DynamicResource Btn.Shrink}" Margin="0,0,2,0"/>
              <Button x:Name="CloseBtn" Style="{DynamicResource Btn.Close}" Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12,14,12">
          <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Appearance" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <Grid Margin="12,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Theme" Style="{DynamicResource Lbl.Body}"/>
              <ComboBox x:Name="ThemeCombo" Grid.Column="1" Style="{DynamicResource Cmb.Flat}"/>
              <TextBlock Grid.Column="2" Style="{DynamicResource Lbl.Muted}" Margin="12,0,0,0"
                         Text="Auto follows Revit's own canvas theme"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="4" Height="16" Background="{DynamicResource BlueBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Which sheets are listed" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <StackPanel Margin="12,0,0,16">
              <CheckBox x:Name="IncludePlaceholders" Style="{DynamicResource Chk.Flat}" Margin="0,0,0,8"
                        Content="Include placeholder sheets"/>
              <CheckBox x:Name="OnlyInSheetList" Style="{DynamicResource Chk.Flat}"
                        Content="Only sheets ticked &quot;Appears In Sheet List&quot;"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="4" Height="16" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Parameters" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <StackPanel Margin="12,0,0,16">
              <TextBlock Text="Columns the table opens with" Style="{DynamicResource Lbl.Body}"
                         Margin="0,0,0,4"/>
              <TextBox x:Name="ColumnsBox" Style="{DynamicResource Txt.Field}" Margin="0,0,0,4"
                       Tag="blank - take them from the browser organisation"/>
              <TextBlock Style="{DynamicResource Lbl.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                         Text="Parameter names separated by a vertical bar. Sheet Number and Sheet Name are always shown."/>

              <TextBlock Text="Project browser grouping parameters" Style="{DynamicResource Lbl.Body}"
                         Margin="0,0,0,2"/>
              <TextBlock Style="{DynamicResource Lbl.Muted}" Margin="0,0,0,6" TextWrapping="Wrap"
                         Text="These are also the grouping columns in Duplicate's table of sets - Stage, Discipline, Series and WIP Tag by default. The preview sorts and groups by the one with Series in its name. Leave them all as (none) to use the project browser's own."/>
              <StackPanel x:Name="GroupingHost" Margin="0,0,0,4"/>
              <Button x:Name="ReadBrowserBtn" Style="{DynamicResource Btn.Flat}"
                      Content="Read from the project browser" HorizontalAlignment="Left"
                      Margin="0,2,0,4"/>
              <TextBlock x:Name="BrowserNote" Style="{DynamicResource Lbl.Muted}" Margin="0,0,0,12"
                         TextWrapping="Wrap" Text=""/>

              <TextBlock Text="Push sheet names" Style="{DynamicResource Lbl.Body}"
                         Margin="0,0,0,4"/>
              <TextBlock Style="{DynamicResource Lbl.Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="When 'Write the sheet names into sheet parameters' is ticked in Duplicate, each new sheet name is split on the delimiter and the parts written into these sheet parameters in the order they were written: with _, MECHANICAL SERVICES_VENTILATION_LAYOUT gives MECHANICAL SERVICES, VENTILATION and LAYOUT. Type in a box to search the project's sheet parameters. Where a parameter is also in the browser grouping above and a grouping value is set, the grouping value wins."/>
              <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Delimiter" Style="{DynamicResource Lbl.Body}"/>
                <TextBox x:Name="NameDelimiter" Grid.Column="1" Style="{DynamicResource Txt.Field}" Tag="_"
                         ToolTip="What the sheet name is split on - blank means _"/>
                <TextBlock Grid.Column="2" Style="{DynamicResource Lbl.Muted}" Margin="10,0,0,0"
                           Text="default _ - any text, e.g. - or &#x2009;/&#x2009;"/>
              </Grid>
              <StackPanel x:Name="NameParamsHost" Margin="0,0,0,4"/>
              <TextBlock Style="{DynamicResource Lbl.Muted}" TextWrapping="Wrap"
                         Text="Extra parts past the last parameter are joined onto it with the delimiter. Leave them all as (none) to write nothing."/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="4" Height="16" Background="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="View template presets" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <StackPanel Margin="12,0,0,16">
              <TextBlock Style="{DynamicResource Lbl.Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                         Text="Pick a view template and the values it brings with it. When that template is added to Duplicate's table of sets, its row fills in by itself. Presets are kept by template name, so they work in every project with a template of that name. The &#x2605; on a row in Duplicate keeps that row's values as its template's preset too."/>
              <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="170"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="View template" Style="{DynamicResource Lbl.Body}"
                           VerticalAlignment="Center"/>
                <StackPanel x:Name="PresetTemplateHost" Grid.Column="1"/>
              </Grid>
              <StackPanel x:Name="PresetFieldsHost"/>
              <StackPanel Orientation="Horizontal" Margin="170,4,0,12">
                <Button x:Name="PresetKeepBtn" Style="{DynamicResource Btn.Orange}" Content="Keep preset"
                        Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="PresetDeleteBtn" Style="{DynamicResource Btn.Flat}" Content="Delete preset"
                        Margin="0,0,6,0" IsEnabled="False"/>
                <Button x:Name="PresetClearBtn" Style="{DynamicResource Btn.Flat}" Content="Clear fields"/>
              </StackPanel>
              <TextBlock x:Name="PresetListTitle" Text="Presets" Style="{DynamicResource Lbl.Body}" Margin="0,0,0,4"/>
              <ListBox x:Name="PresetList" Style="{DynamicResource Lst.Flat}" Height="150"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="4" Height="16" Background="{DynamicResource OrangeBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="Behaviour" Style="{DynamicResource Lbl.Section}"/>
            </StackPanel>
            <StackPanel Margin="12,0,0,8">
              <CheckBox x:Name="ConfirmBox" Style="{DynamicResource Chk.Flat}" Margin="0,0,0,8"
                        Content="Say what the duplicate is about to do before writing anything"/>
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="230"/>
                  <ColumnDefinition Width="220"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Show results" Style="{DynamicResource Lbl.Body}"/>
                <ComboBox x:Name="ResultsCombo" Grid.Column="1" Style="{DynamicResource Cmb.Flat}"/>
              </Grid>
              <Button x:Name="ResetDupBtn" Style="{DynamicResource Btn.Flat}" HorizontalAlignment="Left"
                      Content="Reset the duplicate options to their defaults"/>
            </StackPanel>

            <TextBlock x:Name="PathNote" Style="{DynamicResource Lbl.Muted}" Margin="12,10,0,0"
                       TextWrapping="Wrap" Text=""/>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,6,6"
                Padding="12,8,12,8" BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,1,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{DynamicResource Lbl.Muted}"
                       Text="" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CancelBtn" Style="{DynamicResource Btn.Flat}" Content="Cancel"
                      Margin="0,0,8,0"/>
              <Button x:Name="ApplyBtn" Style="{DynamicResource Btn.Green}" Content="Apply"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="GripLayer">
      <Thumb x:Name="GripT" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Top"
             HorizontalAlignment="Stretch" Cursor="SizeNS"/>
      <Thumb x:Name="GripR" Style="{DynamicResource Grip}" Width="5" HorizontalAlignment="Right"
             VerticalAlignment="Stretch" Cursor="SizeWE"/>
      <Thumb x:Name="GripB" Style="{DynamicResource Grip}" Height="5" VerticalAlignment="Bottom"
             HorizontalAlignment="Stretch" Cursor="SizeNS"/>
      <Thumb x:Name="GripBR" Style="{DynamicResource Grip}" Width="9" Height="9"
             HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

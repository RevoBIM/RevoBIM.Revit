<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ====================== palette (dark defaults, overwritten at runtime) ====================== -->
  <SolidColorBrush x:Key="WindowBg"      Color="#3C4454"/>
  <SolidColorBrush x:Key="CardBg"        Color="#343C4A"/>
  <SolidColorBrush x:Key="FieldBg"       Color="#2D3441"/>
  <SolidColorBrush x:Key="BarBg"         Color="#222933"/>
  <SolidColorBrush x:Key="EdgeBrush"     Color="#4E5665"/>
  <SolidColorBrush x:Key="TextBrush"     Color="#EEF0F4"/>
  <SolidColorBrush x:Key="MutedBrush"    Color="#A4AAB1"/>
  <SolidColorBrush x:Key="BlueBrush"     Color="#5AAEEB"/>
  <SolidColorBrush x:Key="OrangeBrush"   Color="#E8912D"/>
  <SolidColorBrush x:Key="GreenBrush"    Color="#3FA75A"/>
  <SolidColorBrush x:Key="GreenHover"    Color="#4EC06D"/>
  <SolidColorBrush x:Key="RedBrush"      Color="#D9534F"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#3A7392"/>
  <SolidColorBrush x:Key="HoverBg"       Color="#444E5E"/>
  <SolidColorBrush x:Key="HeaderBg"      Color="#323C48"/>
  <SolidColorBrush x:Key="RowAltBg"      Color="#333A47"/>
  <SolidColorBrush x:Key="GroupRowBg"    Color="#42495C"/>
  <SolidColorBrush x:Key="GroupL1Bg" Color="#5B5B3A"/>
  <SolidColorBrush x:Key="GroupL2Bg" Color="#5B483A"/>
  <SolidColorBrush x:Key="GroupL3Bg" Color="#2D5274"/>
  <SolidColorBrush x:Key="GroupL4Bg" Color="#3B624C"/>
  <SolidColorBrush x:Key="GroupL5Bg" Color="#4B426C"/>
  <SolidColorBrush x:Key="GroupL6Bg" Color="#2F566C"/>
  <SolidColorBrush x:Key="BandL1Bg" Color="#3A3E39"/>
  <SolidColorBrush x:Key="BandL2Bg" Color="#3C3A3B"/>
  <SolidColorBrush x:Key="BandL3Bg" Color="#2A3D55"/>
  <SolidColorBrush x:Key="BandL4Bg" Color="#2D433D"/>
  <SolidColorBrush x:Key="BandL5Bg" Color="#36374E"/>
  <SolidColorBrush x:Key="BandL6Bg" Color="#2A404E"/>
  <SolidColorBrush x:Key="CreatedBg" Color="#2A6E48"/>
  <SolidColorBrush x:Key="VioletBrush" Color="#B08EE6"/>
  <SolidColorBrush x:Key="TealBrush" Color="#4CC2C0"/>
  <SolidColorBrush x:Key="AmberBrush" Color="#DDBF55"/>
  <SolidColorBrush x:Key="StagedBg" Color="#30624E"/>
  <SolidColorBrush x:Key="ImportBg" Color="#2D5E68"/>
  <SolidColorBrush x:Key="RefusedBg" Color="#8B3B42"/>
  <SolidColorBrush x:Key="ReadOnlyBg" Color="#4E3E48"/>
  <SolidColorBrush x:Key="CopiedBg" Color="#5B5736"/>
  <SolidColorBrush x:Key="DupBg1" Color="#4B426C"/>
  <SolidColorBrush x:Key="DupBg2" Color="#2F566C"/>
  <SolidColorBrush x:Key="DupBg3" Color="#5B5240"/>
  <SolidColorBrush x:Key="DupBg4" Color="#3B624C"/>
  <SolidColorBrush x:Key="DupBg5" Color="#5B424C"/>
  <SolidColorBrush x:Key="DupBg6" Color="#3B426C"/>
  <SolidColorBrush x:Key="DisabledBrush" Color="#7B8290"/>
  <SolidColorBrush x:Key="GridLineBrush" Color="#3A4250"/>
  <SolidColorBrush x:Key="FoundGreen" Color="#6CD38A"/>
  <SolidColorBrush x:Key="TintBlueBg" Color="#364C63"/>
  <SolidColorBrush x:Key="TintOrangeBg" Color="#52473D"/>
  <SolidColorBrush x:Key="TintGreenBg" Color="#314B46"/>

  <!-- ====================== text ====================== -->
  <Style x:Key="Lbl.Body" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Lbl.Muted" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Lbl.Section" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ====================== buttons ====================== -->
  <Style x:Key="Btn.Flat" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="12,3,12,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="3" Background="{DynamicResource CardBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
              <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Green" TargetType="Button">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="16,4,16,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="3" Background="{DynamicResource GreenBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource GreenHover}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource CardBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Orange" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource OrangeBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="12,3,12,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="3" Background="Transparent"
                  BorderBrush="{DynamicResource OrangeBrush}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Chip" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Padding" Value="10,2,10,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="12" Background="{DynamicResource CardBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Glyph" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="3" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- shrink to taskbar: a down arrow onto a bar; parked (Tag="shrunk") it
       becomes a green up arrow. Drawn as Paths, never a symbol-font glyph. -->
  <Style x:Key="Btn.Shrink" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="3" Background="Transparent">
            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path x:Name="down" Data="M7,1 L7,9.5 M3.2,5.8 L7,9.5 L10.8,5.8 M1.5,12.8 L12.5,12.8"
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              <Path x:Name="up" Data="M7,13 L7,4.2 M2.8,8.2 L7,4 L11.2,8.2 M1.5,1.2 L12.5,1.2"
                    Stroke="{DynamicResource GreenBrush}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
            <Trigger Property="Tag" Value="shrunk">
              <Setter TargetName="down" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="up" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a collapsible section's heading: the whole bar is the click target -->
  <Style x:Key="Btn.Section" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="4" Background="{DynamicResource HeaderBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" Padding="10,6,10,6">
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Btn.Close" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="3" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource RedBrush}"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== tab chips ====================== -->
  <Style x:Key="Btn.Tab" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="18,4,18,4"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" CornerRadius="3,3,0,0" Background="Transparent"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="0,0,0,2">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== text box ====================== -->
  <Style x:Key="Txt.Field" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="7,3,7,3"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="3" Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
            <Grid ClipToBounds="True">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
              <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource MutedBrush}" FontSize="12"
                         VerticalAlignment="Center" Margin="9,0,0,0" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a text box carrying its own colour: Background and BorderBrush are
       bound, so the set table's number / name / view boxes can wear the
       colour of the find they replace -->
  <Style x:Key="Txt.Tinted" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="7,3,7,3"/>
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="3" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <Grid ClipToBounds="True">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
              <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource MutedBrush}" FontSize="12"
                         VerticalAlignment="Center" Margin="9,0,0,0" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Txt.Small" TargetType="TextBox" >
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource SelectionBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Padding" Value="5,1,5,1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" CornerRadius="2" Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
            <Grid ClipToBounds="True">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                            Margin="{TemplateBinding Padding}"/>
              <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource MutedBrush}" FontSize="11"
                         VerticalAlignment="Center" Margin="7,0,0,0" Visibility="Collapsed"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== check box ====================== -->
  <Style x:Key="Chk.Flat" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
              <Border x:Name="tick" Width="7" Height="7" CornerRadius="1"
                      Background="{DynamicResource BlueBrush}" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== radio button ====================== -->
  <Style x:Key="Rad.Flat" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="box" Width="15" Height="15" CornerRadius="8" VerticalAlignment="Center"
                    Background="{DynamicResource FieldBg}"
                    BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
              <Border x:Name="dot" Width="7" Height="7" CornerRadius="4"
                      Background="{DynamicResource BlueBrush}" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== list box and items ====================== -->
  <Style x:Key="Lst.Flat" TargetType="ListBox">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <Style x:Key="Lst.Item" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="6,3,6,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="bd" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== combo box ====================== -->
  <Style x:Key="Cmb.Toggle" TargetType="ToggleButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" CornerRadius="3" Background="{DynamicResource FieldBg}"
                  BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
            <Path x:Name="ar" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"
                  Data="M 0 0 L 8 0 L 4 5 Z" Fill="{DynamicResource MutedBrush}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BlueBrush}"/>
              <Setter TargetName="ar" Property="Fill" Value="{DynamicResource TextBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Cmb.Flat" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_ToggleBtn" Style="{DynamicResource Cmb.Toggle}"
                          Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Margin="9,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   PopupAnimation="None">
              <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                      BorderThickness="1" CornerRadius="3"
                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="320">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel IsItemsHost="True"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Cmb.Item" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Padding" Value="9,5,9,5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== scroll bar (implicit: ScrollViewer builds its own) ====================== -->
  <Style x:Key="Sb.Thumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="bd" CornerRadius="4" Margin="2"
                  Background="{DynamicResource EdgeBrush}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource MutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Sb.Track" TargetType="RepeatButton">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{DynamicResource Sb.Track}" Command="ScrollBar.PageUpCommand"/>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{DynamicResource Sb.Thumb}"/>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{DynamicResource Sb.Track}" Command="ScrollBar.PageDownCommand"/>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="10"/>
              <Setter Property="Width" Value="Auto"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== tool tip ====================== -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="9,6,9,6">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== data grid ====================== -->
  <!-- ========================= context menus ========================= -->
  <!-- if a control can render a surface, retemplate it: a stock ContextMenu
       falls back to the OS chrome, which is a white slab in a dark window -->
  <Style x:Key="Menu.Flat" TargetType="ContextMenu">
    <Setter Property="Background" Value="{DynamicResource CardBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="3" Padding="3">
            <StackPanel IsItemsHost="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="MenuItem.Flat" TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Shell" Background="Transparent" CornerRadius="2" Padding="10,5,14,5">
            <ContentPresenter ContentSource="Header"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Shell" Property="Background" Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Grid.Header" TargetType="DataGridColumnHeader">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalContentAlignment" Value="Top"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="0,0,1,1" Padding="2,2,2,2">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6"
                   Cursor="SizeWE" Opacity="0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Grid.Cell" TargetType="DataGridCell">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" BorderBrush="{DynamicResource GridLineBrush}"
                  BorderThickness="0,0,1,0" Padding="6,3,6,3">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Grid.Row" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource GridLineBrush}" BorderThickness="0,0,0,1">
            <DataGridCellsPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Grid.Flat" TargetType="DataGrid">
    <Setter Property="Background" Value="{DynamicResource FieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="RowBackground" Value="Transparent"/>
    <Setter Property="GridLinesVisibility" Value="None"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserDeleteRows" Value="False"/>
    <Setter Property="CanUserResizeRows" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="ColumnHeaderStyle" Value="{DynamicResource Grid.Header}"/>
    <Setter Property="CellStyle" Value="{DynamicResource Grid.Cell}"/>
    <Setter Property="RowStyle" Value="{DynamicResource Grid.Row}"/>
    <Setter Property="RowHeight" Value="26"/>
  </Style>

  <!-- ====================== resize grip ====================== -->
  <Style x:Key="Grip" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ====================== splitter ====================== -->
  <Style x:Key="Split.Flat" TargetType="GridSplitter">
    <Setter Property="Background" Value="{DynamicResource EdgeBrush}"/>
    <Setter Property="Width" Value="4"/>
    <Setter Property="Cursor" Value="SizeWE"/>
  </Style>

</ResourceDictionary>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM revision" Width="640" Height="520"
        MinWidth="440" MinHeight="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid x:Name="Root">
    <Border x:Name="Shell" CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0">
          <Grid Margin="14,0,10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="RevoBimLogo" Text="RevoBIM" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Bottom"/>
              <TextBlock x:Name="PickerTitle" Text="Revision" FontSize="15" Margin="8,0,0,2"
                         Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="1" Style="{DynamicResource ArcMuted}"
                       FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0"/>
            <Button x:Name="CloseButton" Grid.Column="2" Style="{DynamicResource ArcCloseButton}"
                    Content="&#x2715;"/>
          </Grid>
        </Border>

        <!-- ============================ headings ========================== -->
        <Grid Grid.Row="1" Margin="18,10,18,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="110"/>
            <ColumnDefinition Width="70"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Style="{DynamicResource ArcMuted}" Text="Seq"/>
          <TextBlock Grid.Column="2" Style="{DynamicResource ArcMuted}" Text="Description"/>
          <TextBlock Grid.Column="3" Style="{DynamicResource ArcMuted}" Text="Date"/>
          <TextBlock Grid.Column="4" Style="{DynamicResource ArcMuted}" Text="Status"/>
        </Grid>

        <!-- ============================ the list =========================== -->
        <Border Grid.Row="2" Margin="12,0,12,0" Background="{DynamicResource FieldBg}"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1" CornerRadius="4">
          <ListBox x:Name="RevList" Style="{DynamicResource ArcList}" SelectionMode="Single"
                   Background="Transparent" BorderThickness="0"/>
        </Border>

        <!-- ============================ footer ============================= -->
        <Border Grid.Row="3" Background="{DynamicResource BarBg}" CornerRadius="0,0,5,5">
          <Grid Margin="14,0,14,0">
            <TextBlock x:Name="StatusText" Style="{DynamicResource ArcMuted}"
                       VerticalAlignment="Center"
                       Text="Click a revision. Issued revisions cannot take a cloud."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="EditButton" Style="{DynamicResource ArcOrangeButton}"
                      Content="Edit..." Padding="14,4" Margin="0,0,8,0"
                      ToolTip="Edit the revision highlighted above"/>
              <Button x:Name="NewButton" Style="{DynamicResource ArcGreenButton}"
                      Content="New revision..." Padding="14,4" Margin="0,0,8,0"
                      ToolTip="Create a revision sequence in the project and use it"/>
              <Button x:Name="ClearButton" Style="{DynamicResource ArcSmallButton}"
                      Content="Use the default" Padding="14,4" Margin="0,0,8,0"
                      ToolTip="Follow the revision chosen at the bottom of the main window"/>
              <Button x:Name="CancelButton" Style="{DynamicResource ArcSmallButton}"
                      Content="Cancel" Padding="16,4" Margin="0,0,8,0"/>
              <Button x:Name="OkButton" Style="{DynamicResource ArcGreenButton}"
                      Content="Use this" Padding="20,5"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ============================ resize grips ======================== -->
    <Grid x:Name="Grips">
      <Thumb x:Name="GripLeft" Style="{DynamicResource ArcGrip}" Width="6" HorizontalAlignment="Left" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripRight" Style="{DynamicResource ArcGrip}" Width="6" HorizontalAlignment="Right" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripTop" Style="{DynamicResource ArcGrip}" Height="6" VerticalAlignment="Top" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripBottom" Style="{DynamicResource ArcGrip}" Height="6" VerticalAlignment="Bottom" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripTopLeft" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
      <Thumb x:Name="GripTopRight" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBottomLeft" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBottomRight" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

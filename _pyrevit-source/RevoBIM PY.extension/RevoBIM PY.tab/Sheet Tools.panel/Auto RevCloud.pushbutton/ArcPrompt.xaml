<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Auto RevCloud" Width="640" Height="440" MinWidth="420" MinHeight="240"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12.5">
  <Grid x:Name="Root">
    <Border x:Name="Shell" CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource ShellEdge}" BorderThickness="1" Margin="5">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="5,5,0,0">
          <Grid Margin="12,0,6,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Bottom"/>
              <TextBlock x:Name="TitleText" Text="Auto RevCloud" FontSize="15" Foreground="{DynamicResource OrangeBrush}" Margin="8,0,0,2" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="2" Style="{DynamicResource ArcMuted}" FontSize="11" Margin="12,0,6,0"/>
            <Button x:Name="FullScreenButton" Grid.Column="3" Style="{DynamicResource ArcIconButton}" ToolTip="Full screen (F11)">
              <Border Width="12" Height="12" BorderThickness="1.5" BorderBrush="{DynamicResource MutedBrush}" CornerRadius="1"/>
            </Button>
            <Button x:Name="CloseButton" Grid.Column="4" Style="{DynamicResource ArcCloseButton}" Content="&#x2715;"/>
          </Grid>
        </Border>

        <!-- ============================ body ============================== -->
        <Border Grid.Row="1" Style="{DynamicResource ArcCard}" Margin="10">
          <TextBox x:Name="MessageBox" Style="{DynamicResource ArcTextArea}" BorderThickness="0" Background="Transparent"/>
        </Border>

        <!-- ============================ footer ============================ -->
        <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,5,5">
          <Grid Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{DynamicResource ArcMuted}" Text=""/>
            <Button x:Name="NoButton" Grid.Column="1" Style="{DynamicResource ArcButton}" Content="No"/>
            <Button x:Name="YesButton" Grid.Column="2" Style="{DynamicResource ArcGreenButton}" Content="OK" Margin="0"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

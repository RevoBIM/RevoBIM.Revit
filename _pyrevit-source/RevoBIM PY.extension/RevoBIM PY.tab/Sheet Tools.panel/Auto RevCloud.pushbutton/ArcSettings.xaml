<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Auto RevCloud Settings" Width="820" Height="680"
        MinWidth="620" MinHeight="380"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid x:Name="Root">
    <Border x:Name="Shell" CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0">
          <Grid Margin="14,0,10,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="RevoBimLogo" Text="RevoBIM" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Bottom"/>
              <TextBlock Text="Auto RevCloud settings" FontSize="15" Margin="8,0,0,1"
                         Foreground="{DynamicResource OrangeBrush}" VerticalAlignment="Bottom"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="VersionText" Style="{DynamicResource ArcMuted}" FontSize="11"
                         VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="CloseButton" Style="{DynamicResource ArcCloseButton}" Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ============================ body ==============================
             Scrolls, because settings keep arriving and the window has to
             stay usable on a laptop. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
          <Grid Margin="14,10,14,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================== left column ====================== -->
            <StackPanel Grid.Column="0">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{DynamicResource ArcTickBlue}"/>
                <TextBlock Style="{DynamicResource ArcHeading}" Text="What counts as a change"/>
              </StackPanel>
              <Border Style="{DynamicResource ArcCard}">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource ArcLabel}" Text="How elements are matched"
                               ToolTip="By element id: the same element is followed between the two models, so a move is reported as a move. Spatially: no ids at all - anything that does not line up exactly is a change, which is what you want when the link's ids do not correspond to this model's."/>
                    <ComboBox x:Name="MethodCombo" Grid.Column="1" Style="{DynamicResource ArcComboBox}"/>
                  </Grid>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="36"/>
                      <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{DynamicResource ArcLabel}"
                               Text="Spatial: must line up within, mm"
                               ToolTip="Only used by the spatial method. How exactly a host element's geometry has to match something of the same category in the link before it counts as unchanged."/>
                    <TextBox x:Name="SpatialTolBox" Grid.Row="0" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                    <TextBlock Grid.Row="1" Style="{DynamicResource ArcLabel}"
                               Text="Spatial: look this far for a moved element, mm"
                               ToolTip="Without ids there is nothing to say two elements are the same one, so a move only reads as a move when a like-for-like element is found within this distance. Beyond it, a move is reported as a removal plus an addition. 0 turns the second pass off."/>
                    <TextBox x:Name="SpatialSearchBox" Grid.Row="1" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="36"/>
                      <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{DynamicResource ArcLabel}"
                               Text="Moved more than, mm"
                               ToolTip="Model millimetres, measured between the element's centre now and in the link. Below this it is treated as the same position."/>
                    <TextBox x:Name="MoveTolBox" Grid.Row="0" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                    <TextBlock Grid.Row="1" Style="{DynamicResource ArcLabel}"
                               Text="...or changed size by more than, mm"
                               ToolTip="Model millimetres on any one side of the element's bounding box - a pipe that got longer or a duct that got wider."/>
                    <TextBox x:Name="SizeTolBox" Grid.Row="1" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                  </Grid>
                  <CheckBox x:Name="MatchEidCheck" Style="{DynamicResource ArcCheckBox}"
                            Content="Also match elements on Element ID"
                            ToolTip="UniqueId is tried first; anything left over is matched on Element ID. Some routes to a copy of a model regenerate the UniqueId but keep the Element ID, and this rescues those."/>
                  <CheckBox x:Name="CheckTypeCheck" Style="{DynamicResource ArcCheckBox}"
                            Content="A changed type is a change"
                            ToolTip="An element that has not moved but is now a different type - a 100 dia swapped for a 150 dia."/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource ArcLabel}"
                               Text="...or turned more than, degrees"
                               ToolTip="Catches a fitting rotated in place, which leaves its bounding box identical."/>
                    <TextBox x:Name="RotateTolBox" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                  </Grid>
                  <CheckBox x:Name="CheckParamsCheck" Style="{DynamicResource ArcCheckBox}"
                            Content="...or one of these parameters changed"
                            ToolTip="Catches a change that moves nothing and resizes nothing - a system reassigned, a level changed, an offset edited."/>
                  <TextBox x:Name="CompareParamsBox" Style="{DynamicResource ArcTextArea}" Height="80"
                           AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                           ToolTip="One per line. Only parameters both the model and the link carry are compared."/>
                  <CheckBox x:Name="CloudRemovedCheck" Style="{DynamicResource ArcCheckBox}"
                            Content="Cloud things that have been taken out"
                            ToolTip="Clouded where the element used to be, which is the only place it exists. Off clouds only what is new or has moved."/>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <Border Style="{DynamicResource ArcTickOrange}"/>
                <TextBlock Style="{DynamicResource ArcHeading}" Text="Experimental 1 - VersionGuid"/>
              </StackPanel>
              <Border Style="{DynamicResource ArcCard}">
                <StackPanel>
                  <TextBlock Style="{DynamicResource ArcMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                             Text="Every element carries a GUID Revit changes on ANY edit. Identical means untouched and skips every other test; different means something changed, even something no other test can see. Whether it survives the way your previous version was made is what the run reports - if almost every pair differs, it does not, and this should be off."/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource ArcLabel}" Text="Use the VersionGuid"
                               ToolTip="Off: not read. Flag: an identical GUID skips the element, a different one only counts if a test can say what changed. Trust: a different GUID is clouded even when nothing else can say why - as 'edited'."/>
                    <ComboBox x:Name="GuidModeCombo" Grid.Column="1" Style="{DynamicResource ArcComboBox}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <Border Style="{DynamicResource ArcTickOrange}"/>
                <TextBlock Style="{DynamicResource ArcHeading}" Text="Experimental 2 - only what this view shows"/>
              </StackPanel>
              <Border Style="{DynamicResource ArcCard}">
                <StackPanel>
                  <TextBlock Style="{DynamicResource ArcMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"
                             Text="A pipe that moved 300mm straight up looks identical on a plan. With this on, a move or a resize is only clouded if it shows on THIS view's drawing by more than the distance below. Additions, removals, retypes, rotations and parameter changes are always kept."/>
                  <CheckBox x:Name="OnlyVisibleCheck" Style="{DynamicResource ArcCheckBox}"
                            Content="Only cloud a move or resize that shows in this view"/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource ArcLabel}" Text="...by more than, mm on paper"
                               ToolTip="Paper millimetres, measured on the view's own plane. 0.5mm is about a pen width; at 1:50 that is 25mm in the model."/>
                    <TextBox x:Name="VisibleTolBox" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <Border Style="{DynamicResource ArcTickOrange}"/>
                <TextBlock Style="{DynamicResource ArcHeading}" Text="The clouds"/>
              </StackPanel>
              <Border Style="{DynamicResource ArcCard}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="36"/>
                      <RowDefinition Height="36"/>
                      <RowDefinition Height="36"/>
                      <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{DynamicResource ArcLabel}"
                               Text="Changes closer than this share a cloud, mm on paper"
                               ToolTip="Paper millimetres, so a cloud looks the same at 1:50 as at 1:100."/>
                    <TextBox x:Name="MergeBox" Grid.Row="0" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                    <TextBlock Grid.Row="1" Style="{DynamicResource ArcLabel}"
                               Text="Clearance around a change, mm on paper"
                               ToolTip="How far the cloud sits outside what changed."/>
                    <TextBox x:Name="OffsetBox" Grid.Row="1" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                    <TextBlock Grid.Row="2" Style="{DynamicResource ArcLabel}"
                               Text="Most clouds on one view"
                               ToolTip="More than this and only the largest groups are drawn. A view that lights up everywhere usually means the link is not a previous version of this model."/>
                    <TextBox x:Name="MaxCloudsBox" Grid.Row="2" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                    <TextBlock Grid.Row="3" Style="{DynamicResource ArcLabel}"
                               Text="Scallop size, mm on paper (0 leaves the type alone)"
                               ToolTip="Arc length lives on the revision cloud TYPE, so setting it re-draws every cloud already on that type in the project, not just the ones this run makes. 0 changes nothing."/>
                    <TextBox x:Name="ArcLengthBox" Grid.Row="3" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                  </Grid>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource ArcLabel}" Text="Cloud arcs bulge"
                               ToolTip="Which side of the outline the scallops sit on. Revit decides this from the direction the outline is drawn, so if the clouds come out scalloped inwards, switch this to Inwards."/>
                    <ComboBox x:Name="ArcSideCombo" Grid.Column="1" Style="{DynamicResource ArcComboBox}"/>
                  </Grid>
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <Border Style="{DynamicResource ArcTickBlue}"/>
                <TextBlock Style="{DynamicResource ArcHeading}" Text="The comment on the cloud"/>
              </StackPanel>
              <Border Style="{DynamicResource ArcCard}">
                <StackPanel>
                  <CheckBox x:Name="WriteCommentsCheck" Style="{DynamicResource ArcCheckBox}"
                            Content="Describe the change in the cloud's Comments"
                            ToolTip="Writes something like '3 pipes moved, cable tray added' onto each cloud, so a revision schedule can carry it."/>
                  <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{DynamicResource ArcLabel}"
                               Text="How many kinds of change to list"
                               ToolTip="Beyond this the comment ends with 'and N more', so it still fits a schedule column."/>
                    <TextBox x:Name="CommentItemsBox" Grid.Column="1" Style="{DynamicResource ArcTextBox}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ====================== right column ====================== -->
            <StackPanel Grid.Column="2">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Style="{DynamicResource ArcTickOrange}"/>
                <TextBlock Style="{DynamicResource ArcHeading}" Text="Categories to compare"/>
              </StackPanel>
              <TextBlock Style="{DynamicResource ArcMuted}" FontSize="11" TextWrapping="Wrap"
                         Margin="0,0,0,4"
                         Text="One per line. Only these are read, out of the view and out of the link, so tags, text and dimensions are never compared."/>
              <TextBox x:Name="CategoriesBox" Style="{DynamicResource ArcTextArea}" Height="300"
                       AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                       ToolTip="Category names as Revit spells them. A name this model does not have is reported and skipped rather than failing."/>
              <Button x:Name="CategoriesResetButton" Style="{DynamicResource ArcSmallButton}"
                      Content="Restore the MEP list" HorizontalAlignment="Left" Margin="0,6,0,0"/>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <Border Style="{DynamicResource ArcTickBlue}"/>
                <TextBlock Style="{DynamicResource ArcHeading}" Text="Window"/>
              </StackPanel>
              <Border Style="{DynamicResource ArcCard}">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="36"/>
                      <RowDefinition Height="36"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Style="{DynamicResource ArcLabel}" Text="Theme"
                               ToolTip="Follow Revit uses whatever the canvas is set to."/>
                    <ComboBox x:Name="ThemeCombo" Grid.Row="0" Grid.Column="1" Style="{DynamicResource ArcComboBox}"/>
                    <TextBlock Grid.Row="1" Style="{DynamicResource ArcLabel}" Text="Show results"
                               ToolTip="A clean run does not interrupt by default."/>
                    <ComboBox x:Name="ResultsCombo" Grid.Row="1" Grid.Column="1" Style="{DynamicResource ArcComboBox}"/>
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- ============================ footer ============================ -->
        <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,5,5">
          <Grid Margin="14,0,14,0">
            <Button x:Name="DefaultsButton" Style="{DynamicResource ArcSmallButton}"
                    Content="Restore all defaults" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Padding="14,4"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="CancelButton" Style="{DynamicResource ArcSmallButton}"
                      Content="Cancel" Padding="16,4" Margin="0,0,8,0"/>
              <Button x:Name="ApplyButton" Style="{DynamicResource ArcGreenButton}"
                      Content="Apply" Padding="20,5"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ============================ resize grips ======================== -->
    <Grid x:Name="Grips">
      <Thumb x:Name="GripLeft" Style="{DynamicResource ArcGrip}" Width="6" HorizontalAlignment="Left" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripRight" Style="{DynamicResource ArcGrip}" Width="6" HorizontalAlignment="Right" Margin="0,8,0,8" Cursor="SizeWE"/>
      <Thumb x:Name="GripTop" Style="{DynamicResource ArcGrip}" Height="6" VerticalAlignment="Top" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripBottom" Style="{DynamicResource ArcGrip}" Height="6" VerticalAlignment="Bottom" Margin="8,0,8,0" Cursor="SizeNS"/>
      <Thumb x:Name="GripTopLeft" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE"/>
      <Thumb x:Name="GripTopRight" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBottomLeft" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW"/>
      <Thumb x:Name="GripBottomRight" Style="{DynamicResource ArcGrip}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"/>
    </Grid>
  </Grid>
</Window>

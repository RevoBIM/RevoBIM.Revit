<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Auto RevCloud - Add sheets" Width="620" Height="600" MinWidth="480" MinHeight="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="12.5">
  <Grid x:Name="Root">
    <Border x:Name="Shell" CornerRadius="6" Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource ShellEdge}" BorderThickness="1" Margin="5">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="52"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Border x:Name="Header" Grid.Row="0" Background="{DynamicResource BarBg}" CornerRadius="5,5,0,0">
          <Grid Margin="12,0,6,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="RevoBimLogo" Text="RevoBIM" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Bottom"/>
              <TextBlock x:Name="PickerTitle" Text="Add sheets" FontSize="15" Foreground="{DynamicResource OrangeBrush}" Margin="8,0,0,2" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Grid.Column="2" Style="{DynamicResource ArcMuted}" FontSize="11" Margin="12,0,6,0"/>
            <Button x:Name="FullScreenButton" Grid.Column="3" Style="{DynamicResource ArcIconButton}" ToolTip="Full screen (F11)">
              <Border Width="12" Height="12" BorderThickness="1.5" BorderBrush="{DynamicResource MutedBrush}" CornerRadius="1"/>
            </Button>
            <Button x:Name="CloseButton" Grid.Column="4" Style="{DynamicResource ArcCloseButton}" Content="&#x2715;"/>
          </Grid>
        </Border>

        <!-- ============================ body ============================== -->
        <Border Grid.Row="1" Style="{DynamicResource ArcCard}" Margin="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="SearchBox" Grid.Column="0" Style="{DynamicResource ArcTextBox}" Tag="Search number or name" Margin="0,0,8,0"/>
              <Button x:Name="AllButton" Grid.Column="1" Style="{DynamicResource ArcSmallButton}" Content="All"/>
              <Button x:Name="NoneButton" Grid.Column="2" Style="{DynamicResource ArcSmallButton}" Content="None" Margin="0"/>
            </Grid>
            <CheckBox x:Name="HideAddedCheck" Grid.Row="1" Style="{DynamicResource ArcCheckBox}" Content="Hide sheets already in the window" IsChecked="True" Margin="0,0,0,6"/>
            <ListBox x:Name="SheetList" Grid.Row="2" Style="{DynamicResource ArcList}" SelectionMode="Extended"/>
          </Grid>
        </Border>

        <!-- ============================ footer ============================ -->
        <Border Grid.Row="2" Background="{DynamicResource BarBg}" CornerRadius="0,0,5,5">
          <Grid Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Style="{DynamicResource ArcMuted}" Text="Click, shift-click for a run, ctrl-click to add or remove."/>
            <Button x:Name="CancelButton" Grid.Column="1" Style="{DynamicResource ArcButton}" Content="Cancel"/>
            <Button x:Name="AddButton" Grid.Column="2" Style="{DynamicResource ArcGreenButton}" Content="Add selected" Margin="0"/>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

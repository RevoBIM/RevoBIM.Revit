<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM" Width="720" Height="460"
        MinWidth="460" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Border CornerRadius="6" Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource FrameBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="46"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- ===================== header ===================== -->
        <Border x:Name="HeaderBar" Grid.Row="0" CornerRadius="6,6,0,0"
                Background="{DynamicResource BarBrush}">
          <Grid Margin="12,0,8,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoZone" Grid.Column="0" Background="Transparent"
                    ToolTip="RevoBIM PY">
              <StackPanel Orientation="Horizontal">
                <Image x:Name="LogoImage" Width="24" Height="24" VerticalAlignment="Center"/>
                <TextBlock Text="RevoBIM" Margin="8,0,0,0" Style="{DynamicResource TitleText}"/>
                <TextBlock x:Name="PromptTitle" Text="Callout to 3D"
                           Style="{DynamicResource SubtitleText}"/>
              </StackPanel>
            </Border>

            <TextBlock x:Name="VersionText" Grid.Column="2" Text="v1.0.0"
                       Margin="0,0,10,0" Style="{DynamicResource MutedText}"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
              <Button x:Name="ShrinkButton" Content="" Margin="0,0,2,0"
                      Style="{DynamicResource ShrinkButton}"/>
              <Button x:Name="CloseButton" Content="&#x2715;"
                      Style="{DynamicResource CloseButton}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===================== body ===================== -->
        <Border Grid.Row="1" Margin="14,10,14,4" CornerRadius="5"
                Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource EdgeBrush}" BorderThickness="1">
          <ScrollViewer Margin="12" VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="PromptBody" TextWrapping="NoWrap"
                       FontFamily="Consolas" FontSize="12"
                       Foreground="{DynamicResource TextBrush}"/>
          </ScrollViewer>
        </Border>

        <!-- ===================== footer ===================== -->
        <Border Grid.Row="2" CornerRadius="0,0,6,6" Background="{DynamicResource BarBrush}">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                      VerticalAlignment="Center" Margin="0,0,14,0">
            <Button x:Name="CancelButton" Content="Cancel" Margin="0,0,10,0"
                    Style="{DynamicResource GhostButton}"/>
            <Button x:Name="OkButton" Content="Close"
                    Style="{DynamicResource PrimaryButton}"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="GripGrid"/>
  </Grid>
</Window>

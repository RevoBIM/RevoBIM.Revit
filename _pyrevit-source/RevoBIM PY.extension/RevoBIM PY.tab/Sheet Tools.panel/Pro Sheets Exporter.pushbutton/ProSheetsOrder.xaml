<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Order sheets and views"
        Width="560" Height="640" MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SnapsToDevicePixels="True">

  <Grid>
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0"
                Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoHost" Grid.Column="0" Width="28" Height="28"
                    CornerRadius="4" Margin="0,0,11,0"
                    Background="{DynamicResource ChipBg}" Cursor="Hand">
              <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="17" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Order sheets and views" FontSize="13"
                         Margin="0,-3,0,0"
                         Foreground="{DynamicResource OrangeBrush}"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" Grid.Column="2"
                       Style="{DynamicResource MutedText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" Text="v0.0.0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen"/>
              <Button x:Name="CloseButton"
                      Style="{DynamicResource CloseButton}"
                      Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <ListBox x:Name="OrderList" Grid.Row="1" Margin="14,14,14,0"
                 SelectionMode="Extended"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="14,10,14,0">
          <Button x:Name="MoveTopButton" Width="46" Height="32"
                  Margin="0,0,8,0" ToolTip="Move to the top">
            <Path Width="13" Height="12" Stretch="Uniform"
                  Fill="{DynamicResource MutedBrush}"
                  Data="M 0,0 L 12,0 L 12,2 L 0,2 Z M 6,3 L 12,10 L 0,10 Z"/>
          </Button>
          <Button x:Name="MoveUpButton" Width="46" Height="32"
                  Margin="0,0,8,0" ToolTip="Move up">
            <Path Width="13" Height="9" Stretch="Uniform"
                  Fill="{DynamicResource MutedBrush}"
                  Data="M 6,0 L 12,9 L 0,9 Z"/>
          </Button>
          <Button x:Name="MoveDownButton" Width="46" Height="32"
                  Margin="0,0,8,0" ToolTip="Move down">
            <Path Width="13" Height="9" Stretch="Uniform"
                  Fill="{DynamicResource MutedBrush}"
                  Data="M 0,0 L 12,0 L 6,9 Z"/>
          </Button>
          <Button x:Name="MoveBottomButton" Width="46" Height="32"
                  Margin="0,0,8,0" ToolTip="Move to the bottom">
            <Path Width="13" Height="12" Stretch="Uniform"
                  Fill="{DynamicResource MutedBrush}"
                  Data="M 0,0 L 12,0 L 6,7 Z M 0,10 L 12,10 L 12,12 L 0,12 Z"/>
          </Button>
          <Button x:Name="SortButton" Content="Sheet number order"
                  Style="{DynamicResource ChipButton}" Margin="8,0,0,0"/>
        </StackPanel>

        <Border Grid.Row="3" Margin="0,14,0,0"
                Background="{DynamicResource BarBg}"
                CornerRadius="0,0,5,5" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{DynamicResource MutedText}"
                       VerticalAlignment="Center"
                       Text="This is the page order in the combined file."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CancelButton" Content="Cancel" Width="100"
                      Margin="0,0,9,0"/>
              <Button x:Name="OkButton" Content="Ok" Width="100"
                      Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="GripLayer">
      <Grid.RowDefinitions>
        <RowDefinition Height="5"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="5"/>
      </Grid.ColumnDefinitions>
      <Thumb x:Name="GripNW" Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripN"  Grid.Row="0" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripNE" Grid.Row="0" Grid.Column="2" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripW"  Grid.Row="1" Grid.Column="0" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripE"  Grid.Row="1" Grid.Column="2" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSW" Grid.Row="2" Grid.Column="0" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripS"  Grid.Row="2" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSE" Grid.Row="2" Grid.Column="2" Cursor="SizeNWSE"
             Style="{DynamicResource GripThumb}"/>
    </Grid>
  </Grid>
</Window>

<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Revision Manager settings"
        Width="900" Height="600" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SnapsToDevicePixels="True">

  <Grid>
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="HeaderBar" Grid.Row="0"
                Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoHost" Grid.Column="0" Width="28" Height="28"
                    CornerRadius="4" Margin="0,0,11,0"
                    Background="{DynamicResource ChipBg}" Cursor="Hand">
              <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="17" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Revision Manager settings" FontSize="13"
                         Margin="0,-3,0,0"
                         Foreground="{DynamicResource OrangeBrush}"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" Grid.Column="2"
                       Style="{DynamicResource MutedText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" Text="v0.0.0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen"/>
              <Button x:Name="CloseButton"
                      Style="{DynamicResource CloseButton}"
                      Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
          <StackPanel Margin="16,14,16,4">
            <!-- ================ Revision Manager ================ -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Border Width="4" Height="16" Margin="0,0,8,0"
                      Background="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Revision Manager" FontSize="15" FontWeight="Bold"
                         Foreground="{DynamicResource TextBrush}"/>
            </StackPanel>
            <TextBlock Style="{DynamicResource MutedText}" TextWrapping="Wrap"
                       Margin="0,0,0,14"
                       Text="These settings belong to this model: the columns you have added and where their values are pushed. They are written on Apply in the manager, with everything else."/>

            <Border Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource EdgeBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12,10">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Columns and parameter mapping"
                             Style="{DynamicResource SectionLabel}"
                             VerticalAlignment="Center"/>
                  <!-- Hover for how mapping works. -->
                  <Border x:Name="MappingHelp" Width="16" Height="16"
                          Margin="8,0,0,0" CornerRadius="8" Cursor="Help"
                          Background="{DynamicResource BlueBrush}"
                          VerticalAlignment="Center">
                    <TextBlock Text="i" FontWeight="Bold" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                  </Border>
                </StackPanel>
                <StackPanel x:Name="MappingTable"/>
                <TextBlock x:Name="MappingEmpty" Style="{DynamicResource MutedText}"
                           TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"
                           Text="No columns of your own yet. Add one with the green + in the Revision Manager."/>
              </StackPanel>
            </Border>

            <TextBlock Style="{DynamicResource MutedText}" TextWrapping="Wrap"
                       Margin="0,10,0,10"
                       Text="Only instance parameters bound to Sheets or Revision Clouds are listed, and only those whose type of data the column can be written into. Not there yet? Add it in Project Parameters, then Refresh."/>

            <StackPanel Orientation="Horizontal">
              <Button x:Name="ProjectParamsButton" Margin="0,0,9,0" Height="30"
                      ToolTip="Closes the manager and opens Revit's Project Parameters. Add an instance parameter to Sheets or Revision Clouds there, then open the Revision Manager again and map it here.">
                <StackPanel Orientation="Horizontal" Margin="6,0">
                  <Path Width="12" Height="12" Stretch="Uniform"
                        Margin="0,0,8,0" VerticalAlignment="Center"
                        Fill="{DynamicResource GreenBrush}"
                        Data="M 5,0 L 7,0 L 7,5 L 12,5 L 12,7 L 7,7 L 7,12 L 5,12 L 5,7 L 0,7 L 0,5 L 5,5 Z"/>
                  <TextBlock Text="Open Project Parameters..." VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="RefreshParamsButton" Content="Refresh list"
                      Style="{DynamicResource ChipButton}"
                      VerticalAlignment="Center"
                      ToolTip="Read the project's parameters again"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="{DynamicResource BarBg}"
                CornerRadius="0,0,5,5" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{DynamicResource MutedText}"
                       VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="Changes here are staged in the manager and written on Apply."/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CancelButton" Content="Cancel" Width="100"
                      Margin="0,0,9,0"/>
              <Button x:Name="OkButton" Content="Ok" Width="100"
                      Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>

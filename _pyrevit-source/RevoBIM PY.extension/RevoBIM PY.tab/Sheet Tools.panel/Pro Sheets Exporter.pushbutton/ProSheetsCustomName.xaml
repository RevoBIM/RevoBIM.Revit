<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevoBIM Custom File Name"
        Width="1080" Height="720" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" SnapsToDevicePixels="True">

  <Grid>
    <Border Background="{DynamicResource WindowBg}"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            BorderThickness="1" CornerRadius="6">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ======================= header ======================= -->
        <Border x:Name="HeaderBar" Grid.Row="0"
                Background="{DynamicResource BarBg}"
                CornerRadius="5,5,0,0" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="LogoHost" Grid.Column="0" Width="30" Height="30"
                    CornerRadius="4" Margin="0,0,11,0"
                    Background="{DynamicResource ChipBg}" Cursor="Hand">
              <Image x:Name="LogoImage" Stretch="Uniform" Margin="3"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="RevoBIM" FontSize="18" FontWeight="Bold"
                         Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock x:Name="NameModeText" Text="Custom File Name"
                         FontSize="14"
                         Margin="0,-3,0,0"
                         Foreground="{DynamicResource OrangeBrush}"/>
            </StackPanel>

            <TextBlock x:Name="VersionText" Grid.Column="2"
                       Style="{DynamicResource MutedText}"
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,10,0" Text="v0.0.0"/>

            <StackPanel Grid.Column="3" Orientation="Horizontal"
                        VerticalAlignment="Center">
              <Button x:Name="ShrinkButton" Style="{DynamicResource ShrinkButton}"
                      ToolTip="Shrink to the bottom of the screen"/>
              <Button x:Name="CloseButton"
                      Style="{DynamicResource CloseButton}"
                      Content="&#x2715;"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ======================= body ======================= -->
        <Grid Grid.Row="1" Margin="14,14,14,0">
          <Grid.ColumnDefinitions>
            <!-- Both columns either side of the splitter are star sized.
                 With one of them absolute the splitter writes pixels into
                 it, Grid never shrinks an absolute column, and widening the
                 panel then shrinking the window pushes the table off the
                 edge with no scrollbar to get it back. -->
            <ColumnDefinition x:Name="LeftColumn" Width="0.72*" MinWidth="240"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition x:Name="RightColumn" Width="1.28*" MinWidth="380"/>
          </Grid.ColumnDefinitions>

          <!-- available parameters -->
          <Border Grid.Column="0" Background="{DynamicResource CardBg}"
                  BorderBrush="{DynamicResource EdgeBrush}"
                  BorderThickness="1" CornerRadius="4">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="{DynamicResource HeaderBg}"
                      CornerRadius="3,3,0,0" Padding="10,8">
                <TextBlock Text="Available Parameters"
                           Style="{DynamicResource SectionLabel}"
                           HorizontalAlignment="Center"/>
              </Border>

              <ComboBox x:Name="GroupCombo" Grid.Row="1" Margin="8,8,8,0"/>
              <TextBox x:Name="ParamSearchBox" Grid.Row="2" Margin="8,7,8,7"
                       Tag="Search"/>

              <ListBox x:Name="AvailableList" Grid.Row="3"
                       Margin="8,0,8,8"
                       SelectionMode="Extended"
                       BorderThickness="1"
                       ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Width="4" Margin="5,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"/>

          <!-- push buttons -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center"
                      Margin="6,0,10,0">
            <Button x:Name="PushRightButton" Width="46" Height="40"
                    Margin="0,0,0,12"
                    ToolTip="Add the chosen parameters to the file name">
              <Path Width="13" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource BlueBrush}"
                    Data="M 0,0 L 11,7.5 L 0,15 Z"/>
            </Button>
            <Button x:Name="PushLeftButton" Width="46" Height="40"
                    ToolTip="Take the chosen rows back out of the file name">
              <Path Width="13" Height="15" Stretch="Uniform"
                    Fill="{DynamicResource MutedBrush}"
                    Data="M 11,0 L 0,7.5 L 11,15 Z"/>
            </Button>
          </StackPanel>

          <!-- chosen parameters -->
          <Grid Grid.Column="3">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="RuleGrid" Grid.Row="0"
                      IsReadOnly="False"
                      SelectionMode="Extended"
                      HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Parameter Name"
                                    Binding="{Binding pname}"
                                    Width="1.6*" MinWidth="150" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Prefix" Width="0.8*" MinWidth="70">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding prefix, Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
                               BorderThickness="0" Background="Transparent"
                               Margin="0" Padding="0,2"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Sample Value"
                                    Binding="{Binding sample}"
                                    Width="1.4*" MinWidth="120" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Suffix" Width="0.8*" MinWidth="70">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding suffix, Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
                               BorderThickness="0" Background="Transparent"
                               Margin="0" Padding="0,2"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Separator" Width="0.8*" MinWidth="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBox Text="{Binding sep, Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
                               BorderThickness="0" Background="Transparent"
                               Margin="0" Padding="0,2"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="MoveTopButton" Width="46" Height="32"
                      Margin="0,0,8,0" ToolTip="Move to the top">
                <Path Width="13" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource MutedBrush}"
                      Data="M 0,0 L 12,0 L 12,2 L 0,2 Z M 6,3 L 12,10 L 0,10 Z"/>
              </Button>
              <Button x:Name="MoveUpButton" Width="46" Height="32"
                      Margin="0,0,8,0" ToolTip="Move up">
                <Path Width="13" Height="9" Stretch="Uniform"
                      Fill="{DynamicResource MutedBrush}"
                      Data="M 6,0 L 12,9 L 0,9 Z"/>
              </Button>
              <Button x:Name="MoveDownButton" Width="46" Height="32"
                      Margin="0,0,8,0" ToolTip="Move down">
                <Path Width="13" Height="9" Stretch="Uniform"
                      Fill="{DynamicResource MutedBrush}"
                      Data="M 0,0 L 12,0 L 6,9 Z"/>
              </Button>
              <Button x:Name="MoveBottomButton" Width="46" Height="32"
                      Margin="0,0,8,0" ToolTip="Move to the bottom">
                <Path Width="13" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource MutedBrush}"
                      Data="M 0,0 L 12,0 L 6,7 Z M 0,10 L 12,10 L 12,12 L 0,12 Z"/>
              </Button>
              <Button x:Name="ResetButton" Width="46" Height="32"
                      ToolTip="Back to Sheet Number and Sheet Name">
                <Path Width="14" Height="14" Stretch="Uniform"
                      Fill="{DynamicResource OrangeBrush}"
                      Data="M 7,0 A 7,7 0 1 1 0.9,3.6 L 2.7,4.6 A 5,5 0 1 0 7,2 Z M 6,0 L 10,2.2 L 6,4.4 Z"/>
              </Button>

              <TextBlock x:Name="SampleNote" Style="{DynamicResource MutedText}"
                         VerticalAlignment="Center" Margin="16,0,0,0"
                         TextTrimming="CharacterEllipsis"
                         Text="Sample values come from the first ticked sheet."/>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ======================= preview ======================= -->
        <Border Grid.Row="2" Margin="14,14,14,0" Padding="12,10"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource EdgeBrush}"
                BorderThickness="1" CornerRadius="4">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Custom Name Preview:"
                         Style="{DynamicResource FieldLabel}"
                         Margin="0,0,10,0"/>
              <TextBlock x:Name="PreviewText" Grid.Column="1"
                         FontFamily="Consolas" FontSize="12.5"
                         Foreground="{DynamicResource BlueBrush}"
                         TextTrimming="CharacterEllipsis"
                         Text="(nothing chosen)"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="On the first sheet:"
                         Style="{DynamicResource FieldLabel}"
                         Margin="0,0,10,0"/>
              <TextBlock x:Name="RealPreviewText" Grid.Column="1"
                         FontFamily="Consolas" FontSize="12.5"
                         Foreground="{DynamicResource GreenBrush}"
                         TextTrimming="CharacterEllipsis" Text=""/>
            </Grid>
          </Grid>
        </Border>

        <!-- ======================= footer ======================= -->
        <Border Grid.Row="3" Margin="0,14,0,0"
                Background="{DynamicResource BarBg}"
                CornerRadius="0,0,5,5" Padding="14,9">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0"
                       Style="{DynamicResource MutedText}"
                       VerticalAlignment="Center" Text=""/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CancelButton" Content="Cancel" Width="108"
                      Margin="0,0,9,0"/>
              <Button x:Name="OkButton" Content="Ok" Width="108"
                      Style="{DynamicResource PrimaryButton}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Grid x:Name="GripLayer">
      <Grid.RowDefinitions>
        <RowDefinition Height="5"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="5"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="5"/>
      </Grid.ColumnDefinitions>
      <Thumb x:Name="GripNW" Grid.Row="0" Grid.Column="0" Cursor="SizeNWSE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripN"  Grid.Row="0" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripNE" Grid.Row="0" Grid.Column="2" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripW"  Grid.Row="1" Grid.Column="0" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripE"  Grid.Row="1" Grid.Column="2" Cursor="SizeWE"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSW" Grid.Row="2" Grid.Column="0" Cursor="SizeNESW"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripS"  Grid.Row="2" Grid.Column="1" Cursor="SizeNS"
             Style="{DynamicResource GripThumb}"/>
      <Thumb x:Name="GripSE" Grid.Row="2" Grid.Column="2" Cursor="SizeNWSE"
             Style="{DynamicResource GripThumb}"/>
    </Grid>
  </Grid>
</Window>
